<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PackageId>Panoptes.AspNetCore</PackageId>
    <Version>1.0.0</Version>
    <Authors>Fatih Ceritli, Panoptes UI</Authors>
    <Company>Panoptes UI</Company>
    <Product>Panoptes ASP.NET Core UI Components</Product>
    <Description>Enterprise UI Components &amp; Razor TagHelpers (&lt;panoptes-grid&gt;, Scheduler, TreeList, Form components) for ASP.NET Core MVC &amp; Razor Pages. Zero external dependencies, Tailwind CSS and Bootstrap 5 themes included.</Description>
    <PackageTags>panoptes;aspnetcore;taghelper;razor;grid;datagrid;components;ui;tailwind;bootstrap</PackageTags>
    <PackageProjectUrl>https://panoptesui.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ceritli/panoptesui-aspnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Panoptes.Core\Panoptes.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
