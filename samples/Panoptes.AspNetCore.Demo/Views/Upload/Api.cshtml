@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Upload JavaScript API - Panoptes Enterprise UI" : "API Metotları - Upload - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/Upload" : "/Upload")" class="hover:text-blue-600 transition">Upload</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">@(isEn ? "API Methods" : "API Metotları")</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Upload - @(isEn ? "JavaScript Client API" : "API Metotları")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-violet-50 text-violet-700 border border-violet-200 font-mono">
                    Panoptes.Upload API
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    getFiles / clearFiles
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Read uploaded files, clear queues, access file objects, and interact with the upload instance programmatically." 
                    : "İstemci tarafında Upload bileşenine JavaScript ile müdahale etme ve durumunu okuma.")
            </p>
        </div>
    </div>

    <!-- DEMO: API -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-violet-600 inline-block"></span>
                    @(isEn ? "Programmatic JavaScript API Methods" : "Programatik JavaScript API")
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    @(isEn 
                        ? "Inspect and control file queues via the Panoptes.Upload helper methods." 
                        : "Panoptes.Upload nesnesi üzerinden listeyi temizleme ve dosyaları okuma.")
                </p>
            </div>
            <span class="text-xs font-mono bg-violet-50 text-violet-700 px-2 py-1 rounded font-medium border border-violet-100">Panoptes.Upload API</span>
        </div>

        <div class="p-8 max-w-2xl mx-auto space-y-6">
            <panoptes-upload id="apiUploadDemo" 
                            name="apiFiles" 
                            multiple="true" 
                            auto-upload="true" 
                            save-url="/Upload/Save" 
                            drop-zone-text="@(isEn ? "Upload files to test client API" : "API'yi test etmek için dosyalar yükleyin")" />

            <!-- API Butonları -->
            <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-slate-200">
                <button type="button" onclick="getUploadFiles()" class="px-3 py-1.5 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-lg transition active:scale-95 border border-blue-200 cursor-pointer">
                    @(isEn ? "Get Files (getFiles)" : "Dosya Listesini Oku (getFiles)")
                </button>
                <button type="button" onclick="clearUploadFiles()" class="px-3 py-1.5 text-xs font-semibold text-rose-700 bg-rose-50 hover:bg-rose-100 rounded-lg transition active:scale-95 border border-rose-200 cursor-pointer">
                    @(isEn ? "Clear All Files (clearFiles)" : "Tüm Dosyaları Temizle (clearFiles)")
                </button>
            </div>
        </div>

        <!-- Tabbed Light Code Block (Prime standard) -->
        <div class="panoptes-code-block border-t border-slate-200 bg-white overflow-hidden">
            <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">JavaScript API</span>
                </div>
                <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                    <span>@(isEn ? "Copy" : "Kopyala")</span>
                </button>
            </div>
            <div class="panoptes-code-viewer">
                <pre class="panoptes-raw-code hidden"><code>// Dosya listesini okuma
const files = Panoptes.Upload.getFiles('apiUploadDemo');
console.log(files); // [{id: '...', name: '...', status: 'success'}]

// Dosyaları temizleme
Panoptes.Upload.clearFiles('apiUploadDemo');</code></pre>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/panoptes/panoptes-upload.js"></script>
    <script>
        function getUploadFiles() {
            const files = Panoptes.Upload.getFiles('apiUploadDemo');
            alert(`Toplam Seçili/Yüklü Dosya Sayısı: ${files.length}\nDetayları Console'dan inceleyebilirsiniz.`);
            console.log("Dosya Listesi:", files);
        }

        function clearUploadFiles() {
            Panoptes.Upload.clearFiles('apiUploadDemo');
        }
    </script>
}
