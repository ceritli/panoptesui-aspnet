@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Editor (Rich Text WYSIWYG) - Panoptes Enterprise UI" : "Editor (Zengin Metin Editörü - WYSIWYG) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/Editor" : "/Editor")" class="hover:text-blue-600 transition">@(isEn ? "Form Components" : "Form Bileşenleri")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">Editor</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Editor (Zengin Metin Editörü - WYSIWYG)</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-editor&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    WAI-ARIA Uyumlu
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn ? "Formatted announcements and mail templates without leaving the form." : "Duyuru ve e-posta şablonları formdan çıkmadan biçimli yazılır.")
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>Örnekler (Features)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">5</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>API Referansı (Props & Events)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">5</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>Erişilebilirlik (WAI-ARIA)</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
<!-- DEMO 1: Standart Zengin Blog & Makale Düzenleyici -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                    1. Standart Zengin Makale Düzenleyici (Tam Araç Çubuğu, Tablo & HTML Kaynak Kodu)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    H1-H3 başlıkları, kalın/italik/altı çizili, hizalama, numaralı ve madde imli listeler, tablo ekleme ve &lt;/&gt; HTML kaynak kodu görünümü.
                </p>
            </div>
            <span class="text-xs font-mono bg-blue-50 text-blue-700 px-2 py-1 rounded font-medium border border-blue-100">&lt;panoptes-editor tools="all"&gt;</span>
        </div>

        <div class="p-8 max-w-4xl mx-auto space-y-4">
            <panoptes-editor id="fullEditorDemo" 
                            name="articleContent" 
                            height="300" 
                            tools="all">
                <h2>Panoptes Kurumsal UI Mimarisi</h2>
                <p>Panoptes, modern web uygulamaları için <strong>sıfır harici kütüphane bağımlılığı</strong> ile geliştirilmiş yüksek performanslı bir <em>ASP.NET Core</em> bileşen kütüphanesidir.</p>
                <ul>
                    <li>Tailwind CSS tabanlı mikro animasyonlar ve modern estetik</li>
                    <li>Tam erişilebilir WAI-ARIA klavye navigasyonu</li>
                    <li>Hafif ve yüksek performanslı saf Vanilla JS motoru</li>
                </ul>
            </panoptes-editor>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-3 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>Kopyala</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-editor id=&quot;fullEditorDemo&quot; 
                 name=&quot;articleContent&quot; 
                 height=&quot;300&quot; 
                 tools=&quot;all&quot;&gt;
    &lt;h2&gt;Panoptes Kurumsal UI Mimarisi&lt;/h2&gt;
    &lt;p&gt;Panoptes, modern web uygulamaları için...&lt;/p&gt;
&lt;/panoptes-editor&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 2: Sade E-Posta & Hızlı Yorum Editörü -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-indigo-600 inline-block"></span>
                    2. Sade E-Posta & Destek Talebi Yanıt Editörü (tools="basic")
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Kullanıcı yorumları, bilet yanıtlama veya kompakt formlar için sadece temel metin biçimlendirmeyi içeren minimal araç çubuğu modu.
                </p>
            </div>
            <span class="text-xs font-mono bg-indigo-50 text-indigo-700 px-2 py-1 rounded font-medium border border-indigo-100">tools="basic"</span>
        </div>

        <div class="p-8 max-w-4xl mx-auto space-y-4">
            <panoptes-editor id="basicEditorDemo" 
                            name="replyContent" 
                            height="180" 
                            tools="basic" 
                            placeholder="Müşteriye iletilecek yanıt mesajınızı buraya yazın...">
                <p>Merhaba Fatih Bey,</p>
                <p>Destek talebiniz sistemimize ulaşmış olup teknik ekibimiz tarafından incelenmektedir.</p>
            </panoptes-editor>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-3 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>Kopyala</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-editor id=&quot;basicEditorDemo&quot; 
                 name=&quot;replyContent&quot; 
                 height=&quot;180&quot; 
                 tools=&quot;basic&quot; 
                 placeholder=&quot;Müşteriye iletilecek yanıt...&quot; /&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 3: Programatik JavaScript API, Şablon Yükleme ve Canlı Log -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
                    3. Programatik JavaScript API, Şablon Yükleme ve Canlı Günlük (Event Log)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    getHTML(), setHTML(), getText() fonksiyonları ile dışarıdan şablon yükleme ve on-change canlı içerik takibi.
                </p>
            </div>
            <span class="text-xs font-mono bg-emerald-50 text-emerald-700 px-2 py-1 rounded font-medium border border-emerald-100">Panoptes.Editor API</span>
        </div>

        <div class="p-8 max-w-4xl mx-auto space-y-6">
            <panoptes-editor id="apiEditorDemo" 
                            name="apiContent" 
                            height="220" 
                            tools="all" 
                            on-change="onApiEditorChange" 
                            placeholder="Canlı API takibi için buraya yazın...">
                <p>Canlı API motorunu test etmek için butonları kullanabilir veya metni değiştirebilirsiniz.</p>
            </panoptes-editor>

            <!-- API Kontrol Butonları -->
            <div class="flex flex-wrap items-center gap-2 pt-2">
                <button type="button" onclick="loadTemplateA()" class="px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition active:scale-95 border border-slate-200">
                    Sözleşme Şablonu Yükle
                </button>
                <button type="button" onclick="loadTemplateB()" class="px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition active:scale-95 border border-slate-200">
                    Duyuru Şablonu Yükle
                </button>
                <button type="button" onclick="readEditorHtml()" class="px-3 py-1.5 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-lg transition active:scale-95 border border-blue-200">
                    HTML Kodunu Oku (getHTML)
                </button>
                <button type="button" onclick="readEditorText()" class="px-3 py-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-lg transition active:scale-95 border border-emerald-200">
                    Saf Metni Oku (getText)
                </button>
                <button type="button" onclick="clearEditorLog()" class="ml-auto px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-slate-800 transition">
                    Günlüğü Temizle
                </button>
            </div>

            <!-- Canlı Olay Günlüğü Terminali -->
            <div class="space-y-1">
                <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Canlı Olay Günlüğü (Terminal):</div>
                <div id="editorEventLog" class="h-28 bg-slate-950 text-slate-200 p-3 rounded-xl font-mono text-[11px] overflow-y-auto space-y-1 border border-slate-800 shadow-inner">
                    <div class="text-slate-500">// Editör olayları ve HTML çıktıları burada canlı listelenecektir...</div>
                </div>
            </div>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-3 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>Kopyala</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-editor id=&quot;apiEditorDemo&quot; 
                 name=&quot;apiContent&quot; 
                 height=&quot;220&quot; 
                 tools=&quot;all&quot; 
                 on-change=&quot;onApiEditorChange&quot; /&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- Parametre & Nitelik Referans Tablosu -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 bg-slate-50/50">
            <h2 class="text-base font-bold text-slate-800">TagHelper Parametre & Nitelik Referansı</h2>
            <p class="text-xs text-slate-500 mt-0.5">&lt;panoptes-editor&gt; bileşeninin desteklediği tüm nitelikler</p>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-600">
                <thead class="bg-slate-50 text-slate-800 font-bold border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-3">Nitelik (Attribute)</th>
                        <th class="px-6 py-3">Tür (Type)</th>
                        <th class="px-6 py-3">Varsayılan</th>
                        <th class="px-6 py-3">Açıklama</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">id</td>
                        <td class="px-6 py-3 font-mono text-slate-500">string</td>
                        <td class="px-6 py-3 font-mono text-slate-400">otomatik guid</td>
                        <td class="px-6 py-3">Bileşenin benzersiz DOM kimliği ve JavaScript API referansı.</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">name</td>
                        <td class="px-6 py-3 font-mono text-slate-500">string</td>
                        <td class="px-6 py-3 font-mono text-slate-400">id ile aynı</td>
                        <td class="px-6 py-3">Form POST edilirken eşleşecek gizli input adı.</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">height</td>
                        <td class="px-6 py-3 font-mono text-slate-500">int</td>
                        <td class="px-6 py-3 font-mono text-slate-400">320</td>
                        <td class="px-6 py-3">Düzenleyici alanının minimum piksel yüksekliği.</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">tools</td>
                        <td class="px-6 py-3 font-mono text-slate-500">string</td>
                        <td class="px-6 py-3 font-mono text-slate-400">"all"</td>
                        <td class="px-6 py-3">Araç çubuğu seti: "all" (tam donanım) veya "basic" (sade metin formatı).</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">placeholder</td>
                        <td class="px-6 py-3 font-mono text-slate-500">string</td>
                        <td class="px-6 py-3 font-mono text-slate-400">"İçeriğinizi buraya..."</td>
                        <td class="px-6 py-3">İçerik boşken gösterilen yer tutucu metin.</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">readonly</td>
                        <td class="px-6 py-3 font-mono text-slate-500">bool</td>
                        <td class="px-6 py-3 font-mono text-slate-400">false</td>
                        <td class="px-6 py-3">Düzenlemeyi engeller ve araç çubuğunu gizler.</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">on-change</td>
                        <td class="px-6 py-3 font-mono text-slate-500">string</td>
                        <td class="px-6 py-3 font-mono text-slate-400">null</td>
                        <td class="px-6 py-3">Metin veya biçim her değiştiğinde çağrılan JavaScript fonksiyon adı.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>


</div>

@section Scripts {
    <script src="~/panoptes/panoptes-editor.js"></script>
    
}

    <!-- PANEL 2: API & ATTRIBUTES -->
    <div id="panel-api" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">TagHelper Özellikleri & Parametreleri</h3>
                    <p class="text-xs text-slate-500 mt-0.5">&lt;panoptes-editor&gt; bileşeninin desteklediği tüm C# ve HTML nitelikleri.</p>
                </div>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-blue-100 text-blue-800">PanoptesEditorTagHelper</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                            <th class="py-3 px-6">Özellik (Attribute)</th>
                            <th class="py-3 px-4">Tip (C#)</th>
                            <th class="py-3 px-4">Varsayılan</th>
                            <th class="py-3 px-6">Açıklama</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">id</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">Otomatik</td>
                            <td class="py-3 px-6 text-slate-700">Bileşen kimliği.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">value</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">HTML formatındaki başlangıç içeriği.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">height</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">"320px"</td>
                            <td class="py-3 px-6 text-slate-700">Editör yazma alanının yüksekliği.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">tools</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">"all"</td>
                            <td class="py-3 px-6 text-slate-700">Araç çubuğunda gösterilecek buton grupları.</td>
