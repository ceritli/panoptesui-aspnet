                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PANEL 3: ACCESSIBILITY (WAI-ARIA & KEYBOARD) -->
    <div id="panel-a11y" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
            <div>
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
                    WAI-ARIA Standartları & Klavye Erişilebilirliği
                </h2>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                    Panoptes Editor bileşeni, W3C WAI-ARIA standartlarına uygun olarak ekran okuyucular ve salt klavye navigasyonu için tasarlanmıştır.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">WAI-ARIA Nitelikleri</div>
                    <div class="text-slate-600">
                        Standart <code>role="textbox (rich-text)"</code> rolünü taşır. Duruma göre <code>aria-disabled</code>, <code>aria-expanded</code>, <code>aria-selected</code> ve <code>aria-label</code> nitelikleri dinamik olarak güncellenir.
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">Odak Yönetimi (Focus Management)</div>
                    <div class="text-slate-600">
                        Sekme sırasını doğal akışında korur (<code>tabIndex="0"</code>). Görsel odak halkaları (focus ring) yüksek kontrastla görünür durumdadır.
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <h3 class="text-sm font-bold text-slate-900 mb-3">Klavye Kısayolları (Keyboard Shortcuts)</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                                <th class="py-2.5 px-4 w-48">Tuş (Key)</th>
                                <th class="py-2.5 px-4">İşlev (Function)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Ctrl+B / Cmd+B</kbd></td>
                                <td class="py-2.5 px-4">Seçili metni kalın yapar.</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Ctrl+I / Cmd+I</kbd></td>
                                <td class="py-2.5 px-4">Seçili metni italik yapar.</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Ctrl+U / Cmd+U</kbd></td>
                                <td class="py-2.5 px-4">Seçili metnin altını çizer.</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Ctrl+Z / Cmd+Z</kbd></td>
                                <td class="py-2.5 px-4">Son işlemi geri alır.</td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
function onApiEditorChange(html, inst) {
            logEditorEvent(`[on-change]: İçerik güncellendi. Toplam ${html.length} karakter.`);
        }

        function loadTemplateA() {
            const tpl = `
                <h3>Gizlilik ve Hizmet Sözleşmesi</h3>
                <p>Bu sözleşme, taraflar arasındaki hizmet kapsamını ve veri güvenliği standartlarını belirler.</p>
                <table class="w-full my-2 border border-slate-300 text-xs">
                    <tr class="bg-slate-100"><th class="border p-2 text-left">Madde</th><th class="border p-2 text-left">Açıklama</th></tr>
                    <tr><td class="border p-2">Madde 1</td><td class="border p-2">Tarafların karşılıklı yükümlülükleri.</td></tr>
                    <tr><td class="border p-2">Madde 2</td><td class="border p-2">Gizli bilginin korunması ve KVKK uyumu.</td></tr>
                </table>
            `;
            Panoptes.Editor.setHTML('apiEditorDemo', tpl);
            logEditorEvent(`Panoptes.Editor.setHTML('apiEditorDemo') ile Sözleşme Şablonu yüklendi.`);
        }

        function loadTemplateB() {
            const tpl = `
                <h2>🎉 Yeni Sürüm v2.0 Duyurusu</h2>
                <p>Panoptes kütüphanesine yeni eklenen tüm modern bileşenler yayına alınmıştır.</p>
                <blockquote>"Hızlı, hafif ve bağımsızlıksız kurumsal arayüzler."</blockquote>
            `;
            Panoptes.Editor.setHTML('apiEditorDemo', tpl);
            logEditorEvent(`Panoptes.Editor.setHTML('apiEditorDemo') ile Duyuru Şablonu yüklendi.`);
        }

        function readEditorHtml() {
            const html = Panoptes.Editor.getHTML('apiEditorDemo');
            logEditorEvent(`[getHTML]: ${html}`);
            alert(html);
        }

        function readEditorText() {
            const text = Panoptes.Editor.getText('apiEditorDemo');
            logEditorEvent(`[getText]: ${text}`);
            alert(text);
        }

        function logEditorEvent(msg) {
            const logBox = document.getElementById('editorEventLog');
            if (!logBox) return;
            const time = new Date().toLocaleTimeString('tr-TR');
            const row = document.createElement('div');
            row.innerHTML = `<span class="text-emerald-400 font-mono">[${time}]</span> <span class="text-slate-200">${msg}</span>`;
            logBox.appendChild(row);
            logBox.scrollTop = logBox.scrollHeight;
        }

        function clearEditorLog() {
            const logBox = document.getElementById('editorEventLog');
            if (logBox) logBox.innerHTML = '<div class="text-slate-500">// Günlük temizlendi...</div>';
        }
</script>
