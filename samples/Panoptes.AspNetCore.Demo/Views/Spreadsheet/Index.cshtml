@model Panoptes.AspNetCore.Demo.Controllers.SpreadsheetPageModel
@using Panoptes.AspNetCore.Demo.Services
@{
    bool isEn = DemoTranslations.IsEnglish(Context);
    var pages = Panoptes.AspNetCore.Demo.Controllers.SpreadsheetController.Pages;
}

@{
    ViewData["Title"] = isEn ? "Spreadsheet (Web Excel Sheet) - Panoptes Enterprise UI" : "Spreadsheet (Web Excel Tablosu) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="/" class="hover:text-blue-600 transition">Ana Sayfa</a>
        <span>/</span>
        <a href="/Spreadsheet" class="hover:text-blue-600 transition">Veri Yönetimi & Tablolar</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">Spreadsheet</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Spreadsheet (Web Excel Tablosu)</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-spreadsheet&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    WAI-ARIA Uyumlu
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn ? "Full Excel experience in the browser: formula bar, ribbon, and multiple sheets for budgets and price lists, with .xlsx import and export." : "Tarayıcıda tam Excel deneyimi: formül çubuğu, şerit menü ve çoklu sayfalarla bütçe ve fiyat listeleri hazırlanır, .xlsx alınıp verilir.")
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>Örnekler (Features)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">3</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>API Referansı (Props & Events)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">1</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>Erişilebilirlik (WAI-ARIA)</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
<!-- Temel Kullanım -->
    <section class="space-y-3">
        <div>
            <h2 class="text-base font-bold text-slate-800">Temel Kullanım</h2>
            <p class="text-xs text-slate-500 mt-0.5">Hücreyi seçip yazın, <code class="font-mono">=SUM(B2:B4)</code> gibi formüller girin, sağ tıklayın, şerit sekmelerini gezin. Alttaki sekmelerden ikinci sayfaya geçebilirsiniz.</p>
        </div>
        <panoptes-spreadsheet id="sheet" sheets="@Model.Sheets" title="Mali Bütçe Çalışma Kitabı" height="520"
                              export-url="@Url.Action("ExportXlsx", "Spreadsheet")"
                              import-url="@Url.Action("ImportXlsx", "Spreadsheet")"
                              file-name="Butce" />

        <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
        <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                <div class="flex items-center gap-2">
                    <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                        Razor TagHelper (C# / .NET 8)
                    </span>
                    <span class="text-xs text-slate-400 font-medium">Spreadsheet (Web Excel Tablosu)</span>
                </div>
                <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                    <span>Kodu Kopyala</span>
                </button>
            </div>
            <div class="panoptes-code-viewer">
                <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-spreadsheet id="sheet" 
                      sheets="@@Model.Sheets" 
                      title="Mali Bütçe Çalışma Kitabı" 
                      height="520"
                      export-url="@@Url.Action("ExportXlsx", "Spreadsheet")"
                      import-url="@@Url.Action("ImportXlsx", "Spreadsheet")"
                      file-name="Butce" /&gt;</code></pre>
            </div>
        </div>
    </section>

    <!-- Özellik Galerisi -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 bg-slate-50/50 flex items-center justify-between gap-3 flex-wrap">
            <div>
                <h2 class="text-base font-bold text-slate-800">Spreadsheet Özellikleri</h2>
                <p class="text-xs text-slate-500 mt-0.5">Panoptes Spreadsheet bileşeninin sunduğu gelişmiş kurumsal özellikler.</p>
            </div>
        </div>
        <div class="p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            @foreach (var p in pages)
            {
                <a href="/Spreadsheet/@p.Action" class="group block rounded-2xl border border-slate-200 p-3.5 hover:border-sky-300 hover:bg-sky-50/40 hover:-translate-y-0.5 hover:shadow-sm transition">
                    <div class="text-sm font-bold text-slate-800 group-hover:text-sky-700 transition">@(isEn ? p.EnTitle : p.Title)</div>
                    <div class="text-[11px] text-slate-500 mt-0.5 leading-snug">@(isEn ? p.EnDescription : p.Description)</div>
                </a>
            }
        </div>
    </div>

    <!-- Formül Fonksiyonları -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 bg-slate-50/50">
            <h2 class="text-base font-bold text-slate-800">Desteklenen Formül Fonksiyonları</h2>
            <p class="text-xs text-slate-500 mt-0.5">Dört işlem, karşılaştırma, birleştirme (&amp;), yüzde ve aralık referansları (mutlak/göreli, sayfalar arası) dahil. Fonksiyon adları İngilizcedir.</p>
        </div>
        <div id="fnList" class="p-4 flex flex-wrap gap-1.5"></div>
    </div>


    </div>

    <!-- PANEL 2: API & ATTRIBUTES -->
    <div id="panel-api" class="main-doc-panel space-y-8 hidden">
        <!-- TagHelper Props -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">TagHelper Özellikleri & Parametreleri</h3>
                    <p class="text-xs text-slate-500 mt-0.5">&lt;panoptes-spreadsheet&gt; bileşeninin desteklediği tüm C# ve HTML nitelikleri.</p>
                </div>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-blue-100 text-blue-800">PanoptesSpreadsheetTagHelper</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                            <th class="py-3 px-6">Özellik (Attribute)</th>
                            <th class="py-3 px-4">Tip (C#)</th>
                            <th class="py-3 px-4">Varsayılan</th>
                            <th class="py-3 px-6">Açıklama</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">id</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">Otomatik</td>
                            <td class="py-3 px-6 text-slate-700">Bileşenin DOM kimliği; <code class="font-mono text-blue-600">Panoptes.Spreadsheet.getInstance(id)</code> ile API'ye erişilir.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">title</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">Tablonun üst araç çubuğunda gösterilecek başlık metni.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">sheets</td>
                            <td class="py-3 px-4 font-mono text-purple-600">List&lt;SpreadsheetSheet&gt;</td>
                            <td class="py-3 px-4 font-mono text-slate-400">1 boş sayfa</td>
                            <td class="py-3 px-6 text-slate-700">Çalışma sayfaları koleksiyonu (hücreler, biçimler, birleştirmeler, doğrulamalar, düzenleyiciler, DataSource).</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">height</td>
                            <td class="py-3 px-4 font-mono text-purple-600">int</td>
                            <td class="py-3 px-4 font-mono text-slate-400">520</td>
                            <td class="py-3 px-6 text-slate-700">Bileşenin piksel cinsinden yüksekliği.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">toolbar</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">"true"</td>
                            <td class="py-3 px-6 text-slate-700">true/false veya virgülle ayrılmış sekmeler: <code class="font-mono">home,insert,data,view,file</code>.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">formula-bar</td>
                            <td class="py-3 px-4 font-mono text-purple-600">bool</td>
                            <td class="py-3 px-4 font-mono text-slate-400">true</td>
                            <td class="py-3 px-6 text-slate-700">Formül ve hücre giriş çubuğunu gösterir veya gizler.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">sheets-bar</td>
                            <td class="py-3 px-4 font-mono text-purple-600">bool</td>
                            <td class="py-3 px-4 font-mono text-slate-400">true</td>
                            <td class="py-3 px-6 text-slate-700">Tablonun altındaki çalışma sayfası sekmelerini gösterir veya gizler.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">editable</td>
                            <td class="py-3 px-4 font-mono text-purple-600">bool</td>
                            <td class="py-3 px-4 font-mono text-slate-400">true</td>
                            <td class="py-3 px-6 text-slate-700">false yapıldığında tüm tablo salt okunur (read-only) kilitlenir.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">resizable</td>
                            <td class="py-3 px-4 font-mono text-purple-600">bool</td>
                            <td class="py-3 px-4 font-mono text-slate-400">false</td>
                            <td class="py-3 px-6 text-slate-700">Bileşenin sağ alt köşesinden serbest boyutlandırılabilmesini sağlar.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">show-grid-lines</td>
                            <td class="py-3 px-4 font-mono text-purple-600">bool</td>
                            <td class="py-3 px-4 font-mono text-slate-400">true</td>
                            <td class="py-3 px-6 text-slate-700">Hücre ızgara çizgilerinin görünürlüğü.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">export-url</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">Excel (.xlsx) dışa aktarma uç noktası (POST, JSON gövde).</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">import-url</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">Excel (.xlsx) içe aktarma uç noktası (POST, multipart "file").</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">file-name</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">"Panoptes"</td>
                            <td class="py-3 px-6 text-slate-700">İndirilen Excel/PDF dosyalarının varsayılan ön adı.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">on-event</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">Tüm tablo olaylarını dinleyen genel JavaScript fonksiyon adı.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">on-cell-change</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">Hücre değeri değiştiğinde çalışan JavaScript fonksiyonu (<code class="font-mono">{ row, col, ref, value }</code>).</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">class</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">Kök konteyner elementine eklenecek özel CSS sınıfları.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SpreadsheetCell Model -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">SpreadsheetCell Modeli Özellikleri</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Her bir hücrenin veri, formül ve görsel biçim tanımları.</p>
                </div>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-sky-100 text-sky-800">SpreadsheetCell</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                            <th class="py-3 px-6">Özellik</th>
                            <th class="py-3 px-4">Tip (C#)</th>
                            <th class="py-3 px-6">Açıklama</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        <tr class="hover:bg-slate-50/60 transition"><td class="py-2.5 px-6 font-mono font-bold text-sky-700">Row / Col</td><td class="py-2.5 px-4 font-mono text-purple-600">int</td><td class="py-2.5 px-6">1 tabanlı satır ve sütun indeksi.</td></tr>
                        <tr class="hover:bg-slate-50/60 transition"><td class="py-2.5 px-6 font-mono font-bold text-sky-700">Value / Formula</td><td class="py-2.5 px-4 font-mono text-purple-600">string</td><td class="py-2.5 px-6">Sabit metin/sayı değeri veya "=SUM(A1:A5)" biçiminde dinamik formül.</td></tr>
                        <tr class="hover:bg-slate-50/60 transition"><td class="py-2.5 px-6 font-mono font-bold text-sky-700">Bold / Italic / Underline / Strike</td><td class="py-2.5 px-4 font-mono text-purple-600">bool</td><td class="py-2.5 px-6">Tipografi biçimlendirmeleri (kalın, italik, altı çizgili, üstü çizgili).</td></tr>
                        <tr class="hover:bg-slate-50/60 transition"><td class="py-2.5 px-6 font-mono font-bold text-sky-700">Color / Background</td><td class="py-2.5 px-4 font-mono text-purple-600">string</td><td class="py-2.5 px-6">Yazı rengi ve hücre dolgu rengi (#RRGGBB).</td></tr>
                        <tr class="hover:bg-slate-50/60 transition"><td class="py-2.5 px-6 font-mono font-bold text-sky-700">Align / VAlign</td><td class="py-2.5 px-4 font-mono text-purple-600">string</td><td class="py-2.5 px-6">Yatay (left|center|right) ve dikey (top|middle|bottom) hizalama.</td></tr>
                        <tr class="hover:bg-slate-50/60 transition"><td class="py-2.5 px-6 font-mono font-bold text-sky-700">Format</td><td class="py-2.5 px-4 font-mono text-purple-600">string</td><td class="py-2.5 px-6">Sayı biçimi: currency, percent, date, datetime, text veya özel kalıp (#,##0.00 ₺).</td></tr>
                        <tr class="hover:bg-slate-50/60 transition"><td class="py-2.5 px-6 font-mono font-bold text-sky-700">FontSize / Wrap / Border</td><td class="py-2.5 px-4 font-mono text-purple-600">int / bool / string</td><td class="py-2.5 px-6">Yazı boyutu, metin kaydırma ve kenarlık tanımları (t, b, l, r).</td></tr>
                        <tr class="hover:bg-slate-50/60 transition"><td class="py-2.5 px-6 font-mono font-bold text-sky-700">Enabled</td><td class="py-2.5 px-4 font-mono text-purple-600">bool</td><td class="py-2.5 px-6">false ise hücre kilitlidir; düzenlenemez, silinemez.</td></tr>
