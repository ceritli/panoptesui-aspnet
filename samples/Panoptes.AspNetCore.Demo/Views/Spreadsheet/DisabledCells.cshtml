@model Panoptes.AspNetCore.Demo.Controllers.SpreadsheetPageModel

<div class="space-y-6 pb-16">
    <partial name="_Header" model="Model" />

    <div class="space-y-4">
        <div class="flex flex-wrap gap-2">
            <button type="button" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-300 hover:text-sky-700 transition" onclick="pssSheet().disable(pssSheet().getSelection().ref)">Seçimi kilitle</button>
            <button type="button" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-300 hover:text-sky-700 transition" onclick="pssSheet().enable(pssSheet().getSelection().ref)">Seçimin kilidini aç</button>
            <button type="button" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-300 hover:text-sky-700 transition" onclick="pssSheet().setReadonly(true)">Salt okunur yap</button>
            <button type="button" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-300 hover:text-sky-700 transition" onclick="pssSheet().setReadonly(false)">Düzenlemeyi aç</button>
        </div>
        <panoptes-spreadsheet id="sheet" sheets="@Model.Sheets" height="460" on-event="pssOnEvent" />
        <p class="text-xs text-slate-500 leading-relaxed">Gri arka planlı hücreler kilitlidir: yazmayı, Delete, yapıştırma ve otomatik doldurmayı deneyin; engellenen her işlem <code>blocked</code> olayı üretir.</p>
        <partial name="_LogBox" />
    </div>

    <partial name="_Code" model="Model" />
</div>

@section Scripts {
    <partial name="_LogScript" />
}
