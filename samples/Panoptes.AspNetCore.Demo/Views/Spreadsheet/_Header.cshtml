<script>
    function switchSpreadsheetDocTab(tabName) {
        // Update tab buttons
        document.querySelectorAll('.spreadsheet-main-tab-btn').forEach(btn => {
            btn.classList.remove('font-bold', 'text-blue-600', 'border-blue-600', 'bg-blue-50/40');
            btn.classList.add('font-semibold', 'text-slate-600', 'border-transparent');
        });
        const activeBtn = document.getElementById('spreadsheet-main-tab-btn-' + tabName);
        if (activeBtn) {
            activeBtn.classList.remove('font-semibold', 'text-slate-600', 'border-transparent');
            activeBtn.classList.add('font-bold', 'text-blue-600', 'border-blue-600', 'bg-blue-50/40');
        }

        // Show/hide panels inside #spreadsheet-nav-container
        document.querySelectorAll('.spreadsheet-doc-panel').forEach(p => p.classList.add('hidden'));
        const activePanel = document.getElementById('spreadsheet-doc-panel-' + tabName);
        if (activePanel) {
            activePanel.classList.remove('hidden');
        }

        // Hide/show page body content (siblings of spreadsheet-nav-container)
        const navContainer = document.getElementById('spreadsheet-nav-container');
        if (navContainer && navContainer.parentElement) {
            Array.from(navContainer.parentElement.children).forEach(child => {
                if (child !== navContainer) {
                    if (tabName === 'features') {
                        child.style.display = '';
                    } else {
                        child.style.display = 'none';
                    }
                }
            });
        }

        if (typeof initPanoptesLightCodeBlocks === 'function') {
            initPanoptesLightCodeBlocks();
        }
    }
</script>
