@model Panoptes.AspNetCore.Demo.Controllers.SpreadsheetPageModel

<div class="space-y-6 pb-16">
    <partial name="_Header" model="Model" />

    <div class="space-y-4">
        <div class="flex flex-wrap gap-2">
            <button type="button" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-300 hover:text-sky-700 transition" onclick="pssSheet().setCommentAt('B2', 'Bu değer tahminidir.')">B2'ye yorum ekle</button>
            <button type="button" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-300 hover:text-sky-700 transition" onclick="pssLog('B2 yorumu: ' + JSON.stringify(pssSheet().getComment('B2')))">B2 yorumunu oku</button>
            <button type="button" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-300 hover:text-sky-700 transition" onclick="pssSheet().setCommentAt('B2', '')">B2 yorumunu sil</button>
        </div>
        <panoptes-spreadsheet id="sheet" sheets="@Model.Sheets" height="460" on-event="pssOnEvent" />
        <p class="text-xs text-slate-500 leading-relaxed">Köşe işaretli hücrelerin üzerine gelin. Sağ tık menüsü veya <kbd class="px-1 border rounded bg-slate-100">Shift</kbd>+<kbd class="px-1 border rounded bg-slate-100">F2</kbd> ile yorumu düzenleyin.</p>
        <partial name="_LogBox" />
    </div>

    <partial name="_Code" model="Model" />
</div>

@section Scripts {
    <partial name="_LogScript" />
}
