@section Scripts {
<script>
let eventLogCounter = 0;

        function logEvent(action, title, detail) {
            eventLogCounter++;
            const counterEl = document.getElementById('eventCount');
            if (counterEl) {
                counterEl.textContent = `${eventLogCounter} olay tetiklendi`;
            }
            
            const container = document.getElementById('eventLogContainer');
            if (!container) return;
            const time = new Date().toLocaleTimeString();
            
            const logEntry = document.createElement('div');
            logEntry.className = 'flex items-center gap-2 py-0.5 border-b border-slate-800/60';
            logEntry.innerHTML = `
                <span class="text-slate-500">[${time}]</span>
                <span class="font-bold text-purple-400">${action}</span>
                <span class="text-slate-300 font-medium">"${title}"</span>
                ${detail ? `<span class="text-slate-400">(${detail})</span>` : ''}
            `;
            
            if (container.querySelector('.italic')) {
                container.innerHTML = '';
            }
            
            container.prepend(logEntry);
        }

        function handlePanelSelect(e) {
            logEvent('SELECT', e.title, `indeks: ${e.index}`);
        }

        function handlePanelExpand(e) {
            logEvent('EXPAND', e.title, `indeks: ${e.index}`);
        }

        function handlePanelCollapse(e) {
            logEvent('COLLAPSE', e.title, `indeks: ${e.index}`);
        }

        function getDemoPanelBar() {
            return (window.panoptesPanelBar && window.panoptesPanelBar.getInstance('demoApiPanelBar'))
                || (window.Panoptes && window.Panoptes.PanelBar && window.Panoptes.PanelBar.get('demoApiPanelBar'));
        }

        // Programatik API Fonksiyonları
        window.expandAllPanels = function() {
            const pb = getDemoPanelBar();
            if (pb) {
                pb.expandAll();
                logEvent('API_CALL', 'demoApiPanelBar', 'expandAll() çağrıldı');
            } else {
                console.warn('demoApiPanelBar örneği bulunamadı');
            }
        };

        window.collapseAllPanels = function() {
            const pb = getDemoPanelBar();
            if (pb) {
                pb.collapseAll();
                logEvent('API_CALL', 'demoApiPanelBar', 'collapseAll() çağrıldı');
            } else {
                console.warn('demoApiPanelBar örneği bulunamadı');
            }
        };

        window.togglePanelIndex = function(index) {
            const pb = getDemoPanelBar();
            if (pb) {
                pb.toggle(index);
                logEvent('API_CALL', 'demoApiPanelBar', `toggle(${index}) çağrıldı`);
            } else {
                console.warn('demoApiPanelBar örneği bulunamadı');
            }
        };

        window.clearEventLog = function() {
            eventLogCounter = 0;
            const counterEl = document.getElementById('eventCount');
            if (counterEl) counterEl.textContent = '0 olay tetiklendi';
            const container = document.getElementById('eventLogContainer');
            if (container) {
                container.innerHTML = '<div class="text-slate-500 italic">// Olay günlüğü temizlendi.</div>';
            }
        };
</script>
}
