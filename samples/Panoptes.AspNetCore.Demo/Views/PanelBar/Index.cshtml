@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "PanelBar - Panoptes UI" : "PanelBar (Akordeon & Daraltılabilir Panel) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="/" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="/PanelBar" class="hover:text-blue-600 transition">@(isEn ? "Navigation & Layout" : "Navigasyon & Düzen")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">PanelBar</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">PanelBar @(isEn ? "(Accordion & Collapsible Panels)" : "(Akordeon & Daraltılabilir Panel)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-panelbar&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "WAI-ARIA Compliant" : "WAI-ARIA Uyumlu")
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn ? "Vertical expandable accordion panels, single or multiple expand modes, AJAX lazy loading, and nested category hierarchy." : "Dikey açılır/kapanır akordeon panelleri, tekli veya çoklu panel genişletme modu ve iç içe alt kategori hiyerarşisi.")
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>@(isEn ? "Examples (Features)" : "Örnekler (Features)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">5</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>@(isEn ? "API Reference (Props & Events)" : "API Referansı (Props & Events)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">2</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>@(isEn ? "Accessibility (WAI-ARIA)" : "Erişilebilirlik (WAI-ARIA)")</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
<!-- DEMO 1: Akordeon Modu (Tek Açık Panel) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                    1. Akordeon Modu (Tek Açık Panel - Single Expand Mode)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Bir panel genişletildiğinde açık olan diğer panel otomatik olarak daraltılır. İkonlar, rozetler ve devre dışı (disabled) panel durumları.
                </p>
            </div>
            <span class="text-xs font-mono bg-blue-50 text-blue-700 px-2 py-1 rounded font-medium border border-blue-100">expand-mode="single"</span>
        </div>

        <div class="p-6">
            <panoptes-panelbar id="accordionDemo" expand-mode="single" class="max-w-3xl">
                <panoptes-panel title="Kişisel Bilgiler & Profil" icon="heroicon:user" expanded="true" badge="Tamamlandı" badge-class="bg-emerald-100 text-emerald-800">
                    <div class="space-y-3 text-sm text-slate-600">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-slate-500 mb-1">Ad Soyad</label>
                                <input type="text" value="Ahmet Yılmaz" class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg bg-slate-50" readonly />
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-500 mb-1">E-Posta</label>
                                <input type="email" value="ahmet.yilmaz@kurumsal.com" class="w-full text-xs px-3 py-2 border border-slate-200 rounded-lg bg-slate-50" readonly />
                            </div>
                        </div>
                        <p class="text-xs text-slate-500">Profil bilgileriniz kurumsal dizin servisi ile eşitlenmektedir.</p>
                    </div>
                </panoptes-panel>

                <panoptes-panel title="Erişim Yetkileri & Roller" icon="heroicon:shield-check" badge="3 Aktif Rol" badge-class="bg-blue-100 text-blue-800">
                    <div class="space-y-2 text-sm text-slate-600">
                        <ul class="divide-y divide-slate-100">
                            <li class="py-2 flex items-center justify-between">
                                <span class="font-medium text-slate-700">Sistem Yöneticisi</span>
                                <span class="text-xs px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-medium">Tam Yetki</span>
                            </li>
                            <li class="py-2 flex items-center justify-between">
                                <span class="font-medium text-slate-700">Mali Müşavir / Onaycı</span>
                                <span class="text-xs px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-medium">Bütçe Onayı</span>
                            </li>
                            <li class="py-2 flex items-center justify-between">
                                <span class="font-medium text-slate-700">Rapor Görüntüleyici</span>
                                <span class="text-xs px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-medium">Salt Okunur</span>
                            </li>
                        </ul>
                    </div>
                </panoptes-panel>

                <panoptes-panel title="Bildirim Tercihleri" icon="heroicon:bell">
                    <div class="space-y-3 text-sm text-slate-600">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" checked class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4" />
                            <span>Önemli sistem uyarılarını e-posta ile al</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" checked class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4" />
                            <span>Haftalık özet raporlarını SMS ile bildir</span>
                        </label>
                    </div>
                </panoptes-panel>

                <panoptes-panel title="Faturalandırma & Finans (Kilitli)" icon="heroicon:lock-closed" disabled="true" badge="Erişim Yok" badge-class="bg-slate-200 text-slate-600">
                    <p class="text-xs text-slate-400">Bu panele erişim için muhasebe departmanından onay almalısınız.</p>
                </panoptes-panel>
            </panoptes-panelbar>
        </div>

        <!-- Standart Kod Kutusu (1. Resimdeki Standart Kapalı Details) -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-panelbar id="accordionDemo" expand-mode="single" class="max-w-3xl"&gt;
    &lt;panoptes-panel title="Kişisel Bilgiler & Profil" icon="heroicon:user" expanded="true" badge="Tamamlandı" badge-class="bg-emerald-100 text-emerald-800"&gt;
        &lt;div class="space-y-3 text-sm text-slate-600"&gt;
            &lt;!-- Form Alanları --&gt;
        &lt;/div&gt;
    &lt;/panoptes-panel&gt;

    &lt;panoptes-panel title="Erişim Yetkileri & Roller" icon="heroicon:shield-check" badge="3 Aktif Rol" badge-class="bg-blue-100 text-blue-800"&gt;
        &lt;!-- Liste Detayları --&gt;
    &lt;/panoptes-panel&gt;

    &lt;panoptes-panel title="Faturalandırma & Finans (Kilitli)" icon="heroicon:lock-closed" disabled="true" badge="Erişim Yok"&gt;
        &lt;!-- Devre Dışı Panel İçeriği --&gt;
    &lt;/panoptes-panel&gt;
&lt;/panoptes-panelbar&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 2: Çoklu Genişleme Modu (Multiple Expand Mode) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-indigo-600 inline-block"></span>
                    2. Çoklu Genişleme Modu (Multiple Expand Mode)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Kullanıcı dilediği sayıda paneli aynı anda açık tutabilir. Paneller birbirinden bağımsız katlanır ve açılır.
                </p>
            </div>
            <span class="text-xs font-mono bg-indigo-50 text-indigo-700 px-2 py-1 rounded font-medium border border-indigo-100">expand-mode="multiple"</span>
        </div>

        <div class="p-6">
            <panoptes-panelbar id="multiPanelBar" expand-mode="multiple" class="max-w-3xl">
                <panoptes-panel title="Sunucu & Donanım Durumu" icon="heroicon:server" expanded="true" badge="Normal" badge-class="bg-emerald-100 text-emerald-800">
                    <div class="space-y-2 text-xs text-slate-600">
                        <div class="flex justify-between items-center py-1 border-b border-slate-100">
                            <span>CPU Kullanımı:</span>
                            <span class="font-bold text-slate-800">%24.2 (8 Çekirdek)</span>
                        </div>
                        <div class="flex justify-between items-center py-1 border-b border-slate-100">
                            <span>Bellek (RAM):</span>
                            <span class="font-bold text-slate-800">14.8 GB / 32 GB</span>
                        </div>
                        <div class="flex justify-between items-center py-1">
                            <span>Disk Doluluğu:</span>
                            <span class="font-bold text-emerald-600">%41 (NVMe SSD)</span>
                        </div>
                    </div>
                </panoptes-panel>

                <panoptes-panel title="Ağ Trafiği ve Güvenlik Duvarı" icon="heroicon:shield-check" expanded="true" badge="420 Mbps" badge-class="bg-blue-100 text-blue-800">
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Gelen ve giden paket filtreleri devrede. Son 24 saatte 1.420 şüpheli istek otomatik olarak WAF tarafından engellendi.
                    </p>
                </panoptes-panel>

                <panoptes-panel title="Veritabanı Kümesi (PostgreSQL)" icon="heroicon:circle-stack" badge="Replication OK" badge-class="bg-indigo-100 text-indigo-800">
                    <p class="text-xs text-slate-600">
                        Birincil ve iki replika sunucu senkron durumdadır. Ortalama sorgu yanıt süresi 4.2 ms.
                    </p>
                </panoptes-panel>
            </panoptes-panelbar>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-panelbar id="multiPanelBar" expand-mode="multiple" class="max-w-3xl"&gt;
    &lt;panoptes-panel title="Sunucu & Donanım Durumu" icon="heroicon:server" expanded="true" badge="Normal" badge-class="bg-emerald-100 text-emerald-800"&gt;
        &lt;!-- İçerik --&gt;
    &lt;/panoptes-panel&gt;
    &lt;panoptes-panel title="Ağ Trafiği ve Güvenlik Duvarı" icon="heroicon:shield-check" expanded="true" badge="420 Mbps"&gt;
        &lt;!-- İçerik --&gt;
    &lt;/panoptes-panel&gt;
    &lt;panoptes-panel title="Veritabanı Kümesi (PostgreSQL)" icon="heroicon:circle-stack" badge="Replication OK"&gt;
        &lt;!-- İçerik --&gt;
    &lt;/panoptes-panel&gt;
&lt;/panoptes-panelbar&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 3: AJAX Dinamik Lazy Loading Panelleri -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
                    3. AJAX Dinamik Lazy Loading (Tembel İçerik Yükleme)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Panel tıklandığı anda <code class="text-emerald-700 bg-emerald-50 px-1 py-0.5 rounded font-mono">content-url</code> adresine AJAX isteği yapılır, içerik yüklenir ve önbelleğe alınır.
                </p>
            </div>
            <span class="text-xs font-mono bg-emerald-50 text-emerald-700 px-2 py-1 rounded font-medium border border-emerald-100">content-url="/PanelBar/LazyContent"</span>
        </div>

        <div class="p-6">
            <panoptes-panelbar id="lazyPanelBar" expand-mode="single" class="max-w-3xl">
                <panoptes-panel title="Statik Bilgilendirme Paneli" icon="heroicon:information-circle" expanded="true">
                    <p class="text-xs text-slate-600">
                        Bu panel sayfa yüklendiğinde hazır gelir. Aşağıdaki güvenlik panelini açtığınızda sunucudan AJAX ile dinamik içerik çekildiğini görebilirsiniz.
                    </p>
                </panoptes-panel>

                <panoptes-panel title="Gelişmiş Güvenlik Günlüğü (AJAX ile Yüklenir)" 
                                icon="heroicon:shield-check" 
                                content-url="/PanelBar/LazyContent?section=security"
                                badge="Dinamik İstek" 
                                badge-class="bg-amber-100 text-amber-800">
                    <!-- Başlangıçta boş kalır, tıklandığında AJAX ile doldurulur -->
                </panoptes-panel>
            </panoptes-panelbar>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-panelbar id="lazyPanelBar" expand-mode="single"&gt;
    &lt;panoptes-panel title="Statik Bilgilendirme" icon="heroicon:information-circle" expanded="true"&gt;
        &lt;p&gt;Statik içerik...&lt;/p&gt;
    &lt;/panoptes-panel&gt;

    &lt;panoptes-panel title="Gelişmiş Güvenlik Günlüğü" 
                    icon="heroicon:shield-check" 
                    content-url="/PanelBar/LazyContent?section=security" 
                    badge="Dinamik İstek" badge-class="bg-amber-100 text-amber-800"&gt;
    &lt;/panoptes-panel&gt;
&lt;/panoptes-panelbar&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 4: Programatik Kontrol API & Canlı Olay Günlüğü -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-purple-600 inline-block"></span>
                    4. Programatik JavaScript API ve Canlı Olay Günlüğü (Event Log)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Harici butonlarla panelleri programatik olarak açma/kapatma ve <code class="text-purple-700 bg-purple-50 px-1 py-0.5 rounded font-mono">on-select</code>, <code class="text-purple-700 bg-purple-50 px-1 py-0.5 rounded font-mono">on-expand</code>, <code class="text-purple-700 bg-purple-50 px-1 py-0.5 rounded font-mono">on-collapse</code> olaylarını izleme.
                </p>
            </div>
            <span class="text-xs font-mono bg-purple-50 text-purple-700 px-2 py-1 rounded font-medium border border-purple-100">panoptesPanelBar API</span>
        </div>

        <div class="p-6 space-y-6">
            <!-- Kontrol Butonları -->
            <div class="flex flex-wrap items-center gap-2 pb-2">
                <button type="button" onclick="window.expandAllPanels()" class="px-3 py-1.5 text-xs font-medium text-purple-700 bg-purple-50 hover:bg-purple-100 rounded-lg border border-purple-200 transition">
                    Tüm Panelleri Aç (expandAll)
                </button>
                <button type="button" onclick="window.collapseAllPanels()" class="px-3 py-1.5 text-xs font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg border border-slate-200 transition">
                    Tüm Panelleri Kapat (collapseAll)
                </button>
