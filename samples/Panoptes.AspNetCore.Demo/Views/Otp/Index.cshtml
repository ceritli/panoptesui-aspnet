<script>
function logOtp(msg) {
            var logEl = document.getElementById('otpEventLog');
            if (!logEl) return;
            var time = new Date().toLocaleTimeString('tr-TR');
            var line = document.createElement('div');
            line.innerHTML = '<span class="text-slate-500">[' + time + ']</span> ' + msg;
            logEl.appendChild(line);
            logEl.scrollTop = logEl.scrollHeight;
        }

        function clearOtpLogs() {
            var logEl = document.getElementById('otpEventLog');
            if (logEl) logEl.innerHTML = '<div class="text-slate-500">// Günlük temizlendi. Yeni olaylar bekleniyor...</div>';
        }

        function handleOtpComplete(code) {
            logOtp('<span class="text-emerald-400 font-bold">Kod Tamamlandı (onComplete):</span> ' + code + ' <span class="text-emerald-500">✓ Onaylandı</span>');
        }

        function fillTestCode(testCode) {
            var otp = window.panoptesOtp.getInstance('smsOtpDemo');
            if (otp) {
                otp.setValue(testCode);
            }
        }

        function clearOtpInputs() {
            var otp = window.panoptesOtp.getInstance('smsOtpDemo');
            if (otp) {
                otp.clear();
                logOtp('<span class="text-amber-400">Kutucuklar temizlendi.</span>');
            }
        }
</script>
