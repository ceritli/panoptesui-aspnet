@{
    var isEn = DemoTranslations.IsEnglish(Context);
    var p = isEn ? "/en" : "";
    var activeTab = (string)(ViewData["ActiveTab"] ?? "Overview");
    var navLinks = new[]
    {
        new { Key = "Overview", Title = isEn ? "1. Overview" : "1. Genel Bakış", Url = p + "/TileLayout/Overview" },
        new { Key = "TagHelper", Title = isEn ? "2. TagHelper" : "2. TagHelper", Url = p + "/TileLayout/TagHelper" },
        new { Key = "Reordering", Title = isEn ? "3. Drag & Reorder" : "3. Sürükle & Sırala", Url = p + "/TileLayout/Reordering" },
        new { Key = "Resizing", Title = isEn ? "4. Resizing (2D)" : "4. Boyutlandırma (2D)", Url = p + "/TileLayout/Resizing" },
        new { Key = "AddRemove", Title = isEn ? "5. Add / Remove" : "5. Kart Ekle / Çıkar", Url = p + "/TileLayout/AddRemove" },
        new { Key = "KeyboardNavigation", Title = isEn ? "6. Keyboard Navigation" : "6. Klavye Gezintisi (A11y)", Url = p + "/TileLayout/KeyboardNavigation" },
        new { Key = "Events", Title = isEn ? "7. Events" : "7. Olaylar (Events)", Url = p + "/TileLayout/Events" },
        new { Key = "StatePersistence", Title = isEn ? "8. State Persistence" : "8. Durum Saklama (Storage)", Url = p + "/TileLayout/StatePersistence" },
        new { Key = "Api", Title = isEn ? "9. JavaScript API" : "9. JavaScript API", Url = p + "/TileLayout/Api" }
    };
}

<div class="bg-white p-3 rounded-2xl border border-slate-200 shadow-sm overflow-x-auto mb-6">
    <div class="flex items-center gap-1.5 min-w-max">
        @foreach (var tab in navLinks)
        {
            var isActive = tab.Key.Equals(activeTab, System.StringComparison.OrdinalIgnoreCase);
            if (isActive)
            {
                <span class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-sm flex items-center gap-1.5 cursor-default">
                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                    <span>@tab.Title</span>
                </span>
            }
            else
            {
                <a href="@tab.Url" class="px-3.5 py-1.5 rounded-xl text-xs font-medium text-slate-600 hover:text-indigo-600 hover:bg-slate-100 transition">
                    @tab.Title
                </a>
            }
        }
    </div>
</div>
