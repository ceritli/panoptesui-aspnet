@using Panoptes.AspNetCore.Demo.Services
@{
    bool isEn = DemoTranslations.IsEnglish(Context);
    string p = DemoTranslations.Prefix(isEn);
    ViewData["Title"] = isEn ? "ListView (Card & Template List)" : "ListView (Kart & Şablonlu Liste)";
}

<div class="space-y-6">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(p == "" ? "/" : p)" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(p + "/ListView")" class="hover:text-blue-600 transition">@(isEn ? "Data Management & Lists" : "Veri Yönetimi & Tablolar")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">ListView</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "ListView (Card & Template List)" : "ListView (Kart & Şablonlu Liste)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                    @(isEn ? "Data Component" : "Veri Listeleme Bileşeni")
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Customizable Razor card template engine, built-in pager, configurable column grid layouts, multi-card selection, and search toolbar."
                    : "Tamamen özelleştirilebilir Razor kart şablon motoru, dahili sayfalama (Pager), sütun sayısı yapılandırma, çoklu kart seçimi ve filtreleme araç çubuğu sunan kurumsal liste bileşeni.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold">
                @(isEn ? "✓ Production Ready" : "✓ Tam Sürüm Hazır")
            </span>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>@(isEn ? "Examples (Features)" : "Örnekler (Features)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">1</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>@(isEn ? "API Reference (Props & Events)" : "API Referansı (Props & Events)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">14</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>@(isEn ? "Accessibility (WAI-ARIA)" : "Erişilebilirlik (WAI-ARIA)")</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-6">
    <!-- Live Grid / ListView Preview (Grid/Paging.cshtml mimarisi) -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                <span>@(isEn ? "📦 Live ListView Demo" : "📦 Canlı ListView Demosu")</span>
            </h2>
            <span class="text-xs text-slate-400">@(isEn ? "Data loaded asynchronously via In-Memory Entity Framework" : "Veriler In-Memory Entity Framework üzerinden asenkron yüklenmektedir")</span>
        </div>

        <!-- İstemci API Hızlı Eylem Çubuğu -->
        <div class="mb-4 p-3 bg-slate-50 rounded-xl border border-slate-200 flex flex-wrap items-center justify-between gap-3 text-xs">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="font-bold text-slate-700 flex items-center gap-1.5">
                    <span>🕹️</span>
                    <span>@(isEn ? "Client API:" : "İstemci Kontrolleri:")</span>
                </span>
                <button type="button" onclick="window.Panoptes.ListView.get('productsListView').page(1)" class="px-2.5 py-1 rounded-lg bg-white hover:bg-slate-100 font-semibold text-slate-700 border border-slate-200 transition">
                    @(isEn ? "Page 1" : "Sayfa 1")
                </button>
                <button type="button" onclick="window.Panoptes.ListView.get('productsListView').page(2)" class="px-2.5 py-1 rounded-lg bg-white hover:bg-slate-100 font-semibold text-slate-700 border border-slate-200 transition">
                    @(isEn ? "Page 2" : "Sayfa 2")
                </button>
                <button type="button" onclick="window.Panoptes.ListView.get('productsListView').selectAll()" class="px-2.5 py-1 rounded-lg bg-blue-50 text-blue-700 font-bold hover:bg-blue-100 border border-blue-200 transition">
                    @(isEn ? "Select All" : "Tümünü Seç")
                </button>
                <button type="button" onclick="window.Panoptes.ListView.get('productsListView').clearSelection()" class="px-2.5 py-1 rounded-lg bg-white hover:bg-slate-100 text-slate-600 font-semibold border border-slate-200 transition">
                    @(isEn ? "Clear" : "Seçimi Temizle")
                </button>
                <button type="button" onclick="testLogSelection()" class="px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 font-bold hover:bg-indigo-100 border border-indigo-200 transition">
                    @(isEn ? "Read Selected" : "Seçilenleri Oku")
                </button>
            </div>

            <div class="flex items-center gap-2">
                <button type="button" onclick="window.Panoptes.ListView.get('productsListView').add()" class="px-3 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold transition flex items-center gap-1 shadow-2xs">
                    <span>+</span>
                    <span>@(isEn ? "Add New Item" : "Yeni Kart Ekle")</span>
                </button>
            </div>
        </div>

        <!-- The Panoptes ListView Component -->
        <panoptes-listview id="productsListView"
                           url="/api/products/read"
                           create-url="/api/products/create"
                           update-url="/api/products/update"
                           delete-url="/api/products/delete"
                           method="POST"
                           page-size="6"
                           page-sizes="3,6,12,24"
                           pageable="true"
                           sortable="true"
                           searchable="true"
                           selectable="multiple"
                           editable="true"
                           layout="grid"
                           columns="3"
                           client-template-id="productCardTemplate"
                           client-alt-template-id="productAltCardTemplate"
                           on-change="onListViewChange"
                           on-data-bound="onListViewDataBound"
                           on-save="onListViewSave"
                           on-remove="onListViewRemove">
        </panoptes-listview>

    </div>

    <!-- Feature Highlight Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Custom Razor Client Template Engine" : "Özel Razor İstemci Şablon Motoru")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Define rich HTML/Tailwind card structures using '#: Field #' and '#= HTML #' client interpolations."
                    : "#: Field # ve #= HTML # sözdizimi ile zengin HTML/Tailwind kart tasarımı desteği sunar.")
            </div>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Smart Pager & Dynamic Toolbar" : "Akıllı Sayfalama & Dinamik Araç Çubuğu")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Interactive page sizes (3, 6, 12, 24), live search box, and full in-card CRUD actions."
                    : "Etkileşimli sayfa boyutu seçimi (3, 6, 12, 24), canlı arama kutusu ve kart içi CRUD eylemleri.")
            </div>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-listview id="productsListView"
                   url="/api/products/read"
                   create-url="/api/products/create"
                   update-url="/api/products/update"
                   delete-url="/api/products/delete"
                   method="POST"
                   page-size="6"
                   page-sizes="3,6,12,24"
                   pageable="true"
                   sortable="true"
                   searchable="true"
                   selectable="multiple"
                   editable="true"
                   layout="grid"
                   columns="3"
                   client-template-id="productCardTemplate"
                   client-alt-template-id="productAltCardTemplate"
                   on-change="onListViewChange"
                   on-data-bound="onListViewDataBound"&gt;
&lt;/panoptes-listview&gt;</code></pre>
        </div>
    </div>
    </div>

    <!-- PANEL 2: API & ATTRIBUTES -->
    <div id="panel-api" class="main-doc-panel space-y-6 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">@(isEn ? "TagHelper Properties & Parameters" : "TagHelper Özellikleri & Parametreleri")</h3>
                    <p class="text-xs text-slate-500 mt-0.5">@(isEn ? "All C# and HTML attributes supported by <panoptes-listview>." : "<panoptes-listview> bileşeninin desteklediği tüm C# ve HTML nitelikleri.")</p>
                </div>
                <span class="px-2.5 py-1 rounded text-[11px] font-mono bg-blue-100 text-blue-800">&lt;panoptes-listview&gt;</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                            <th class="py-3 px-6">@(isEn ? "Property / Attribute" : "Özellik (Attribute)")</th>
                            <th class="py-3 px-4">@(isEn ? "Type (C# / TS)" : "Tip (C# / TS)")</th>
                            <th class="py-3 px-4">@(isEn ? "Default" : "Varsayılan")</th>
                            <th class="py-3 px-6">@(isEn ? "Description" : "Açıklama")</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">id</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">zorunlu</td><td class="py-3 px-6">ListView DOM benzersiz kimliği.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">url / read-url</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">null</td><td class="py-3 px-6">Verilerin okunacağı HTTP endpoint adresi.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">create-url / update-url / delete-url</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">null</td><td class="py-3 px-6">CRUD işlemleri için HTTP POST uç noktaları.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">layout</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">"grid"</td><td class="py-3 px-6">Kart dizilim modu ("grid" veya "list").</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">columns</td><td class="py-3 px-4 font-mono text-purple-600">int</td><td class="py-3 px-4 font-mono text-slate-400">3</td><td class="py-3 px-6">Grid düzeninde satır başına kart adedi (1-6).</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">pageable / page-size</td><td class="py-3 px-4 font-mono text-purple-600">bool / int</td><td class="py-3 px-4 font-mono text-slate-400">true / 6</td><td class="py-3 px-6">Sayfalama desteği ve sayfa başına kayıt sayısı.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">page-sizes</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">"3,6,12,24"</td><td class="py-3 px-6">Sayfa boyutu seçici seçenekleri.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">selectable</td><td class="py-3 px-4 font-mono text-purple-600">string / bool</td><td class="py-3 px-4 font-mono text-slate-400">"multiple"</td><td class="py-3 px-6">Seçim modu ("single", "multiple" veya false).</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">client-template-id</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">null</td><td class="py-3 px-6">Kart şablonunun script ID'si (#: Prop # sözdizimi).</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">on-change</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">null</td><td class="py-3 px-6">Kart seçimi değiştiğinde tetiklenen istemci fonksiyonu.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">on-data-bound</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">null</td><td class="py-3 px-6">Veri başarıyla yüklendiğinde tetiklenen fonksiyon.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PANEL 3: ACCESSIBILITY -->
    <div id="panel-a11y" class="main-doc-panel space-y-6 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
            <div>
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
                    @(isEn ? "WAI-ARIA Accessibility Standards" : "WAI-ARIA Standartları & Klavye Erişilebilirliği")
                </h2>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                    @(isEn ? "Panoptes ListView component strictly adheres to W3C WAI-ARIA guidelines for screen readers and keyboard navigation." : "Panoptes ListView bileşeni, W3C WAI-ARIA standartlarına uygun olarak ekran okuyucular ve salt klavye navigasyonu için tasarlanmıştır.")
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">WAI-ARIA Roles</div>
                    <div class="text-slate-600"><code>role="list / listitem"</code>, <code>aria-selected</code>, <code>aria-label</code> dinamik senkronize edilir.</div>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">Keyboard Focus</div>
                    <div class="text-slate-600"><code>tabindex="0"</code> ile doğal klavye odak halkaları ve ok tuşu navigasyonu sunulur.</div>
                </div>
            </div>
            <div class="pt-4 border-t border-slate-100">
                <h3 class="text-sm font-bold text-slate-900 mb-3">@(isEn ? "Keyboard Shortcuts" : "Klavye Kısayolları")</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                                <th class="py-2.5 px-4 w-48">Tuş (Key)</th>
                                <th class="py-2.5 px-4">İşlev</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            <tr><td class="py-2.5 px-4 font-mono"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs">Tab / Shift + Tab</kbd></td><td class="py-2.5 px-4">Kartlar ve eylem butonları arasında sıralı odak geçişi sağlar.</td></tr>
                            <tr><td class="py-2.5 px-4 font-mono"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs">Ok Tuşları (← ↑ → ↓)</kbd></td><td class="py-2.5 px-4">Kartlar arasında serbest yönlü gezinme.</td></tr>
                            <tr><td class="py-2.5 px-4 font-mono"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs">Space</kbd></td><td class="py-2.5 px-4">Odaklanılmış kartı seçer veya seçimi kaldırır.</td></tr>
                            <tr><td class="py-2.5 px-4 font-mono"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs">Home / End</kbd></td><td class="py-2.5 px-4">İlk veya son karta hızlı odaklama.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Client Template Definitions -->
<script id="productCardTemplate" type="text/html">
    <div class="bg-white rounded-2xl p-5 border border-slate-200 hover:border-blue-400 hover:shadow-lg transition-all duration-300 flex flex-col justify-between h-full group">
        <div>
            <!-- Card Header -->
            <div class="flex items-start justify-between gap-3 mb-3">
                <div>
                    <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-extrabold rounded-lg bg-indigo-50 text-indigo-700 border border-indigo-100 uppercase tracking-wider mb-1.5">
                        #: Category #
                    </span>
                    <h3 class="font-extrabold text-slate-900 text-base group-hover:text-blue-600 transition leading-snug line-clamp-1">
                        #: Name #
                    </h3>
                </div>
                
                <!-- Selection Indicator -->
                <div class="w-5 h-5 rounded-md border border-slate-300 bg-white flex items-center justify-center transition shrink-0 group-[.ring-2]:bg-blue-600 group-[.ring-2]:border-blue-600 group-[.ring-2]:text-white">
