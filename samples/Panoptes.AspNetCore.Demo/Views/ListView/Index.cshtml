        if (!lv) return;
        const selected = lv.getSelected();
        if (selected.length === 0) {
            alert('Şu anda seçili herhangi bir kart bulunmuyor. Bir veya birden fazla karta tıklayarak seçebilirsiniz.');
        } else {
            const names = selected.map(s => s.Name || s.name).join(', ');
            alert(`Seçilen ${selected.length} Kayıt:\n${names}`);
        }
