@model Panoptes.AspNetCore.Demo.Controllers.TreeListDemoViewModel

@{
    ViewData["Title"] = "TreeList (Ağaç Tablosu / Hiyerarşik Grid) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="/" class="hover:text-blue-600 transition">Ana Sayfa</a>
        <span>/</span>
        <a href="/TreeList" class="hover:text-blue-600 transition">Veri Yönetimi & Tablolar</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">TreeList</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">TreeList (Ağaç Tablosu / Hiyerarşik Grid)</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-treelist&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    WAI-ARIA Uyumlu
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                Sütunlu ızgara yapısını iç içe ana-çocuk ağaç hiyerarşisiyle birleştiren, satır içi düzenleme, sıralama ve Excel aktarımı sunan kurumsal tablo.
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>Örnekler (Features)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">24</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>API Referansı (Props & Events)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">12</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>Erişilebilirlik (WAI-ARIA)</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
@{
        var features = new (string Href, string Title, string Desc)[]
        {
            ("/TreeList/Aggregates", "Toplamlar", "sum / avg / count, üst düğüm ve genel toplam"),
            ("/TreeList/Api", "API", "expand, select, sortBy, addItem, updateItem..."),
            ("/TreeList/CheckboxSelection", "Onay Kutulu Seçim", "Alt kayıtlara yayılan seçim"),
            ("/TreeList/ClientSidePaging", "İstemci Tarafı Sayfalama", "Kök düğüm bazlı sayfalama"),
            ("/TreeList/ColumnMenu", "Sütun Menüsü", "Sırala, filtrele, göster/gizle, kilitle"),
            ("/TreeList/ColumnReordering", "Sütun Sıralama", "Başlıkları sürükleyerek taşıyın"),
            ("/TreeList/ColumnResizing", "Sütun Boyutlandırma", "Genişliği sürükleyerek değiştirin"),
            ("/TreeList/DragDrop", "Sürükle & Bırak", "Satırları taşıyarak ağacı yeniden kurun"),
            ("/TreeList/Editing", "Satır İçi Düzenleme", "Tüm satırı düzenle, alt kayıt ekle, sil"),
            ("/TreeList/EditingInCell", "Hücre İçi Düzenleme", "Tek hücreyi tıklayıp düzenleyin"),
            ("/TreeList/EditingPopup", "Popup Düzenleme", "Modal form ile düzenleme"),
            ("/TreeList/Events", "Olaylar", "25+ olay, tek geri çağırma"),
            ("/TreeList/ExcelExport", "Excel Dışa Aktarım", "Hiyerarşiyi koruyan .xls"),
            ("/TreeList/FilterRow", "Filtre Satırı", "Tip duyarlı sütun filtreleri"),
            ("/TreeList/FrozenColumns", "Dondurulmuş Sütunlar", "Yatay kaydırmada sabit sütunlar"),
            ("/TreeList/KeyboardNavigation", "Klavye Navigasyonu", "Ok tuşları, Boşluk, Enter, F2, Del"),
            ("/TreeList/MultiColumnHeaders", "Çok Katmanlı Başlıklar", "Gruplanmış üst başlıklar"),
            ("/TreeList/OData", "OData Bağlama", "$filter, $orderby, $top, $skip, $count"),
            ("/TreeList/PdfExport", "PDF Dışa Aktarım", "Yazdır / PDF olarak kaydet"),
            ("/TreeList/PersistState", "Durumu Kaydet", "Sıralama, filtre, sütun ve açık düğümler"),
            ("/TreeList/RemoteDataBinding", "Uzak Veri Bağlama", "Sunucudan tembel alt kayıt yükleme"),
            ("/TreeList/RowTemplate", "Satır Şablonu", "Satır HTML'ini kendiniz üretin"),
            ("/TreeList/SearchPanel", "Arama Paneli", "Alan seçilebilir canlı arama"),
            ("/TreeList/ToolbarTemplate", "Araç Çubuğu Şablonu", "Özel HTML araç çubuğu"),
        };
    }

    <!-- Özellik Galerisi -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 bg-slate-50/50 flex items-center justify-between">
            <div>
                <h2 class="text-base font-bold text-slate-800">TreeList Özellikleri</h2>
                <p class="text-xs text-slate-500 mt-0.5">Panoptes TreeList bileşeninin sunduğu gelişmiş kurumsal özellikler.</p>
            </div>
        </div>
        <div class="p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
            @foreach (var f in features)
            {
                <a href="@f.Href" class="group block rounded-2xl border border-slate-200 p-3.5 hover:border-emerald-300 hover:bg-emerald-50/40 hover:-translate-y-0.5 hover:shadow-sm transition">
                    <div class="text-sm font-bold text-slate-800 group-hover:text-emerald-700 transition">@f.Title</div>
                    <div class="text-[11px] text-slate-500 mt-0.5 leading-snug">@f.Desc</div>
                </a>
            }
        </div>
    </div>

    <!-- DEMO 1: Kurumsal Organizasyon & Yönetim Hiyerarşisi -->

    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                    1. Kurumsal Şirket Yönetim & Organizasyon Şeması
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Genel Müdür (CEO), Direktörler ve Takım Liderleri arasındaki ast-üst ilişkisi, para birimi formatlı maaş sütunu, canlı arama ve tümünü aç/kapat araç çubuğu.
                </p>
            </div>
            <span class="text-xs font-mono bg-blue-50 text-blue-700 px-2 py-1 rounded font-medium border border-blue-100">&lt;panoptes-treelist items="@@Model.OrgItems" /&gt;</span>
        </div>

        <div class="p-8 max-w-5xl mx-auto space-y-4">
            <panoptes-treelist id="orgTreeList" 
                              title="Şirket Yönetim ve Personel Ağacı" 
                              columns="@Model.OrgColumns" 
                              items="@Model.OrgItems" 
                              show-search="true" 
                              show-toolbar="true" 
                              on-select="onOrgSelect" 
                              on-expand="onOrgExpand" 
                              on-collapse="onOrgCollapse" />

            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-xs">
                <div class="font-semibold text-slate-700 mb-1 flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Seçilen Satır Bilgisi (on-select):
                </div>
                <div id="selectedOrgInfo" class="text-slate-600 font-mono text-[11px] mt-0.5">
                    Ağaç üzerinden herhangi bir satıra tıkladığınızda kayıt detayları burada gösterilir.
                </div>
            </div>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm">
                <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                            Razor TagHelper (C# / .NET 8)
                        </span>
                        <span class="text-xs text-slate-400 font-medium">1. Şirket Yönetim & Personel Ağacı</span>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Kodu Kopyala</span>
                    </button>
                </div>
                <div class="panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-treelist id="orgTreeList" 
                   title="Şirket Yönetim ve Personel Ağacı" 
                   columns="@@Model.OrgColumns" 
                   items="@@Model.OrgItems" 
                   show-search="true" 
                   show-toolbar="true" 
                   on-select="onOrgSelect" /&gt;</code></pre>
                </div>
            </div>
        </div>
    </div>

    <!-- DEMO 2: Proje Görev Kırılım Ağacı (WBS) & Programatik JS API -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
                    2. Proje Görev Kırılım Ağacı (WBS) & Programatik JavaScript API
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Görev hiyerarşisi, rozet (badge) durumları, harici butonlarla belirli düğümleri programatik açma (expand), daraltma (collapse) veya seçme (select).
                </p>
            </div>
            <span class="text-xs font-mono bg-emerald-50 text-emerald-700 px-2 py-1 rounded font-medium border border-emerald-100">Panoptes.TreeList API</span>
        </div>

        <div class="p-8 max-w-5xl mx-auto space-y-6">
            <panoptes-treelist id="projectTreeList" 
                              title="Yazılım Projesi İş Dağılım Kırılımı (WBS)" 
                              columns="@Model.ProjectColumns" 
                              items="@Model.ProjectItems" 
                              height="420" 
                              show-search="true" 
                              show-toolbar="true" 
                              on-select="onProjectSelect" />

            <!-- Programatik İşlem Butonları -->
            <div class="flex flex-wrap items-center gap-2 pt-2">
                <button type="button" onclick="selectUiTask()" class="px-3 py-1.5 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition active:scale-95 border border-indigo-200">
                    2.1 Bileşenler Görevini Seç (select('p6'))
                </button>
                <button type="button" onclick="expandMimari()" class="px-3 py-1.5 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-lg transition active:scale-95 border border-blue-200">
                    1. Mimari Dalını Genişlet (expand('p2'))
                </button>
                <button type="button" onclick="collapseMimari()" class="px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition active:scale-95 border border-slate-200">
                    1. Mimari Dalını Kapat (collapse('p2'))
                </button>
                <button type="button" onclick="clearTreeLog()" class="ml-auto px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-slate-800 transition">
                    Günlüğü Temizle
                </button>
            </div>

            <!-- Canlı Olay Günlüğü Terminali -->
            <div class="space-y-1">
                <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Canlı TreeList Olay Günlüğü:</div>
                <div id="treeEventLog" class="h-28 bg-slate-950 text-slate-200 p-3 rounded-xl font-mono text-[11px] overflow-y-auto space-y-1 border border-slate-800 shadow-inner">
                    <div class="text-slate-500">// Seçim, genişleme ve daraltma olayları burada canlı listelenecektir...</div>
                </div>
            </div>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm">
                <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-emerald-600 bg-white border border-slate-200 shadow-2xs font-mono">
                            Razor TagHelper (C# / .NET 8)
                        </span>
                        <span class="text-xs text-slate-400 font-medium">2. Proje İş Dağılım Kırılımı (WBS) & JS API</span>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Kodu Kopyala</span>
                    </button>
                </div>
                <div class="panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-treelist id="projectTreeList" 
                   title="Proje İş Kırılımı (WBS)" 
                   columns="@@Model.ProjectColumns" 
                   items="@@Model.ProjectItems" 
                   height="420" 
                   on-select="onProjectSelect" /&gt;</code></pre>
                </div>
            </div>
        </div>
    </div>

</div>

    <!-- PANEL 2: API & ATTRIBUTES -->
    <div id="panel-api" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">TagHelper Özellikleri & Parametreleri</h3>
                    <p class="text-xs text-slate-500 mt-0.5">&lt;panoptes-treelist&gt; bileşeninin desteklediği tüm C# ve HTML nitelikleri.</p>
                </div>
                <span class="px-2.5 py-1 rounded text-[11px] font-mono bg-blue-100 text-blue-800">&lt;panoptes-treelist&gt;</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                            <th class="py-3 px-6">Özellik (Attribute)</th>
                            <th class="py-3 px-4">Tip (C#)</th>
                            <th class="py-3 px-4">Varsayılan</th>
                            <th class="py-3 px-6">Açıklama</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">id</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">Otomatik GUID</td><td class="py-3 px-6 text-slate-700">Bileşenin benzersiz DOM kimliği ve JavaScript API referansı.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">title</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">null</td><td class="py-3 px-6 text-slate-700">Üst araç çubuğunda gösterilecek tablo başlığı.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">columns</td><td class="py-3 px-4 font-mono text-purple-600">List&lt;TreeListColumn&gt;</td><td class="py-3 px-4 font-mono text-slate-400">[]</td><td class="py-3 px-6 text-slate-700">Sütun tanımları: Field, Title, Width, Align, Format, IsTreeColumn.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">items</td><td class="py-3 px-4 font-mono text-purple-600">List&lt;TreeListItem&gt;</td><td class="py-3 px-4 font-mono text-slate-400">[]</td><td class="py-3 px-6 text-slate-700">Hiyerarşik veri satırları (Id, ParentId, Expanded, Values sözlüğü).</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">height</td><td class="py-3 px-4 font-mono text-purple-600">string / int</td><td class="py-3 px-4 font-mono text-slate-400">null</td><td class="py-3 px-6 text-slate-700">Tablonun maksimum yüksekliği (piksel). Aşarsa dikey kaydırma devreye girer.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">show-search</td><td class="py-3 px-4 font-mono text-purple-600">bool</td><td class="py-3 px-4 font-mono text-slate-400">true</td><td class="py-3 px-6 text-slate-700">Araç çubuğunda canlı hiyerarşik arama kutusunun gösterilip gösterilmeyeceği.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">show-toolbar</td><td class="py-3 px-4 font-mono text-purple-600">bool</td><td class="py-3 px-4 font-mono text-slate-400">true</td><td class="py-3 px-6 text-slate-700">Tümünü Aç / Kapat ve araç çubuğu alanını etkinleştirir.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">editable</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">null</td><td class="py-3 px-6 text-slate-700">Düzenleme modu: "inline", "incell" veya "popup".</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">aggregates</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">null</td><td class="py-3 px-6 text-slate-700">Toplamlar modu: "root", "sub" veya "both".</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">on-select</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">null</td><td class="py-3 px-6 text-slate-700">Satır tıklandığında çalışan JavaScript geri çağırma fonksiyonu.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">on-expand / on-collapse</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">null</td><td class="py-3 px-6 text-slate-700">Düğüm açıldığında veya daraltıldığında çalışan JavaScript fonksiyonu.</td></tr>
                        <tr class="hover:bg-slate-50/70 transition-colors"><td class="py-3 px-6 font-mono font-bold text-blue-600">on-event</td><td class="py-3 px-4 font-mono text-purple-600">string</td><td class="py-3 px-4 font-mono text-slate-400">null</td><td class="py-3 px-6 text-slate-700">Tüm TreeList olaylarını dinleyen genel olay fonksiyonu.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PANEL 3: ACCESSIBILITY (WAI-ARIA & KEYBOARD) -->
    <div id="panel-a11y" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
            <div>
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
                    WAI-ARIA Standartları & Klavye Erişilebilirliği
                </h2>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                    Panoptes TreeList bileşeni, W3C WAI-ARIA standartlarına uygun olarak ekran okuyucular ve salt klavye navigasyonu için tasarlanmıştır.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">WAI-ARIA Nitelikleri</div>
                    <div class="text-slate-600">
                        Standart <code>role="treegrid"</code> rolünü taşır. Duruma göre <code>aria-disabled</code>, <code>aria-expanded</code>, <code>aria-selected</code> ve <code>aria-label</code> nitelikleri dinamik olarak güncellenir.
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">Odak Yönetimi (Focus Management)</div>
                    <div class="text-slate-600">
                        Sekme sırasını doğal akışında korur (<code>tabIndex="0"</code>). Görsel odak halkaları (focus ring) yüksek kontrastla görünür durumdadır.
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <h3 class="text-sm font-bold text-slate-900 mb-3">Klavye Kısayolları (Keyboard Shortcuts)</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                                <th class="py-2.5 px-4 w-48">Tuş (Key)</th>
                                <th class="py-2.5 px-4">İşlev (Function)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Ok Tuşları</kbd></td>
                                <td class="py-2.5 px-4">Hücreler arasında gezinir.</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Enter</kbd></td>
                                <td class="py-2.5 px-4">Satırı açar/kapatır veya düzenlemeye başlar.</td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
function logTreeEvent(msg) {
            const el = document.getElementById('treeEventLog');
            if (!el) return;
            const time = new Date().toLocaleTimeString('tr-TR');
            const row = document.createElement('div');
            row.innerHTML = `<span class="text-slate-500">[${time}]</span> <span class="text-emerald-400">${msg}</span>`;
            el.appendChild(row);
            el.scrollTop = el.scrollHeight;
        }

        function clearTreeLog() {
            const el = document.getElementById('treeEventLog');
            if (el) el.innerHTML = '<div class="text-slate-500">// Günlük temizlendi...</div>';
        }

        function onOrgSelect(data) {
            const info = document.getElementById('selectedOrgInfo');
            if (info) {
                info.textContent = `Seçilen Satır ID: ${data.id} | Üst ID: ${data.parentId || '(Kök Yönetici)'} | Seviye: ${data.level}`;
            }
        }

        function onOrgExpand(data) {
            console.log('Org Düğüm Açıldı:', data);
        }

        function onOrgCollapse(data) {
            console.log('Org Düğüm Kapandı:', data);
        }

        function onProjectSelect(data) {
            logTreeEvent(`Görev seçildi -> ID: ${data.id} (Seviye: ${data.level})`);
        }

        function selectUiTask() {
            const tree = Panoptes.TreeList.getInstance('projectTreeList');
            if (tree) {
                tree.select('p6');
                logTreeEvent('Programatik API çağrıldı: tree.select("p6")');
            }
        }

        function expandMimari() {
            const tree = Panoptes.TreeList.getInstance('projectTreeList');
            if (tree) {
                tree.expand('p2');
                logTreeEvent('Programatik API çağrıldı: tree.expand("p2")');
            }
        }

        function collapseMimari() {
            const tree = Panoptes.TreeList.getInstance('projectTreeList');
            if (tree) {
                tree.collapse('p2');
                logTreeEvent('Programatik API çağrıldı: tree.collapse("p2")');
            }
        }
</script>
