        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;!-- Hedef Tablo Satırları (data-* nitelikleriyle dinamik veri taşıma) --&gt;
&lt;tr class=&quot;product-row&quot; data-id=&quot;101&quot; data-code=&quot;PRD-001&quot; data-name=&quot;MacBook Pro&quot; data-price=&quot;124999.00&quot;&gt;
    &lt;td&gt;PRD-001&lt;/td&gt;
    &lt;td&gt;MacBook Pro M3 Max&lt;/td&gt;
&lt;/tr&gt;

&lt;!-- Akıllı Sağ Tık ContextMenu Bileşeni --&gt;
&lt;panoptes-context-menu id=&quot;productContextMenu&quot; target=&quot;.product-row&quot; on-select=&quot;onContextMenuSelect&quot;&gt;
    &lt;panoptes-menu-item text=&quot;Ürün Detayını Aç&quot; icon=&quot;eye&quot; shortcut=&quot;Enter&quot; url=&quot;#view&quot; /&gt;
    &lt;panoptes-menu-item text=&quot;Fiyat &amp; Bilgi Düzenle&quot; icon=&quot;edit&quot; shortcut=&quot;E&quot; url=&quot;#edit&quot; /&gt;
    &lt;panoptes-menu-item text=&quot;Ürün Kodunu Kopyala&quot; icon=&quot;copy&quot; shortcut=&quot;Ctrl+C&quot; url=&quot;#copy-code&quot; /&gt;
    &lt;panoptes-menu-separator /&gt;
    &lt;panoptes-menu-item text=&quot;Stok &amp; Tedarik&quot; icon=&quot;archive&quot;&gt;
        &lt;panoptes-menu-item text=&quot;Depodan Sayım Talep Et&quot; icon=&quot;clipboard&quot; url=&quot;#stock-count&quot; /&gt;
        &lt;panoptes-menu-item text=&quot;Tedarikçiye Sipariş Geç&quot; icon=&quot;truck&quot; url=&quot;#stock-order&quot; /&gt;
    &lt;/panoptes-menu-item&gt;
    &lt;panoptes-menu-separator /&gt;
    &lt;panoptes-menu-item text=&quot;Ürünü Kalıcı Olarak Sil&quot; icon=&quot;trash&quot; shortcut=&quot;Del&quot; url=&quot;#delete&quot; /&gt;
&lt;/panoptes-context-menu&gt;</code></pre>
