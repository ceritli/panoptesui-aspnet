                            <td class="p-3 font-mono font-semibold text-slate-700">@p.Code</td>
                            <td class="p-3 font-bold text-slate-900 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full @(p.Stock > 10 ? "bg-emerald-500" : p.Stock > 0 ? "bg-amber-500" : "bg-red-500")"></span>
                                <span>@p.Name</span>
                            </td>
                            <td class="p-3 text-slate-600">@p.Category</td>
                            <td class="p-3 text-right font-mono font-bold text-slate-900">₺@p.Price.ToString("N2")</td>
                            <td class="p-3 text-center font-mono">@p.Stock Adet</td>
                            <td class="p-3">
                                <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold @(p.Status == "Aktif" ? "bg-emerald-100 text-emerald-800" : p.Status == "Kritik Stok" ? "bg-amber-100 text-amber-800" : "bg-red-100 text-red-800")">
                                    @p.Status
                                </span>
                            </td>
                            <td class="p-3 text-center">
                                <button type="button" class="text-slate-400 hover:text-blue-600 p-1 rounded hover:bg-slate-100 transition" onclick="triggerContextMenuDirectly(event, @p.Id)">
                                    ⋮
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ContextMenu TagHelper Tanımı -->
        <panoptes-context-menu id="productContextMenu" target=".product-row" on-select="onContextMenuSelect">
            <panoptes-menu-item text="Ürün Detayını Aç" icon="eye" shortcut="Enter" url="#view" />
            <panoptes-menu-item text="Fiyat & Bilgi Düzenle" icon="edit" shortcut="E" url="#edit" />
            <panoptes-menu-item text="Ürün Kodunu Kopyala" icon="copy" shortcut="Ctrl+C" url="#copy-code" />
            
            <panoptes-menu-separator />

            <panoptes-menu-item text="Stok & Tedarik" icon="archive">
