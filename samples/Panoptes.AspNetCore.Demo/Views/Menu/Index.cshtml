            </panoptes-menu-item>

            <panoptes-menu-separator />

            <panoptes-menu-item text="Satışı Durdur (Pasife Al)" icon="lock" url="#disable" />
            <panoptes-menu-item text="Ürünü Kalıcı Olarak Sil" icon="trash" shortcut="Del" url="#delete" />
        </panoptes-context-menu>

        <div class="mt-4 p-3 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-500 flex items-center justify-between">
