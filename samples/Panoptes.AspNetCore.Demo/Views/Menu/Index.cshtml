@section Scripts {
<script>
// Olay Konsoluna Yazma
        function logEvent(type, title, details) {
            const consoleEl = document.getElementById('eventConsole');
            if (!consoleEl) return;

            const time = new Date().toLocaleTimeString('tr-TR');
            const row = document.createElement('div');
            row.className = 'flex items-start gap-2 py-0.5 border-b border-slate-900/60';
            
            const badgeColor = type === 'context' ? 'text-amber-400 bg-amber-950/60 border-amber-800' : 'text-blue-400 bg-blue-950/60 border-blue-800';
            
            row.innerHTML = `
                <span class="text-slate-500 shrink-0 font-mono text-[10px]">[${time}]</span>
                <span class="px-1.5 py-0.2 rounded border text-[10px] font-bold shrink-0 ${badgeColor}">${type === 'context' ? 'CONTEXT' : 'MENU'}</span>
                <div class="flex-1">
                    <strong class="text-slate-200">${title}</strong>
                    <div class="text-[11px] text-slate-400 mt-0.5">${details}</div>
                </div>
            `;

            consoleEl.appendChild(row);
            consoleEl.scrollTop = consoleEl.scrollHeight;
        }

        function clearEventLog() {
            const consoleEl = document.getElementById('eventConsole');
            if (consoleEl) {
                consoleEl.innerHTML = '<div class="text-slate-500">// Günlük temizlendi.</div>';
            }
        }

        // Yatay/Dikey Menü Seçim Olayı
        function onMenuItemSelect(e) {
            const item = e.item;
            const details = `URL/Hash: <span class="text-amber-300">${item.url || '-'}</span> | Kısayol: <span class="text-blue-300">${item.shortcut || '-'}</span> | Rozet: <span class="text-purple-300">${item.badge || '-'}</span>`;
            logEvent('menu', `"${item.text}" Menü Öğesi Seçildi`, details);

            // Özel aksiyonlar
            if (item.url === '#theme-light' || item.url === '#theme-dark') {
                alert(`Tema değiştirildi: ${item.text}`);
            }
        }

        // Sağ Tık ContextMenu Seçim Olayı
        function onContextMenuSelect(e) {
            const item = e.item;
            const targetData = e.targetData || {};
            const productDesc = targetData.name ? `${targetData.code} - ${targetData.name} (₺${targetData.price})` : 'Hedef veri bulunamadı';
            
            const details = `Seçilen Aksiyon: <span class="text-amber-300">${item.text}</span> [${item.url}]<br/>Hedef Satır Verisi: <span class="text-emerald-300">${productDesc}</span>`;
            logEvent('context', `Bağlam Menüsü: ${item.text}`, details);

            if (item.url === '#delete') {
                if (confirm(`'${targetData.name}' isimli ürünü silmek istediğinize emin misiniz?`)) {
                    logEvent('context', 'Silme İşlemi Onaylandı', `Ürün ID: ${targetData.id} veritabanından kaldırılmak üzere tetiklendi.`);
                }
            } else if (item.url === '#copy-code') {
                if (targetData.code) {
                    navigator.clipboard.writeText(targetData.code).then(() => {
                        logEvent('context', 'Pano Kopyalama Başarılı', `Kopyalanan Kod: ${targetData.code}`);
                    });
                }
            }
        }

        // Tablodaki üç nokta butonuna tıklanınca ContextMenu tetikleme
        function triggerContextMenuDirectly(event, productId) {
            event.stopPropagation();
            const row = document.querySelector(`.product-row[data-id="${productId}"]`);
            if (row && window.Panoptes && window.Panoptes.ContextMenu) {
                const instance = window.Panoptes.ContextMenu.get('productContextMenu');
                if (instance) {
                    const rect = event.target.getBoundingClientRect();
                    instance.openAt(rect.right, rect.bottom, row);
                }
            }
        }
</script>
}
