@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "DatePicker - Validation (Min/Max)" : "DatePicker - Doğrulama (Min/Max)";
    var minDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("dd.MM.yyyy");
    var maxDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)).ToString("dd.MM.yyyy");
}

<div class="space-y-8">
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/DatePicker" : "/DatePicker")" class="hover:text-blue-600 transition">DatePicker</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">@(isEn ? "Validation (Min/Max)" : "Doğrulama (Min/Max)")</span>
    </nav>

    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "Validation (Min/Max Boundaries)" : "Doğrulama (Min/Max Sınırları)")</h1>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Restrict user selection to an allowed date range; days outside boundaries are dimmed and locked." 
                    : "Kullanıcının yalnızca geçerli bir tarih aralığında seçim yapmasını sağlayın; sınır dışındaki günler kilitlenir ve seçilemez.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold shrink-0">
                ✓ Production Ready
            </span>
        </div>
    </div>

    <!-- Live Demo Card -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "Min & Max Date Boundaries" : "Min & Max Tarih Sınırları")</h2>
            <p class="text-xs text-slate-500 mt-1">@(isEn ? "Allowed selection range is restricted to current month." : "Seçim aralığı yalnızca geçerli ay ile sınırlandırılmıştır.")</p>
        </div>

        <div class="max-w-xl space-y-2">
            <label class="block text-xs font-bold text-slate-700">@(isEn ? "Only Dates in Current Month Can Be Selected" : "Yalnızca Bu Ayın Tarihleri Seçilebilir")</label>
            <panoptes-datepicker id="dp_min_max"
                                 min="@minDate"
                                 max="@maxDate"
                                 placeholder="@(isEn ? "Select date in this month..." : "Bu ay için tarih seçiniz...")" />
            <span class="text-[11px] text-slate-400">@(isEn ? $"Dates before {minDate} and after {maxDate} are disabled." : $"Ayın 1'inden ({minDate}) öncesi ve son gününden ({maxDate}) sonrası takvimde pasif görünür.")</span>
        </div>
    </div>

    <!-- Feature Description Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Strict Range Enforcement" : "Katı Aralık Koruması")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Disables calendar cells and rejects manual text entries outside the min and max threshold."
                    : "Takvim hücrelerini devre dışı bırakır ve min/max eşiği dışındaki manuel metin girişlerini engeller.")
            </div>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Localized Date Formatting" : "Yerelleştirilmiş Tarih Biçimlendirme")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Full integration with localized month names, days of week, and custom delimiter formats."
                    : "Yerelleştirilmiş ay isimleri, gün adları ve özel ayraç biçimleri ile tam entegrasyon.")
            </div>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-datepicker id="dp_min_max"
                     min="@minDate"
                     max="@maxDate"
                     placeholder="@(isEn ? "Select date in this month..." : "Bu ay için tarih seçiniz...")" /&gt;</code></pre>
        </div>
    </div>
</div>
