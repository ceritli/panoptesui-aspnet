@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = "DatePicker (Tarih Seçici) - Panoptes Kurumsal UI";
    var startOfMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("dd.MM.yyyy");
    var endOfMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)).ToString("dd.MM.yyyy");
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="/" class="hover:text-blue-600 transition">Ana Sayfa</a>
        <span>/</span>
        <a href="/DatePicker" class="hover:text-blue-600 transition">Tarih & Zaman</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">DatePicker</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">DatePicker (Tarih Seçici)</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-datepicker&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    WAI-ARIA Uyumlu
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                Açılır takvim görünümü, yerelleştirilmiş Türkçe ay/gün isimleri, Min/Max tarih sınırlamaları, hafta sonu devre dışı bırakma, hafta numaraları ve JavaScript istemci API'si.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold shrink-0">
                ✓ Production Ready
            </span>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>Örnekler (Features)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">7</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>API Referansı (Props & Events)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">18</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>Erişilebilirlik (WAI-ARIA)</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
        <!-- 1. Temel Kullanım & Formatlar -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="border-b border-slate-100 pb-4 mb-6">
                <h2 class="text-base font-bold text-slate-800">1. Temel Kullanım & Tarih Formatları</h2>
                <p class="text-xs text-slate-500 mt-1">Farklı gösterim formatları, yerelleştirme ve tek tıkla temizleme (clearable) yeteneği.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">Türkiye Standardı (DD.MM.YYYY)</label>
                    <panoptes-datepicker id="dp_format_tr"
                                         value="@DateTime.Now.ToString("dd.MM.yyyy")"
                                         format="DD.MM.YYYY"
                                         placeholder="GG.AA.YYYY" />
                    <span class="text-[11px] text-slate-400">Varsayılan Türkçe tarih biçimi.</span>
                </div>

                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">ISO Standardı (YYYY-MM-DD)</label>
                    <panoptes-datepicker id="dp_format_iso"
                                         value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                         format="YYYY-MM-DD"
                                         placeholder="YYYY-AA-GG" />
                    <span class="text-[11px] text-slate-400">Veritabanı ve API uyumlu ISO biçimi.</span>
                </div>

                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">Eğik Çizgi Formatı (DD/MM/YYYY)</label>
                    <panoptes-datepicker id="dp_format_slash"
                                         format="DD/MM/YYYY"
                                         placeholder="GG/AA/YYYY" />
                    <span class="text-[11px] text-slate-400">Uluslararası slash formatı.</span>
                </div>
            </div>

            <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
            <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mt-6">
                <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                            @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                        </span>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
                    </button>
                </div>
                <div class="panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;!-- Türkiye Standardı (DD.MM.YYYY) --&gt;
&lt;panoptes-datepicker id="dp_format_tr"
                     value="@@DateTime.Now.ToString("dd.MM.yyyy")"
                     format="DD.MM.YYYY"
                     placeholder="GG.AA.YYYY" /&gt;

&lt;!-- ISO Standardı (YYYY-MM-DD) --&gt;
&lt;panoptes-datepicker id="dp_format_iso"
                     value="@@DateTime.Now.ToString("yyyy-MM-dd")"
                     format="YYYY-MM-DD"
                     placeholder="YYYY-AA-GG" /&gt;

&lt;!-- Eğik Çizgi Formatı (DD/MM/YYYY) --&gt;
&lt;panoptes-datepicker id="dp_format_slash"
                     format="DD/MM/YYYY"
                     placeholder="GG/AA/YYYY" /&gt;</code></pre>
                </div>
            </div>
        </div>

        <!-- 2. Görünüm & Boyutlar -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="border-b border-slate-100 pb-4 mb-6">
                <h2 class="text-base font-bold text-slate-800">2. Boyut & Stil Çeşitleri (Appearance)</h2>
                <p class="text-xs text-slate-500 mt-1">Küçük (sm), Orta (md), Büyük (lg) boyutlar ve tam yuvarlak (full) kenarlık seçenekleri.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">Küçük Boyut (Size: "sm")</label>
                    <panoptes-datepicker id="dp_size_sm" size="sm" placeholder="Küçük..." />
                </div>
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">Büyük & Yuvarlak (Size: "lg", Rounded: "full")</label>
                    <panoptes-datepicker id="dp_size_lg" size="lg" rounded="full" placeholder="Büyük & Yuvarlak..." />
                </div>
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">Alt Çizgili (FillMode: "flat")</label>
                    <panoptes-datepicker id="dp_fill_flat" fill-mode="flat" placeholder="Düz alt çizgili..." />
                </div>
            </div>

            <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
            <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mt-6">
                <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                            @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                        </span>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
                    </button>
                </div>
                <div class="panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;!-- Küçük Boyut (Size: "sm") --&gt;
&lt;panoptes-datepicker id="dp_size_sm" size="sm" placeholder="Küçük..." /&gt;

&lt;!-- Büyük &amp; Yuvarlak (Size: "lg", Rounded: "full") --&gt;
&lt;panoptes-datepicker id="dp_size_lg" size="lg" rounded="full" placeholder="Büyük &amp; Yuvarlak..." /&gt;

&lt;!-- Alt Çizgili (FillMode: "flat") --&gt;
&lt;panoptes-datepicker id="dp_fill_flat" fill-mode="flat" placeholder="Düz alt çizgili..." /&gt;</code></pre>
                </div>
            </div>
        </div>

        <!-- 3. Doğrulama: Min/Max Tarih Sınırları & Pasif Tarihler -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="border-b border-slate-100 pb-4 mb-6">
                <h2 class="text-base font-bold text-slate-800">3. Tarih Doğrulama & Hafta Sonu Devre Dışı Bırakma</h2>
                <p class="text-xs text-slate-500 mt-1">Kullanıcının yalnızca geçerli bir tarih aralığında ve iş günlerinde seçim yapmasını sağlayın.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">Min/Max Sınırı (Yalnızca Bu Ay)</label>
                    <panoptes-datepicker id="dp_min_max_demo"
                                         min="@startOfMonth"
                                         max="@endOfMonth"
                                         placeholder="Bu ay için tarih seçiniz..." />
                    <span class="text-[11px] text-slate-400">@startOfMonth öncesi ve @endOfMonth sonrası takvimde soluk ve kilitlidir.</span>
                </div>

                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">İş Günü Randevusu (Hafta Sonu Pasif)</label>
                    <panoptes-datepicker id="dp_disabled_weekends_demo"
                                         disable-dates="weekend"
                                         placeholder="İş günü seçiniz (Pzt-Cum)..." />
                    <span class="text-[11px] text-slate-400">Cumartesi ve Pazar günleri otomatik olarak devre dışı bırakılır.</span>
                </div>
            </div>

            <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
            <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mt-6">
                <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                            @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                        </span>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
                    </button>
                </div>
                <div class="panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;!-- Min / Max Tarih Sınırlandırması --&gt;
&lt;panoptes-datepicker id="dp_min_max_demo"
                     min="@@startOfMonth"
                     max="@@endOfMonth"
                     placeholder="Bu ay için tarih seçiniz..." /&gt;

&lt;!-- Hafta Sonu Günlerini Pasife Alma --&gt;
&lt;panoptes-datepicker id="dp_disabled_weekends_demo"
                     disable-dates="weekend"
                     placeholder="İş günü seçiniz (Pzt-Cum)..." /&gt;</code></pre>
                </div>
            </div>
        </div>

        <!-- 4. Hafta Numaraları -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="border-b border-slate-100 pb-4 mb-6">
                <h2 class="text-base font-bold text-slate-800">4. Hafta Numaraları (Week Numbers)</h2>
                <p class="text-xs text-slate-500 mt-1">Takvimin en sol sütununda ISO-8601 standardına göre yılın hafta numarasını (1-52) gösterir.</p>
            </div>

            <div class="max-w-md space-y-2">
                <label class="block text-xs font-bold text-slate-700">Hafta Numaralı Takvim (week-number="true")</label>
                <panoptes-datepicker id="dp_week_numbers_demo"
                                     week-number="true"
                                     value="@DateTime.Now.ToString("dd.MM.yyyy")"
                                     placeholder="Hafta numaralı takvim..." />
            </div>

            <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
            <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mt-6">
                <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                            @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                        </span>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
                    </button>
                </div>
                <div class="panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;!-- Hafta Numaralı Takvim --&gt;
&lt;panoptes-datepicker id="dp_week_numbers_demo"
                     week-number="true"
                     value="@@DateTime.Now.ToString("dd.MM.yyyy")"
                     placeholder="Hafta numaralı takvim..." /&gt;</code></pre>
                </div>
            </div>
        </div>

        <!-- 5. JavaScript İstemci API Kontrolleri -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="border-b border-slate-100 pb-4 mb-6">
                <h2 class="text-base font-bold text-slate-800">5. JavaScript İstemci API (Programatik Yönetim)</h2>
                <p class="text-xs text-slate-500 mt-1">JavaScript API metodlarını tetikleyerek tarih seçiciyi dışarıdan yönetin.</p>
            </div>

            <div class="space-y-4 max-w-xl">
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">API Test Tarih Seçici</label>
                    <panoptes-datepicker id="dp_api_demo"
                                         value="@DateTime.Now.ToString("dd.MM.yyyy")"
                                         placeholder="Tarih seçin..." />
                </div>

                <!-- API Buttons -->
                <div class="flex flex-wrap gap-2 pt-2">
                    <button type="button" onclick="getDpInst('dp_api_demo')?.open()" class="px-3 py-1.5 text-xs font-semibold bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-lg shadow-2xs transition">
                        .open()
                    </button>
                    <button type="button" onclick="getDpInst('dp_api_demo')?.close()" class="px-3 py-1.5 text-xs font-semibold bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-lg shadow-2xs transition">
                        .close()
                    </button>
                    <button type="button" onclick="getDpInst('dp_api_demo')?.setValue('01.01.2027')" class="px-3 py-1.5 text-xs font-semibold bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-lg shadow-2xs transition">
                        .setValue('01.01.2027')
                    </button>
                    <button type="button" onclick="alert('Seçili Tarih: ' + (getDpInst('dp_api_demo')?.getValue() || 'Boş'))" class="px-3 py-1.5 text-xs font-semibold bg-blue-50 border border-blue-200 hover:bg-blue-100 text-blue-700 rounded-lg shadow-2xs transition">
                        .getValue()
                    </button>
                    <button type="button" onclick="toggleDatePickerEnable()" id="btnToggleDpEnable" class="px-3 py-1.5 text-xs font-semibold bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-lg shadow-2xs transition">
                        .enable(false)
                    </button>
                </div>
            </div>

            <!-- JavaScript API Code Snippet (Light Code Viewer Standard) -->
            <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mt-6">
                <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                            JavaScript API
                        </span>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
                    </button>
                </div>
                <div class="panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>// Örneğe erişim
const dp = window.Panoptes?.DatePicker?.instances?.get('dp_api_demo');

// Takvimi açma / kapatma
dp?.open();
dp?.close();

// Değer atama ve okuma
dp?.setValue('01.01.2027');
const secilenTarih = dp?.getValue();

// Etkinleştirme / Devre dışı bırakma
dp?.enable(false); // Kilitler
dp?.enable(true);  // Aktif eder</code></pre>
                </div>
            </div>
        </div>

        <!-- 6. Canlı Olay Günlüğü -->
