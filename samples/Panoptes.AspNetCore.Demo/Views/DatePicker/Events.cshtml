@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "DatePicker - Events" : "DatePicker - Olaylar (Events)";
}

<div class="space-y-8">
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/DatePicker" : "/DatePicker")" class="hover:text-blue-600 transition">DatePicker</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">@(isEn ? "Events" : "Olaylar (Events)")</span>
    </nav>

    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "Events (Client-Side Listeners)" : "Olaylar (Events)")</h1>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Update dependent fields on change: pick a due date, refresh the payment plan."
                    : "Tarih değişince bağımlı alanları güncelle: vade seçilince ödeme planı yenilensin.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold shrink-0">
                ✓ Production Ready
            </span>
        </div>
    </div>

    <!-- Live Demo & Event Log -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "Interactive DatePicker & Console" : "Etkileşimli Tarih Seçici ve Konsol")</h2>
            <p class="text-xs text-slate-500 mt-1">@(isEn ? "Pick a date or open the calendar to trigger events." : "Takvimi açın veya yeni bir tarih seçerek olayları tetikleyin.")</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
            <div class="space-y-4">
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">@(isEn ? "Interactive DatePicker" : "Etkileşimli Tarih Seçici")</label>
                    <panoptes-datepicker id="dp_events_demo"
                                         value="@DateTime.Now.ToString("dd.MM.yyyy")"
                                         placeholder="@(isEn ? "Select date..." : "Tarih seçin...")" />
                    <span class="text-[11px] text-slate-400">@(isEn ? "Click to open calendar or select a new date." : "Takvimi açın veya farklı bir gün seçin.")</span>
                </div>
            </div>

            <!-- Event Log Console -->
            <div class="bg-slate-900 rounded-xl p-4 text-xs font-mono text-slate-300">
                <div class="flex items-center justify-between pb-2 border-b border-slate-800 mb-2">
                    <span class="font-bold text-slate-400">@(isEn ? "Live Event Log" : "Canlı Olay Günlüğü (Event Log)")</span>
                    <button type="button" onclick="document.getElementById('eventLogDp').innerHTML = ''" class="text-[11px] text-slate-500 hover:text-slate-300 transition">@(isEn ? "Clear" : "Temizle")</button>
                </div>
                <div id="eventLogDp" class="h-36 overflow-y-auto space-y-1 text-[11px] text-slate-400">
                    <div class="text-emerald-400">&gt; @(isEn ? "System ready. Awaiting DatePicker events..." : "Sistem hazır. Olaylar bekleniyor...")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Description Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "CustomEvent Detail Payload" : "CustomEvent Detay Verisi")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Change events dispatch standard CustomEvent instances containing formatted string values in event.detail."
                    : "Change olayı event.detail nesnesinde formatlanmış tarih string değerini iletir.")
            </div>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Standard DOM Integration" : "Standart DOM Entegrasyonu")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Seamlessly works with addEventListener or declarative Razor on-change attributes."
                    : "Hem addEventListener ile hem de bildirimsel on-change öznitelikleriyle sorunsuz çalışır.")
            </div>
        </div>
    </div>

    <!-- Razor TagHelper & JS Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    JavaScript Event Listener
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>const el = document.getElementById('dp_events_demo');

// Tarih seçim olayı
el?.addEventListener('change', function(e) {
    const val = e.detail?.value || el.querySelector('input')?.value;
    console.log('Seçilen Tarih:', val);
});

// Odaklanma olayı
el?.querySelector('input')?.addEventListener('focus', function() {
    console.log('DatePicker odaklandı');
});</code></pre>
        </div>
    </div>
</div>

<script>
    function logDpEvent(msg) {
        const log = document.getElementById('eventLogDp');
        if (!log) return;
        const time = new Date().toLocaleTimeString();
        const div = document.createElement('div');
        div.innerHTML = `<span class="text-slate-600">[${time}]</span> ${msg}`;
        log.prepend(div);
    }

    document.addEventListener('DOMContentLoaded', function() {
        const evEl = document.getElementById('dp_events_demo');
        if (evEl) {
            evEl.addEventListener('change', function(e) {
                const val = e.detail?.value || evEl.querySelector('input')?.value || '';
                logDpEvent(`Olay: <strong class="text-blue-400">change</strong> -&gt; Seçilen Tarih: <span class="text-emerald-400 font-semibold">"${val}"</span>`);
            });
            const inputEl = evEl.querySelector('input');
            if (inputEl) {
                inputEl.addEventListener('focus', function() {
                    logDpEvent(`Olay: <strong class="text-indigo-400">focus</strong> -&gt; Giriş alanına odaklanıldı`);
                });
            }
        }
    });
</script>
