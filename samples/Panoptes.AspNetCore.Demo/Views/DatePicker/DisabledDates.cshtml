@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "DatePicker - Disabled Dates" : "DatePicker - Pasif Tarihler";
}

<div class="space-y-8">
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/DatePicker" : "/DatePicker")" class="hover:text-blue-600 transition">DatePicker</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">@(isEn ? "Disabled Dates" : "Pasif Tarihler")</span>
    </nav>

    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "Disabled Dates (Weekends & Holidays)" : "Hafta Sonu Devre Dışı (Disabled Dates)")</h1>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Automatically locks Saturday and Sunday for business-day appointment booking, shipping deliveries, or official requests."
                    : "İş günü randevusu, kargo teslimatı veya resmi işlemler için Cumartesi ve Pazar günlerini otomatik kapatır.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold shrink-0">
                ✓ Production Ready
            </span>
        </div>
    </div>

    <!-- Live Demo Card -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "Business Day Only Selection" : "İş Günü Randevu Seçimi")</h2>
            <p class="text-xs text-slate-500 mt-1">@(isEn ? "Saturdays and Sundays are locked and cannot be selected." : "Cumartesi ve Pazar günleri kilitlidir, seçilemez.")</p>
        </div>

        <div class="max-w-xl space-y-2">
            <label class="block text-xs font-bold text-slate-700">@(isEn ? "Business Day Selection (Monday - Friday)" : "Yalnızca İş Günü Seçimi (Pazartesi - Cuma)")</label>
            <panoptes-datepicker id="dp_disabled_weekends"
                                 disable-dates="weekend"
                                 placeholder="@(isEn ? "Select business day..." : "İş günü seçiniz...")" />
            <span class="text-[11px] text-slate-400">@(isEn ? "Saturdays and Sundays appear dimmed and unclickable in the popup calendar." : "Takvimde Cumartesi ve Pazar günleri soluk renkte kilitlidir.")</span>
        </div>
    </div>

    <!-- Feature Description Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Automatic Weekend Detection" : "Otomatik Hafta Sonu Tespiti")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Built-in weekend engine calculates non-business days dynamically based on the active locale."
                    : "Dahili hafta sonu motoru aktif yerelleştirmeye göre iş dışı günleri dinamik hesaplar.")
            </div>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Custom Disabled Date Lists" : "Özel Tatil Günleri Desteği")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Pass a comma-separated list of dates or custom JS predicate to disable bank holidays and corporate shutdowns."
                    : "Resmi tatilleri ve özel şirket tatillerini devre dışı bırakmak için virgülle ayrılmış tarih listesi verilebilir.")
            </div>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-datepicker id="dp_disabled_weekends"
                     disable-dates="weekend"
                     placeholder="@(isEn ? "Select business day..." : "İş günü seçiniz...")" /&gt;</code></pre>
        </div>
    </div>
</div>
