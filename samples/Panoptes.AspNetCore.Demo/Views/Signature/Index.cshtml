<script>
function onApiSignatureChange(dataUrl, inst) {
            const preview = dataUrl ? (dataUrl.substring(0, 50) + '... (toplam ' + dataUrl.length + ' karakter)') : 'Boş';
            logSigEvent(`[on-change]: İmza güncellendi. Base64: ${preview}`);
        }

        function downloadSigPng() {
            const dataUrl = Panoptes.Signature.getDataURL('apiSigDemo', 'image/png');
            if (!dataUrl) {
                alert('Lütfen önce kutuya bir imza atınız!');
                return;
            }
            const a = document.createElement('a');
            a.href = dataUrl;
            a.download = 'panoptes-imza.png';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            logSigEvent(`Panoptes.Signature.getDataURL() ile 'panoptes-imza.png' indirildi.`);
        }

        function checkSigEmpty() {
            const empty = Panoptes.Signature.isEmpty('apiSigDemo');
            logSigEvent(`Panoptes.Signature.isEmpty('apiSigDemo') -> ${empty ? 'İmza BOŞ' : 'İmza DOLU'}`);
            alert(empty ? 'İmza kutusu henüz BOŞ.' : 'İmza kutusu DOLU.');
        }

        function clearSigDemo() {
            Panoptes.Signature.clear('apiSigDemo');
            logSigEvent(`Panoptes.Signature.clear('apiSigDemo') çağrıldı.`);
        }

        function logSigEvent(msg) {
            const logBox = document.getElementById('sigEventLog');
            if (!logBox) return;
            const time = new Date().toLocaleTimeString('tr-TR');
            const row = document.createElement('div');
            row.innerHTML = `<span class="text-emerald-400 font-mono">[${time}]</span> <span class="text-slate-200">${msg}</span>`;
            logBox.appendChild(row);
            logBox.scrollTop = logBox.scrollHeight;
        }

        function clearSigLog() {
            const logBox = document.getElementById('sigEventLog');
            if (logBox) logBox.innerHTML = '<div class="text-slate-500">// Günlük temizlendi...</div>';
        }
</script>
