@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Signature (Digital Signature Pad) - Panoptes Corporate UI" : "Signature (Dijital Islak İmza) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/Signature" : "/Signature")" class="hover:text-blue-600 transition">@(isEn ? "Form Components" : "Form Bileşenleri")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">Signature</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Signature (Dijital Islak İmza)</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-signature&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    WAI-ARIA Uyumlu
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                Sözleşmeler ve dijital onay akışları için dokunmatik ekran veya fareyle ıslak imza atılmasını sağlayan kanvas tabanlı dijital imza bileşeni.
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>Örnekler (Features)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">4</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>API Referansı (Props & Events)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">6</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>Erişilebilirlik (WAI-ARIA)</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
<!-- DEMO 1: Standart Sözleşme Onay İmzası -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                    1. Standart Sözleşme & Taahhütname İmzası (Temizle & Geri Al)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Kullanıcı fare veya parmağıyla imza atabilir; dahili araç çubuğundaki Temizle veya Geri Al butonlarıyla hatalı darbeleri anında düzeltebilir.
                </p>
            </div>
            <span class="text-xs font-mono bg-blue-50 text-blue-700 px-2 py-1 rounded font-medium border border-blue-100">&lt;panoptes-signature&gt;</span>
        </div>

        <div class="p-8 max-w-2xl mx-auto space-y-4">
            <div class="bg-blue-50/60 border border-blue-100 p-3 rounded-lg text-xs text-blue-800 flex items-center gap-2">
                <svg class="w-4 h-4 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>Yukarıdaki sözleşme şartlarını okudum ve onaylıyorum. Lütfen aşağıdaki kutuyu imzalayınız.</span>
            </div>

            <panoptes-signature id="contractSigDemo" 
                                width="600" 
                                height="200" 
                                stroke-color="#0f172a" 
                                stroke-width="2.5" 
                                show-controls="true" 
                                placeholder="Sözleşmeyi onaylamak için buraya imzanızı atın..." />
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-3 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>Kopyala</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-signature id=&quot;contractSigDemo&quot; 
                    width=&quot;600&quot; 
                    height=&quot;200&quot; 
                    stroke-color=&quot;#0f172a&quot; 
                    stroke-width=&quot;2.5&quot; 
                    show-controls=&quot;true&quot; 
                    placeholder=&quot;Sözleşmeyi onaylamak için buraya imzanızı atın...&quot; /&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 2: Lacivert Mürekkep & Kalın Kalem İmzası -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-indigo-600 inline-block"></span>
                    2. Özel Çizgi Rengi (Lacivert Mürekkep) ve Kalın Çizim
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Resmi evrak veya dolma kalem hissi vermek için mavi/lacivert tonları ve ayarlanabilir çizgi genişliği (stroke-width: 3.5).
                </p>
            </div>
            <span class="text-xs font-mono bg-indigo-50 text-indigo-700 px-2 py-1 rounded font-medium border border-indigo-100">stroke-color="#1d4ed8"</span>
        </div>

        <div class="p-8 max-w-2xl mx-auto space-y-4">
            <panoptes-signature id="navySigDemo" 
                                width="600" 
                                height="200" 
                                stroke-color="#1d4ed8" 
                                stroke-width="3.5" 
                                show-controls="true" 
                                placeholder="Resmi evrak için ıslak imzanız..." />
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-3 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>Kopyala</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-signature id=&quot;navySigDemo&quot; 
                    width=&quot;600&quot; 
                    height=&quot;200&quot; 
                    stroke-color=&quot;#1d4ed8&quot; 
                    stroke-width=&quot;3.5&quot; 
                    show-controls=&quot;true&quot; 
                    placeholder=&quot;Resmi evrak için ıslak imzanız...&quot; /&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 3: Programatik JavaScript API & PNG İndirme -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
                    3. Programatik JavaScript API, PNG İndirme & Canlı Base64 Çıktısı
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    İmza atıldıkça otomatik üretilen Base64 verisi, Panoptes.Signature API motoru ile PNG indirme, SVG üretme ve doğrulama.
                </p>
            </div>
            <span class="text-xs font-mono bg-emerald-50 text-emerald-700 px-2 py-1 rounded font-medium border border-emerald-100">Panoptes.Signature API</span>
        </div>

        <div class="p-8 max-w-2xl mx-auto space-y-6">
            <panoptes-signature id="apiSigDemo" 
                                width="600" 
                                height="200" 
                                stroke-color="#059669" 
                                stroke-width="2.5" 
                                show-controls="true" 
                                on-change="onApiSignatureChange" 
                                placeholder="Buraya test imzanızı çizin..." />

            <!-- API Butonları -->
            <div class="flex flex-wrap items-center gap-2 pt-2">
                <button type="button" onclick="downloadSigPng()" class="px-3 py-1.5 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition active:scale-95 flex items-center gap-1.5 shadow-xs">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    PNG İndir (DataURL)
                </button>
                <button type="button" onclick="checkSigEmpty()" class="px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition active:scale-95 border border-slate-200">
                    İmza Dolu mu? (isEmpty)
                </button>
                <button type="button" onclick="clearSigDemo()" class="px-3 py-1.5 text-xs font-semibold text-rose-700 bg-rose-50 hover:bg-rose-100 rounded-lg transition active:scale-95 border border-rose-200">
                    Programatik Temizle (clear)
                </button>
                <button type="button" onclick="clearSigLog()" class="ml-auto px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-slate-800 transition">
                    Günlüğü Temizle
                </button>
            </div>

            <!-- Canlı Olay Günlüğü Terminali -->
            <div class="space-y-1">
                <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Canlı Olay Günlüğü & Base64 Önizleme:</div>
                <div id="sigEventLog" class="h-28 bg-slate-950 text-slate-200 p-3 rounded-xl font-mono text-[11px] overflow-y-auto space-y-1 border border-slate-800 shadow-inner">
                    <div class="text-slate-500">// İmza çizildikçe Base64 PNG verisi ve API logları burada görünecektir...</div>
                </div>
            </div>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-3 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>Kopyala</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-signature id=&quot;apiSigDemo&quot; 
                    width=&quot;600&quot; 
                    height=&quot;200&quot; 
                    stroke-color=&quot;#059669&quot; 
                    stroke-width=&quot;2.5&quot; 
                    show-controls=&quot;true&quot; 
                    on-change=&quot;onApiSignatureChange&quot; /&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- Parametre & Nitelik Referans Tablosu -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 bg-slate-50/50">
            <h2 class="text-base font-bold text-slate-800">TagHelper Parametre & Nitelik Referansı</h2>
            <p class="text-xs text-slate-500 mt-0.5">&lt;panoptes-signature&gt; bileşeninin desteklediği tüm nitelikler</p>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-600">
                <thead class="bg-slate-50 text-slate-800 font-bold border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-3">Nitelik (Attribute)</th>
                        <th class="px-6 py-3">Tür (Type)</th>
                        <th class="px-6 py-3">Varsayılan</th>
                        <th class="px-6 py-3">Açıklama</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">id</td>
                        <td class="px-6 py-3 font-mono text-slate-500">string</td>
                        <td class="px-6 py-3 font-mono text-slate-400">otomatik guid</td>
                        <td class="px-6 py-3">Bileşenin benzersiz DOM kimliği ve JavaScript API referansı.</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">width</td>
                        <td class="px-6 py-3 font-mono text-slate-500">int</td>
                        <td class="px-6 py-3 font-mono text-slate-400">600</td>
                        <td class="px-6 py-3">Canvas çizim alanının piksel genişliği.</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">height</td>
                        <td class="px-6 py-3 font-mono text-slate-500">int</td>
                        <td class="px-6 py-3 font-mono text-slate-400">220</td>
                        <td class="px-6 py-3">Canvas çizim alanının piksel yüksekliği.</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">stroke-color</td>
                        <td class="px-6 py-3 font-mono text-slate-500">string</td>
                        <td class="px-6 py-3 font-mono text-slate-400">"#0f172a"</td>
                        <td class="px-6 py-3">İmza mürekkep rengi (HEX veya RGB).</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">stroke-width</td>
                        <td class="px-6 py-3 font-mono text-slate-500">double</td>
                        <td class="px-6 py-3 font-mono text-slate-400">2.5</td>
                        <td class="px-6 py-3">Çizgi kalınlığı (piksel).</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">show-controls</td>
                        <td class="px-6 py-3 font-mono text-slate-500">bool</td>
                        <td class="px-6 py-3 font-mono text-slate-400">true</td>
                        <td class="px-6 py-3">Alt kısımda Temizle, Geri Al ve Durum etiketini gösterir.</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">readonly</td>
                        <td class="px-6 py-3 font-mono text-slate-500">bool</td>
                        <td class="px-6 py-3 font-mono text-slate-400">false</td>
                        <td class="px-6 py-3">Çizim yapılmasını engeller, sadece önceden yüklenmiş imzayı sergiler.</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">placeholder</td>
                        <td class="px-6 py-3 font-mono text-slate-500">string</td>
                        <td class="px-6 py-3 font-mono text-slate-400">"Buraya imzanızı atın..."</td>
                        <td class="px-6 py-3">İmza atılmadan önce çizim alanında rehber olarak görünen kılavuz metni.</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-3 font-mono font-semibold text-blue-600">on-change</td>
                        <td class="px-6 py-3 font-mono text-slate-500">string</td>
                        <td class="px-6 py-3 font-mono text-slate-400">null</td>
                        <td class="px-6 py-3">Her imza darbesi bittiğinde veya silindiğinde tetiklenen JS geri çağırma fonksiyonu.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/panoptes/panoptes-signature.js"></script>
    
}

    <!-- PANEL 2: API & ATTRIBUTES -->
    <div id="panel-api" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">TagHelper Özellikleri & Parametreleri</h3>
                    <p class="text-xs text-slate-500 mt-0.5">&lt;panoptes-signature&gt; bileşeninin desteklediği tüm C# ve HTML nitelikleri.</p>
                </div>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-blue-100 text-blue-800">PanoptesSignatureTagHelper</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                            <th class="py-3 px-6">Özellik (Attribute)</th>
                            <th class="py-3 px-4">Tip (C#)</th>
                            <th class="py-3 px-4">Varsayılan</th>
                            <th class="py-3 px-6">Açıklama</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">id</td>
