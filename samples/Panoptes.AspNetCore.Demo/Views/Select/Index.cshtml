@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Select (DropDownList) - Panoptes Enterprise UI" : "Select (Açılır Seçim Listesi / DropDownList) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/Select" : "/Select")" class="hover:text-blue-600 transition">@(isEn ? "Select & Dropdown" : "Form Bileşenleri")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">Select</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Select (DropDownList)</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-select&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "WAI-ARIA Compliant" : "WAI-ARIA Uyumlu")
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Searchable fast lists for customer and product picks; the base of province-district and category flows."
                    : "Müşteri ve ürün seçiminde arama kutulu hızlı liste; il-ilçe ve kategori-alt kategori akışlarının temeli.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold shrink-0">
                ✓ Production Ready
            </span>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>@(isEn ? "Features & Demos" : "Örnekler (Features)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">2</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>@(isEn ? "API Reference" : "API Referansı (Props & Events)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">14</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>@(isEn ? "Accessibility" : "Erişilebilirlik (WAI-ARIA)")</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
        <!-- 1. Temel Kullanım & Boyutlar -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="border-b border-slate-100 pb-4 mb-6">
                <h2 class="text-base font-bold text-slate-800">@(isEn ? "1. Basic Usage & Sizes (Appearance)" : "1. Temel Kullanım & Görünüm Seçenekleri (Appearance)")</h2>
                <p class="text-xs text-slate-500 mt-1">@(isEn ? "Small, Medium, Large sizes and rounded styles." : "Farklı boyutlar (Small, Medium, Large) ve yuvarlaklık stilleri.")</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Small -->
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">@(isEn ? "Small Size (Size: \"sm\")" : "Küçük Boyut (Size: \"sm\")")</label>
                    <panoptes-select id="sel_size_sm"
                                     size="sm"
                                     placeholder="@(isEn ? "Select department..." : "Departman seçiniz...")"
                                     options="Yazılım, İnsan Kaynakları, Finans, Pazarlama, Ar-Ge" />
                    <span class="text-[11px] text-slate-400">@(isEn ? "Ideal for compact forms and tables." : "Kompakt formlar ve tablolar için ideal.")</span>
                </div>

                <!-- Medium -->
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">@(isEn ? "Standard Size (Size: \"md\")" : "Standart Boyut (Size: \"md\")")</label>
                    <panoptes-select id="sel_size_md"
                                     size="md"
                                     value="Yazılım"
                                     placeholder="@(isEn ? "Select department..." : "Departman seçiniz...")"
                                     options="Yazılım, İnsan Kaynakları, Finans, Pazarlama, Ar-Ge" />
                    <span class="text-[11px] text-slate-400">@(isEn ? "Default form control size." : "Varsayılan form alanı boyutu.")</span>
                </div>

                <!-- Large & Pill -->
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">@(isEn ? "Large & Full Rounded (Size: \"lg\", Rounded: \"full\")" : "Büyük & Oval (Size: \"lg\", Rounded: \"full\")")</label>
                    <panoptes-select id="sel_size_lg"
                                     size="lg"
                                     rounded="full"
                                     placeholder="@(isEn ? "Select department..." : "Departman seçiniz...")"
                                     options="Yazılım, İnsan Kaynakları, Finans, Pazarlama, Ar-Ge" />
                    <span class="text-[11px] text-slate-400">@(isEn ? "For prominent search and filter bars." : "Öne çıkan arama ve filtreleme alanları için.")</span>
                </div>
            </div>

            <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
            <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mt-6">
                <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                            @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                        </span>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
                    </button>
                </div>
                <div class="panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;!-- Küçük Boyut (Small) --&gt;
&lt;panoptes-select id="sel_size_sm" size="sm" placeholder="Departman seçiniz..." options="Yazılım, İnsan Kaynakları, Finans, Pazarlama, Ar-Ge" /&gt;

&lt;!-- Standart Boyut (Medium - Varsayılan) --&gt;
&lt;panoptes-select id="sel_size_md" size="md" value="Yazılım" placeholder="Departman seçiniz..." options="Yazılım, İnsan Kaynakları, Finans, Pazarlama, Ar-Ge" /&gt;

&lt;!-- Büyük &amp; Oval (Large &amp; Full Rounded) --&gt;
&lt;panoptes-select id="sel_size_lg" size="lg" rounded="full" placeholder="Departman seçiniz..." options="Yazılım, İnsan Kaynakları, Finans, Pazarlama, Ar-Ge" /&gt;</code></pre>
                </div>
            </div>
        </div>

        <!-- 2. Alt Sayfalar Galerisi -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
            <div class="border-b border-slate-100 px-6 py-4 bg-slate-50/50">
                <h2 class="text-base font-bold text-slate-800">@(isEn ? "Select Feature Pages" : "Select Özellik Sayfaları")</h2>
                <p class="text-xs text-slate-500 mt-0.5">@(isEn ? "Dedicated interactive demo pages for each capability." : "Her özellik için bağımsız çalışan detaylı demo sayfaları.")</p>
            </div>
            <div class="p-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <a href="@(isEn ? "/en/Select/RemoteData" : "/Select/RemoteData")" class="group block rounded-xl border border-slate-200 p-4 hover:border-blue-300 hover:bg-blue-50/30 transition">
                    <div class="text-sm font-bold text-slate-800 group-hover:text-blue-600 transition flex items-center justify-between">
                        <span>@(isEn ? "Remote Data" : "Uzak Veri Kaynağı")</span>
                        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                    <p class="text-xs text-slate-500 mt-1">@(isEn ? "Asynchronous REST API binding." : "Asenkron REST API ile veri yükleme.")</p>
                </a>
                <a href="@(isEn ? "/en/Select/Filtering" : "/Select/Filtering")" class="group block rounded-xl border border-slate-200 p-4 hover:border-blue-300 hover:bg-blue-50/30 transition">
                    <div class="text-sm font-bold text-slate-800 group-hover:text-blue-600 transition flex items-center justify-between">
                        <span>@(isEn ? "Filtering (Search)" : "Filtreleme & Arama")</span>
                        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                    <p class="text-xs text-slate-500 mt-1">@(isEn ? "Live text filtering and search modes." : "Anlık metin arama ve filtreleme modları.")</p>
                </a>
                <a href="@(isEn ? "/en/Select/Grouping" : "/Select/Grouping")" class="group block rounded-xl border border-slate-200 p-4 hover:border-blue-300 hover:bg-blue-50/30 transition">
                    <div class="text-sm font-bold text-slate-800 group-hover:text-blue-600 transition flex items-center justify-between">
                        <span>@(isEn ? "Grouping" : "Gruplu Seçenekler")</span>
                        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                    <p class="text-xs text-slate-500 mt-1">@(isEn ? "Category optgroups and headers." : "Kategori başlıkları altında gruplama.")</p>
                </a>
                <a href="@(isEn ? "/en/Select/Templates" : "/Select/Templates")" class="group block rounded-xl border border-slate-200 p-4 hover:border-blue-300 hover:bg-blue-50/30 transition">
                    <div class="text-sm font-bold text-slate-800 group-hover:text-blue-600 transition flex items-center justify-between">
                        <span>@(isEn ? "Templates" : "Özel Şablonlar")</span>
                        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                    <p class="text-xs text-slate-500 mt-1">@(isEn ? "Custom item, header, and footer templates." : "Özel öğe, başlık ve altbilgi şablonları.")</p>
                </a>
                <a href="@(isEn ? "/en/Select/Cascading" : "/Select/Cascading")" class="group block rounded-xl border border-slate-200 p-4 hover:border-blue-300 hover:bg-blue-50/30 transition">
                    <div class="text-sm font-bold text-slate-800 group-hover:text-blue-600 transition flex items-center justify-between">
                        <span>@(isEn ? "Cascading" : "Kademeli Seçim (Cascading)")</span>
                        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                    <p class="text-xs text-slate-500 mt-1">@(isEn ? "Parent-child dependent dropdowns." : "Üst seçime göre alt listenin filtrelenmesi.")</p>
                </a>
                <a href="@(isEn ? "/en/Select/Events" : "/Select/Events")" class="group block rounded-xl border border-slate-200 p-4 hover:border-blue-300 hover:bg-blue-50/30 transition">
                    <div class="text-sm font-bold text-slate-800 group-hover:text-blue-600 transition flex items-center justify-between">
                        <span>@(isEn ? "Events" : "Olaylar (Events)")</span>
                        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                    <p class="text-xs text-slate-500 mt-1">@(isEn ? "Client-side change and open/close events." : "İstemci tarafı change ve open/close olayları.")</p>
                </a>
                <a href="@(isEn ? "/en/Select/Api" : "/Select/Api")" class="group block rounded-xl border border-slate-200 p-4 hover:border-blue-300 hover:bg-blue-50/30 transition">
                    <div class="text-sm font-bold text-slate-800 group-hover:text-blue-600 transition flex items-center justify-between">
                        <span>@(isEn ? "Client API" : "İstemci API Metotları")</span>
                        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                    <p class="text-xs text-slate-500 mt-1">@(isEn ? "Programmatic control methods." : "Programatik JavaScript API fonksiyonları.")</p>
                </a>
            </div>
        </div>
    </div>

    <!-- PANEL 2: API & ATTRIBUTES -->
    <div id="panel-api" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">TagHelper Özellikleri & Parametreleri</h3>
                    <p class="text-xs text-slate-500 mt-0.5">&lt;panoptes-select&gt; bileşeninin desteklediği tüm C# ve HTML nitelikleri.</p>
                </div>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-blue-100 text-blue-800">PanoptesSelectTagHelper</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                            <th class="py-3 px-6">Özellik (Attribute)</th>
                            <th class="py-3 px-4">Tip (C#)</th>
                            <th class="py-3 px-4">Varsayılan</th>
                            <th class="py-3 px-6">Açıklama</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">id</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">Otomatik</td>
                            <td class="py-3 px-6 text-slate-700">Bileşen kimliği.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">value</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">Seçili öğe değeri.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">options</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">Seçenekler listesi veya veri kaynağı.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">placeholder</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">Seçim yapılmadığında gösterilecek yer tutucu.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">filter</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">"contains"</td>
                            <td class="py-3 px-6 text-slate-700">Arama türü: "none", "contains", "startswith".</td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PANEL 3: ACCESSIBILITY (WAI-ARIA & KEYBOARD) -->
    <div id="panel-a11y" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
            <div>
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
                    WAI-ARIA Standartları & Klavye Erişilebilirliği
                </h2>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                    Panoptes Select bileşeni, W3C WAI-ARIA standartlarına uygun olarak ekran okuyucular ve salt klavye navigasyonu için tasarlanmıştır.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">WAI-ARIA Nitelikleri</div>
                    <div class="text-slate-600">
                        Standart <code>role="combobox / listbox"</code> rolünü taşır. Duruma göre <code>aria-disabled</code>, <code>aria-expanded</code>, <code>aria-selected</code> ve <code>aria-label</code> nitelikleri dinamik olarak güncellenir.
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">Odak Yönetimi (Focus Management)</div>
                    <div class="text-slate-600">
                        Sekme sırasını doğal akışında korur (<code>tabIndex="0"</code>). Görsel odak halkaları (focus ring) yüksek kontrastla görünür durumdadır.
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <h3 class="text-sm font-bold text-slate-900 mb-3">Klavye Kısayolları (Keyboard Shortcuts)</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                                <th class="py-2.5 px-4 w-48">Tuş (Key)</th>
                                <th class="py-2.5 px-4">İşlev (Function)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Alt + Aşağı Ok</kbd></td>
