@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Select - Events" : "Select - Olaylar (Events)";
}

<div class="space-y-8">
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/Select" : "/Select")" class="hover:text-blue-600 transition">Select</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">@(isEn ? "Events" : "Olaylar (Events)")</span>
    </nav>

    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "Client-Side Event Handling" : "İstemci Tarafı Olay Dinleyicileri (Events)")</h1>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Capture user interactions including value changes, item selections, panel opening, and panel closing in real time."
                    : "Kullanıcı bileşenle etkileşime girdiğinde tetiklenen olayları (Change, Select, Open, Close) gerçek zamanlı olarak yakalayıp iş mantığınıza bağlayın.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold shrink-0">
                ✓ Production Ready
            </span>
        </div>
    </div>

    <!-- Live Demo Card -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "Interactive Event Logger" : "Tetiklenen Olayların Canlı İzlenmesi")</h2>
            <p class="text-xs text-slate-500 mt-1">@(isEn ? "Open the dropdown, select items, or close it to view emitted events below." : "Açılır listeyi açın, öğe seçin veya kapatın; tetiklenen olaylar anında log panelinde görüntülenir.")</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
            <div class="space-y-4">
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700">@(isEn ? "Target Select Component" : "Etkileşimli Select Bileşeni")</label>
                    <panoptes-select id="sel_events"
                                     value="Python"
                                     placeholder="@(isEn ? "Select programming language..." : "Programlama dili seçin...")"
                                     on-change="onSelectChange"
                                     on-select="onSelectSelect"
                                     on-open="onSelectOpen"
                                     on-close="onSelectClose"
                                     options="C#, Python, TypeScript, Go, Rust, Java, Kotlin, Swift" />
                </div>
                <div class="text-[11px] text-slate-500 bg-slate-50 p-3 rounded-xl border border-slate-200">
                    💡 @(isEn ? "Listeners are attached using `on-change`, `on-select`, `on-open`, and `on-close` tag helper attributes." : "`on-change`, `on-select`, `on-open` ve `on-close` nitelikleri ile fonksiyon adları doğrudan atanabilir.")
                </div>
            </div>

            <!-- Event Log Console -->
            <div class="bg-slate-900 rounded-xl p-4 text-xs font-mono text-slate-300 shadow-sm">
                <div class="flex items-center justify-between pb-2 border-b border-slate-800 mb-2">
                    <span class="font-bold text-slate-400">@(isEn ? "Live Event Log Console" : "Canlı Olay Günlüğü (Event Log)")</span>
                    <button type="button" onclick="document.getElementById('eventLog').innerHTML = ''" class="text-[11px] text-slate-500 hover:text-slate-300 transition cursor-pointer">
                        @(isEn ? "Clear" : "Temizle")
                    </button>
                </div>
                <div id="eventLog" class="h-44 overflow-y-auto space-y-1 text-[11px] text-slate-400">
                    <div class="text-emerald-400">> @(isEn ? "System ready. Awaiting user interaction..." : "Sistem hazır. Olaylar bekleniyor...")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Description Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Lifecycle Hooks" : "Yaşam Döngüsü Kancaları")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "React to open and close animations to trigger conditional data pre-fetching or DOM layout recalibrations."
                    : "Açılma ve kapanma animasyonlarını dinleyerek veri ön yükleme veya sayfa hizalama işlemlerini tetikleyin.")
            </div>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Payload Details" : "Detaylı Olay Yükü")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Access selected model properties, item indices, and previous values directly from the event handler parameters."
                    : "Seçilen nesne modeline, metin/değer özelliklerine ve önceki değerlere olay fonksiyonu parametrelerinden doğrudan erişin.")
            </div>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "Razor TagHelper & JS (C# / .NET 8)" : "Razor TagHelper & JS (C# / .NET 8)")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-select id="sel_events"
                 value="Python"
                 placeholder="Programlama dili seçin..."
                 on-change="onSelectChange"
                 on-select="onSelectSelect"
                 on-open="onSelectOpen"
                 on-close="onSelectClose"
                 options="C#, Python, TypeScript, Go, Rust, Java, Kotlin, Swift" /&gt;

&lt;script&gt;
    function onSelectChange(value) {
        console.log("Yeni değer:", value);
    }
    function onSelectSelect(item) {
        console.log("Seçilen öğe:", item);
    }
    function onSelectOpen() {
        console.log("Panel açıldı");
    }
    function onSelectClose() {
        console.log("Panel kapandı");
    }
&lt;/script&gt;</code></pre>
        </div>
    </div>
</div>

<script>
    function logEvent(msg) {
        const log = document.getElementById('eventLog');
        if (!log) return;
        const time = new Date().toLocaleTimeString();
        const div = document.createElement('div');
        div.innerHTML = `<span class="text-slate-600">[${time}]</span> ${msg}`;
        log.prepend(div);
    }

    function onSelectChange(value) {
        logEvent(`Olay: <strong class="text-blue-400">change</strong> -> Yeni Değer: <span class="text-amber-300">"${value}"</span>`);
    }

    function onSelectSelect(item) {
        logEvent(`Olay: <strong class="text-blue-400">select</strong> -> Seçilen Öğe: <span class="text-amber-300">${JSON.stringify(item)}</span>`);
    }

    function onSelectOpen() {
        logEvent(`Olay: <strong class="text-blue-400">open</strong> -> Açılır liste açıldı.`);
    }

    function onSelectClose() {
        logEvent(`Olay: <strong class="text-blue-400">close</strong> -> Açılır liste kapatıldı.`);
    }
</script>
