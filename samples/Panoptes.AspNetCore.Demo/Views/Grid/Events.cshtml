@using Panoptes.AspNetCore.Demo.Services
@{
    bool isEn = DemoTranslations.IsEnglish(Context);
    string p = DemoTranslations.Prefix(isEn);
    ViewData["Title"] = "Data Grid - Olaylar (Events)";
    ViewData["ActiveTab"] = "Events";
}

<div class="space-y-6">
    <partial name="_GridNav" />

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">İstemci Olayları (Client Events)</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-purple-50 text-purple-700 border border-purple-200">
                    Event Handling & Logging
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                ASP.NET Core Grid Events (<code class="text-purple-600 bg-purple-50 px-1.5 py-0.5 rounded">DataBound</code>, <code class="text-purple-600 bg-purple-50 px-1.5 py-0.5 rounded">Change</code>, <code class="text-purple-600 bg-purple-50 px-1.5 py-0.5 rounded">Page</code>, <code class="text-purple-600 bg-purple-50 px-1.5 py-0.5 rounded">Sort</code>, <code class="text-purple-600 bg-purple-50 px-1.5 py-0.5 rounded">Filter</code>) mimarisiyle; istemci tarafında tetiklenen olayları anlık olarak konsolda takip edin.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold">
                @(isEn ? "✓ Production Ready" : "✓ Tam Sürüm Hazır")
            </span>
        </div>
    </div>

    <!-- Live Grid Preview -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span>⚡ Canlı Grid ile Olayları Tetikleyin</span>
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">Sütun başlığına tıklayarak sıralayın, sayfayı değiştirin veya satır seçerek olay loglarını anlık izleyin.</p>
            </div>
            <span class="text-xs text-slate-400">Tüm kullanıcı etkileşimleri yakalanmaktadır</span>
        </div>

        <panoptes-grid id="grid_events"
                       page-size="6"
                       page-sizes="5,6,10,20"
                       sortable="true"
                       filterable="true"
                       class="shadow-xs">
            <panoptes-grid-datasource url="/api/products"
                                      create-url="/api/products/create"
                                      update-url="/api/products/update"
                                      delete-url="/api/products/delete" />
            <panoptes-grid-columns>
                <panoptes-grid-column selectable="true" width="50px" />
                <panoptes-grid-column field="Id" title="#" width="60px" editable="false" />
                <panoptes-grid-column field="Name" title="@(isEn ? "Product Name" : "Ürün Adı")" width="220px" editor-type="text" />
                <panoptes-grid-column field="Category" title="@(isEn ? "Category" : "Kategori")" width="140px" editor-type="select" editor-options="Elektronik, Giyim, Kitap, Kozmetik, Aksesuar, Spor" />
                <panoptes-grid-column field="Country" title="@(isEn ? "Country" : "Ülke")" width="130px" format="country" />
                <panoptes-grid-column field="Price" title="@(isEn ? "Price" : "Fiyat")" width="130px" format="currency" editor-type="number" />
                <panoptes-grid-column field="Stock" title="@(isEn ? "Stock" : "Stok")" width="90px" editor-type="number" />
                <panoptes-grid-column field="CustomerRating" title="Puan" width="120px" format="stars" />
            </panoptes-grid-columns>
        </panoptes-grid>
    </div>

    <!-- Event Console Logger -->
    <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 shadow-xl text-white">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
            <div class="flex items-center gap-3">
                <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
                <h3 class="font-mono text-sm font-bold text-slate-200">Grid Event Console Log</h3>
                <span id="log-count" class="text-xs font-mono bg-slate-800 text-slate-400 px-2 py-0.5 rounded">0 olay</span>
            </div>
            <button id="btn-clear-log" class="px-3 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium rounded-lg border border-slate-700 transition">
                Konsolu Temizle
            </button>
        </div>

        <div id="events-log-container" class="font-mono text-xs space-y-2 max-h-64 overflow-y-auto pr-2 text-slate-300">
            <div class="text-slate-500 italic">Grid başlatılıyor, olaylar dinleniyor...</div>
        </div>
    </div>

    <!-- Razor & JS Event Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "JavaScript & Razor Events" : "JavaScript & Razor Olayları")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>const grid = document.getElementById('grid_events');

// Veri yüklendiğinde
grid.addEventListener('panoptes:databound', (e) => {
    console.log('Satırlar yüklendi:', e.detail.data);
});

// Satır seçildiğinde
grid.addEventListener('panoptes:change', (e) => {
    console.log('Seçilen ID listesi:', e.detail.selectedKeys);
});

// Sayfa değiştiğinde
grid.addEventListener('panoptes:pagechange', (e) => {
    console.log('Yeni sayfa:', e.detail.page);
});

// Sıralama uygulandığında
grid.addEventListener('panoptes:sort', (e) => {
    console.log('Sıralama kuralları:', e.detail.sorts);
});</code></pre>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const gridEl = document.getElementById('grid_events');
            const logContainer = document.getElementById('events-log-container');
            const logCountEl = document.getElementById('log-count');
            const btnClear = document.getElementById('btn-clear-log');
            let count = 0;

            function logEvent(eventName, badgeClass, message) {
                count++;
                logCountEl.textContent = count + ' olay';
                const time = new Date().toLocaleTimeString('tr-TR', { hour12: false });
                const row = document.createElement('div');
                row.className = 'flex items-start gap-3 py-1 border-b border-slate-800/60 animate-fadeIn';
                row.innerHTML = `
                    <span class="text-slate-500 shrink-0 font-light">[${time}]</span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold ${badgeClass} shrink-0">${eventName}</span>
                    <span class="text-slate-200 truncate">${message}</span>
                `;
                if (logContainer.querySelector('.italic')) {
                    logContainer.innerHTML = '';
                }
                logContainer.insertBefore(row, logContainer.firstChild);
            }

            btnClear.addEventListener('click', function () {
                logContainer.innerHTML = '<div class="text-slate-500 italic">Konsol temizlendi. Yeni olaylar bekleniyor...</div>';
                count = 0;
                logCountEl.textContent = '0 olay';
            });

            if (gridEl) {
                gridEl.addEventListener('panoptes:databound', function (e) {
                    const total = e.detail?.total ?? 0;
                    const items = e.detail?.data?.length ?? 0;
                    logEvent('DataBound', 'bg-blue-600/30 text-blue-300 border border-blue-500/40', `${items} satır yüklendi (Toplam: ${total} kayıt)`);
                });

                gridEl.addEventListener('panoptes:change', function (e) {
                    const keys = e.detail?.selectedKeys || [];
                    logEvent('Change', 'bg-emerald-600/30 text-emerald-300 border border-emerald-500/40', `Seçim güncellendi: ${keys.length} satır seçili (ID: ${keys.slice(0, 3).join(', ')}${keys.length > 3 ? '...' : ''})`);
                });

                gridEl.addEventListener('panoptes:pagechange', function (e) {
                    const page = e.detail?.page || 1;
                    logEvent('Page', 'bg-amber-600/30 text-amber-300 border border-amber-500/40', `Sayfa değiştirildi -> Sayfa ${page}`);
                });

                gridEl.addEventListener('panoptes:sort', function (e) {
                    const sorts = e.detail?.sorts || [];
                    const text = sorts.length > 0 ? sorts.map(s => `${s.field} (${s.dir.toUpperCase()})`).join(', ') : 'Sıralama sıfırlandı';
                    logEvent('Sort', 'bg-purple-600/30 text-purple-300 border border-purple-500/40', `Sıralama uygulandı: ${text}`);
                });

                gridEl.addEventListener('panoptes:filter', function (e) {
                    logEvent('Filter', 'bg-rose-600/30 text-rose-300 border border-rose-500/40', 'Sütun filtresi uygulandı');
                });
            }
        });
    </script>
}
