@using Panoptes.AspNetCore.Demo.Services
@{
    bool isEn = DemoTranslations.IsEnglish(Context);
    string p = DemoTranslations.Prefix(isEn);
    ViewData["Title"] = isEn ? "Hierarchy & Detail Grid - Panoptes Enterprise UI" : "Master-Detail Hiyerarşisi (Nested Grids) - Panoptes Kurumsal UI";
    ViewData["ActiveTab"] = "Hierarchy";
}

<div class="space-y-6">
    <partial name="_GridNav" />

    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(p == "" ? "/" : p)" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(p + "/Grid")" class="hover:text-blue-600 transition">Data Grid</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">@(isEn ? "Hierarchy" : "Hiyerarşi")</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "Master-Detail Hierarchy (Nested Grids)" : "Master-Detail Hiyerarşisi (Nested Grids)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                    @(isEn ? "Data Grid Feature" : "Data Grid Özelliği")
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Ability to open nested detail sub-grids under main table rows. For instance, expanding a product displays its independent stock movement logs."
                    : "Ana tablo satırlarının altında alt detay tabloları (Nested Sub-Grids) açma yeteneği. Örneğin bir ürün satırının altında o ürüne ait stok hareketleri tablosu bağımsız olarak çalışır.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold">
                @(isEn ? "✓ Production Ready" : "✓ Tam Sürüm Hazır")
            </span>
        </div>
    </div>

    <!-- Live Grid Preview -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                <span>@(isEn ? "📦 Live Grid Demo" : "📦 Canlı Grid Demosu")</span>
            </h2>
            <span class="text-xs text-slate-400">@(isEn ? "Data loaded asynchronously via In-Memory Entity Framework" : "Veriler In-Memory Entity Framework üzerinden asenkron yüklenmektedir")</span>
        </div>

        <panoptes-grid id="grid_Hierarchy"
                       page-size="10"
                       sortable="true"
                       class="shadow-xs">
            <panoptes-grid-datasource url="/api/products"
                                      create-url="/api/products/create"
                                      update-url="/api/products/update"
                                      delete-url="/api/products/delete" />
            <panoptes-grid-columns>
                <panoptes-grid-column field="Id" title="#" width="70px" editable="false" />
                <panoptes-grid-column field="Name" title="@(isEn ? "Product Name" : "Ürün Adı")" width="230px" editor-type="text" />
                <panoptes-grid-column field="Category" title="@(isEn ? "Category" : "Kategori")" width="140px" editor-type="select" editor-options="@(isEn ? "Electronics, Clothing, Books, Cosmetics, Accessories, Sports" : "Elektronik, Giyim, Kitap, Kozmetik, Aksesuar, Spor")" />
                <panoptes-grid-column field="Price" title="@(isEn ? "Price" : "Fiyat")" width="130px" format="currency" editor-type="number" />
                <panoptes-grid-column field="Stock" title="@(isEn ? "Stock" : "Stok")" width="100px" editor-type="number" />
                <panoptes-grid-column field="CreatedDate" title="@(isEn ? "Registration Date" : "Kayıt Tarihi")" width="130px" format="date" editor-type="date" />
                <panoptes-grid-column field="Supplier" title="@(isEn ? "Supplier" : "Tedarikçi")" width="160px" editor-type="select" editor-options="@(isEn ? "TechCorp, GlobalTrade, Anadolu Logistics, Innovation Inc., Aegean Dist., Marmara Supply" : "TechCorp, GlobalTrade, Anadolu Lojistik, İnovasyon A.Ş., Ege Dağıtım, Marmara Tedarik")" />
                <panoptes-grid-column field="IsActive" title="@(isEn ? "Status" : "Durum")" width="110px" editor-type="boolean" />
            </panoptes-grid-columns>
            <panoptes-grid-detail-template>
                <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-2">
                    <div class="flex items-center justify-between text-xs font-bold text-slate-700">
                        <span>📦 @(isEn ? "Stock In/Out Logs: #:Name# (Product ID: #:Id#)" : "Stok Giriş / Çıkış Hareketleri (#:Id# - #:Name#)")</span>
                    </div>
                    <panoptes-grid id="subGrid_#:Id#"
                                   page-size="5"
                                   sortable="true"
                                   resizable="true">
                        <panoptes-grid-datasource url="/api/stockmovements?productId=#:Id#" />
                        <panoptes-grid-columns>
                            <panoptes-grid-column field="MovementType" title="@(isEn ? "Movement Type" : "Hareket Türü")" width="120px" />
                            <panoptes-grid-column field="Quantity" title="@(isEn ? "Quantity" : "Miktar")" width="80px" />
                            <panoptes-grid-column field="MovementDate" title="@(isEn ? "Date" : "Tarih")" width="120px" format="date" />
                            <panoptes-grid-column field="Warehouse" title="@(isEn ? "Warehouse" : "Depo")" width="130px" />
                            <panoptes-grid-column field="Description" title="@(isEn ? "Description" : "Açıklama")" />
                        </panoptes-grid-columns>
                    </panoptes-grid>
                </div>
            </panoptes-grid-detail-template>
        </panoptes-grid>
    </div>

    <!-- Feature Highlight Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Lazy Loading Sub-Grids" : "Tembel Yükleme (Lazy Loading)")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Sub-grid rows are fetched from the API only on demand when the user clicks the '+' expander."
                    : "Alt tablo verileri yalnızca kullanıcı '+' butonuna bastığında API'den çekilir.")
            </div>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Independent Paging & Sorting" : "Bağımsız Sayfalama & Sıralama")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Each nested sub-grid manages its own page size, paging buttons, and column sorting."
                    : "Alt grid kendi bağımsız sayfalamasına ve kolon ayarlarına sahiptir.")
            </div>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-grid id="myGrid"
               page-size="10"
               sortable="true"&gt;
    &lt;panoptes-grid-datasource url="/api/products"
                              create-url="/api/products/create"
                              update-url="/api/products/update"
                              delete-url="/api/products/delete" /&gt;
    &lt;panoptes-grid-columns&gt;
        &lt;panoptes-grid-column field="Id" title="#" width="70px" editable="false" /&gt;
        &lt;panoptes-grid-column field="Name" title="@(isEn ? "Product Name" : "Ürün Adı")" width="200px" /&gt;
        &lt;panoptes-grid-column field="Category" title="@(isEn ? "Category" : "Kategori")" width="130px" /&gt;
        &lt;panoptes-grid-column field="Price" title="@(isEn ? "Price" : "Fiyat")" format="currency" /&gt;
        &lt;panoptes-grid-column field="Stock" title="@(isEn ? "Stock" : "Stok")" /&gt;
        &lt;panoptes-grid-column field="IsActive" title="@(isEn ? "Status" : "Durum")" editor-type="boolean" /&gt;
    &lt;/panoptes-grid-columns&gt;

    &lt;panoptes-grid-detail-template&gt;
        &lt;div class="p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-2"&gt;
            &lt;panoptes-grid id="subGrid_#:Id#" page-size="5" sortable="true"&gt;
                &lt;panoptes-grid-datasource url="/api/stockmovements?productId=#:Id#" /&gt;
                &lt;panoptes-grid-columns&gt;
                    &lt;panoptes-grid-column field="MovementType" title="Hareket Türü" width="120px" /&gt;
                    &lt;panoptes-grid-column field="Quantity" title="Miktar" width="80px" /&gt;
                    &lt;panoptes-grid-column field="MovementDate" title="Tarih" width="120px" format="date" /&gt;
                    &lt;panoptes-grid-column field="Warehouse" title="Depo" width="130px" /&gt;
                    &lt;panoptes-grid-column field="Description" title="Açıklama" /&gt;
                &lt;/panoptes-grid-columns&gt;
            &lt;/panoptes-grid&gt;
        &lt;/div&gt;
    &lt;/panoptes-grid-detail-template&gt;
&lt;/panoptes-grid&gt;</code></pre>
        </div>
    </div>
</div>
