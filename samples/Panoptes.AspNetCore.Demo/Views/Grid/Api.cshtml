@using Panoptes.AspNetCore.Demo.Services
@{
    bool isEn = DemoTranslations.IsEnglish(Context);
    string p = DemoTranslations.Prefix(isEn);
    ViewData["Title"] = "Data Grid - İstemci API (Client API)";
    ViewData["ActiveTab"] = "Api";
}

<div class="space-y-6">
    <partial name="_GridNav" />

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">İstemci API (JavaScript API)</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-teal-50 text-teal-700 border border-teal-200">
                    window.Panoptes.Grid.get(id)
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn ? "Drive the grid from JavaScript: paging, refresh, sorting, selection, and export in one line each. Custom toolbar buttons and external workflows plug in here." : "Tabloyu JavaScript ile sürün: sayfalama, yenileme, sıralama, seçim ve dışa aktarma tek satırla. Özel araç çubuğu düğmeleri ve harici iş akışları buradan bağlanır.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold">
                @(isEn ? "✓ Production Ready" : "✓ Tam Sürüm Hazır")
            </span>
        </div>
    </div>

    <!-- API Command Toolbar -->
    <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800 shadow-lg text-white">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Programatik Grid Komutları</div>
        <div class="flex flex-wrap items-center gap-2">
            <button id="api-refresh" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 rounded-xl text-xs font-semibold shadow-sm transition">
                ↻ Yenile (refresh)
            </button>
            <button id="api-page-1" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-xl text-xs font-medium border border-slate-700 transition">
                📄 1. Sayfaya Git
            </button>
            <button id="api-page-2" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-xl text-xs font-medium border border-slate-700 transition">
                📄 2. Sayfaya Git
            </button>
            <button id="api-sort-price" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-xl text-xs font-medium border border-slate-700 transition">
                ↕ Fiyata Göre Sırala
            </button>
            <button id="api-select-all" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-xl text-xs font-medium border border-slate-700 transition">
                ☑ Tümünü Seç
            </button>
            <button id="api-clear-select" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-xl text-xs font-medium border border-slate-700 transition">
                ☐ Seçimi Temizle
            </button>
            <button id="api-get-selected" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 rounded-xl text-xs font-semibold shadow-sm transition">
                🔍 Seçilenleri Oku
            </button>
            <button id="api-export-excel" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-xl text-xs font-medium border border-slate-700 transition">
                📊 Excel'e Aktar
            </button>
            <button id="api-export-pdf" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-xl text-xs font-medium border border-slate-700 transition">
                📕 PDF'e Aktar
            </button>
        </div>
    </div>

    <!-- Live Grid Preview -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <panoptes-grid id="grid_api"
                       page-size="7"
                       page-sizes="5,7,10,20"
                       sortable="true"
                       filterable="true"
                       class="shadow-xs">
            <panoptes-grid-datasource url="/api/products"
                                      create-url="/api/products/create"
                                      update-url="/api/products/update"
                                      delete-url="/api/products/delete" />
            <panoptes-grid-columns>
                <panoptes-grid-column selectable="true" width="50px" />
                <panoptes-grid-column field="Id" title="#" width="60px" editable="false" />
                <panoptes-grid-column field="Name" title="@(isEn ? "Product Name" : "Ürün Adı")" width="220px" editor-type="text" />
                <panoptes-grid-column field="Category" title="@(isEn ? "Category" : "Kategori")" width="140px" editor-type="select" editor-options="Elektronik, Giyim, Kitap, Kozmetik, Aksesuar, Spor" />
                <panoptes-grid-column field="Country" title="@(isEn ? "Country" : "Ülke")" width="130px" format="country" />
                <panoptes-grid-column field="Price" title="@(isEn ? "Price" : "Fiyat")" width="130px" format="currency" editor-type="number" />
                <panoptes-grid-column field="Stock" title="@(isEn ? "Stock" : "Stok")" width="90px" editor-type="number" />
                <panoptes-grid-column field="CustomerRating" title="Puan" width="120px" format="stars" />
                <panoptes-grid-column field="TargetSales" title="Hedef Satış" width="140px" format="sparkline" />
            </panoptes-grid-columns>
        </panoptes-grid>
    </div>

    <!-- API Output Console -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <h3 class="font-bold text-slate-800 text-sm mb-2 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-teal-500"></span>
            API Çıktı & Sonuç Ekranı
        </h3>
        <pre id="api-output" class="bg-slate-900 text-emerald-400 p-4 rounded-xl text-xs font-mono overflow-x-auto min-h-[60px] flex items-center">API komutunu tetiklemek için yukarıdaki butonlara tıklayın...</pre>
    </div>

    <!-- JavaScript API Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-teal-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "JavaScript Client API" : "JavaScript İstemci API")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>// Grid bileşeni referansını alma
const grid = window.Panoptes?.Grid?.get('grid_api');

// Yenileme ve sayfalama
grid.refresh();
grid.setPage(2);

// Sıralama ve seçim
grid.toggleSort('Price');
grid.selectAll(true);
grid.clearSelection();

// Seçili kayıtları alma ve dışa aktarma
const selectedRows = grid.getSelectedRows();
grid.exportToExcel();
grid.exportToPdf();</code></pre>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function getGrid() {
                return window.Panoptes?.Grid?.get('grid_api');
            }

            const output = document.getElementById('api-output');

            function showResult(text, obj = null) {
                if (obj) {
                    output.textContent = `${text}\n` + JSON.stringify(obj, null, 2);
                } else {
                    output.textContent = text;
                }
            }

            document.getElementById('api-refresh')?.addEventListener('click', function () {
                const grid = getGrid();
                if (grid) {
                    grid.refresh();
                    showResult('grid.refresh() çağrıldı -> Veriler sunucudan yeniden yüklendi.');
                }
            });

            document.getElementById('api-page-1')?.addEventListener('click', function () {
                const grid = getGrid();
                if (grid) {
                    grid.setPage(1);
                    showResult('grid.setPage(1) çağrıldı -> 1. sayfaya geçildi.');
                }
            });

            document.getElementById('api-page-2')?.addEventListener('click', function () {
                const grid = getGrid();
                if (grid) {
                    grid.setPage(2);
                    showResult('grid.setPage(2) çağrıldı -> 2. sayfaya geçildi.');
                }
            });

            document.getElementById('api-sort-price')?.addEventListener('click', function () {
                const grid = getGrid();
                if (grid) {
                    grid.toggleSort('Price');
                    showResult('grid.toggleSort("Price") çağrıldı -> Fiyat sütunu sıralandı.');
                }
            });

            document.getElementById('api-select-all')?.addEventListener('click', function () {
                const grid = getGrid();
                if (grid) {
                    grid.selectAll(true);
                    showResult('grid.selectAll(true) çağrıldı -> Tüm sayfadaki kayıtlar seçildi.');
                }
            });

            document.getElementById('api-clear-select')?.addEventListener('click', function () {
                const grid = getGrid();
                if (grid) {
                    grid.clearSelection();
                    showResult('grid.clearSelection() çağrıldı -> Tüm seçimler temizlendi.');
                }
            });

            document.getElementById('api-get-selected')?.addEventListener('click', function () {
                const grid = getGrid();
                if (grid) {
                    const rows = grid.getSelectedRows();
                    const keys = grid.getSelectedKeys();
                    showResult(`grid.getSelectedRows() çağrıldı (${rows.length} kayıt seçili):`, rows);
                }
            });

            document.getElementById('api-export-excel')?.addEventListener('click', function () {
                const grid = getGrid();
                if (grid) {
                    grid.exportToExcel();
                    showResult('grid.exportToExcel() çağrıldı -> OpenXML (.xlsx) tablosu indiriliyor.');
                }
            });

            document.getElementById('api-export-pdf')?.addEventListener('click', function () {
                const grid = getGrid();
                if (grid) {
                    grid.exportToPdf();
                    showResult('grid.exportToPdf() çağrıldı -> PDF rapor çıktısı hazırlanıyor.');
                }
            });
        });
    </script>
}
