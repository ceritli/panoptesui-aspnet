@using Panoptes.AspNetCore.Demo.Services
@{
    bool isEn = DemoTranslations.IsEnglish(Context);
    string p = DemoTranslations.Prefix(isEn);
    ViewData["Title"] = "Data Grid - Arama Paneli (Search Panel)";
    ViewData["ActiveTab"] = "SearchPanel";
}

<div class="space-y-6">
    <partial name="_GridNav" />

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Arama Paneli (Search Panel)</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                    Hızlı Çoklu Sütun Arama
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn ? "One search box scans product name, category, country, and every text column at once. Warehouse staff find the right row without knowing which column to filter." : "Tek arama kutusu ürün adı, kategori, ülke ve tüm metin sütunlarını aynı anda tarar. Depo personeli hangi sütunu filtreleyeceğini bilmeden doğru kaydı bulur.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold">
                @(isEn ? "✓ Production Ready" : "✓ Tam Sürüm Hazır")
            </span>
        </div>
    </div>

    <!-- Live Grid Preview with Search Panel -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span>🔍 Entegre Arama Çubuğu Demosu</span>
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">Toolbar üzerindeki arama alanına herhangi bir kelime yazıp sonuçları canlı olarak filtreleyin.</p>
            </div>
            <span class="text-xs text-indigo-700 font-mono bg-indigo-50 px-2.5 py-1 rounded border border-indigo-200 font-semibold">searchable="true"</span>
        </div>

        <panoptes-grid id="grid_search"
                       page-size="8"
                       page-sizes="5,8,15,30"
                       searchable="true"
                       sortable="true"
                       filterable="true"
                       class="shadow-xs">
            <panoptes-grid-datasource url="/api/products"
                                      create-url="/api/products/create"
                                      update-url="/api/products/update"
                                      delete-url="/api/products/delete" />
            <panoptes-grid-columns>
                <panoptes-grid-column field="Id" title="#" width="60px" editable="false" />
                <panoptes-grid-column field="Name" title="@(isEn ? "Product Name" : "Ürün Adı")" width="220px" editor-type="text" />
                <panoptes-grid-column field="Category" title="@(isEn ? "Category" : "Kategori")" width="140px" editor-type="select" editor-options="Elektronik, Giyim, Kitap, Kozmetik, Aksesuar, Spor" />
                <panoptes-grid-column field="Country" title="Tedarik Ülkesi" width="140px" format="country" />
                <panoptes-grid-column field="Price" title="@(isEn ? "Price" : "Fiyat")" width="130px" format="currency" editor-type="number" />
                <panoptes-grid-column field="Stock" title="@(isEn ? "Stock" : "Stok")" width="90px" editor-type="number" />
                <panoptes-grid-column field="CustomerRating" title="Puan" width="120px" format="stars" />
                <panoptes-grid-column field="TargetSales" title="Hedef Satış" width="140px" format="sparkline" />
            </panoptes-grid-columns>
        </panoptes-grid>
    </div>

    <!-- Features Overview -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold mb-3">1</div>
            <h3 class="font-bold text-slate-800 text-sm mb-1">Debounced Canlı Arama</h3>
            <p class="text-xs text-slate-500 leading-relaxed">@(isEn ? "Typing waits 300ms before sending an optimized server query; no wasted request traffic." : "Yazarken 300ms beklenip optimize sorgu gönderilir; gereksiz istek trafiği engellenir.")</p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold mb-3">2</div>
            <h3 class="font-bold text-slate-800 text-sm mb-1">Çoklu Sütun OR Mantığı</h3>
            <p class="text-xs text-slate-500 leading-relaxed">@(isEn ? "The term scans every text column such as Name, Category, and Country as a contains filter." : "Girilen terim Name, Category ve Country gibi tüm metin sütunlarında contains filtresiyle taranır.")</p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold mb-3">3</div>
            <h3 class="font-bold text-slate-800 text-sm mb-1">Sayfalama ve Sıralama Uyumu</h3>
            <p class="text-xs text-slate-500 leading-relaxed">Arama yapıldığında sayfa numarası otomatik olarak ilk sayfaya döner, mevcut sıralama kuralları korunur.</p>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-grid id="grid_search"
               page-size="8"
               page-sizes="5,8,15,30"
               searchable="true"
               sortable="true"
               filterable="true"&gt;
    &lt;panoptes-grid-datasource url="/api/products"
                              create-url="/api/products/create"
                              update-url="/api/products/update"
                              delete-url="/api/products/delete" /&gt;
    &lt;panoptes-grid-columns&gt;
        &lt;panoptes-grid-column field="Id" title="#" width="60px" editable="false" /&gt;
        &lt;panoptes-grid-column field="Name" title="@(isEn ? "Product Name" : "Ürün Adı")" width="220px" /&gt;
        &lt;panoptes-grid-column field="Category" title="@(isEn ? "Category" : "Kategori")" width="140px" /&gt;
        &lt;panoptes-grid-column field="Country" title="Tedarik Ülkesi" width="140px" format="country" /&gt;
        &lt;panoptes-grid-column field="Price" title="@(isEn ? "Price" : "Fiyat")" width="130px" format="currency" /&gt;
        &lt;panoptes-grid-column field="Stock" title="@(isEn ? "Stock" : "Stok")" width="90px" /&gt;
        &lt;panoptes-grid-column field="CustomerRating" title="Puan" width="120px" format="stars" /&gt;
        &lt;panoptes-grid-column field="TargetSales" title="Hedef Satış" width="140px" format="sparkline" /&gt;
    &lt;/panoptes-grid-columns&gt;
&lt;/panoptes-grid&gt;</code></pre>
        </div>
    </div>
</div>
