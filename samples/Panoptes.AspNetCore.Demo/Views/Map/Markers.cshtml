@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Map - Markers & Popups" : "Map - İşaretçiler ve Bilgi Pencereleri (Markers)";
    ViewData["ActiveTab"] = "Markers";
}

<div class="space-y-6">
    <partial name="_MapNav" />

    <!-- Hero Header -->
    <div class="bg-gradient-to-r from-rose-700 via-pink-600 to-amber-600 rounded-3xl p-8 text-white shadow-xl relative overflow-hidden">
        <div class="relative z-10 max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-semibold text-white mb-4">
                <span>@(isEn ? "Rich Markers & Popups" : "Zengin İşaretçiler & Popuplar")</span>
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight mb-3">@(isEn ? "Markers & Information Popups (Markers & Popups)" : "İşaretçiler ve Bilgi Pencereleri (Markers & Popups)")</h1>
            <p class="text-rose-100 text-sm sm:text-base leading-relaxed">
                @(isEn ? "Branch pins, radar animation, HTML popups; click the list to focus." : "Şube pinleri, radar animasyonu ve HTML bilgi penceresi; listeden tıkla odaklan.")
            </p>
        </div>
        <div class="absolute -right-12 -bottom-12 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
    </div>

    <!-- Quick Location List & Map Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Sol Liste: Mağazalar -->
        <div class="lg:col-span-1 bg-white rounded-3xl border border-slate-200 p-5 shadow-sm space-y-3 flex flex-col justify-between">
            <div>
                <h3 class="text-sm font-bold text-slate-900">@(isEn ? "Stores & Branches" : "Mağaza ve Şubeler")</h3>
                <p class="text-xs text-slate-500 mt-0.5">@(isEn ? "Click on a store from the list to focus on the map immediately." : "Listeden bir şubeye tıklayarak haritada anında odaklanabilirsiniz.")</p>

                <div class="mt-4 space-y-2">
                    <button type="button" onclick="focusStore(41.1118, 29.0205, 14, 'st-ist-1')" class="w-full text-left p-3 rounded-2xl border border-slate-200 hover:border-indigo-400 hover:bg-indigo-50/50 transition flex items-center justify-between cursor-pointer">
                        <div>
                            <span class="text-xs font-bold text-slate-900 block">Maslak Flagship</span>
                            <span class="text-[11px] text-slate-500">@(isEn ? "Istanbul - Maslak" : "İstanbul - Maslak")</span>
                        </div>
                        <span class="w-2.5 h-2.5 rounded-full bg-indigo-600"></span>
                    </button>

                    <button type="button" onclick="focusStore(40.9902, 29.0298, 14, 'st-ist-2')" class="w-full text-left p-3 rounded-2xl border border-slate-200 hover:border-cyan-400 hover:bg-cyan-50/50 transition flex items-center justify-between cursor-pointer">
                        <div>
                            <span class="text-xs font-bold text-slate-900 block">@(isEn ? "Kadikoy Store" : "Kadıköy Mağaza")</span>
                            <span class="text-[11px] text-slate-500">@(isEn ? "Istanbul - Bagdat Ave." : "İstanbul - Bağdat Cad.")</span>
                        </div>
                        <span class="w-2.5 h-2.5 rounded-full bg-cyan-500"></span>
                    </button>

                    <button type="button" onclick="focusStore(39.9132, 32.8085, 14, 'st-ank-1')" class="w-full text-left p-3 rounded-2xl border border-slate-200 hover:border-red-400 hover:bg-red-50/50 transition flex items-center justify-between cursor-pointer">
                        <div>
                            <span class="text-xs font-bold text-slate-900 block">@(isEn ? "Armada Mall" : "Armada AVM")</span>
                            <span class="text-[11px] text-slate-500">@(isEn ? "Ankara - Eskisehir Road" : "Ankara - Eskişehir Yolu")</span>
                        </div>
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
                    </button>

                    <button type="button" onclick="focusStore(38.4362, 27.1422, 14, 'st-izm-1')" class="w-full text-left p-3 rounded-2xl border border-slate-200 hover:border-emerald-400 hover:bg-emerald-50/50 transition flex items-center justify-between cursor-pointer">
                        <div>
                            <span class="text-xs font-bold text-slate-900 block">@(isEn ? "Alsancak Branch" : "Alsancak Şube")</span>
                            <span class="text-[11px] text-slate-500">@(isEn ? "Izmir - Alsancak" : "İzmir - Alsancak")</span>
                        </div>
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    </button>

                    <button type="button" onclick="focusStore(36.8523, 30.7571, 14, 'st-ant-1')" class="w-full text-left p-3 rounded-2xl border border-slate-200 hover:border-amber-400 hover:bg-amber-50/50 transition flex items-center justify-between cursor-pointer">
                        <div>
                            <span class="text-xs font-bold text-slate-900 block">@(isEn ? "Terracity Branch" : "Terracity Şube")</span>
                            <span class="text-[11px] text-slate-500">@(isEn ? "Antalya - Lara" : "Antalya - Lara")</span>
                        </div>
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                    </button>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <button type="button" onclick="window.Panoptes?.Map?.getInstance('markersMap')?.resetView()" class="w-full py-2 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-xs font-semibold text-slate-700 transition cursor-pointer">
                    @(isEn ? "View All Branches" : "Tüm Şubeleri Gör")
                </button>
            </div>
        </div>

        <!-- Sağ Taraf: Harita -->
        <div class="lg:col-span-3 bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
            <panoptes-map id="markersMap" center="39.5, 30.5" zoom="6" min-zoom="4" max-zoom="17" height="520px" controls="true">
                <panoptes-map-layer type="tile" title="OpenStreetMap" 
                                    url-template="https://tile.openstreetmap.org/{z}/{x}/{y}.png" 
                                    attribution="&copy; OpenStreetMap contributors" />

                <!-- Uzaktan Veri Bağlamalı Marker Katmanı -->
                <panoptes-map-layer type="marker" source-url="/Map/GetStoresJson" />
            </panoptes-map>
        </div>
    </div>

    <!-- Code Snippet -->
    <div class="panoptes-code-block rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-map id=&quot;markersMap&quot; center=&quot;39.5, 30.5&quot; zoom=&quot;6&quot; height=&quot;520px&quot;&gt;
    &lt;panoptes-map-layer type=&quot;tile&quot; title=&quot;OpenStreetMap&quot; 
                        url-template=&quot;https://tile.openstreetmap.org/{z}/{x}/{y}.png&quot; 
                        attribution=&quot;&amp;copy; OpenStreetMap contributors&quot; /&gt;

    &lt;!-- Controller'dan JSON çeken işaretçi katmanı --&gt;
    &lt;panoptes-map-layer type=&quot;marker&quot; source-url=&quot;/Map/GetStoresJson&quot; /&gt;
&lt;/panoptes-map&gt;</code></pre>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function focusStore(lat, lng, zoom, storeId) {
        const map = window.Panoptes?.Map?.getInstance('markersMap');
        if (map) {
            map.center(lat, lng, zoom);
        }
    }
</script>
}
