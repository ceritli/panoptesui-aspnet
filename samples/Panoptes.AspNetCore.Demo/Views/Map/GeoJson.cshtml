@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Map - GeoJSON & Vector Layer" : "Map - GeoJSON & Vektör Katmanı";
    ViewData["ActiveTab"] = "GeoJson";
}

<div class="space-y-6">
    <partial name="_MapNav" />

    <!-- Hero Header -->
    <div class="bg-gradient-to-r from-blue-800 via-indigo-700 to-sky-700 rounded-3xl p-8 text-white shadow-xl relative overflow-hidden">
        <div class="relative z-10 max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-semibold text-white mb-4">
                <span>@(isEn ? "Vector Polygons & Real Boundaries" : "Vektörel Poligonlar & Gerçek Sınırlar")</span>
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight mb-3">@(isEn ? "GeoJSON & Vector Layer" : "GeoJSON & Vektör Katmanı")</h1>
            <p class="text-blue-100 text-sm sm:text-base leading-relaxed">
                @(isEn ? "81 province borders with income choropleth; regional reports read on the map." : "81 il sınırı ve gelir renklendirmesi; bölge raporu haritada okunur.")
            </p>
        </div>
        <div class="absolute -right-12 -bottom-12 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
    </div>

    <!-- Katman Değiştirici & Hızlı Bölge Seçici Barı -->
    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex flex-wrap items-center justify-between gap-4">
        <!-- Görünüm Modu: 7 Bölge / 81 İl -->
        <div class="flex items-center gap-2 bg-slate-100 p-1.5 rounded-xl text-xs font-semibold">
            <button type="button" id="btnModeRegions" onclick="setGeoJsonMode('regions')"
                    class="px-4 py-2 rounded-lg bg-white text-indigo-700 shadow-sm transition-all flex items-center gap-2 cursor-pointer">
                <span>@(isEn ? "🇹🇷 7 Geographical Regions" : "🇹🇷 7 Coğrafi Bölge")</span>
            </button>
            <button type="button" id="btnModeCities" onclick="setGeoJsonMode('cities')"
                    class="px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 transition-all flex items-center gap-2 cursor-pointer">
                <span>@(isEn ? "📍 81 Province Boundaries" : "📍 81 İl Sınırları")</span>
            </button>
        </div>

        <!-- Hızlı Bölgeye Odaklanma Butonları -->
        <div class="flex items-center gap-1.5 flex-wrap text-xs">
            <span class="text-slate-400 font-medium mr-1 text-[11px]">@(isEn ? "Focus:" : "Odaklan:")</span>
            <button type="button" onclick="focusRegion('turkey')" class="px-2.5 py-1 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-700 font-medium transition cursor-pointer">@(isEn ? "All Turkey" : "Tüm Türkiye")</button>
            <button type="button" onclick="focusRegion('marmara')" class="px-2.5 py-1 rounded-lg border border-indigo-200 bg-indigo-50/60 hover:bg-indigo-100 text-indigo-700 font-semibold transition cursor-pointer">Marmara</button>
            <button type="button" onclick="focusRegion('ege')" class="px-2.5 py-1 rounded-lg border border-sky-200 bg-sky-50/60 hover:bg-sky-100 text-sky-700 font-semibold transition cursor-pointer">@(isEn ? "Aegean" : "Ege")</button>
            <button type="button" onclick="focusRegion('akdeniz')" class="px-2.5 py-1 rounded-lg border border-amber-200 bg-amber-50/60 hover:bg-amber-100 text-amber-700 font-semibold transition cursor-pointer">@(isEn ? "Mediterranean" : "Akdeniz")</button>
            <button type="button" onclick="focusRegion('ic_anadolu')" class="px-2.5 py-1 rounded-lg border border-teal-200 bg-teal-50/60 hover:bg-teal-100 text-teal-700 font-semibold transition cursor-pointer">@(isEn ? "Central Anatolia" : "İç Anadolu")</button>
            <button type="button" onclick="focusRegion('karadeniz')" class="px-2.5 py-1 rounded-lg border border-emerald-200 bg-emerald-50/60 hover:bg-emerald-100 text-emerald-700 font-semibold transition cursor-pointer">@(isEn ? "Black Sea" : "Karadeniz")</button>
            <button type="button" onclick="focusRegion('dogu_anadolu')" class="px-2.5 py-1 rounded-lg border border-orange-200 bg-orange-50/60 hover:bg-orange-100 text-orange-700 font-semibold transition cursor-pointer">@(isEn ? "Eastern An." : "Doğu Anadolu")</button>
            <button type="button" onclick="focusRegion('guneydogu_anadolu')" class="px-2.5 py-1 rounded-lg border border-rose-200 bg-rose-50/60 hover:bg-rose-100 text-rose-700 font-semibold transition cursor-pointer">@(isEn ? "SE Anatolia" : "G.Doğu")</button>
        </div>
    </div>

    <!-- Live Map & Region Details -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <div class="lg:col-span-3 bg-white rounded-3xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between">
            <panoptes-map id="geoJsonMap" center="39.0, 35.2" zoom="6" min-zoom="5" max-zoom="14" height="560px" controls="true" 
                          on-shape-click="handleRegionClick" on-shape-mouse-enter="handleRegionHover">
                <!-- Açık OpenStreetMap Taban Katmanı -->
                <panoptes-map-layer type="tile" title="OpenStreetMap" 
                                    url-template="https://tile.openstreetmap.org/{z}/{x}/{y}.png" 
                                    attribution="&copy; OpenStreetMap contributors" />

                <!-- Uzaktan Gerçek Türkiye GeoJSON Çeken Şekil Katmanı -->
                <panoptes-map-layer type="shape" source-url="/Map/GetRegionsGeoJson" opacity="0.65" stroke-width="2" stroke-color="#1e1b4b" />
            </panoptes-map>

            <!-- Lejant (Choropleth Açıklaması) -->
            <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-500">
                <div class="flex items-center gap-2">
                    <span class="font-semibold text-slate-700">@(isEn ? "Regions Legend:" : "Bölgeler Lejantı:")</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#4338ca]"></span> Marmara</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#0284c7]"></span> @(isEn ? "Aegean" : "Ege")</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#d97706]"></span> @(isEn ? "Mediterranean" : "Akdeniz")</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#0d9488]"></span> @(isEn ? "Central An." : "İç Anadolu")</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#16a34a]"></span> @(isEn ? "Black Sea" : "Karadeniz")</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#ea580c]"></span> @(isEn ? "East An." : "Doğu An.")</span>
                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-[#e11d48]"></span> @(isEn ? "SE Anatolia" : "G.Doğu")</span>
                </div>
                <div class="text-[11px] text-slate-400">
                    @(isEn ? "Hover or click on region polygon." : "Bölge poligonuna fare ile gelin veya tıklayın.")
                </div>
            </div>
        </div>

        <!-- Bölge İstatistik Paneli -->
        <div class="lg:col-span-1 bg-white rounded-3xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between">
                    <span id="regionBadge" class="text-[11px] font-bold tracking-wider uppercase text-blue-600 bg-blue-50 px-2.5 py-1 rounded-full">@(isEn ? "Region Metrics" : "Bölge Göstergeleri")</span>
                    <span id="citiesCountBadge" class="text-[11px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md">11 @(isEn ? "Provinces" : "İl")</span>
                </div>
                <h4 id="regionTitle" class="text-2xl font-extrabold text-slate-900 mt-3">Marmara Bölgesi</h4>
                <p id="regionSub" class="text-xs text-slate-500 mt-0.5">@(isEn ? "Highest industry, commerce and population density" : "En yüksek sanayi, ticaret ve nüfus yoğunluğu")</p>

                <div class="mt-5 space-y-3">
                    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                        <span class="text-xs text-slate-500 font-medium">@(isEn ? "GDP Share" : "Milli Gelir Payı")</span>
                        <span id="regionGdp" class="text-sm font-bold text-slate-900">%31.2</span>
                    </div>

                    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                        <span class="text-xs text-slate-500 font-medium">@(isEn ? "Region Population" : "Bölge Nüfusu")</span>
                        <span id="regionPop" class="text-sm font-bold text-slate-900">25.4 @(isEn ? "Million" : "Milyon")</span>
                    </div>

                    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                        <span class="text-xs text-slate-500 font-medium">@(isEn ? "Land Area" : "Yüzölçümü")</span>
                        <span id="regionArea" class="text-sm font-bold text-slate-900">67.000 km²</span>
                    </div>

                    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100">
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="text-xs text-slate-500 font-medium">@(isEn ? "Development Score" : "Gelişmişlik Skoru")</span>
                            <span id="regionScore" class="text-xs font-bold text-emerald-600">95 / 100</span>
                        </div>
                        <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                            <div id="regionScoreBar" class="bg-emerald-500 h-full rounded-full transition-all duration-500" style="width: 95%;"></div>
                        </div>
                    </div>

                    <!-- İller Listesi -->
                    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100">
                        <span class="text-xs text-slate-500 font-medium block mb-2">@(isEn ? "Included Provinces" : "Kapsadığı İller")</span>
                        <div id="regionCities" class="flex flex-wrap gap-1 text-[11px] text-slate-700">
                            <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-medium">İstanbul</span>
                            <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-medium">Bursa</span>
                            <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-medium">Kocaeli</span>
                            <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-medium">Balıkesir</span>
                            <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-medium">Tekirdağ</span>
                            <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-medium">Çanakkale</span>
                            <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-medium">Sakarya</span>
                            <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-medium">Edirne</span>
                            <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-medium">Kırklareli</span>
                            <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-medium">Bilecik</span>
                            <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-medium">Yalova</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 text-[11px] text-slate-400">
                @(isEn ? "Click or hover over region boundaries to inspect real-time metrics." : "Haritadaki gerçek bölge sınırlarına tıklayarak veya fare ile üzerine gelerek verileri canlı inceleyebilirsiniz.")
            </div>
        </div>
    </div>

    <!-- Code Snippet -->
    <div class="panoptes-code-block rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-map id=&quot;geoJsonMap&quot; center=&quot;39.0, 35.2&quot; zoom=&quot;6&quot; height=&quot;560px&quot;
              on-shape-click=&quot;handleRegionClick&quot; on-shape-mouse-enter=&quot;handleRegionHover&quot;&gt;
    &lt;!-- Açık OpenStreetMap Taban Katmanı --&gt;
    &lt;panoptes-map-layer type=&quot;tile&quot; title=&quot;OpenStreetMap&quot; 
                        url-template=&quot;https://tile.openstreetmap.org/{z}/{x}/{y}.png&quot; 
                        attribution=&quot;&amp;copy; OpenStreetMap contributors&quot; /&gt;

    &lt;!-- Gerçek Türkiye Bölgeleri GeoJSON Katmanı --&gt;
    &lt;panoptes-map-layer type=&quot;shape&quot; 
                        source-url=&quot;/Map/GetRegionsGeoJson&quot; 
                        opacity=&quot;0.65&quot; 
                        stroke-width=&quot;2&quot; /&gt;
&lt;/panoptes-map&gt;</code></pre>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const isEnGeo = @(isEn ? "true" : "false");

    const regionCenters = {
        'turkey': { lat: 39.0, lng: 35.2, zoom: 6 },
        'marmara': { lat: 40.8, lng: 28.5, zoom: 7 },
        'ege': { lat: 38.3, lng: 28.2, zoom: 7 },
        'akdeniz': { lat: 37.0, lng: 33.5, zoom: 7 },
        'ic_anadolu': { lat: 39.3, lng: 33.2, zoom: 7 },
        'karadeniz': { lat: 41.2, lng: 36.5, zoom: 7 },
        'dogu_anadolu': { lat: 39.3, lng: 41.5, zoom: 7 },
        'guneydogu_anadolu': { lat: 37.8, lng: 39.5, zoom: 7 }
    };

    function updateRegionPanel(props) {
        if (!props) return;
        
        const titleEl = document.getElementById('regionTitle');
        const subEl = document.getElementById('regionSub');
        const gdpEl = document.getElementById('regionGdp');
        const popEl = document.getElementById('regionPop');
        const areaEl = document.getElementById('regionArea');
        const scoreEl = document.getElementById('regionScore');
        const scoreBarEl = document.getElementById('regionScoreBar');
        const badgeEl = document.getElementById('regionBadge');
        const countBadgeEl = document.getElementById('citiesCountBadge');
        const citiesListEl = document.getElementById('regionCities');

        const isCity = !props.gdpShare && props.region;

        if (isCity) {
            titleEl.textContent = props.name || (isEnGeo ? 'Province' : 'İl');
            subEl.textContent = (props.region || '') + (isEnGeo ? ' Province' : ' İli');
            badgeEl.textContent = isEnGeo ? 'Province Detail' : 'İl Detayı';
            countBadgeEl.textContent = isEnGeo ? 'Province' : 'İl';
            gdpEl.textContent = '-';
            popEl.textContent = props.population || '-';
            areaEl.textContent = '-';
            scoreEl.textContent = isEnGeo ? 'Active' : 'Aktif';
            scoreBarEl.style.width = '100%';
            citiesListEl.innerHTML = `<span class="px-2.5 py-1 rounded-md bg-indigo-50 text-indigo-700 font-semibold border border-indigo-200">${props.name}</span>`;
            return;
        }

        titleEl.textContent = props.name || (isEnGeo ? 'Region' : 'Bölge');
        subEl.textContent = props.name + (isEnGeo ? ' Official Boundaries & Metrics' : ' Resmi Sınır ve Göstergeleri');
        badgeEl.textContent = isEnGeo ? 'Region Metrics' : 'Bölge Göstergeleri';
        countBadgeEl.textContent = (props.citiesCount || 0) + (isEnGeo ? ' Provinces' : ' İl');
        gdpEl.textContent = props.gdpShare || '-';
        popEl.textContent = props.population || '-';
        areaEl.textContent = props.area || '-';
        
        const score = props.score || 0;
        scoreEl.textContent = score + ' / 100';
        scoreBarEl.style.width = score + '%';

        if (props.cities) {
            const cityArr = props.cities.split(',').map(c => c.trim());
            citiesListEl.innerHTML = cityArr.map(c => 
                `<span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-medium">${c}</span>`
            ).join('');
        }
    }

    function handleRegionClick(e) {
        if (e.properties) updateRegionPanel(e.properties);
    }

    function handleRegionHover(e) {
        if (e.properties) updateRegionPanel(e.properties);
    }

    function setGeoJsonMode(mode) {
        const mapEl = document.getElementById('geoJsonMap');
        if (!mapEl || !mapEl.panoptesMap) return;

        const btnRegions = document.getElementById('btnModeRegions');
        const btnCities = document.getElementById('btnModeCities');

        if (mode === 'regions') {
            btnRegions.className = "px-4 py-2 rounded-lg bg-white text-indigo-700 shadow-sm transition-all flex items-center gap-2 font-semibold cursor-pointer";
            btnCities.className = "px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 transition-all flex items-center gap-2 cursor-pointer";
            mapEl.panoptesMap.loadGeoJson('/Map/GetRegionsGeoJson', {
                opacity: 0.65,
                strokeWidth: 2,
                strokeColor: '#1e1b4b'
            });
        } else {
            btnCities.className = "px-4 py-2 rounded-lg bg-white text-indigo-700 shadow-sm transition-all flex items-center gap-2 font-semibold cursor-pointer";
            btnRegions.className = "px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 transition-all flex items-center gap-2 cursor-pointer";
            mapEl.panoptesMap.loadGeoJson('/Map/GetCitiesGeoJson', {
                opacity: 0.6,
                strokeWidth: 1.5,
                strokeColor: '#334155'
            });
        }
    }

    function focusRegion(regionId) {
        const target = regionCenters[regionId];
        if (!target) return;

        const mapEl = document.getElementById('geoJsonMap');
        if (mapEl && mapEl.panoptesMap) {
            mapEl.panoptesMap.flyTo(target.lat, target.lng, target.zoom);
        }
    }
</script>
}
