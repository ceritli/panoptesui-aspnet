</div>

@section Scripts {
    <script src="~/panoptes/panoptes-gauge.js" asp-append-version="true"></script>
    <script>
        function logGauge(msg) {
            var logEl = document.getElementById('gaugeEventLog');
            if (!logEl) return;
            var time = new Date().toLocaleTimeString('tr-TR');
            var line = document.createElement('div');
            line.innerHTML = '<span class="text-slate-500">[' + time + ']</span> ' + msg;
            logEl.appendChild(line);
            logEl.scrollTop = logEl.scrollHeight;
        }

        function setGaugeValue(val) {
            var radial = window.panoptesGauge.getInstance('radialCpuGauge');
            var arc = window.panoptesGauge.getInstance('arcSalesGauge');
            var linear = window.panoptesGauge.getInstance('linearTempGauge');

            if (radial) radial.setValue(val);
            if (arc) arc.setValue(val);
            if (linear) linear.setValue(Math.min(80, Math.round(val * 0.8)));

            logGauge('<span class="text-emerald-400 font-bold">Yeni Değer:</span> Göstergeler ' + val + ' değerine güncellendi.');
        }

        var simInterval = null;
        function startTelemetrySimulation() {
            var btn = document.getElementById('btnSimulate');
            if (simInterval) {
                clearInterval(simInterval);
                simInterval = null;
                btn.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> <span>Canlı Telemetri Simülasyonu Başlat</span>';
                btn.classList.remove('bg-rose-600', 'hover:bg-rose-700');
                btn.classList.add('bg-blue-600', 'hover:bg-blue-700');
                logGauge('<span class="text-amber-400">Simülasyon durduruldu.</span>');
            } else {
                btn.innerHTML = 'Simülasyonu Durdur';
                btn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
                btn.classList.add('bg-rose-600', 'hover:bg-rose-700');
                logGauge('<span class="text-blue-400 font-bold">Simülasyon Başlatıldı:</span> Her 1.5 saniyede telemetri verisi güncelleniyor.');

                simInterval = setInterval(function () {
                    var randVal = Math.round(20 + Math.random() * 75);
                    setGaugeValue(randVal);
                }, 1500);
            }
        }
    </script>
}
