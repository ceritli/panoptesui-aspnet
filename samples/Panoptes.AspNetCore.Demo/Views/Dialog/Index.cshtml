                                <td class="p-3">@(isEn ? "Dialog title." : "Diyalog başlığı.")</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-mono text-blue-600 pl-6">type</td>
                                <td class="p-3 font-mono text-slate-500">string</td>
                                <td class="p-3 font-mono">"alert"</td>
                                <td class="p-3">@(isEn ? "Dialog type: \"alert\", \"confirm\", \"prompt\"." : "Diyalog türü: \"alert\", \"confirm\", \"prompt\".")</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-mono text-blue-600 pl-6">ok-text</td>
                                <td class="p-3 font-mono text-slate-500">string</td>
                                <td class="p-3 font-mono">"Tamam"</td>
                                <td class="p-3">@(isEn ? "Confirmation button text." : "Onay butonu metni.")</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-mono text-blue-600 pl-6">cancel-text</td>
                                <td class="p-3 font-mono text-slate-500">string</td>
                                <td class="p-3 font-mono">"İptal"</td>
                                <td class="p-3">@(isEn ? "Cancellation button text." : "İptal butonu metni.")</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-mono text-blue-600 pl-6">width</td>
                                <td class="p-3 font-mono text-slate-500">string</td>
                                <td class="p-3 font-mono">"440px"</td>
                                <td class="p-3">@(isEn ? "Maximum dialog modal width." : "Maksimum modal genişliği.")</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-mono text-blue-600 pl-6">closable</td>
                                <td class="p-3 font-mono text-slate-500">bool</td>
                                <td class="p-3 font-mono">true</td>
                                <td class="p-3">@(isEn ? "Allows close button and click-outside dismissal." : "Sağ üst kapatma butonu ve dışarı tıklayarak kapatma izni.")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


    </div>

    <!-- PANEL 2: API & ATTRIBUTES -->
    <div id="panel-api" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">@(isEn ? "TagHelper Properties & Parameters" : "TagHelper Özellikleri & Parametreleri")</h3>
                    <p class="text-xs text-slate-500 mt-0.5">&lt;panoptes-dialog&gt; @(isEn ? "all supported C# and HTML attributes." : "bileşeninin desteklediği tüm C# ve HTML nitelikleri.")</p>
                </div>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-blue-100 text-blue-800">PanoptesDialogTagHelper</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                            <th class="py-3 px-6">@(isEn ? "Attribute" : "Özellik (Attribute)")</th>
                            <th class="py-3 px-4">@(isEn ? "Type (C#)" : "Tip (C#)")</th>
                            <th class="py-3 px-4">@(isEn ? "Default" : "Varsayılan")</th>
                            <th class="py-3 px-6">@(isEn ? "Description" : "Açıklama")</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">id</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">@(isEn ? "Automatic" : "Otomatik")</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Component identifier." : "Bileşen kimliği.")</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">title</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Dialog title." : "Diyalog başlığı.")</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">width</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">"420px"</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Dialog modal width." : "Pencere genişliği.")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PANEL 3: ACCESSIBILITY (WAI-ARIA & KEYBOARD) -->
    <div id="panel-a11y" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
            <div>
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
                    @(isEn ? "WAI-ARIA Standards & Keyboard Accessibility" : "WAI-ARIA Standartları & Klavye Erişilebilirliği")
                </h2>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                    @(isEn ? "Panoptes Dialog is designed for screen readers and keyboard-only users in compliance with W3C WAI-ARIA modal guidelines." : "Panoptes Dialog bileşeni, W3C WAI-ARIA standartlarına uygun olarak ekran okuyucular ve salt klavye navigasyonu için tasarlanmıştır.")
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">@(isEn ? "WAI-ARIA Attributes" : "WAI-ARIA Nitelikleri")</div>
                    <div class="text-slate-600">
                        @(isEn ? "Carries standard role=\"dialog\" (modal). Attributes aria-modal=\"true\", aria-labelledby and aria-describedby are maintained dynamically." : "Standart role=\"dialog (modal)\" rolünü taşır. Duruma göre aria-disabled, aria-expanded, aria-selected ve aria-label nitelikleri dinamik olarak güncellenir.")
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">@(isEn ? "Focus Management" : "Odak Yönetimi (Focus Management)")</div>
                    <div class="text-slate-600">
                        @(isEn ? "Maintains focus trap inside modal dialog, auto-focuses primary action button upon opening and restores focus to triggering element upon close." : "Sekme sırasını doğal akışında korur (tabIndex=\"0\"). Görsel odak halkaları (focus ring) yüksek kontrastla görünür durumdadır.")
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <h3 class="text-sm font-bold text-slate-900 mb-3">@(isEn ? "Keyboard Shortcuts" : "Klavye Kısayolları (Keyboard Shortcuts)")</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                                <th class="py-2.5 px-4 w-48">@(isEn ? "Key" : "Tuş (Key)")</th>
                                <th class="py-2.5 px-4">@(isEn ? "Function" : "İşlev (Function)")</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Escape</kbd></td>
                                <td class="py-2.5 px-4">@(isEn ? "Cancels and closes the active dialog." : "Diyaloğu iptal eder / kapatır.")</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Enter</kbd></td>
                                <td class="py-2.5 px-4">@(isEn ? "Confirms default primary action." : "Varsayılan birincil eylemi onaylar.")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/panoptes/panoptes-dialog.js"></script>
    <script>
        const isEnDialog = @(isEn ? "true" : "false");

        function showAlertDemo() {
            Panoptes.alert(
                isEnDialog ? 'System updates have completed successfully. All services are active.' : 'Sistem güncellemeleri başarıyla tamamlandı. Tüm servisler aktif durumda.',
                isEnDialog ? 'System Update' : 'Sistem Güncellemesi'
            );
        }

        async function showStandardConfirm() {
            const confirmed = await Panoptes.confirm(
                isEnDialog ? 'Do you want to save all changes?' : 'Değişiklikleri kaydetmek istiyor musunuz?',
                isEnDialog ? 'Save Confirmation' : 'Kayıt Onayı',
                { okText: isEnDialog ? 'Save' : 'Kaydet', cancelText: isEnDialog ? 'Cancel' : 'Vazgeç' }
            );

            const badge = document.getElementById('confirmResultBadge');
            if (badge) {
                if (isEnDialog) {
                    badge.textContent = 'Result: ' + (confirmed ? 'Confirmed (true)' : 'Cancelled (false)');
                } else {
                    badge.textContent = 'Sonuç: ' + (confirmed ? 'Onaylandı (true)' : 'Vazgeçildi (false)');
                }
                badge.className = 'text-xs font-mono px-3 py-1.5 rounded-lg border ' + (confirmed ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-rose-50 text-rose-700 border-rose-200');
            }
        }

        async function showDangerConfirm() {
            const confirmed = await Panoptes.confirm(
                isEnDialog ? 'The selected 3 records will be permanently deleted. This cannot be undone!' : 'Seçilen 3 adet kayıt kalıcı olarak silinecektir. Bu eylem geri alınamaz!',
                isEnDialog ? 'Delete Records' : 'Kayıtları Sil',
                { danger: true, okText: isEnDialog ? 'Yes, Delete Permanently' : 'Evet, Kalıcı Olarak Sil', cancelText: isEnDialog ? 'Cancel' : 'İptal' }
            );

            const badge = document.getElementById('confirmResultBadge');
            if (badge) {
                if (isEnDialog) {
                    badge.textContent = 'Result: ' + (confirmed ? 'Deletion Confirmed (true)' : 'Deletion Cancelled (false)');
                } else {
                    badge.textContent = 'Sonuç: ' + (confirmed ? 'Silme Onaylandı (true)' : 'Silme İptal Edildi (false)');
                }
                badge.className = 'text-xs font-mono px-3 py-1.5 rounded-lg border ' + (confirmed ? 'bg-rose-50 text-rose-700 border-rose-200' : 'bg-slate-100 text-slate-600 border-slate-200');
            }
        }

        async function showPromptDemo() {
            const result = await Panoptes.prompt(
                isEnDialog ? 'Enter the name of the new project folder:' : 'Yeni oluşturulacak proje klasörünün adını giriniz:',
                'Finance-Reports-2026',
                isEnDialog ? 'New Folder' : 'Yeni Klasör'
            );

            const badge = document.getElementById('promptResultBadge');
            if (badge) {
                if (result !== null) {
                    badge.textContent = isEnDialog ? `Entered Value: "${result}"` : `Girilen Değer: "${result}"`;
                    badge.className = 'text-xs font-mono px-3 py-1.5 rounded-lg border bg-blue-50 text-blue-700 border-blue-200';
                } else {
                    badge.textContent = isEnDialog ? 'Input Cancelled' : 'Giriş İptal Edildi';
                    badge.className = 'text-xs font-mono px-3 py-1.5 rounded-lg border bg-slate-100 text-slate-600 border-slate-200';
                }
            }
        }
    </script>
}
