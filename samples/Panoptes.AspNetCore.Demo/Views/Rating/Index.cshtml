<script>
function logRating(msg) {
            var logEl = document.getElementById('ratingEventLog');
            if (!logEl) return;
            var time = new Date().toLocaleTimeString('tr-TR');
            var line = document.createElement('div');
            line.innerHTML = '<span class="text-slate-500">[' + time + ']</span> ' + msg;
            logEl.appendChild(line);
            logEl.scrollTop = logEl.scrollHeight;
        }

        function clearRatingLogs() {
            var logEl = document.getElementById('ratingEventLog');
            if (logEl) logEl.innerHTML = '<div class="text-slate-500">// Günlük temizlendi. Yeni olaylar bekleniyor...</div>';
        }

        function handleRatingChange(val) {
            logRating('<span class="text-amber-400 font-bold">Puan Değişti:</span> Seçilen Değer: ' + val);
        }

        function setDemoRating(score) {
            var rating = window.panoptesRating.getInstance('productRatingDemo');
            if (rating) {
                rating.setValue(score);
            }
        }
</script>
