<script>
function setSliderVal(v) {
            Panoptes.Slider.setValue('apiSliderDemo', v);
            logSliderEvent(`Panoptes.Slider.setValue('apiSliderDemo', ${v}) çağrıldı.`);
        }

        function getSliderVal() {
            const v = Panoptes.Slider.getValue('apiSliderDemo');
            logSliderEvent(`Panoptes.Slider.getValue('apiSliderDemo') -> Değer: ${v}`);
            alert(`Mevcut Slider Değeri: ${v}`);
        }

        function onBudgetRangeSlide(val) {
            if (Array.isArray(val)) {
                const badge = document.getElementById('budgetRangeBadge');
                if (badge) {
                    badge.textContent = `${Number(val[0]).toLocaleString('tr-TR')} ₺ - ${Number(val[1]).toLocaleString('tr-TR')} ₺`;
                }
            }
        }

        function onApiSliderSlide(val) {
            logSliderEvent(`[on-slide]: Canlı Sürükleme Değeri: ${val}`);
        }

        function onApiSliderChange(val) {
            logSliderEvent(`[on-change]: Nihai Bırakılan Değer: ${val}`);
        }

        function logSliderEvent(msg) {
            const logBox = document.getElementById('sliderEventLog');
            if (!logBox) return;
            const time = new Date().toLocaleTimeString('tr-TR');
            const row = document.createElement('div');
            row.innerHTML = `<span class="text-purple-400 font-mono">[${time}]</span> <span class="text-slate-200">${msg}</span>`;
            logBox.appendChild(row);
            logBox.scrollTop = logBox.scrollHeight;
        }

        function clearSliderLog() {
            const logBox = document.getElementById('sliderEventLog');
            if (logBox) logBox.innerHTML = '<div class="text-slate-500">// Günlük temizlendi...</div>';
        }
</script>

