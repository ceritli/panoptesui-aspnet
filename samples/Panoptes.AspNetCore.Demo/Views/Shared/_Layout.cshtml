    <script>
        // UI theme switcher: swaps Bootstrap 5 + panoptes-bootstrap.css in/out, choice persists.
        function setPanoptesTheme(mode) {
            var bs = document.getElementById("bootstrapCss");
            var th = document.getElementById("panoptesThemeCss");
            var isBs = mode === "bootstrap";
            if (bs) { if (isBs) bs.removeAttribute("disabled"); else bs.setAttribute("disabled", ""); }
            if (th) th.href = isBs ? th.getAttribute("data-bootstrap-href") : th.getAttribute("data-tailwind-href");
            try { localStorage.setItem("panoptes-theme", isBs ? "bootstrap" : "tailwind"); } catch (e) { /* ignore */ }
            paintThemeButtons(isBs ? "bootstrap" : "tailwind");
        }
        function paintThemeButtons(mode) {
            var tw = document.getElementById("themeBtnTailwind");
            var bts = document.getElementById("themeBtnBootstrap");
            var on = ["bg-slate-900", "text-white"], off = ["bg-white", "text-slate-600"];
            [[tw, mode === "tailwind"], [bts, mode === "bootstrap"]].forEach(function (pair) {
                if (!pair[0]) return;
                pair[0].classList.remove.apply(pair[0].classList, pair[1] ? off : on);
                pair[0].classList.add.apply(pair[0].classList, pair[1] ? on : off);
            });
        }
        document.addEventListener('DOMContentLoaded', () => {
            // Tema butonlarının ilk boyası (kayıtlı seçime göre)
            try { paintThemeButtons(localStorage.getItem("panoptes-theme") === "bootstrap" ? "bootstrap" : "tailwind"); } catch (e) { paintThemeButtons("tailwind"); }
            // Aktif menü öğesini görünür alana kaydır
            const activeLink = document.querySelector('.sidebar-link.active');
            if (activeLink) {
                activeLink.scrollIntoView({ block: 'nearest' });
            }

            // Sidebar search filter & hide empty groups
            const searchInput = document.getElementById('sidebarSearch');
            const emptyMsg = document.getElementById('sidebarEmpty');
            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    const q = e.target.value.toLowerCase().trim();
                    let totalVisible = 0;
                    document.querySelectorAll('.sidebar-group').forEach(group => {
                        let visibleCount = 0;
                        group.querySelectorAll('.sidebar-item').forEach(row => {
                            const link = row.querySelector('.sidebar-link');
                            const match = !q || link.textContent.toLowerCase().includes(q);
                            row.style.display = match ? '' : 'none';
                            if (match) visibleCount++;
                        });
                        totalVisible += visibleCount;
                        group.style.display = (visibleCount > 0 || !q) ? '' : 'none';
                        if (q) {
                            group.open = visibleCount > 0;
                        } else {
                            group.open = group.dataset.open === '1';
                        }
                    });
                    if (emptyMsg) emptyMsg.classList.toggle('hidden', !q || totalVisible > 0);
                });
            }
        });

        // ===== Panoptes Global Light Code Viewer Standard =====
        function escapeHtml(str) {
            return (str || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function tokenizePanoptesLine(line) {
            if (!line) return '';
            let s = line;
            let out = '';
            let i = 0;
            while (i < s.length) {
                // Comments
                const commentMatch = s.slice(i).match(/^(\/\/.*|\/\*[\s\S]*?\*\/|<!--.*?-->)/);
                if (commentMatch) {
                    out += '<span class="text-slate-400 italic">' + escapeHtml(commentMatch[0]) + '</span>';
                    i += commentMatch[0].length;
                    continue;
                }
                // Strings
                const strMatch = s.slice(i).match(/^("[^"]*"|'[^']*'|`[^`]*`)/);
                if (strMatch) {
                    out += '<span class="text-sky-700 font-medium">' + escapeHtml(strMatch[0]) + '</span>';
                    i += strMatch[0].length;
                    continue;
                }
                // Tag Open
                const tagMatch = s.slice(i).match(/^<\/?[a-zA-Z0-9_\-:]+/);
                if (tagMatch) {
                    out += '<span class="text-emerald-600 font-semibold">' + escapeHtml(tagMatch[0]) + '</span>';
                    i += tagMatch[0].length;
                    continue;
                }
                // Tag Close
                const closeMatch = s.slice(i).match(/^\/?>/);
                if (closeMatch) {
                    out += '<span class="text-emerald-600 font-semibold">' + escapeHtml(closeMatch[0]) + '</span>';
                    i += closeMatch[0].length;
                    continue;
                }
                // Attribute name followed by =
                const attrMatch = s.slice(i).match(/^([a-zA-Z0-9_\-:]+)(?=\=)/);
                if (attrMatch) {
                    out += '<span class="text-purple-600">' + escapeHtml(attrMatch[0]) + '</span>';
                    i += attrMatch[0].length;
                    continue;
                }
                // Keywords
                const kwMatch = s.slice(i).match(/^(var|let|const|function|return|if|else|public|private|class|void|string|int|bool|true|false|new|import|export)\b/);
                if (kwMatch) {
                    out += '<span class="text-rose-600 font-semibold">' + escapeHtml(kwMatch[0]) + '</span>';
                    i += kwMatch[0].length;
                    continue;
                }
                out += escapeHtml(s[i]);
                i++;
            }
            return out;
        }

        function formatPanoptesCodeBlocks() {
            const blocks = document.querySelectorAll('.panoptes-code-snippet, .panoptes-code-viewer');
            blocks.forEach(block => {
                if (block.dataset.panoptesFormatted === '1') return;

                const codeEl = block.querySelector('code') || block.querySelector('pre');
                if (!codeEl) return;

                // Extract raw text before clearing (textContent works even when details is closed)
                let rawCode = codeEl.textContent || codeEl.innerText || '';
                rawCode = rawCode.replace(/^\s*\n/, '').replace(/\s*$/, '');
                if (!rawCode) return;

                block.dataset.panoptesFormatted = '1';
                block.dataset.rawCode = rawCode;

                // Clean dark background classes
                block.classList.remove('bg-slate-900', 'text-slate-200', 'border-slate-800', 'bg-[#0f172a]', 'shadow-inner');
                block.classList.add('bg-white', 'text-slate-800', 'border', 'border-slate-200', 'rounded-xl', 'shadow-xs', 'overflow-hidden');

                // Determine badge text
                const isTagHelper = rawCode.includes('<panoptes-') || rawCode.includes('<Panoptes');
                const badgeLabel = isTagHelper ? 'Razor TagHelper' : 'C# / HTML';
                const copyBtnLabel = '@(isEn ? "Copy Code" : "Kodu Kopyala")';

                const lines = rawCode.split('\n');
                let lineNumsHtml = '';
                let codeLinesHtml = '';

                lines.forEach((line, idx) => {
                    lineNumsHtml += `<div class="select-none leading-relaxed">${idx + 1}</div>`;
                    const highlighted = tokenizePanoptesLine(line);
                    codeLinesHtml += `<div class="leading-relaxed whitespace-pre">${highlighted || '&nbsp;'}</div>`;
                });

                block.innerHTML = `
                    <div class="flex justify-between items-center px-4 py-2 bg-slate-50/80 border-b border-slate-200 text-xs text-slate-500 font-sans">
                        <span class="font-semibold text-slate-700 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                            <span>${badgeLabel}</span>
                        </span>
                        <button type="button" 
                                onclick="copyCode(this)" 
                                class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1 border border-slate-200 transition shadow-2xs cursor-pointer">
                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            <span>${copyBtnLabel}</span>
                        </button>
                    </div>
                    <div class="p-4 font-mono text-xs flex overflow-x-auto bg-white">
                        <div class="text-right pr-4 border-r border-slate-200 text-slate-400 select-none mr-4 font-mono text-xs">
                            ${lineNumsHtml}
                        </div>
                        <div class="flex-1 font-mono text-xs text-slate-800">
                            ${codeLinesHtml}
                        </div>
                    </div>
                `;
            });
        }

        // Global Copy Code Helper (Copies clean code without line numbers)
        function copyCode(btn, codeId) {
            let text = '';
            if (codeId) {
                const el = document.getElementById(codeId);
                if (el) text = el.getAttribute('data-raw-code') || el.innerText;
            }
            if (!text) {
                const container = btn.closest('.panoptes-code-snippet, .panoptes-code-viewer') || btn.parentElement;
                if (container) {
                    text = container.getAttribute('data-raw-code');
                    if (!text) {
                        const codeEl = container.querySelector('code');
                        if (codeEl) text = codeEl.getAttribute('data-raw-code') || codeEl.innerText;
                    }
                }
            }
            if (!text) return;

            navigator.clipboard.writeText(text.trim()).then(() => {
                const orig = btn.innerHTML;
                const copiedLabel = '@(isEn ? "✓ Copied!" : "✓ Kopyalandı!")';
                btn.innerHTML = `<span class="text-emerald-600 font-bold flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>${copiedLabel}</span>`;
                btn.classList.add('border-emerald-300', 'bg-emerald-50');
                setTimeout(() => {
                    btn.innerHTML = orig;
                    btn.classList.remove('border-emerald-300', 'bg-emerald-50');
                }, 2000);
            });
        }

        window.formatPanoptesCodeBlocks = formatPanoptesCodeBlocks;
        document.addEventListener('DOMContentLoaded', formatPanoptesCodeBlocks);
        document.addEventListener('toggle', (e) => {
            setTimeout(formatPanoptesCodeBlocks, 20);
        }, true);
        document.addEventListener('click', (e) => {
            if (e.target.closest('summary')) {
                setTimeout(formatPanoptesCodeBlocks, 50);
            }
        });
    </script>

