@using Panoptes.Core.Localization
@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    var langPrefix = DemoTranslations.Prefix(isEn);
    var groups = DemoTranslations.GetNavGroups(isEn);

    var rawPath = (Context.Request.Path.Value ?? "/").TrimEnd('/').ToLowerInvariant();
    if (rawPath == "") { rawPath = "/"; }
    var path = rawPath;
    if (isEn && !path.StartsWith("/en"))
    {
        path = "/en" + (path == "/" ? "" : path);
    }

    DemoNavItem? active = null;
    foreach (var g in groups)
    {
        foreach (var it in g.Items)
        {
            if (string.Equals(it.Href, path, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(it.Href, rawPath, StringComparison.OrdinalIgnoreCase))
            {
                active = it;
            }
        }
    }
    if (active == null)
    {
        var bestLen = 0;
        foreach (var g in groups)
        {
            foreach (var it in g.Items)
            {
                var h = it.Href.ToLowerInvariant();
                if ((path.StartsWith(h + "/") || rawPath.StartsWith(h + "/")) && h.Length > bestLen)
                {
                    bestLen = h.Length;
                    active = it;
                }
            }
        }
    }
    var totalComponents = groups.Sum(g => g.Items.Count(i => !i.Sub));
    var currentLocale = PanoptesLocales.Get(isEn ? "en-US" : System.Globalization.CultureInfo.CurrentUICulture.Name);
}
<!DOCTYPE html>
<html lang="@currentLocale.Code" dir="@currentLocale.Direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(isEn ? "Panoptes Enterprise UI" : "Panoptes Kurumsal UI")</title>
    <script>
        window.panoptes = window.panoptes || {};
        window.panoptes.currentLocale = '@currentLocale.Code';
        window.panoptes.direction = '@currentLocale.Direction';
    </script>
    <!-- Tailwind CSS CDN (Tailwind theme mode) -->
    <script id="tailwindCdn" src="https://cdn.tailwindcss.com"></script>
    <!-- Bootstrap 5.3 reboot only (Bootstrap theme mode, local).
         Full bootstrap.min.css is intentionally NOT loaded here: its utilities
         (.p-5, .gap-4, ...) share names with Tailwind's but use a different
         scale, which would restyle the Tailwind-built demo shell. Reboot brings
         the Bootstrap base + CSS variables with no collisions. -->
    <link id="bootstrapCss" rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-reboot.min.css" asp-append-version="true" disabled />
    <!-- Panoptes component theme: swapped by the theme switcher (data-bootstrap-href) -->
    <link id="panoptesThemeCss" rel="stylesheet" href="~/_content/Panoptes.AspNetCore/panoptes/panoptes.css"
          data-tailwind-href="@Url.Content("~/_content/Panoptes.AspNetCore/panoptes/panoptes.css")"
          data-bootstrap-href="@Url.Content("~/_content/Panoptes.AspNetCore/panoptes/panoptes-bootstrap.css")" />
    <link rel="stylesheet" href="~/_content/Panoptes.AspNetCore/panoptes/panoptes-scheduler.css" />
    <script>
        // Apply saved UI theme before first paint. Modes: "tailwind" (default) | "bootstrap".
        (function () {
            try {
                if (localStorage.getItem("panoptes-theme") === "bootstrap") {
                    var bs = document.getElementById("bootstrapCss");
                    var th = document.getElementById("panoptesThemeCss");
                    if (bs) bs.removeAttribute("disabled");
                    if (th && th.getAttribute("data-bootstrap-href")) th.href = th.getAttribute("data-bootstrap-href");
                }
            } catch (e) { /* private mode: stay on Tailwind theme */ }
        })();
    </script>
    <link rel="stylesheet" href="~/panoptes/leaflet/leaflet.css" asp-append-version="true" />
    <style>
        pre code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        }

        /* ===== Global Light Theme Code Viewer Standard (Prime & Panoptes Standard) ===== */
        .panoptes-code-snippet,
        .panoptes-code-viewer {
            background-color: #ffffff !important;
            color: #1e293b !important;
            border: 1px solid #e2e8f0 !important;
            border-radius: 0.75rem !important;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03) !important;
        }
        .panoptes-code-snippet pre,
        .panoptes-code-viewer pre {
            background-color: transparent !important;
            color: #1e293b !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow-x: auto !important;
        }
        .panoptes-code-snippet code,
        .panoptes-code-viewer code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
            font-size: 0.8125rem !important;
            line-height: 1.625 !important;
            color: #1e293b !important;
            background: transparent !important;
        }
        .panoptes-code-snippet button,
        .panoptes-code-viewer button {
            background-color: #ffffff !important;
            color: #475569 !important;
            border: 1px solid #e2e8f0 !important;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.02) !important;
            cursor: pointer !important;
        }
        .panoptes-code-snippet button:hover,
        .panoptes-code-viewer button:hover {
            background-color: #f8fafc !important;
            color: #0f172a !important;
        }

        /* ===== Sol Menü ===== */
        .sidebar-scroll { scrollbar-width: thin; scrollbar-color: #cbd5e1 transparent; }
        .sidebar-scroll::-webkit-scrollbar { width: 6px; }
        .sidebar-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }

        .sidebar-link {
            color: #475569;
            transition: background-color .15s ease, color .15s ease, transform .15s ease;
        }
        .sidebar-link:hover { background-color: #f1f5f9; color: #0f172a; }
        .sidebar-link.active {
            background: linear-gradient(90deg, #eff6ff 0%, #eef2ff 100%);
            color: #1d4ed8;
            font-weight: 700;
            box-shadow: inset 3px 0 0 #2563eb;
        }

        .sidebar-group > summary { list-style: none; cursor: pointer; }
        .sidebar-group > summary::-webkit-details-marker { display: none; }
        .sidebar-group .chev { transition: transform .2s ease; }
        .sidebar-group[open] .chev { transform: rotate(90deg); }

        .sidebar-sub { margin-left: 1.15rem; padding-left: .5rem; border-left: 1px dashed #cbd5e1; }
        .sidebar-sub .sidebar-link.active { box-shadow: inset 3px 0 0 #2563eb; border-radius: .5rem; }

        
        @@keyframes fadeSlide { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
        .sidebar-group[open] > nav { animation: fadeSlide .18s ease; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans antialiased">
    <!-- Top Header Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-xs">
        <div class="max-w-[1700px] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-4">
                <a href="@(langPrefix + "/")" class="flex items-center space-x-3 group">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-700 to-indigo-500 flex items-center justify-center text-white font-black text-xl shadow-md group-hover:scale-105 transition">
                        P
                    </div>
                    <div>
                        <div class="font-extrabold text-lg tracking-tight text-slate-900 leading-none">Panoptes <span class="text-blue-600 font-bold">UI</span></div>
                        <div class="text-[10px] text-slate-400 font-semibold tracking-wider uppercase mt-0.5">Enterprise Components</div>
                    </div>
                </a>
                <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "Enterprise UI v1.0" : "Kurumsal UI v1.0")
                </span>
            </div>

            <!-- Primary Navigation Links (Clean & Focused) -->
            <div class="flex items-center space-x-2 text-sm">
                <a href="@(langPrefix + "/")" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-blue-600 hover:bg-slate-100 font-medium transition flex items-center gap-1.5">
                    <span>@DemoTranslations.T("TopNav.Showcase", isEn)</span>
                </a>
                <a href="@(langPrefix + "/Grid")" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-blue-600 hover:bg-slate-100 font-medium transition flex items-center gap-1.5">
                    <span>@DemoTranslations.T("TopNav.DataGrid", isEn)</span>
                </a>
                <a href="@(langPrefix + "/Home/ComponentCatalog")" class="px-3 py-1.5 rounded-lg text-blue-700 bg-blue-50 hover:bg-blue-100 font-semibold transition flex items-center gap-1.5 border border-blue-200">
                    <span>@DemoTranslations.T("TopNav.Catalog", isEn)</span>
                </a>
                <span class="w-px h-5 bg-slate-200 mx-1"></span>

                <!-- Language Selector (18 Languages) -->
                <form id="panoptesLangForm" action="/Home/SetLanguage" method="post" class="inline-flex items-center">
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <div class="relative inline-flex items-center">
                        <select name="culture" onchange="document.getElementById('panoptesLangForm').submit()"
                                aria-label="@(isEn ? "Language selection" : "Dil seçimi")"
                                class="appearance-none bg-white border border-slate-200 text-slate-700 text-xs rounded-xl px-2.5 py-1.5 pr-7 font-bold hover:border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer shadow-2xs transition">
                            @foreach (var loc in PanoptesLocales.All)
                            {
                                var isSel = isEn ? loc.Code.Equals("en", StringComparison.OrdinalIgnoreCase) : loc.Code.Equals(currentLocale.Code, StringComparison.OrdinalIgnoreCase);
                                if (isSel)
                                {
                                    <option value="@loc.Culture" selected="selected">@loc.Flag @loc.NativeName (@loc.Code.ToUpper())</option>
                                }
                                else
                                {
                                    <option value="@loc.Culture">@loc.Flag @loc.NativeName (@loc.Code.ToUpper())</option>
                                }
                            }
                        </select>
                        <span class="pointer-events-none absolute right-2 text-slate-400 text-[10px]">▼</span>
                    </div>
                </form>

                <span class="w-px h-5 bg-slate-200 mx-1"></span>
                <span class="text-xs font-semibold px-2.5 py-1 bg-slate-100 text-slate-600 rounded-md border border-slate-200 hidden lg:inline-flex">
                    @DemoTranslations.T("TopNav.ZeroDep", isEn)
                </span>

                <!-- UI Theme Switcher: Tailwind | Bootstrap (choice persists in localStorage) -->
                <span class="hidden lg:inline-flex items-center rounded-md border border-slate-200 overflow-hidden text-xs font-semibold" role="group" aria-label="UI theme">
                    <button type="button" id="themeBtnTailwind" onclick="setPanoptesTheme('tailwind')"
                            class="px-2.5 py-1 transition">Tailwind</button>
                    <button type="button" id="themeBtnBootstrap" onclick="setPanoptesTheme('bootstrap')"
                            class="px-2.5 py-1 transition">Bootstrap</button>
                </span>
            </div>
        </div>
    </header>

    <!-- Main Container with Sticky Sidebar -->
    <div class="max-w-[1700px] w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 flex gap-8">
        <!-- Sidebar Navigation -->
        <aside class="w-72 shrink-0 hidden md:block">
            <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto sidebar-scroll pr-2 pb-8 space-y-4">

                <!-- Search -->
                <div>
                    <div class="relative">
                        <input type="text"
                               id="sidebarSearch"
                               autocomplete="off"
                               placeholder="@DemoTranslations.T("TopNav.SearchPlaceholder", isEn, totalComponents)"
                               class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-xl text-slate-700 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm" />
                    </div>
                                    </div>

                <!-- Featured: Component Catalog Matrix -->
                <a href="@(langPrefix + "/Home/ComponentCatalog")"
                   class="block relative overflow-hidden rounded-2xl p-3.5 bg-gradient-to-br from-blue-600 via-indigo-600 to-violet-600 text-white shadow-lg shadow-indigo-200 hover:shadow-xl hover:-translate-y-0.5 transition">
                    <div class="absolute -right-6 -top-6 w-24 h-24 rounded-full bg-white/10"></div>
                    <div class="absolute -right-2 -bottom-8 w-20 h-20 rounded-full bg-white/10"></div>
                    <div class="relative flex items-center justify-between">
                        <div>
                            <div class="text-[10px] font-bold uppercase tracking-widest text-blue-100">@DemoTranslations.T("Sidebar.CatalogBadge", isEn)</div>
                            <div class="text-sm font-black mt-0.5">@DemoTranslations.T("Sidebar.CatalogTitle", isEn)</div>
                            <div class="text-[11px] text-blue-100 mt-0.5">@DemoTranslations.T("Sidebar.CatalogDesc", isEn)</div>
                        </div>
                        <span class="bg-white/20 backdrop-blur text-white text-[10px] font-black px-2 py-1 rounded-full">@totalComponents+</span>
                    </div>
                </a>

                <!-- Gruplar -->
                <div class="space-y-2" id="sidebarGroups">
                    @foreach (var group in groups)
                    {
                        var hasActive = active != null && group.Items.Any(i => i == active);
                        var count = group.Items.Count(i => !i.Sub);
                        <details class="sidebar-group bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden" data-open="@(hasActive ? "1" : "0")" @(hasActive ? "open" : "")>
                            <summary class="flex items-center justify-between gap-2 px-3 py-2.5 hover:bg-slate-50 transition select-none">
                                <span class="flex items-center gap-2.5 min-w-0">
                                    <span class="text-[11px] font-black tracking-wider text-slate-700 uppercase truncate">@group.Title</span>
                                </span>
                                <span class="flex items-center gap-2 shrink-0">
                                    <span class="text-[10px] bg-slate-100 text-slate-600 font-bold px-1.5 py-0.5 rounded-full">@count</span>
                                    <svg class="chev w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                                </span>
                            </summary>
                            <nav class="px-2 pb-2 pt-0.5 space-y-0.5 text-xs border-t border-slate-100">
                                @foreach (var item in group.Items)
                                {
                                    var isActive = item == active;
                                    <div class="sidebar-item group relative flex items-center @(item.Sub ? "sidebar-sub" : "")">
                                        <a href="@item.Href"
                                           class="sidebar-link @(isActive ? "active" : "") flex-1 min-w-0 flex items-center gap-2.5 rounded-lg @(item.Sub ? "px-2 py-1.5 text-[11px]" : "px-2 py-1.5 font-semibold")">
                                            <span class="truncate">@item.Label</span>
                                        </a>
                                    </div>
                                }
                            </nav>
                        </details>
                    }
                    <div id="sidebarEmpty" class="hidden text-center text-xs text-slate-400 py-6">@DemoTranslations.T("TopNav.SearchEmpty", isEn)</div>
                </div>
            </div>
        </aside>

        <!-- Main Workspace Area -->
        <main class="flex-1 min-w-0">
            @if (active != null)
            {
                <div id="panoptesRef" class="mb-5 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-blue-200 bg-gradient-to-r from-blue-50/80 via-white to-indigo-50/80 px-4 py-3 shadow-sm">
                    <div class="flex items-center gap-3 min-w-0">
                        <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 text-white flex items-center justify-center font-black shadow-sm shrink-0">P</span>
                        <div class="min-w-0">
                            <div class="text-[10px] font-bold uppercase tracking-widest text-blue-700">@DemoTranslations.T("Ref.SuiteTitle", isEn)</div>
                            <div class="text-sm font-bold text-slate-800 truncate">@active.Label &mdash; @DemoTranslations.T("Ref.SuiteSubtitle", isEn)</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <a href="@(langPrefix + "/Home/ComponentCatalog")"
                           class="inline-flex items-center px-3 py-1.5 rounded-lg bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold transition">
                            @DemoTranslations.T("Ref.CatalogButton", isEn)
                        </a>
                    </div>
                </div>
            }
            @RenderBody()
            
            <!-- Tech Stack Footer -->
            <footer class="mt-20 mb-4 border-t border-slate-200 pt-6 px-4 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500 bg-transparent">
                <div>
                    <span class="font-bold text-slate-800">Panoptes UI</span> &copy; @DateTime.Now.Year &mdash; @DemoTranslations.T("Footer.Subtitle", isEn)
                </div>
                <div class="flex flex-wrap justify-center items-center gap-6">
                    <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-sky-600 transition" title="Styled with Tailwind CSS">
                        <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12.001,4.8c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 C13.666,10.618,15.027,12,18.001,12c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C16.337,6.182,14.976,4.8,12.001,4.8z M6.001,12c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 c1.177,1.194,2.538,2.576,5.512,2.576c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C10.337,13.382,8.976,12,6.001,12z"></path></svg>
                        <span class="font-medium text-slate-600">Tailwind CSS</span>
                    </a>
                    <a href="https://heroicons.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-indigo-600 transition" title="Icons by Heroicons">
                        <svg class="w-4 h-4 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" /></svg>
                        <span class="font-medium text-slate-600">Heroicons</span>
                    </a>
                    <a href="https://dotnet.microsoft.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-purple-700 transition" title="Powered by ASP.NET Core">
                        <span class="font-black text-purple-600">.NET</span>
                        <span class="font-medium text-slate-600">ASP.NET Core 8</span>
                    </a>
                </div>
                <div class="text-[10px]">
                    Built with <span class="text-red-500 text-sm">♥️</span> for modern web
                </div>
            </footer>
        </main>
    </div>

