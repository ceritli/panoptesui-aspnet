                    "Serbest Hareketli Pencere": "Window (Modal/Draggable)",
                    "Alttan Açılan Eylem Sayfası": "ActionSheet",
                    "Takvim & Randevu Planlayıcı": "Scheduler",
                    "Proje Çizelgesi & İş Planı": "Gantt Chart",
                    "HTML5 Sürükle-Bırak Görev Panosu": "TaskBoard (Kanban)",
                    "Vektörel Grafik Çizimi": "Charts",
                    "Finansal Borsa Grafiği": "StockChart",
                    "Kadran ve Termometre Göstergeleri": "Gauges",
                    "Barkod ve Karekod Üretici": "Barcode & QRCode",
                    "Akış ve Organizasyon Şeması": "Diagram & OrgChart",
                    "İnteraktif Coğrafi Harita": "Map (Geo Map)",
                    "Bulut Dosya Gezgini": "FileManager",
                    "Gelişmiş Filtre Oluşturucu": "Filter (Query Builder)",
                    "Gömülü PDF Okuyucu": "PDF Viewer",
                    "Medya ve Video Oynatıcı": "MediaPlayer"
                };

                const placeholderDict = {
                    "Ülke adı yazmaya başlayın...": "Start typing country name...",
                    "Bileşen veya yetenek ara...": "Search components or capabilities...",
                    "Tabloda ara...": "Search in table...",
                    "Hızlı ara...": "Quick search...",
                    "Tarih seçin...": "Select date...",
                    "Değer yazın...": "Enter value...",
                    "Seçiniz...": "Select..."
                };

                function translateText(text) {
                    if (!text) return text;
                    const trimmed = text.trim();
                    if (exactDict[trimmed]) {
                        return text.replace(trimmed, exactDict[trimmed]);
                    }

                    // Patterns & Suffixes
                    let res = text;
                    if (res.includes("Panoptes Kurumsal UI")) {
                        res = res.replace("Panoptes Kurumsal UI", "Panoptes Enterprise UI");
                    }
                    if (res.includes("Kurumsal UI Bileşen Paketi")) {
                        res = res.replace("Kurumsal UI Bileşen Paketi", "Enterprise UI Component Suite");
                    }
                    if (res.includes("Son 30 günlük giriş / çıkış logları")) {
                        res = res.replace("Son 30 günlük giriş / çıkış logları", "Last 30 days in/out logs");
                    }
                    return res;
                }

                function walk(node) {
                    if (!node) return;
                    if (node.nodeType === Node.TEXT_NODE) {
                        const original = node.nodeValue;
                        const translated = translateText(original);
                        if (translated !== original) {
                            node.nodeValue = translated;
                        }
                    } else if (node.nodeType === Node.ELEMENT_NODE) {
                        const tag = node.tagName.toLowerCase();
                        if (tag === 'script' || tag === 'style' || tag === 'pre' || tag === 'code') return;

                        // Placeholders & Titles
                        if (node.placeholder && placeholderDict[node.placeholder]) {
                            node.placeholder = placeholderDict[node.placeholder];
                        }
                        if (node.title && exactDict[node.title]) {
                            node.title = exactDict[node.title];
                        }

                        for (let child = node.firstChild; child; child = child.nextSibling) {
                            walk(child);
                        }
                    }
                }

                function applyTranslations() {
                    // Update Title
                    if (document.title) {
                        document.title = translateText(document.title);
                    }

                    // Update Main Content
                    const main = document.querySelector('main') || document.body;
                    walk(main);
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', applyTranslations);
                } else {
                    applyTranslations();
                }

                // Also observe dynamic DOM changes (e.g., grids rendering client-side)
                const observer = new MutationObserver((mutations) => {
                    for (const m of mutations) {
                        for (const node of m.addedNodes) {
                            if (node.nodeType === Node.ELEMENT_NODE) {
                                walk(node);
                            }
                        }
                    }
                });
                observer.observe(document.body, { childList: true, subtree: true });
            })();
        </script>
