@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "AutoComplete - Panoptes Enterprise UI" : "AutoComplete (Otomatik Tamamlama) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/Components/AutoComplete" : "/Components/AutoComplete")" class="hover:text-blue-600 transition">@(isEn ? "Form Components" : "Form Bileşenleri")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">AutoComplete</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">AutoComplete @(isEn ? "" : "(Otomatik Tamamlama)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                    &lt;panoptes-autocomplete&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "WAI-ARIA Compliant" : "WAI-ARIA Uyumlu")
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Suggests products and accounts as you type; fast keyboard picks save time at checkout and order entry."
                    : "Yazdıkça ürün ve cari önerir; klavyeden hızlı seçim, kasada ve siparişte zaman kazandırır.")
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>Örnekler (Features)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">6</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>API Referansı (Props & Events)</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>Erişilebilirlik (WAI-ARIA)</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
        
        <!-- 1. Temel Kullanım (Basic AutoComplete) -->
        <div class="panoptes-card bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                        1. Temel Kullanım (Basic AutoComplete)
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">En az 1 karakter yazıldığında eşleşen ülkeler açılır, aranan harfler sarı ile vurgulanır.</p>
                </div>
                <span class="text-xs font-mono bg-blue-50 text-blue-700 px-2.5 py-1 rounded font-medium border border-blue-100 self-start sm:self-auto">
                    min-length="1" filter="startswith"
                </span>
            </div>

            <!-- Canlı Önizleme Alanı -->
            <div class="p-8 bg-white flex flex-col items-center justify-center">
                <div class="w-full max-w-md space-y-1.5">
                    <label for="ac_basic-input" class="block text-xs font-bold text-slate-700">Ülke Seçin</label>
                    <panoptes-autocomplete id="ac_basic"
                                          min-length="1"
                                          filter="startswith"
                                          options="Türkiye, Almanya, Amerika Birleşik Devletleri, Fransa, İngiltere, İtalya, İspanya, Hollanda, Belçika, Avusturya, İsviçre, Japonya, Kanada"
                                          placeholder="Ülke adı yazmaya başlayın (örn: T, A, F)..." />
                    <span class="text-[11px] text-slate-400">İpucu: "t", "a" veya "i" tuşlayarak açılır listeyi deneyebilirsiniz.</span>
                </div>
            </div>

            <!-- Tabbed Light Code Block (Resimdeki gibi) -->
            <div class="panoptes-code-block border-t border-slate-200 bg-white">
                <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <div class="flex gap-1.5">
                        <button type="button" onclick="switchCodeTab(this, 'ac_basic_razor')" class="tab-btn px-3 py-1 rounded-md text-xs font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs">Razor TagHelper</button>
                        <button type="button" onclick="switchCodeTab(this, 'ac_basic_html')" class="tab-btn px-3 py-1 rounded-md text-xs font-medium text-slate-600 hover:text-slate-900 transition">HTML Çıktısı</button>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Kopyala</span>
                    </button>
                </div>
                <div id="ac_basic_razor" class="tab-pane panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-autocomplete id="ac_basic"
                       min-length="1"
                       filter="startswith"
                       options="Türkiye, Almanya, Fransa, İngiltere, İtalya, İspanya, Hollanda"
                       placeholder="Ülke adı yazmaya başlayın..." /&gt;</code></pre>
                </div>
                <div id="ac_basic_html" class="tab-pane panoptes-code-viewer hidden">
                    <pre class="panoptes-raw-code hidden"><code>&lt;div id="ac_basic" class="panoptes-autocomplete-wrapper relative inline-block w-full"&gt;
  &lt;div class="panoptes-input-group relative flex items-center"&gt;
    &lt;input type="text" id="ac_basic-input" name="ac_basic" autocomplete="off"
           role="combobox" aria-autocomplete="list" aria-expanded="false"
           placeholder="Ülke adı yazmaya başlayın..."
           class="panoptes-autocomplete-input w-full pl-3 pr-8 py-2 text-sm rounded-lg border border-slate-300" /&gt;
  &lt;/div&gt;
&lt;/div&gt;</code></pre>
                </div>
            </div>
        </div>

        <!-- 2. Çoklu Seçim & Ayraç (Multiple with Separator) -->
        <div class="panoptes-card bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-indigo-600 inline-block"></span>
                        2. Çoklu Seçim & Ayraç Desteği (Multiple / Separator)
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">Virgül (,) ile ayrılmış birden fazla etiketi veya teknolojiyi aynı metin kutusunda arka arkaya tamamlayın.</p>
                </div>
                <span class="text-xs font-mono bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded font-medium border border-indigo-100 self-start sm:self-auto">
                    separator="," filter="contains"
                </span>
            </div>

            <div class="p-8 bg-white flex flex-col items-center justify-center">
                <div class="w-full max-w-md space-y-1.5">
                    <label for="ac_separator-input" class="block text-xs font-bold text-slate-700">Teknoloji Yığını (Virgülle ayırarak yazın)</label>
                    <panoptes-autocomplete id="ac_separator"
                                          separator=","
                                          min-length="1"
                                          filter="contains"
                                          options="C#, .NET, ASP.NET Core, JavaScript, TypeScript, TailwindCSS, React, Vue, Docker, Kubernetes, PostgreSQL, Redis"
                                          placeholder="Örn: C#, Docker, TailwindCSS..." />
                    <span class="text-[11px] text-slate-400">Bir etiket seçtiğinizde otomatik virgül eklenir ve yazmaya devam edebilirsiniz.</span>
                </div>
            </div>

            <div class="panoptes-code-block border-t border-slate-200 bg-white">
                <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <span class="text-xs font-semibold text-slate-700">Razor TagHelper</span>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Kopyala</span>
                    </button>
                </div>
                <div class="tab-pane panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-autocomplete id="ac_separator"
                       separator=","
                       min-length="1"
                       filter="contains"
                       options="C#, .NET, ASP.NET Core, JavaScript, TypeScript, TailwindCSS, React, Vue"
                       placeholder="Örn: C#, Docker, TailwindCSS..." /&gt;</code></pre>
                </div>
            </div>
        </div>

        <!-- 3. Zengin Görsel Şablonlar (Custom Item Template) -->
        <div class="panoptes-card bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
                        3. Zengin Görsel Şablonlar & Rozetler (Custom Item Templates)
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">Avatar, açıklama metni ve yetki rozetleri içeren özelleştirilmiş öneri listesi.</p>
                </div>
                <span class="text-xs font-mono bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded font-medium border border-emerald-100 self-start sm:self-auto">
                    JSON Array / Obje Formatı
                </span>
            </div>

            <div class="p-8 bg-white flex flex-col items-center justify-center">
                <div class="w-full max-w-md space-y-1.5">
                    <label for="ac_rich-input" class="block text-xs font-bold text-slate-700">Kullanıcı veya Hesap Arama</label>
                    <panoptes-autocomplete id="ac_rich"
                                          min-length="1"
                                          filter="contains"
                                          placeholder="Kullanıcı veya e-posta arayın..."
                                          options='[
                                              {"text":"Ahmet Yılmaz","value":"ahmet@panoptes.dev","icon":"👨‍💼","desc":"Kıdemli Sistem Mimarı","badge":"Admin"},
                                              {"text":"Ayşe Demir","value":"ayse@panoptes.dev","icon":"👩‍💻","desc":"Frontend Takım Lideri","badge":"Yönetici"},
                                              {"text":"Mehmet Kaya","value":"mehmet@panoptes.dev","icon":"👨‍🔧","desc":"DevOps & Bulut Uzmanı","badge":"Mühendislik"},
                                              {"text":"Zeynep Çelik","value":"zeynep@panoptes.dev","icon":"👩‍🎨","desc":"Baş Tasarımcı (UI/UX)","badge":"Tasarım"}
                                          ]' />
                    <span class="text-[11px] text-slate-400">"Ahmet" veya "Demir" yazarak zengin şablonu inceleyin.</span>
                </div>
            </div>

            <div class="panoptes-code-block border-t border-slate-200 bg-white">
                <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <span class="text-xs font-semibold text-slate-700">Razor TagHelper</span>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Kopyala</span>
                    </button>
                </div>
                <div class="tab-pane panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-autocomplete id="ac_rich"
                       min-length="1"
                       filter="contains"
                       placeholder="Kullanıcı arayınız..."
                       options='[
                           {"text":"Ahmet Yılmaz","value":"ahmet@panoptes.dev","icon":"👨‍💼","desc":"Sistem Mimarı","badge":"Admin"},
                           {"text":"Ayşe Demir","value":"ayse@panoptes.dev","icon":"👩‍💻","desc":"Frontend Lideri","badge":"Yönetici"}
                       ]' /&gt;</code></pre>
                </div>
            </div>
        </div>

        <!-- 4. Boyutlar (Sizes: sm, md, lg) -->
        <div class="panoptes-card bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-purple-600 inline-block"></span>
                        4. Farklı Boyut Seçenekleri (Sizes)
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">Küçük (sm), Standart (md) ve Büyük (lg) boyut varyantları.</p>
                </div>
                <span class="text-xs font-mono bg-purple-50 text-purple-700 px-2.5 py-1 rounded font-medium border border-purple-100 self-start sm:self-auto">
                    size="sm | md | lg"
                </span>
            </div>

            <div class="p-8 bg-white grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">Küçük Boyut (sm)</label>
                    <panoptes-autocomplete id="ac_size_sm" size="sm" options="İstanbul, Ankara, İzmir, Bursa, Antalya" placeholder="Küçük (sm)..." />
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">Standart Boyut (md)</label>
                    <panoptes-autocomplete id="ac_size_md" size="md" options="İstanbul, Ankara, İzmir, Bursa, Antalya" placeholder="Standart (md)..." />
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">Büyük Boyut (lg)</label>
                    <panoptes-autocomplete id="ac_size_lg" size="lg" options="İstanbul, Ankara, İzmir, Bursa, Antalya" placeholder="Büyük (lg)..." />
                </div>
            </div>

            <div class="panoptes-code-block border-t border-slate-200 bg-white">
                <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <span class="text-xs font-semibold text-slate-700">Razor TagHelper</span>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Kopyala</span>
                    </button>
                </div>
                <div class="tab-pane panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-autocomplete id="ac_sm" size="sm" options="İstanbul, Ankara, İzmir" /&gt;
&lt;panoptes-autocomplete id="ac_md" size="md" options="İstanbul, Ankara, İzmir" /&gt;
&lt;panoptes-autocomplete id="ac_lg" size="lg" options="İstanbul, Ankara, İzmir" /&gt;</code></pre>
                </div>
            </div>
        </div>

        <!-- 5. Durumlar: Devre Dışı & Salt Okunur (Disabled & Readonly) -->
        <div class="panoptes-card bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-slate-600 inline-block"></span>
                        5. Devre Dışı & Salt Okunur Durumlar (Disabled & Readonly)
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">Kullanıcı etkileşimini kısıtlama ve salt okunur sunum durumları.</p>
                </div>
                <span class="text-xs font-mono bg-slate-100 text-slate-700 px-2.5 py-1 rounded font-medium border border-slate-200 self-start sm:self-auto">
                    disabled="true" | readonly="true"
                </span>
            </div>

            <div class="p-8 bg-white grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">Devre Dışı (Disabled)</label>
                    <panoptes-autocomplete id="ac_disabled" disabled="true" value="Türkiye (Kilitli)" options="Türkiye, Almanya" />
                    <span class="text-[11px] text-slate-400">Tıklanamaz, odaklanamaz ve veri değiştirilemez.</span>
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">Salt Okunur (Readonly)</label>
                    <panoptes-autocomplete id="ac_readonly" readonly="true" value="Salt Okunur Değer" options="Türkiye, Almanya" />
                    <span class="text-[11px] text-slate-400">Odaklanabilir ve kopyalanabilir ancak açılır liste tetiklenmez.</span>
                </div>
            </div>

            <div class="panoptes-code-block border-t border-slate-200 bg-white">
                <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <span class="text-xs font-semibold text-slate-700">Razor TagHelper</span>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Kopyala</span>
                    </button>
                </div>
                <div class="tab-pane panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-autocomplete id="ac_dis" disabled="true" value="Türkiye" /&gt;
&lt;panoptes-autocomplete id="ac_ro" readonly="true" value="Salt Okunur" /&gt;</code></pre>
                </div>
            </div>
        </div>

        <!-- 6. İstemci JavaScript API & Etkileşimli Olay Konsolu -->
        <div class="panoptes-card bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
