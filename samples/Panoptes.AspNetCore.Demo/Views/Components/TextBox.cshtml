@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "TextBox - Panoptes Enterprise UI" : "TextBox (Metin Kutusu) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/Components/TextBox" : "/Components/TextBox")" class="hover:text-blue-600 transition">@(isEn ? "Form Components" : "Form Bileşenleri")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">TextBox</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">TextBox @(isEn ? "" : "(Metin Kutusu)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-textbox&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "WAI-ARIA Compliant" : "WAI-ARIA Uyumlu")
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Clearable, validated text entry; the building block of every form."
                    : "Temizleme düğmeli, doğrulamalı metin girişi; tüm formların yapı taşı.")
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>Örnekler (Features)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">3</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>API Referansı (Props & Events)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">8</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>Erişilebilirlik (WAI-ARIA)</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
        
        <!-- 1. Temel Kullanım -->
        <div class="panoptes-card bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                        1. Temel Kullanım & Temizlenebilir Giriş (Clearable)
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">Kullanıcı yazdıkça temizleme ikonu aktif olur, tek tıkla içerik sıfırlanabilir.</p>
                </div>
                <span class="text-xs font-mono bg-blue-50 text-blue-700 px-2.5 py-1 rounded font-medium border border-blue-100 self-start sm:self-auto">
                    clearable="true"
                </span>
            </div>

            <div class="p-8 bg-white flex flex-col items-center justify-center">
                <div class="w-full max-w-md space-y-1.5">
                    <label for="tbMain" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Kullanıcı Adı veya E-Posta</label>
                    <panoptes-textbox id="tbMain" value="fatih@panoptes.dev" placeholder="E-posta giriniz..." clearable="true" />
                    <span class="text-[11px] text-slate-400">Metin girdiğinizde sağdaki temizleme (x) butonunu deneyebilirsiniz.</span>
                </div>
            </div>

            <!-- Tabbed Light Code Block (Prime standardı) -->
            <div class="panoptes-code-block border-t border-slate-200 bg-white">
                <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <div class="flex gap-1.5">
                        <button type="button" onclick="switchCodeTab(this, 'tb_basic_razor')" class="tab-btn px-3 py-1 rounded-md text-xs font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs cursor-pointer">Razor TagHelper</button>
                        <button type="button" onclick="switchCodeTab(this, 'tb_basic_html')" class="tab-btn px-3 py-1 rounded-md text-xs font-medium text-slate-600 hover:text-slate-900 transition cursor-pointer">HTML Çıktısı</button>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Kopyala</span>
                    </button>
                </div>
                <div id="tb_basic_razor" class="tab-pane panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-textbox id="userName" 
                 value="@@Model.UserName" 
                 placeholder="Kullanıcı adı veya e-posta..." 
                 clearable="true" /&gt;</code></pre>
                </div>
                <div id="tb_basic_html" class="tab-pane panoptes-code-viewer hidden">
                    <pre class="panoptes-raw-code hidden"><code>&lt;div class="panoptes-textbox-wrapper relative flex items-center w-full"&gt;
  &lt;input id="userName" name="userName" type="text" value="fatih@panoptes.dev" placeholder="Kullanıcı adı veya e-posta..." class="panoptes-textbox w-full px-3 py-2 text-xs border border-slate-200 rounded-xl" /&gt;
  &lt;button type="button" class="panoptes-clear-btn absolute right-2.5 text-slate-400 hover:text-slate-600"&gt;✕&lt;/button&gt;
&lt;/div&gt;</code></pre>
                </div>
            </div>
        </div>

        <!-- 2. Durumlar ve Varyasyonlar -->
        <div class="panoptes-card bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="border-b border-slate-100 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                        2. Durumlar ve Varyasyonlar (Readonly & Disabled)
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">Salt okunur, devre dışı ve yer tutucu içeren varyasyonlar.</p>
                </div>
            </div>

            <div class="p-8 bg-white">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                        <label class="text-xs font-bold text-slate-700 block">Temizlenebilir Kutu</label>
                        <panoptes-textbox id="tbVar1" placeholder="Yazmaya başlayın..." clearable="true" />
                    </div>
                    <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                        <label class="text-xs font-bold text-slate-700 block">Salt Okunur (Readonly)</label>
                        <panoptes-textbox id="tbVar2" value="SABİT_KOD_123" readonly="true" />
                    </div>
                    <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                        <label class="text-xs font-bold text-slate-700 block">Devre Dışı (Disabled)</label>
                        <panoptes-textbox id="tbVar3" value="Değiştirilemez Veri" disabled="true" />
                    </div>
                </div>
            </div>

            <!-- Tabbed Light Code Block -->
            <div class="panoptes-code-block border-t border-slate-200 bg-white">
                <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <div class="flex gap-1.5">
                        <button type="button" onclick="switchCodeTab(this, 'tb_var_razor')" class="tab-btn px-3 py-1 rounded-md text-xs font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs cursor-pointer">Razor TagHelper</button>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>Kopyala</span>
                    </button>
                </div>
                <div id="tb_var_razor" class="tab-pane panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;!-- Salt Okunur --&gt;
&lt;panoptes-textbox id="refCode" value="SABIT_123" readonly="true" /&gt;

&lt;!-- Devre Dışı --&gt;
&lt;panoptes-textbox id="sysId" value="Değiştirilemez" disabled="true" /&gt;</code></pre>
                </div>
            </div>
        </div>

    </div>

    <!-- PANEL 2: API & ATTRIBUTES -->
    <div id="panel-api" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">TagHelper Özellikleri & Parametreleri</h3>
                    <p class="text-xs text-slate-500 mt-0.5">&lt;panoptes-textbox&gt; bileşeninin desteklediği tüm C# ve HTML nitelikleri.</p>
                </div>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-blue-100 text-blue-800">TextBoxTagHelper</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                            <th class="py-3 px-6">Özellik (Attribute)</th>
                            <th class="py-3 px-4">Tip (C#)</th>
                            <th class="py-3 px-4">Varsayılan</th>
                            <th class="py-3 px-6">Açıklama</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">id</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">Otomatik</td>
                            <td class="py-3 px-6 text-slate-700">Bileşenin benzersiz DOM kimliği.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">value</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">Metin kutusunun başlangıç değeri veya model bağımlılığı.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">placeholder</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">Boşken gösterilecek yer tutucu metin.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">clearable</td>
                            <td class="py-3 px-4 font-mono text-purple-600">bool</td>
                            <td class="py-3 px-4 font-mono text-slate-400">true</td>
                            <td class="py-3 px-6 text-slate-700">Yazı varken tek tıkla temizleme butonunun gösterilmesini sağlar.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">disabled</td>
                            <td class="py-3 px-4 font-mono text-purple-600">bool</td>
                            <td class="py-3 px-4 font-mono text-slate-400">false</td>
                            <td class="py-3 px-6 text-slate-700">Girişi devre dışı bırakır ve form gönderiminden hariç tutar.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">readonly</td>
                            <td class="py-3 px-4 font-mono text-purple-600">bool</td>
                            <td class="py-3 px-4 font-mono text-slate-400">false</td>
                            <td class="py-3 px-6 text-slate-700">Salt okunur mod; metin seçilebilir fakat değiştirilemez.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">maxlength</td>
                            <td class="py-3 px-4 font-mono text-purple-600">int?</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">İzin verilen maksimum karakter sayısı.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">size</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">"md"</td>
                            <td class="py-3 px-6 text-slate-700">Boyut: "sm", "md", "lg".</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PANEL 3: ACCESSIBILITY (WAI-ARIA & KEYBOARD) -->
    <div id="panel-a11y" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
            <div>
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
                    WAI-ARIA Standartları & Klavye Erişilebilirliği
                </h2>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                    Panoptes TextBox bileşeni, W3C WAI-ARIA metin alanı standartlarına uygun olarak ekran okuyucular ve salt klavye navigasyonu için tasarlanmıştır.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">WAI-ARIA Nitelikleri</div>
                    <div class="text-slate-600">
                        Standart <code>role="textbox"</code> rolünü taşır. Duruma göre <code>aria-disabled</code>, <code>aria-readonly</code> ve <code>aria-invalid</code> nitelikleri otomatik güncellenir.
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">Odak Yönetimi (Focus Management)</div>
                    <div class="text-slate-600">
                        Sekme sırasını korur (<code>tabIndex="0"</code>). Temizle butonuna tıklandığında odak tekrar metin alanına yönlendirilir.
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <h3 class="text-sm font-bold text-slate-900 mb-3">Klavye Kısayolları (Keyboard Shortcuts)</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                                <th class="py-2.5 px-4 w-48">Tuş (Key)</th>
                                <th class="py-2.5 px-4">İşlev (Function)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Tab</kbd></td>
                                <td class="py-2.5 px-4">Metin kutusuna odaklanır veya bir sonraki form elemanına geçer.</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Escape</kbd></td>
                                <td class="py-2.5 px-4">Temizlenebilir kutularda mevcut metni temizler.</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Enter</kbd></td>
                                <td class="py-2.5 px-4">Formu gönderir veya bağlı eylemi tetikler.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
