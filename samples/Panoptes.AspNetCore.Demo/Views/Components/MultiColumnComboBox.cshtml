@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "MultiColumnComboBox - Panoptes Enterprise UI" : "MultiColumnComboBox (Çok Sütunlu Liste) - Panoptes Kurumsal UI";
    var employeesJson = "[{\"id\":101,\"name\":\"Ahmet Yılmaz\",\"title\":\"Yazılım Mimarı\",\"dept\":\"Ar-Ge\",\"city\":\"İstanbul\"},{\"id\":102,\"name\":\"Ayşe Kaya\",\"title\":\"Ürün Müdürü\",\"dept\":\"Ürün\",\"city\":\"Ankara\"},{\"id\":103,\"name\":\"Mehmet Demir\",\"title\":\"DevOps Mühendisi\",\"dept\":\"BT\",\"city\":\"İzmir\"},{\"id\":104,\"name\":\"Zeynep Şahin\",\"title\":\"UI/UX Tasarımcı\",\"dept\":\"Tasarım\",\"city\":\"Bursa\"},{\"id\":105,\"name\":\"Can Yıldız\",\"title\":\"Frontend Geliştirici\",\"dept\":\"Ar-Ge\",\"city\":\"Antalya\"},{\"id\":106,\"name\":\"Elif Kara\",\"title\":\"Veri Analisti\",\"dept\":\"İş Zekası\",\"city\":\"İstanbul\"}]";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/Components/MultiColumnComboBox" : "/Components/MultiColumnComboBox")" class="hover:text-blue-600 transition">@(isEn ? "Form Components" : "Form Bileşenleri")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">MultiColumnComboBox</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">MultiColumnComboBox @(isEn ? "" : "(Çok Sütunlu Liste)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-multicolumncombobox&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "WAI-ARIA Compliant" : "WAI-ARIA Uyumlu")
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Pick from code+name+price grids; find the right item on product cards."
                    : "Kod+ad+fiyat tablosundan seçim; ürün kartında doğru kalemi bulma.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold shrink-0">
                ✓ @(isEn ? "Mini Grid + Search" : "Mini Grid + Tablo Arama")
            </span>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>@(isEn ? "Demos & Showcase" : "Örnekler (Features)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">2</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>API @(isEn ? "Reference" : "Referansı (Props & Events)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">6</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>@(isEn ? "Accessibility (WAI-ARIA)" : "Erişilebilirlik (WAI-ARIA)")</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">

        <!-- 1. Temel Kullanım & Sütun Tanımları -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="border-b border-slate-100 pb-4 mb-6">
                <h2 class="text-base font-bold text-slate-800">
                    @(isEn ? "1. Basic Multi-Column Grid Dropdown" : "1. Temel Kullanım & Çocuk Etiketlerle Sütun Tanımı (TagHelper Columns)")
                </h2>
                <p class="text-xs text-slate-500 mt-1">
                    @(isEn 
                        ? "Employee ID, Name, Title, and Department are presented in a clean tabular grid inside the dropdown popup with instant search."
                        : "Açılır listede personelin ID'si, Adı, Unvanı ve Departmanı ayrı sütunlarda tablo şeklinde listelenir. Yazdıkça anında filtrelenir.")
                </p>
            </div>

            <div class="max-w-md space-y-2 mb-6">
                <label class="block text-xs font-bold text-slate-700">@(isEn ? "Select Employee (Multi-Column)" : "Personel Seçiniz (Çok Sütunlu)")</label>
                <panoptes-multicolumncombobox id="mccb_basic"
                                            text-field="name"
                                            value-field="id"
                                            options="@employeesJson"
                                            placeholder="@(isEn ? "Type employee name or title..." : "Personel adı veya unvan yazın...")"
                                            dropdown-width="580px">
                    <panoptes-mccb-column field="id" title="Sicil" width="70px" align="center" />
                    <panoptes-mccb-column field="name" title="Ad Soyad" width="160px" />
                    <panoptes-mccb-column field="title" title="Unvan" width="180px" />
                    <panoptes-mccb-column field="dept" title="Departman" width="170px" />
                </panoptes-multicolumncombobox>
                <span class="text-[11px] text-slate-400">
                    @(isEn 
                        ? "Tips: Type to filter columns, navigate rows with Up/Down arrows, or click the trigger icon." 
                        : "İpuçları: Klavyeden arama yapabilir, yön tuşlarıyla gezinebilir veya oka tıklayarak tabloyu açabilirsiniz.")
                </span>
            </div>

            <!-- Tabbed Light Code Block (Prime standard) -->
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
                <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>@(isEn ? "Copy" : "Kopyala")</span>
                    </button>
                </div>
                <div class="panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-multicolumncombobox id="mccb_basic"
                             text-field="name"
                             value-field="id"
                             options="@@employeesJson"
                             placeholder="Personel adı veya unvan yazın..."
                             dropdown-width="580px"&gt;
    &lt;panoptes-mccb-column field="id" title="Sicil" width="70px" align="center" /&gt;
    &lt;panoptes-mccb-column field="name" title="Ad Soyad" width="160px" /&gt;
    &lt;panoptes-mccb-column field="title" title="Unvan" width="180px" /&gt;
    &lt;panoptes-mccb-column field="dept" title="Departman" width="170px" /&gt;
&lt;/panoptes-multicolumncombobox&gt;</code></pre>
                </div>
            </div>
        </div>

        <!-- 2. Live API & Events Interactive Demo -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-6">
            <div class="border-b border-slate-100 pb-4">
                <h2 class="text-base font-bold text-slate-800">
                    @(isEn ? "2. JavaScript Client API & Live Events" : "2. İstemci JavaScript API & Canlı Olay Günlüğü")
                </h2>
                <p class="text-xs text-slate-500 mt-1">
                    @(isEn 
                        ? "Select items programmatically, read data items, toggle enable/disable state, and monitor live change/select events."
                        : "Programatik değer atama, veri nesnesi okuma, kilitleme/aktifleştirme ve canlı olay takibi.")
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
                <div class="space-y-4">
                    <div class="space-y-2">
                        <label class="block text-xs font-bold text-slate-700">@(isEn ? "Interactive Demo Component" : "Etkileşimli Bileşen")</label>
                        <panoptes-multicolumncombobox id="mccb_api_demo"
                                                    text-field="name"
                                                    value-field="id"
                                                    options="@employeesJson"
                                                    placeholder="@(isEn ? "Select employee..." : "Personel seçiniz...")"
                                                    dropdown-width="560px">
                            <panoptes-mccb-column field="id" title="Sicil" width="60px" align="center" />
                            <panoptes-mccb-column field="name" title="Ad Soyad" width="160px" />
                            <panoptes-mccb-column field="title" title="Unvan" width="180px" />
                            <panoptes-mccb-column field="city" title="Şehir" width="120px" />
                        </panoptes-multicolumncombobox>
                    </div>

                    <!-- API Controls Buttons -->
                    <div class="flex flex-wrap gap-2 pt-2">
                        <button type="button" onclick="mccbSelectAhmet()" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 border border-blue-200 transition cursor-pointer">
                            @(isEn ? "Select Ahmet (101)" : "Ahmet Seç (101)")
                        </button>
                        <button type="button" onclick="mccbSelectElif()" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200 transition cursor-pointer">
                            @(isEn ? "Select Elif (106)" : "Elif Seç (106)")
                        </button>
                        <button type="button" onclick="mccbReadSelected()" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition cursor-pointer">
                            @(isEn ? "Read Selected" : "Seçiliyi Oku")
                        </button>
                        <button type="button" onclick="mccbToggleEnable()" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-amber-50 text-amber-700 hover:bg-amber-100 border border-amber-200 transition cursor-pointer">
                            @(isEn ? "Toggle Enable" : "Aktif/Pasif")
                        </button>
                        <button type="button" onclick="mccbClear()" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 transition cursor-pointer">
                            @(isEn ? "Clear" : "Temizle")
                        </button>
                    </div>
                </div>

                <!-- Event Log Console -->
                <div class="bg-slate-950 p-4 rounded-xl text-xs font-mono text-slate-300 border border-slate-800 shadow-inner">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-2 mb-2">
                        <span class="font-bold text-slate-400 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            @(isEn ? "Live Event Console" : "Etkileşimli Olay Konsolu (Live Events)")
                        </span>
                        <button type="button" onclick="document.getElementById('eventLogMccb').innerHTML=''" class="text-[11px] text-slate-400 hover:text-slate-200 transition cursor-pointer">@(isEn ? "Clear" : "Temizle")</button>
                    </div>
                    <div id="eventLogMccb" class="space-y-1 max-h-48 overflow-y-auto font-mono text-[11px]">
                        <div class="text-slate-500">@(isEn ? "[Ready] Listening for events (change, select, filter)..." : "[Hazır] Olaylar dinleniyor (change, select, filter)...")</div>
                    </div>
                </div>
            </div>

            <!-- Tabbed Light Code Block (Prime standard) -->
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
                <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-amber-600 bg-white border border-slate-200 shadow-2xs font-mono">JavaScript API</span>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>@(isEn ? "Copy" : "Kopyala")</span>
                    </button>
                </div>
                <div class="panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>// JavaScript API Kullanımı
const mccb = window.Panoptes.MultiColumnComboBox.instances.get("mccb_api_demo");

mccb.value("101");               // Değere göre seçer
mccb.text("Özel Metin");         // Girdi metnini günceller
const item = mccb.dataItem();    // Seçili tam veri nesnesini döndürür
mccb.enable(false);              // Kilitler / Pasifleştirir
mccb.enable(true);               // Aktifleştirir
mccb.clear();                    // Temizler</code></pre>
                </div>
            </div>
        </div>

    </div>

    <!-- PANEL 2: API & ATTRIBUTES -->
    <div id="panel-api" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">@(isEn ? "TagHelper Attributes & Properties" : "TagHelper Özellikleri & Parametreleri")</h3>
                    <p class="text-xs text-slate-500 mt-0.5">&lt;panoptes-multicolumncombobox&gt; @(isEn ? "supported C# and HTML attributes." : "bileşeninin desteklediği tüm C# ve HTML nitelikleri.")</p>
                </div>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-blue-100 text-blue-800">PanoptesMulticolumncomboboxTagHelper</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                            <th class="py-3 px-6">@(isEn ? "Attribute" : "Özellik (Attribute)")</th>
                            <th class="py-3 px-4">@(isEn ? "Type" : "Tip (C#)")</th>
                            <th class="py-3 px-4">@(isEn ? "Default" : "Varsayılan")</th>
                            <th class="py-3 px-6">@(isEn ? "Description" : "Açıklama")</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">id</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">Otomatik</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Unique component ID." : "Bileşen kimliği.")</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">options</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string / IEnumerable</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "JSON array or C# model collection for table rows." : "Tablo satırları için veri kaynağı (JSON dizisi veya C# modeli).")</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">text-field</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">"text"</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Field to display in the main input box upon selection." : "Seçim yapıldığında ana kutuda görüntülenecek alan adı.")</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">value-field</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">"value"</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Field to store in the form value." : "Form değeri olarak tutulacak anahtar alan.")</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">dropdown-width</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">"100%"</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Custom width for the dropdown grid popup (e.g., '600px')." : "Açılır ızgara menüsünün özel genişliği (örn: '580px').")</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">placeholder</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Input placeholder hint text." : "Giriş kutusu yer tutucu metni.")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PANEL 3: ACCESSIBILITY (WAI-ARIA & KEYBOARD) -->
    <div id="panel-a11y" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
            <div>
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
                    @(isEn ? "WAI-ARIA Standards & Keyboard Accessibility" : "WAI-ARIA Standartları & Klavye Erişilebilirliği")
                </h2>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                    @(isEn 
                        ? "Panoptes MultiColumnComboBox conforms to W3C WAI-ARIA Combobox and Grid standards, fully operational via screen readers and pure keyboard navigation." 
                        : "Panoptes MultiColumnComboBox bileşeni, W3C WAI-ARIA standartlarına uygun olarak ekran okuyucular ve salt klavye navigasyonu için tasarlanmıştır.")
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">WAI-ARIA @(isEn ? "Attributes" : "Nitelikleri")</div>
                    <div class="text-slate-600">
                        @(isEn 
                            ? "Uses role=\"combobox\" and popup role=\"grid\". Attributes like aria-expanded, aria-selected, and aria-controls update dynamically."
                            : "Standart role=\"combobox / grid\" rolünü taşır. Duruma göre aria-disabled, aria-expanded, aria-selected ve aria-controls nitelikleri dinamik olarak güncellenir.")
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">@(isEn ? "Focus Management" : "Odak Yönetimi")</div>
                    <div class="text-slate-600">
                        @(isEn 
                            ? "Natural tab order with tabIndex=\"0\" and high-contrast visible focus rings."
                            : "Sekme sırasını doğal akışında korur (tabIndex=\"0\"). Görsel odak halkaları (focus ring) yüksek kontrastla görünür durumdadır.")
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <h3 class="text-sm font-bold text-slate-900 mb-3">@(isEn ? "Keyboard Shortcuts" : "Klavye Kısayolları (Keyboard Shortcuts)")</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                                <th class="py-2.5 px-4 w-48">@(isEn ? "Key" : "Tuş (Key)")</th>
                                <th class="py-2.5 px-4">@(isEn ? "Function" : "İşlev (Function)")</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Alt + Down Arrow</kbd></td>
                                <td class="py-2.5 px-4">@(isEn ? "Opens the multi-column table popup." : "Çok sütunlu ızgara menüsünü açar.")</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Up / Down Arrow</kbd></td>
                                <td class="py-2.5 px-4">@(isEn ? "Navigates between table rows." : "Tablo satırları arasında hareket eder.")</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Enter</kbd></td>
                                <td class="py-2.5 px-4">@(isEn ? "Selects highlighted row and closes popup." : "Satırı seçer ve menüyü kapatır.")</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Esc</kbd></td>
                                <td class="py-2.5 px-4">@(isEn ? "Closes the popup without changing selection." : "Seçimi değiştirmeden menüyü kapatır.")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function logMccbEvent(msg) {
        const log = document.getElementById('eventLogMccb');
        if (!log) return;
        const time = new Date().toLocaleTimeString();
        const div = document.createElement('div');
        div.innerHTML = `<span class="text-slate-600">[${time}]</span> ${msg}`;
        log.prepend(div);
    }

    function mccbSelectAhmet() {
        const inst = window.Panoptes?.MultiColumnComboBox?.instances?.get('mccb_api_demo');
        if (inst) inst.value('101');
    }

    function mccbSelectElif() {
        const inst = window.Panoptes?.MultiColumnComboBox?.instances?.get('mccb_api_demo');
        if (inst) inst.value('106');
    }

    function mccbReadSelected() {
        const inst = window.Panoptes?.MultiColumnComboBox?.instances?.get('mccb_api_demo');
        if (inst) {
            const data = inst.dataItem();
            if (data) {
                logMccbEvent(`dataItem: <span class="text-amber-400 font-bold">${data.name}</span> (${data.title} - ${data.dept || data.department})`);
            } else {
                logMccbEvent(`dataItem: <span class="text-slate-400">Hiçbir öğe seçili değil.</span>`);
            }
        }
    }

    function mccbClear() {
        const inst = window.Panoptes?.MultiColumnComboBox?.instances?.get('mccb_api_demo');
        if (inst) inst.clear();
    }

    let mccbEnabled = true;
    function mccbToggleEnable() {
        const inst = window.Panoptes?.MultiColumnComboBox?.instances?.get('mccb_api_demo');
        if (inst) {
            mccbEnabled = !mccbEnabled;
            inst.enable(mccbEnabled);
            logMccbEvent(`Durum: <span class="font-bold text-amber-400">${mccbEnabled ? 'Aktif' : 'Kilitli'}</span>`);
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const demoEl = document.getElementById('mccb_api_demo');
        if (demoEl) {
            demoEl.addEventListener('change', function(e) {
                logMccbEvent(`Olay: <strong class="text-blue-400">change</strong> -> Değer: <span class="text-emerald-400 font-bold">${e.detail?.value || 'Boş'}</span> (Metin: "${e.detail?.text || ''}")`);
            });
            demoEl.addEventListener('select', function(e) {
                logMccbEvent(`Olay: <strong class="text-indigo-400">select</strong> -> Seçilen: <span class="text-cyan-400 font-bold">${e.detail?.dataItem?.name}</span>`);
            });
        }
    });
</script>
