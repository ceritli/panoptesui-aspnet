@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "ActionSheet - Custom Templates & Content" : "ActionSheet - Özel Şablonlar & İçerik (Templates)";
    ViewData["ActiveTab"] = "Templates";
}

<div class="space-y-6">
    <partial name="_ActionSheetNav" />

    <!-- Info Card -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mb-2">@(isEn ? "Custom Content and Templates" : "Özel İçerik ve Şablonlar (Custom Templates)")</h1>
        <p class="text-sm text-slate-600 leading-relaxed">
            @(isEn ? "Embed forms and profile cards; doubles as a filter panel." : "Sayfa içine form ve profil kartı gömülür; filtre paneli gibi kullanılır.")
        </p>
    </div>

    <!-- Live Demo Trigger -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4">
        <h2 class="text-base font-bold text-slate-800">@(isEn ? "Rich Content Sheet Example" : "Zengin İçerikli Alt Sayfa Örneği")</h2>
        <button type="button" onclick="window.Panoptes.ActionSheet.open('filterTemplateSheet')" class="px-4 py-2.5 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition shadow-sm flex items-center gap-2 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
            <span>@(isEn ? "Open Quick Filter & Search Sheet" : "Hızlı Filtreleme & Arama Sayfasını Aç")</span>
        </button>

        <!-- Template ActionSheet with Form Controls Inside -->
        <panoptes-actionsheet id="filterTemplateSheet" title='@(isEn ? "Search & Filter" : "Arama & Filtreleme")' subtitle='@(isEn ? "Select criteria to narrow down results" : "Sonuçları daraltmak için kriterleri seçiniz")'>
            <div class="space-y-4 p-2">
                <!-- Arama Kutusu -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">@(isEn ? "Search Term" : "Arama Kelimesi")</label>
                    <div class="relative">
                        <input type="text" placeholder='@(isEn ? "Product name or code..." : "Ürün adı veya kod...")' class="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </div>
                </div>

                <!-- Durum Seçimi (Pills) -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">@(isEn ? "Order Status" : "Sipariş Durumu")</label>
                    <div class="flex flex-wrap gap-1.5">
                        <button type="button" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white cursor-pointer">@(isEn ? "All" : "Tümü")</button>
                        <button type="button" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer">@(isEn ? "Approved" : "Onaylandı")</button>
                        <button type="button" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer">@(isEn ? "In Transit" : "Kargoda")</button>
                        <button type="button" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer">@(isEn ? "Completed" : "Tamamlandı")</button>
                    </div>
                </div>

                <!-- Toggle Switch -->
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                    <div>
                        <div class="text-xs font-bold text-slate-800">@(isEn ? "Discounted Products Only" : "Yalnızca İndirimli Ürünler")</div>
                        <div class="text-[11px] text-slate-500">@(isEn ? "List promotional items only" : "Kampanyalı ürünleri listele")</div>
                    </div>
                    <input type="checkbox" checked class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500" />
                </div>

                <!-- Footer Butonları -->
                <div class="flex items-center gap-2 pt-2 border-t border-slate-100">
                    <button type="button" onclick="window.Panoptes.ActionSheet.close('filterTemplateSheet')" class="flex-1 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition shadow-sm cursor-pointer">
                        @(isEn ? "Apply Filter" : "Filtreyi Uygula")
                    </button>
                    <button type="button" onclick="window.Panoptes.ActionSheet.close('filterTemplateSheet')" class="px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-xs font-bold hover:bg-slate-50 transition cursor-pointer">
                        @(isEn ? "Cancel" : "Vazgeç")
                    </button>
                </div>
            </div>
        </panoptes-actionsheet>
    </div>

    <!-- Code Snippet -->
    <div class="panoptes-code-block rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-actionsheet id=&quot;filterTemplateSheet&quot; title=&quot;Arama & Filtreleme&quot;&gt;
    &lt;!-- İçerisinde serbest form ve kontroller yer alabilir --&gt;
    &lt;div class=&quot;p-2 space-y-4&quot;&gt;
        &lt;input type=&quot;text&quot; placeholder=&quot;Arama...&quot; class=&quot;form-input&quot; /&gt;
        &lt;button type=&quot;button&quot; onclick=&quot;window.Panoptes.ActionSheet.close('filterTemplateSheet')&quot;&gt;
            Filtreyi Uygula
        &lt;/button&gt;
    &lt;/div&gt;
&lt;/panoptes-actionsheet&gt;</code></pre>
        </div>
    </div>
</div>
