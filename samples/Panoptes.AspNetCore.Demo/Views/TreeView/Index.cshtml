@model List<Panoptes.AspNetCore.Models.TreeViewItemModel>

@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "TreeView - Panoptes UI" : "TreeView (Ağaç Görünümü) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="/" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="/TreeView" class="hover:text-blue-600 transition">@(isEn ? "Navigation & Layout" : "Navigasyon & Düzen")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">TreeView</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">TreeView @(isEn ? "(Hierarchical Tree View)" : "(Ağaç Görünümü)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-treeview&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "WAI-ARIA Compliant" : "WAI-ARIA Uyumlu")
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn ? "Multi-level hierarchical tree view for folder directories, organizational charts, checkboxes with tri-state selection, and programmatic API." : "Klasör dizinleri, organizasyon şemaları ve hiyerarşik veriler için çok seviyeli ağaç görünümü, onay kutuları ve sürükle-bırak desteği.")
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>@(isEn ? "Examples (Features)" : "Örnekler (Features)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">5</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>@(isEn ? "API Reference (Props & Events)" : "API Referansı (Props & Events)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">3</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>@(isEn ? "Accessibility (WAI-ARIA)" : "Erişilebilirlik (WAI-ARIA)")</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
<!-- DEMO 1: Standart Hiyerarşik Klasör Ağacı -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                    1. Standart Hiyerarşik Klasör Ağacı
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Katlanabilir klasörler, dosya ikonları, rozetler ve seçilebilir satır yapısı.
                </p>
            </div>
            <span class="text-xs font-mono bg-blue-50 text-blue-700 px-2 py-1 rounded font-medium border border-blue-100">&lt;panoptes-treeview&gt;</span>
        </div>

        <div class="p-6">
            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 max-w-2xl">
                <panoptes-treeview id="demoTreeBasic">
                    <panoptes-treeview-item text="Kurumsal Dosya Sistemi" icon="folder" expanded="true">
                        <panoptes-treeview-item text="Departman Belgeleri" icon="folder" expanded="true">
                            <panoptes-treeview-item text="Mali Tablolar 2026.xlsx" icon="document" badge="Finans" badge-color="emerald" />
                            <panoptes-treeview-item text="İK Personel Listesi.pdf" icon="file" badge="İK" badge-color="blue" />
                            <panoptes-treeview-item text="Gizli Denetim (Kilitli)" icon="document" disabled="true" badge="Erişim Yok" badge-color="red" />
                        </panoptes-treeview-item>
                        <panoptes-treeview-item text="Yazılım Projeleri" icon="folder">
                            <panoptes-treeview-item text="Panoptes UI Çekirdeği" icon="code" badge="v1.0" badge-color="purple" />
                            <panoptes-treeview-item text="PostgreSQL Veritabanı Şeması" icon="database" />
                        </panoptes-treeview-item>
                        <panoptes-treeview-item text="Medya Arşivi" icon="folder">
                            <panoptes-treeview-item text="Kurumsal_Logo.png" icon="image" />
                            <panoptes-treeview-item text="Tanıtım_Afişi.jpg" icon="image" />
                        </panoptes-treeview-item>
                    </panoptes-treeview-item>
                </panoptes-treeview>
            </div>
        </div>

        <!-- Standart Kod Kutusu (1. Resimdeki Standart Kapalı Details) -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-treeview id="demoTreeBasic"&gt;
    &lt;panoptes-treeview-item text="Kurumsal Dosya Sistemi" icon="folder" expanded="true"&gt;
        &lt;panoptes-treeview-item text="Departman Belgeleri" icon="folder" expanded="true"&gt;
            &lt;panoptes-treeview-item text="Mali Tablolar 2026.xlsx" icon="document" badge="Finans" badge-color="emerald" /&gt;
            &lt;panoptes-treeview-item text="İK Personel Listesi.pdf" icon="file" badge="İK" badge-color="blue" /&gt;
        &lt;/panoptes-treeview-item&gt;
    &lt;/panoptes-treeview-item&gt;
&lt;/panoptes-treeview&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 2: Checkbox Çoklu Seçim Modu (Tri-State Indeterminate) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
                    2. Checkbox Çoklu Seçim Modu (Tri-State Indeterminate)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Bir klasörün onay kutusu işaretlendiğinde tüm alt dosyaları otomatik seçilir. Kısmi seçimlerde ebeveyn onay kutusu <code class="text-emerald-700 bg-emerald-50 px-1 py-0.5 rounded font-mono">indeterminate (-)</code> durumuna geçer.
                </p>
            </div>
            <span class="text-xs font-mono bg-emerald-50 text-emerald-700 px-2 py-1 rounded font-medium border border-emerald-100">show-checkboxes="true"</span>
        </div>

        <div class="p-6">
            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 max-w-2xl">
                <panoptes-treeview id="demoTreeCheckbox" show-checkboxes="true" on-check="handleTreeCheck">
                    <panoptes-treeview-item id="grp_root" text="Erişim Yetkileri & Roller" icon="folder" expanded="true">
                        <panoptes-treeview-item id="grp_admin" text="Yönetici Yetkileri" icon="folder" expanded="true">
                            <panoptes-treeview-item id="perm_users" text="Kullanıcıları Listele & Düzenle" checked="true" />
                            <panoptes-treeview-item id="perm_roles" text="Rol Tanımlama & Yetkilendirme" checked="true" />
                            <panoptes-treeview-item id="perm_audit" text="Sistem Denetim Günlükleri (Audit)" />
                        </panoptes-treeview-item>
                        <panoptes-treeview-item id="grp_finance" text="Mali İzinler" icon="folder" expanded="true">
                            <panoptes-treeview-item id="perm_invoices" text="Fatura Kesme ve İptal" />
                            <panoptes-treeview-item id="perm_payment" text="Banka Ödemesi Onaylama" />
                        </panoptes-treeview-item>
                    </panoptes-treeview-item>
                </panoptes-treeview>
            </div>
            <div class="mt-3 text-xs text-slate-500 flex items-center gap-2">
                <span class="font-bold text-slate-700">Seçilen Yetki ID'leri:</span>
                <span id="checkedNodesDisplay" class="font-mono text-blue-600 bg-blue-50 px-2 py-0.5 rounded border border-blue-100">perm_users, perm_roles</span>
            </div>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-treeview id="demoTreeCheckbox" show-checkboxes="true" on-check="handleTreeCheck"&gt;
    &lt;panoptes-treeview-item id="grp_root" text="Erişim Yetkileri" expanded="true"&gt;
        &lt;panoptes-treeview-item id="perm_users" text="Kullanıcı Yönetimi" checked="true" /&gt;
    &lt;/panoptes-treeview-item&gt;
&lt;/panoptes-treeview&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 3: Programatik JavaScript API & Canlı Olay Konsolu -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-purple-600 inline-block"></span>
                    3. Programatik JavaScript API ve Canlı Olay Günlüğü (Event Log)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Harici butonlarla ağacı açma/kapatma (<code class="text-purple-700 bg-purple-50 px-1 py-0.5 rounded font-mono">expandAll</code>, <code class="text-purple-700 bg-purple-50 px-1 py-0.5 rounded font-mono">collapseAll</code>), tümünü seçme ve seçim/genişletme olaylarını izleme.
                </p>
            </div>
            <span class="text-xs font-mono bg-purple-50 text-purple-700 px-2 py-1 rounded font-medium border border-purple-100">panoptesTreeView API</span>
        </div>

        <div class="p-6 space-y-6">
            <!-- Butonlar -->
            <div class="flex flex-wrap items-center gap-2">
                <button type="button" onclick="window.treeExpandAll()" class="px-3 py-1.5 text-xs font-medium text-purple-700 bg-purple-50 hover:bg-purple-100 rounded-lg border border-purple-200 transition">
                    Tümünü Genişlet (expandAll)
                </button>
                <button type="button" onclick="window.treeCollapseAll()" class="px-3 py-1.5 text-xs font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg border border-slate-200 transition">
                    Tümünü Daralt (collapseAll)
                </button>
                <button type="button" onclick="window.treeCheckAll()" class="px-3 py-1.5 text-xs font-medium text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-lg border border-emerald-200 transition">
                    Tümünü Seç (checkAll)
                </button>
                <button type="button" onclick="window.treeUncheckAll()" class="px-3 py-1.5 text-xs font-medium text-amber-700 bg-amber-50 hover:bg-amber-100 rounded-lg border border-amber-200 transition">
                    Tüm Seçimleri Kaldır (uncheckAll)
                </button>
                <button type="button" onclick="window.clearTreeLog()" class="px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 rounded-lg border border-red-200 transition ml-auto">
                    Konsolu Temizle
                </button>
            </div>

            <!-- Ağaç Bileşeni -->
            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 max-w-2xl">
                <panoptes-treeview id="demoTreeApi" show-checkboxes="true" on-select="handleTreeSelect" on-expand="handleTreeExpand" on-collapse="handleTreeCollapse">
                    <panoptes-treeview-item id="api_root" text="Bulut Altyapısı (AWS & GCP)" icon="folder" expanded="true">
                        <panoptes-treeview-item id="api_compute" text="İşlem Kümeleri (Kubernetes)" icon="folder" expanded="true">
                            <panoptes-treeview-item id="pod_web" text="k8s-pod-frontend (React)" icon="code" badge="Aktif" badge-color="emerald" />
                            <panoptes-treeview-item id="pod_api" text="k8s-pod-gateway (ASP.NET Core)" icon="code" badge="Aktif" badge-color="emerald" />
                        </panoptes-treeview-item>
                        <panoptes-treeview-item id="api_storage" text="Veri Depolama" icon="folder">
                            <panoptes-treeview-item id="s3_bucket" text="s3-panoptes-assets" icon="database" />
                            <panoptes-treeview-item id="redis_cache" text="redis-session-store" icon="database" />
                        </panoptes-treeview-item>
                    </panoptes-treeview-item>
                </panoptes-treeview>
            </div>

            <!-- Canlı Olay Günlüğü Konsolu -->
            <div class="mt-4">
                <div class="flex items-center justify-between mb-1.5">
                    <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        Canlı Olay Günlüğü (Event Log Console)
                    </span>
                    <span id="treeEventCount" class="text-[11px] font-mono text-slate-400">0 olay tetiklendi</span>
                </div>
                <div id="treeEventLogContainer" class="bg-slate-900 text-slate-200 font-mono text-[11px] p-3 rounded-lg h-32 overflow-y-auto space-y-1 shadow-inner border border-slate-800">
                    <div class="text-slate-500 italic">// Ağaç düğümlerine tıklayın veya butonları kullanın, olaylar burada görünecektir.</div>
                </div>
            </div>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>// TreeView örneğini alma
const tree = window.panoptesTreeView.getInstance('demoTreeApi');

// Programatik API fonksiyonları
tree.expandAll();
tree.collapseAll();
tree.checkAll();
tree.uncheckAll();
const selected = tree.getCheckedIds();</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 4: C# Modelinden Dinamik Hiyerarşik Bağlama -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-600 inline-block"></span>
                    4. C# Modelinden Dinamik Hiyerarşik Bağlama (Model Binding)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Controller'da oluşturulmuş çok seviyeli hiyerarşik <code class="text-amber-700 bg-amber-50 px-1 py-0.5 rounded font-mono">List&lt;TreeViewItemModel&gt;</code> modelinin <code class="text-amber-700 bg-amber-50 px-1 py-0.5 rounded font-mono">items="@@Model"</code> ile render edilmesi.
                </p>
            </div>
            <span class="text-xs font-mono bg-amber-50 text-amber-700 px-2 py-1 rounded font-medium border border-amber-100">items="@@Model"</span>
        </div>

        <div class="p-6">
            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 max-w-2xl">
                <panoptes-treeview id="demoTreeModel" items="@Model" />
            </div>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
