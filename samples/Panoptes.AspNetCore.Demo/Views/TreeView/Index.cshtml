@section Scripts {
<script>
let treeEventCounter = 0;

        function logTreeEvent(action, text, detail) {
            treeEventCounter++;
            const counterEl = document.getElementById('treeEventCount');
            if (counterEl) counterEl.textContent = `${treeEventCounter} olay tetiklendi`;

            const container = document.getElementById('treeEventLogContainer');
            if (!container) return;
            const time = new Date().toLocaleTimeString();

            const entry = document.createElement('div');
            entry.className = 'flex items-center gap-2 py-0.5 border-b border-slate-800/60';
            entry.innerHTML = `
                <span class="text-slate-500">[${time}]</span>
                <span class="font-bold text-purple-400">${action}</span>
                <span class="text-slate-300 font-medium">"${text}"</span>
                ${detail ? `<span class="text-slate-400">(${detail})</span>` : ''}
            `;

            if (container.querySelector('.italic')) container.innerHTML = '';
            container.prepend(entry);
        }

        function handleTreeSelect(e) {
            logTreeEvent('SELECT', e.text, `id: ${e.id}`);
        }

        function handleTreeExpand(e) {
            logTreeEvent('EXPAND', e.text, `id: ${e.id}`);
        }

        function handleTreeCollapse(e) {
            logTreeEvent('COLLAPSE', e.text, `id: ${e.id}`);
        }

        function handleTreeCheck(e) {
            logTreeEvent('CHECK', e.text, `durum: ${e.checked}`);
            const displayEl = document.getElementById('checkedNodesDisplay');
            if (displayEl) {
                displayEl.textContent = e.checkedIds && e.checkedIds.length > 0 ? e.checkedIds.join(', ') : '(seçim yok)';
            }
        }

        function getDemoTree() {
            return window.panoptesTreeView?.getInstance('demoTreeApi');
        }

        window.treeExpandAll = function () {
            const tree = getDemoTree();
            if (tree) {
                tree.expandAll();
                logTreeEvent('API_CALL', 'demoTreeApi', 'expandAll() çağrıldı');
            }
        };

        window.treeCollapseAll = function () {
            const tree = getDemoTree();
            if (tree) {
                tree.collapseAll();
                logTreeEvent('API_CALL', 'demoTreeApi', 'collapseAll() çağrıldı');
            }
        };

        window.treeCheckAll = function () {
            const tree = getDemoTree();
            if (tree) {
                tree.checkAll();
                logTreeEvent('API_CALL', 'demoTreeApi', 'checkAll() çağrıldı');
            }
        };

        window.treeUncheckAll = function () {
            const tree = getDemoTree();
            if (tree) {
                tree.uncheckAll();
                logTreeEvent('API_CALL', 'demoTreeApi', 'uncheckAll() çağrıldı');
            }
        };

        window.clearTreeLog = function () {
            treeEventCounter = 0;
            const counterEl = document.getElementById('treeEventCount');
            if (counterEl) counterEl.textContent = '0 olay tetiklendi';
            const container = document.getElementById('treeEventLogContainer');
            if (container) container.innerHTML = '<div class="text-slate-500 italic">// Olay günlüğü temizlendi.</div>';
        };
</script>
}
