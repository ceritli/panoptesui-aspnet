                    <panoptes-breadcrumb-item text="Kurumsal UI Kit" url="/Breadcrumb" />
                    <panoptes-breadcrumb-item text="Bileşenler" url="/Breadcrumb" />
                    <panoptes-breadcrumb-item text="Breadcrumb" is-current="true" />
                </panoptes-breadcrumb>
            </div>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-breadcrumb delimiter="slash"&gt;
    &lt;panoptes-breadcrumb-item text="Projeler" url="/" icon="folder" /&gt;
    &lt;panoptes-breadcrumb-item text="Kurumsal UI Kit" url="/Projects/Panoptes" /&gt;
    &lt;panoptes-breadcrumb-item text="Bileşenler" url="/Components" /&gt;
    &lt;panoptes-breadcrumb-item text="Breadcrumb" is-current="true" /&gt;
&lt;/panoptes-breadcrumb&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 3: Ok Ayracı & Pasif Öğe (Arrow Delimiter & Disabled Item) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-purple-600 inline-block"></span>
                    3. Ok Ayracı ve Pasif/Erişilemez Öğe (Arrow Delimiter & Disabled)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Sağa dönük ok simgesi (<code class="text-purple-700 bg-purple-50 px-1 py-0.5 rounded font-mono">arrow</code>) ve tıklanamayan devre dışı (<code class="text-purple-700 bg-purple-50 px-1 py-0.5 rounded font-mono">disabled="true"</code>) ara bağlantı örneği.
                </p>
            </div>
            <span class="text-xs font-mono bg-purple-50 text-purple-700 px-2 py-1 rounded font-medium border border-purple-100">delimiter="arrow"</span>
        </div>

        <div class="p-6">
            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 max-w-3xl">
                <panoptes-breadcrumb delimiter="arrow">
