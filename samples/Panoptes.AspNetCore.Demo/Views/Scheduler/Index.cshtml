@model List<Panoptes.AspNetCore.Models.SchedulerEventModel>
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Scheduler (Calendar & Appointment Engine) - Panoptes Corporate UI" : "Scheduler (Takvim & Randevu Yönetimi) - Panoptes Kurumsal UI";
    ViewData["ActiveTab"] = "Overview";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="/" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="/Scheduler" class="hover:text-blue-600 transition">@(isEn ? "Scheduling & Project" : "Planlama & Proje")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">Scheduler</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Scheduler @(isEn ? "(Calendar & Appointments)" : "(Takvim & Randevu Yönetimi)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-scheduler&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "WAI-ARIA Compliant" : "WAI-ARIA Uyumlu")
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn ? "Drag-and-drop calendars for appointments and shifts; clinics and field teams." : "Randevu ve vardiya planlamada sürükle-bırak takvim; klinik ve saha ekipleri için.")
            </p>
        </div>
    </div>

    <!-- Sub Navigation -->
    <partial name="_SchedulerNav" />

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>@(isEn ? "Features & Demos" : "Örnekler (Features)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">1</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>@(isEn ? "API Reference (Props & Events)" : "API Referansı (Props & Events)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">3</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>@(isEn ? "Accessibility (WAI-ARIA)" : "Erişilebilirlik (WAI-ARIA)")</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="border-b border-slate-100 pb-4 mb-6">
                <h2 class="text-base font-bold text-slate-800">@(isEn ? "Full-Featured Calendar Demonstration" : "Tam Özellikli Takvim Demonstrasyonu")</h2>
                <p class="text-xs text-slate-500 mt-1">
                    @(isEn ? "Multi-view scheduling, resource grouping, drag-and-drop editing, PDF export, and rich appointment cards." : "Görünümler, kaynak gruplama, düzenleme (Sürükle&Bırak), PDF dışa aktarma, çoklu kaynak bağlama ve daha fazlası.")
                </p>
            </div>

            <div class="w-full">
                <panoptes-scheduler id="schedFullDemo" 
                                    default-view="@Panoptes.AspNetCore.Models.SchedulerViewType.Week" 
                                    events="@Model" 
                                    editable="true"
                                    selectable="multiple"
                                    toolbar="pdf, search, today, prev, next, views"
                                    pdf-file-name="Takvim_Raporu.pdf"
                                    group-resources="RoomId, Attendees"
                                    group-orientation="horizontal"
                                    current-time-marker="true"
                                    more-events-popover="true"
                                    on-event-click="handleSchedulerEventClick">
                    
                    <panoptes-scheduler-view type="@Panoptes.AspNetCore.Models.SchedulerViewType.Day"></panoptes-scheduler-view>
                    <panoptes-scheduler-view type="@Panoptes.AspNetCore.Models.SchedulerViewType.Week"></panoptes-scheduler-view>
                    <panoptes-scheduler-view type="@Panoptes.AspNetCore.Models.SchedulerViewType.Month"></panoptes-scheduler-view>
                    <panoptes-scheduler-view type="@Panoptes.AspNetCore.Models.SchedulerViewType.TimelineMonth"></panoptes-scheduler-view>
                    <panoptes-scheduler-view type="@Panoptes.AspNetCore.Models.SchedulerViewType.Agenda"></panoptes-scheduler-view>

                    <panoptes-scheduler-resource field="RoomId" title="@(isEn ? "Meeting Room" : "Toplantı Odası")" multiple="false">
                        <panoptes-scheduler-resource-item value="1" text="@(isEn ? "Main Conference Hall A" : "Ana Toplantı Salonu A")" color="#3b82f6" />
                        <panoptes-scheduler-resource-item value="2" text="@(isEn ? "Room 204" : "Oda 204")" color="#10b981" />
                    </panoptes-scheduler-resource>

                    <panoptes-scheduler-resource field="Attendees" title="@(isEn ? "Attendees" : "Katılımcılar")" multiple="true">
                        <panoptes-scheduler-resource-item value="1" text="Fatih" color="#f43f5e" />
                        <panoptes-scheduler-resource-item value="2" text="Ahmet" color="#8b5cf6" />
                        <panoptes-scheduler-resource-item value="3" text="Zeynep" color="#f59e0b" />
                    </panoptes-scheduler-resource>

                </panoptes-scheduler>
            </div>

            <!-- Prime LightCodeViewer -->
            <div class="mt-6">
                <div class="panoptes-code-block border border-slate-200 rounded-xl overflow-hidden shadow-xs">
                    <div class="panoptes-code-header flex items-center justify-between px-4 py-2 bg-slate-50 border-b border-slate-200">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
                        </div>
                        <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            <span>@(isEn ? "Copy" : "Kopyala")</span>
                        </button>
                    </div>
                    <div class="panoptes-code-viewer">
                        <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-scheduler id="schedFullDemo" 
                    default-view="@@Panoptes.AspNetCore.Models.SchedulerViewType.Week" 
                    events="@@Model" 
                    editable="true"
                    selectable="multiple"
                    toolbar="pdf, search, today, prev, next, views"
                    pdf-file-name="Takvim_Raporu.pdf"
                    group-resources="RoomId, Attendees"
                    group-orientation="horizontal"
                    current-time-marker="true"
                    more-events-popover="true"
                    on-event-click="handleSchedulerEventClick"&gt;
    
    &lt;panoptes-scheduler-view type="@@Panoptes.AspNetCore.Models.SchedulerViewType.Day"&gt;&lt;/panoptes-scheduler-view&gt;
    &lt;panoptes-scheduler-view type="@@Panoptes.AspNetCore.Models.SchedulerViewType.Week"&gt;&lt;/panoptes-scheduler-view&gt;
    &lt;panoptes-scheduler-view type="@@Panoptes.AspNetCore.Models.SchedulerViewType.Month"&gt;&lt;/panoptes-scheduler-view&gt;
    &lt;panoptes-scheduler-view type="@@Panoptes.AspNetCore.Models.SchedulerViewType.TimelineMonth"&gt;&lt;/panoptes-scheduler-view&gt;
    &lt;panoptes-scheduler-view type="@@Panoptes.AspNetCore.Models.SchedulerViewType.Agenda"&gt;&lt;/panoptes-scheduler-view&gt;

    &lt;panoptes-scheduler-resource field="RoomId" title="Toplantı Odası" multiple="false"&gt;
        &lt;panoptes-scheduler-resource-item value="1" text="Ana Toplantı Salonu A" color="#3b82f6" /&gt;
        &lt;panoptes-scheduler-resource-item value="2" text="Oda 204" color="#10b981" /&gt;
    &lt;/panoptes-scheduler-resource&gt;

    &lt;panoptes-scheduler-resource field="Attendees" title="Katılımcılar" multiple="true"&gt;
        &lt;panoptes-scheduler-resource-item value="1" text="Fatih" color="#f43f5e" /&gt;
        &lt;panoptes-scheduler-resource-item value="2" text="Ahmet" color="#8b5cf6" /&gt;
        &lt;panoptes-scheduler-resource-item value="3" text="Zeynep" color="#f59e0b" /&gt;
    &lt;/panoptes-scheduler-resource&gt;

&lt;/panoptes-scheduler&gt;</code></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PANEL 2: API & ATTRIBUTES -->
    <div id="panel-api" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">@(isEn ? "TagHelper Properties & Parameters" : "TagHelper Özellikleri & Parametreleri")</h3>
                    <p class="text-xs text-slate-500 mt-0.5">&lt;panoptes-scheduler&gt; @(isEn ? "all supported C# and HTML attributes." : "bileşeninin desteklediği tüm C# ve HTML nitelikleri.")</p>
                </div>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-blue-100 text-blue-800">PanoptesSchedulerTagHelper</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                            <th class="py-3 px-6">@(isEn ? "Attribute" : "Özellik (Attribute)")</th>
                            <th class="py-3 px-4">@(isEn ? "Type (C#)" : "Tip (C#)")</th>
                            <th class="py-3 px-4">@(isEn ? "Default" : "Varsayılan")</th>
                            <th class="py-3 px-6">@(isEn ? "Description" : "Açıklama")</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">id</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">@(isEn ? "Automatic" : "Otomatik")</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Component identifier." : "Bileşen kimliği.")</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">default-view</td>
                            <td class="py-3 px-4 font-mono text-purple-600">SchedulerViewType</td>
                            <td class="py-3 px-4 font-mono text-slate-400">"Week"</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Initial active calendar view." : "Başlangıç aktif takvim görünümü.")</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">editable</td>
                            <td class="py-3 px-4 font-mono text-purple-600">bool</td>
                            <td class="py-3 px-4 font-mono text-slate-400">true</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Allows event creation, dragging, and resizing." : "Yeni randevu ekleme ve düzenleme izni.")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PANEL 3: ACCESSIBILITY (WAI-ARIA & KEYBOARD) -->
    <div id="panel-a11y" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
            <div>
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
                    @(isEn ? "WAI-ARIA Standards & Keyboard Accessibility" : "WAI-ARIA Standartları & Klavye Erişilebilirliği")
                </h2>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                    @(isEn ? "Panoptes Scheduler adheres to W3C WAI-ARIA application grid guidelines for accessible calendar browsing." : "Panoptes Scheduler bileşeni, W3C WAI-ARIA standartlarına uygun olarak ekran okuyucular ve salt klavye navigasyonu için tasarlanmıştır.")
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">@(isEn ? "WAI-ARIA Attributes" : "WAI-ARIA Nitelikleri")</div>
                    <div class="text-slate-600">
                        @(isEn ? "Carries standard role=\"application\" or role=\"grid\". Event slots and time slots contain descriptive aria-label attributes." : "Standart role=\"application / grid\" rolünü taşır. Duruma göre aria-disabled, aria-expanded, aria-selected ve aria-label nitelikleri dinamik olarak güncellenir.")
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">@(isEn ? "Focus Management" : "Odak Yönetimi (Focus Management)")</div>
                    <div class="text-slate-600">
                        @(isEn ? "Maintains intuitive arrow-key navigation between time slots and appointments with visible high-contrast focus rings." : "Sekme sırasını doğal akışında korur (tabIndex=\"0\"). Görsel odak halkaları (focus ring) yüksek kontrastla görünür durumdadır.")
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <h3 class="text-sm font-bold text-slate-900 mb-3">@(isEn ? "Keyboard Shortcuts" : "Klavye Kısayolları (Keyboard Shortcuts)")</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                                <th class="py-2.5 px-4 w-48">@(isEn ? "Key" : "Tuş (Key)")</th>
                                <th class="py-2.5 px-4">@(isEn ? "Function" : "İşlev (Function)")</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">@(isEn ? "Arrow Keys" : "Ok Tuşları")</kbd></td>
                                <td class="py-2.5 px-4">@(isEn ? "Navigates between calendar slots and appointments." : "Takvim hücreleri ve randevular arasında gezinir.")</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Enter</kbd></td>
                                <td class="py-2.5 px-4">@(isEn ? "Opens appointment details or edit modal." : "Randevu detay penceresini açar.")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function handleSchedulerEventClick(e) {
            console.log("Scheduler Event Clicked:", e);
        }
    </script>
}
