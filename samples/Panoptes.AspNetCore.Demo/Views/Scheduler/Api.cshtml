@model List<Panoptes.AspNetCore.Models.SchedulerEventModel>
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Scheduler - Client API & Methods - Panoptes Corporate UI" : "Scheduler - API & Metotlar - Panoptes Kurumsal UI";
    ViewData["ActiveTab"] = "Api";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="/" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="/Scheduler" class="hover:text-blue-600 transition">Scheduler</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">@(isEn ? "Client API" : "İstemci API")</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "Client API Methods & External Controls" : "İstemci API Metotları ve Harici Kontroller")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    PanoptesUI.get("schedApiDemo")
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    JavaScript API
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn ? "Control views, jump to specific dates, trigger exports and manage appointments dynamically from external buttons." : "Dış butonlar aracılığıyla JavaScript API'sini kullanarak görünümleri, tarihleri ve dışa aktarma seçeneklerini dinamik olarak yönetin.")
            </p>
        </div>
    </div>

    <!-- Sub Navigation -->
    <partial name="_SchedulerNav" />

    <!-- Demo Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "Interactive API Controls" : "Harici API Kontrolleri (JavaScript)")</h2>
            <p class="text-xs text-slate-500 mt-1">
                @(isEn ? "Click external buttons below to manipulate the calendar instance via client methods." : "Aşağıdaki butonları kullanarak takvim örneğini istemci metotlarıyla yönetebilirsiniz.")
            </p>
        </div>

        <div class="flex flex-wrap gap-2 mb-4">
            <button class="px-3 py-1.5 text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition cursor-pointer" onclick="setDayView()">@(isEn ? "Switch to Day View" : "Günlük Görünüme Geç")</button>
            <button class="px-3 py-1.5 text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition cursor-pointer" onclick="setMonthView()">@(isEn ? "Switch to Month View" : "Aylık Görünüme Geç")</button>
            <button class="px-3 py-1.5 text-xs font-semibold bg-indigo-50 hover:bg-indigo-100 text-indigo-700 rounded-lg transition cursor-pointer" onclick="goNextWeek()">@(isEn ? "Jump to Next Week" : "Sonraki Haftaya Atla")</button>
            <button class="px-3 py-1.5 text-xs font-semibold bg-rose-50 hover:bg-rose-100 text-rose-700 rounded-lg transition cursor-pointer" onclick="exportPDF()">@(isEn ? "Export as PDF" : "PDF Olarak İndir")</button>
        </div>

        <div class="w-full">
            <panoptes-scheduler id="schedApiDemo" 
                                default-view="@Panoptes.AspNetCore.Models.SchedulerViewType.Week" 
                                events="@Model"
                                editable="true">
                <panoptes-scheduler-view type="@Panoptes.AspNetCore.Models.SchedulerViewType.Day"></panoptes-scheduler-view>
                <panoptes-scheduler-view type="@Panoptes.AspNetCore.Models.SchedulerViewType.Week"></panoptes-scheduler-view>
                <panoptes-scheduler-view type="@Panoptes.AspNetCore.Models.SchedulerViewType.Month"></panoptes-scheduler-view>
            </panoptes-scheduler>
        </div>

        <!-- Prime LightCodeViewer -->
        <div class="mt-6">
            <div class="panoptes-code-block border border-slate-200 rounded-xl overflow-hidden shadow-xs">
                <div class="panoptes-code-header flex items-center justify-between px-4 py-2 bg-slate-50 border-b border-slate-200">
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">JavaScript API</span>
                    </div>
                    <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        <span>@(isEn ? "Copy" : "Kopyala")</span>
                    </button>
                </div>
                <div class="panoptes-code-viewer">
                    <pre class="panoptes-raw-code hidden"><code>function getScheduler() {
    return PanoptesUI.get("schedApiDemo");
}

function setDayView() {
    getScheduler().view("day");
}

function setMonthView() {
    getScheduler().view("month");
}

function goNextWeek() {
    var sched = getScheduler();
    var current = sched.date();
    current.setDate(current.getDate() + 7);
    sched.date(current);
}

function exportPDF() {
    getScheduler().saveAsPDF();
}</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getScheduler() {
            return PanoptesUI.get("schedApiDemo");
        }
        function setDayView() {
            const sched = getScheduler();
            if (sched && sched.view) sched.view("day");
        }
        function setMonthView() {
            const sched = getScheduler();
            if (sched && sched.view) sched.view("month");
        }
        function goNextWeek() {
            const sched = getScheduler();
            if (sched && sched.date) {
                var current = sched.date() || new Date();
                current.setDate(current.getDate() + 7);
                sched.date(current);
            }
        }
        function exportPDF() {
            const sched = getScheduler();
            if (sched && sched.saveAsPDF) sched.saveAsPDF();
        }
    </script>
}
