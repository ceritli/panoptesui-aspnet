@{
    var trackingNumber = ViewBag.TrackingNumber as string ?? "PNP-TR-849204";
    var productEan = ViewBag.ProductEan as string ?? "8690123456789";
    var portalUrl = ViewBag.PortalUrl as string ?? "https://panoptes.dev";
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Barcode & QR Code (Generator Engine) - Panoptes Corporate UI" : "Barcode & QR Code (Barkod Üretici) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="/" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="/Barcode" class="hover:text-blue-600 transition">@(isEn ? "Charts & Visuals" : "Grafikler & Görselleştirme")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">Barcode & QR Code</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Barcode & QR Code @(isEn ? "(Generator Engine)" : "(Barkod Üretici)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-barcode&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "WAI-ARIA Compliant" : "WAI-ARIA Uyumlu")
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Lossless client-side vector SVG generation for QR Code, CODE128, EAN-13, EAN-8 and UPC barcode symbologies with zero external dependencies." 
                    : "QR Code, CODE128, EAN-13, EAN-8 ve UPC standartlarında anında SVG vektör formatında kayıpsız barkod ve karekod oluşturan bileşen.")
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>@(isEn ? "Features & Demos" : "Örnekler (Features)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">4</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>@(isEn ? "API Reference (Props & Events)" : "API Referansı (Props & Events)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">3</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>@(isEn ? "Accessibility (WAI-ARIA)" : "Erişilebilirlik (WAI-ARIA)")</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
        <!-- DEMO 1: Code 128 Kargo ve Lojistik Takip Barkodu -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
            <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                        @(isEn ? "1. Code 128 Logistics & Shipment Tracking Barcode" : "1. Code 128 Lojistik & Kargo Gönderi Takip Barkodu")
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">
                        @(isEn 
                            ? "Generates high-precision vector SVG linear barcodes for alphanumeric parcel, box and cargo tracking codes." 
                            : "Alfanümerik koli, paket ve sevkiyat takip numaraları için standart çizgili SVG barkod oluşturur.")
                    </p>
                </div>
                <span class="text-xs font-mono bg-blue-50 text-blue-700 px-2 py-1 rounded font-medium border border-blue-100">&lt;panoptes-barcode type="Code128"&gt;</span>
            </div>

            <div class="p-6 flex flex-col items-center justify-center">
                <panoptes-barcode id="shippingBarcode" 
                                  type="Code128" 
                                  value="@trackingNumber" 
                                  title="Yurt İçi Kargo Takip Kodu" 
                                  width="320" 
                                  height="110" 
                                  show-text="true" />
            </div>

            <!-- Standart Kod Kutusu -->
            <div class="px-6 pb-6">
                <div class="panoptes-code-block rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
                    <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
                        </div>
                        <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            <span>@(isEn ? "Copy" : "Kopyala")</span>
                        </button>
                    </div>
                    <div class="panoptes-code-viewer">
                        <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-barcode id="shippingBarcode" 
                  type="Code128" 
                  value="@@ViewBag.TrackingNumber" 
                  title="Yurt İçi Kargo Takip Kodu" 
                  width="320" 
                  height="110" 
                  show-text="true" /&gt;</code></pre>
                    </div>
                </div>
            </div>
        </div>

        <!-- DEMO 2: EAN-13 Perakende Ürün Barkodu -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
            <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
                        @(isEn ? "2. EAN-13 / Retail FMCG Product Barcode" : "2. EAN-13 / Perakende Market Ürün Barkodu")
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">
                        @(isEn 
                            ? "Crisp vector SVG line bars formatted for 13-digit international GS1 standard retail product barcodes." 
                            : "13 basamaklı uluslararası GS1 ürün numaralandırma standartlarında net SVG çizgileri.")
                    </p>
                </div>
                <span class="text-xs font-mono bg-emerald-50 text-emerald-700 px-2 py-1 rounded font-medium border border-emerald-100">&lt;panoptes-barcode type="EAN13"&gt;</span>
            </div>

            <div class="p-6 flex flex-col items-center justify-center">
                <panoptes-barcode id="productBarcode" 
                                  type="EAN13" 
                                  value="@productEan" 
                                  title="GS1 Türkiye Standart Ürün Kodu" 
                                  width="280" 
                                  height="100" 
                                  show-text="true" />
            </div>

            <!-- Standart Kod Kutusu -->
            <div class="px-6 pb-6">
                <div class="panoptes-code-block rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
                    <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
                        </div>
                        <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            <span>@(isEn ? "Copy" : "Kopyala")</span>
                        </button>
                    </div>
                    <div class="panoptes-code-viewer">
                        <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-barcode id="productBarcode" 
                  type="EAN13" 
                  value="8690123456789" 
                  title="GS1 Türkiye Standart Ürün Kodu" 
                  width="280" 
                  height="100" /&gt;</code></pre>
                    </div>
                </div>
            </div>
        </div>

        <!-- DEMO 3: 2D QRCode (Karekod - URL & Güvenli Doğrulama) -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
            <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-indigo-600 inline-block"></span>
                        @(isEn ? "3. 2D QRCode (Mobile Login & Two-Factor Authentication QR)" : "3. 2D QRCode (Mobil Giriş & İki Aşamalı Güvenlik Karekodu)")
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">
                        @(isEn 
                            ? "Optimized pixel matrix 2D QR code for web URLs, OTP authentication tokens and mobile payment authorizations." 
                            : "Web URL'leri, OTP kimlik doğrulama token'ları ve mobil işlem onayları için optimize edilmiş piksel matrisli karekod.")
                    </p>
                </div>
                <span class="text-xs font-mono bg-indigo-50 text-indigo-700 px-2 py-1 rounded font-medium border border-indigo-100">&lt;panoptes-qrcode size="190"&gt;</span>
            </div>

            <div class="p-6 flex flex-col items-center justify-center">
                <panoptes-qrcode id="portalQrCode" 
                                 value="@portalUrl" 
                                 size="190" 
                                 title="Panoptes Güvenli Giriş Bağlantısı" />
                <p class="text-[11px] text-slate-400 font-mono mt-3">@(isEn ? "Target:" : "Hedef:") @portalUrl</p>
            </div>

            <!-- Standart Kod Kutusu -->
            <div class="px-6 pb-6">
                <div class="panoptes-code-block rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
                    <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
                        </div>
                        <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            <span>@(isEn ? "Copy" : "Kopyala")</span>
                        </button>
                    </div>
                    <div class="panoptes-code-viewer">
                        <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-qrcode id="portalQrCode" 
                 value="@@ViewBag.PortalUrl" 
                 size="190" 
                 title="Panoptes Güvenli Giriş Bağlantısı" /&gt;</code></pre>
                    </div>
                </div>
            </div>
        </div>

        <!-- DEMO 4: Canlı İnteraktif Dinamik Barkod & Karekod Üretici -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
            <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-cyan-600 inline-block"></span>
                        @(isEn ? "4. Live Interactive Barcode & QR Code Generator (setValue API)" : "4. Canlı İnteraktif Dinamik Barkod & Karekod Üretici (setValue API)")
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">
                        @(isEn 
                            ? "Type any text, tracking code or URL in the input field to re-render barcode and QR code synchronously." 
                            : "Metin kutusuna herhangi bir metin veya bağlantı yazın; barkod ve karekod aynı anda anlık olarak yeniden çizilsin.")
                    </p>
                </div>
                <span class="text-xs font-mono bg-cyan-50 text-cyan-700 px-2 py-1 rounded font-medium border border-cyan-100">window.panoptesBarcode.getInstance()</span>
            </div>

            <div class="p-6 space-y-6">
                <!-- Giriş Kutusu -->
                <div class="max-w-md mx-auto">
                    <label for="liveInput" class="block text-xs font-bold text-slate-700 mb-1">@(isEn ? "Dynamic Text / Tracking ID / URL:" : "Dinamik Metin / Takip Kodu / URL:")</label>
                    <div class="relative">
                        <input type="text" 
                               id="liveInput" 
                               value="PANOPTES-2026-KURUMSAL" 
                               oninput="onLiveTextChanged(this.value)"
                               class="w-full px-3.5 py-2 bg-slate-50 border border-slate-300 rounded-lg text-xs font-mono focus:ring-2 focus:ring-blue-500 focus:bg-white focus:outline-hidden transition" />
                    </div>
                    <p class="text-[11px] text-slate-400 mt-1">@(isEn ? "Both SVG codes below update immediately as you type." : "Yazdığınız her karakterde aşağıdaki iki SVG grafiği de eş zamanlı güncellenir.")</p>
                </div>

                <!-- Canlı Çizim Alanı (Alt Alta Tekil) -->
                <div class="space-y-4">
                    <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 flex flex-col items-center justify-center">
                        <panoptes-barcode id="interactiveBarcode" value="PANOPTES-2026-KURUMSAL" width="340" height="90" title="Dinamik Çizgili Barkod" />
                    </div>
                    <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 flex flex-col items-center justify-center">
                        <panoptes-qrcode id="interactiveQrCode" value="PANOPTES-2026-KURUMSAL" size="170" title="Dinamik Karekod" />
                    </div>
                </div>

                <!-- Canlı Olay Günlüğü -->
                <div class="bg-slate-900 text-slate-200 p-4 rounded-xl font-mono text-xs h-24 overflow-y-auto space-y-1" id="barcodeEventLog">
                    <div class="text-slate-500">@(isEn ? "// Live barcode engine ready. Type in input box above to test..." : "// Canlı barkod motoru hazır. Giriş kutusuna yazarak test edin...")</div>
                </div>
            </div>

            <!-- Standart Kod Kutusu -->
            <div class="px-6 pb-6">
                <div class="panoptes-code-block rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
                    <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">JavaScript API</span>
                        </div>
                        <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            <span>@(isEn ? "Copy" : "Kopyala")</span>
                        </button>
                    </div>
                    <div class="panoptes-code-viewer">
                        <pre class="panoptes-raw-code hidden"><code>var bc = window.panoptesBarcode.getInstance('interactiveBarcode');
var qr = window.panoptesBarcode.getInstance('interactiveQrCode');

// Dinamik yeni değer atama
bc.setValue('YENI-KOD-123');
qr.setValue('https://panoptes.dev/target');</code></pre>
                    </div>
                </div>
            </div>
        </div>

        <!-- TagHelper Referans Tablosu -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
            <div class="border-b border-slate-100 px-6 py-4 bg-slate-50/50">
                <h2 class="text-base font-bold text-slate-800">@(isEn ? "TagHelper Parameter & Attribute Reference" : "TagHelper Parametre ve Nitelik Referansı")</h2>
                <p class="text-xs text-slate-500 mt-0.5">@(isEn ? "Attributes and parameters supported by <panoptes-barcode> and <panoptes-qrcode>." : "<panoptes-barcode> ve <panoptes-qrcode> bileşenlerinin desteklediği tüm C# nitelikleri ve veri tipleri.")</p>
            </div>
            <div class="p-6 overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 text-slate-500 font-semibold bg-slate-50">
                            <th class="py-2.5 px-4">TagHelper</th>
                            <th class="py-2.5 px-4">@(isEn ? "Attribute Name" : "Nitelik Adı")</th>
                            <th class="py-2.5 px-4">@(isEn ? "Data Type" : "Veri Tipi")</th>
                            <th class="py-2.5 px-4">@(isEn ? "Default" : "Varsayılan")</th>
                            <th class="py-2.5 px-4">@(isEn ? "Description" : "Açıklama")</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-600">
                        <tr>
                            <td class="py-2.5 px-4 font-mono font-bold text-slate-800">&lt;panoptes-barcode&gt;</td>
                            <td class="py-2.5 px-4 font-mono text-blue-600">value</td>
                            <td class="py-2.5 px-4 font-mono text-slate-500">string</td>
                            <td class="py-2.5 px-4 font-mono text-slate-400">""</td>
                            <td class="py-2.5 px-4">@(isEn ? "Alphanumeric code or text value to encode." : "Barkoda dönüştürülecek alfanümerik metin veya kod.")</td>
                        </tr>
                        <tr>
                            <td class="py-2.5 px-4 font-mono font-bold text-slate-800">&lt;panoptes-barcode&gt;</td>
                            <td class="py-2.5 px-4 font-mono text-blue-600">type</td>
                            <td class="py-2.5 px-4 font-mono text-slate-500">BarcodeType</td>
                            <td class="py-2.5 px-4 font-mono text-slate-400">Code128</td>
                            <td class="py-2.5 px-4">@(isEn ? "Barcode standard: Code128, Code39, EAN13." : "Barkod standardı: Code128, Code39, EAN13.")</td>
                        </tr>
                        <tr>
                            <td class="py-2.5 px-4 font-mono font-bold text-slate-800">&lt;panoptes-barcode&gt;</td>
                            <td class="py-2.5 px-4 font-mono text-blue-600">show-text</td>
                            <td class="py-2.5 px-4 font-mono text-slate-500">bool</td>
                            <td class="py-2.5 px-4 font-mono text-slate-400">true</td>
                            <td class="py-2.5 px-4">@(isEn ? "Renders human-readable text below bars." : "Çizgilerin altında okunabilir değer metninin gösterilip gösterilmeyeceği.")</td>
                        </tr>
                        <tr>
                            <td class="py-2.5 px-4 font-mono font-bold text-slate-800">&lt;panoptes-qrcode&gt;</td>
                            <td class="py-2.5 px-4 font-mono text-blue-600">value</td>
                            <td class="py-2.5 px-4 font-mono text-slate-500">string</td>
                            <td class="py-2.5 px-4 font-mono text-slate-400">""</td>
                            <td class="py-2.5 px-4">@(isEn ? "Text, URL, or authentication token to encode in QR." : "Karekod matrisine dönüştürülecek metin, URL veya token.")</td>
                        </tr>
                        <tr>
                            <td class="py-2.5 px-4 font-mono font-bold text-slate-800">&lt;panoptes-qrcode&gt;</td>
                            <td class="py-2.5 px-4 font-mono text-blue-600">size</td>
                            <td class="py-2.5 px-4 font-mono text-slate-500">int</td>
                            <td class="py-2.5 px-4 font-mono text-slate-400">180</td>
                            <td class="py-2.5 px-4">@(isEn ? "Square width and height dimensions in pixels." : "Karekodun piksel cinsinden en-boy boyutu.")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PANEL 2: API & ATTRIBUTES -->
    <div id="panel-api" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">@(isEn ? "TagHelper Attributes & Parameters" : "TagHelper Özellikleri & Parametreleri")</h3>
                    <p class="text-xs text-slate-500 mt-0.5">@(isEn ? "Complete configuration attributes supported by <panoptes-barcode>." : "<panoptes-barcode> bileşeninin desteklediği tüm C# ve HTML nitelikleri.")</p>
                </div>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-blue-100 text-blue-800">PanoptesBarcodeTagHelper</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                            <th class="py-3 px-6">@(isEn ? "Attribute" : "Özellik (Attribute)")</th>
                            <th class="py-3 px-4">@(isEn ? "Type" : "Tip (C#)")</th>
                            <th class="py-3 px-4">@(isEn ? "Default" : "Varsayılan")</th>
                            <th class="py-3 px-6">@(isEn ? "Description" : "Açıklama")</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">id</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">Otomatik</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Element identifier." : "Bileşen kimliği.")</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">type</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">"qr"</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Type: \"qr\", \"code128\", \"ean13\"." : "Tür: \"qr\", \"code128\", \"ean13\".")</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">value</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">@(isEn ? "Value or string to encode." : "Kodlanacak metin veya sayı dizisi.")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PANEL 3: ACCESSIBILITY (WAI-ARIA & KEYBOARD) -->
    <div id="panel-a11y" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
            <div>
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
                    @(isEn ? "WAI-ARIA Standards & Keyboard Accessibility" : "WAI-ARIA Standartları & Klavye Erişilebilirliği")
                </h2>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                    @(isEn 
                        ? "Panoptes Barcode & QR Code is engineered in accordance with W3C WAI-ARIA standards for screen readers." 
                        : "Panoptes Barcode & QR Code bileşeni, W3C WAI-ARIA standartlarına uygun olarak ekran okuyucular ve salt klavye navigasyonu için tasarlanmıştır.")
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">@(isEn ? "WAI-ARIA Roles" : "WAI-ARIA Nitelikleri")</div>
                    <div class="text-slate-600">
                        @(isEn 
                            ? "Standard role=\"img\" role with detailed aria-label specifying symbology and encoded data." 
                            : "Standart role=\"img (barcode)\" rolünü taşır. Duruma göre aria-disabled, aria-expanded, aria-selected ve aria-label nitelikleri dinamik olarak güncellenir.")
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">@(isEn ? "Focus Management" : "Odak Yönetimi (Focus Management)")</div>
                    <div class="text-slate-600">
                        @(isEn 
                            ? "Maintains tab sequence natively (tabIndex=\"0\"). High-contrast visual focus rings." 
                            : "Sekme sırasını doğal akışında korur (tabIndex=\"0\"). Görsel odak halkaları (focus ring) yüksek kontrastla görünür durumdadır.")
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <h3 class="text-sm font-bold text-slate-900 mb-3">@(isEn ? "Keyboard Shortcuts" : "Klavye Kısayolları (Keyboard Shortcuts)")</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                                <th class="py-2.5 px-4 w-48">@(isEn ? "Key" : "Tuş (Key)")</th>
                                <th class="py-2.5 px-4">@(isEn ? "Function" : "İşlev (Function)")</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Tab</kbd></td>
                                <td class="py-2.5 px-4">@(isEn ? "Focuses on the barcode graphic element." : "Barkod görseline odaklanır.")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/panoptes/panoptes-barcode.js" asp-append-version="true"></script>
    <script>
        function logBarcode(msg) {
            var logEl = document.getElementById('barcodeEventLog');
            if (!logEl) return;
            var time = new Date().toLocaleTimeString('tr-TR');
            var line = document.createElement('div');
            line.innerHTML = '<span class="text-slate-500">[' + time + ']</span> ' + msg;
            logEl.appendChild(line);
            logEl.scrollTop = logEl.scrollHeight;
        }

        function onLiveTextChanged(val) {
            var bc = window.panoptesBarcode.getInstance('interactiveBarcode');
            var qr = window.panoptesBarcode.getInstance('interactiveQrCode');

            if (bc) bc.setValue(val);
            if (qr) qr.setValue(val);

            logBarcode('<span class="text-cyan-400 font-bold">Dinamik Çizim Güncellendi:</span> ' + val);
        }
    </script>
}
