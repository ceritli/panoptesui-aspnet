@model List<Panoptes.AspNetCore.Models.DropDownTreeItemModel>
@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "DropDownTree - Local Data Binding" : "DropDownTree - Yerel Model Veri Bağlama (Local Data Binding)";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/DropDownTree" : "/DropDownTree")" class="hover:text-blue-600 transition">DropDownTree</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">@(isEn ? "Local Data" : "Yerel Veri Bağlama")</span>
    </nav>

    <!-- Top Navigation Bar between 15 examples -->
    @await Html.PartialAsync("_DropDownTreeNav")

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "Local Data Binding (C# Model)" : "Yerel Veri Bağlama (Local Data Binding)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-violet-50 text-violet-700 border border-violet-200">
                    C# Strongly-Typed Model
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Compile-time-checked binding from C# lists; pages open with zero extra AJAX."
                    : "C# listesinden derleme anında doğrulamalı bağlama; sayfa ek AJAX'sız açılır.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-violet-50 text-violet-700 border border-violet-200 rounded-lg text-xs font-bold shrink-0">
                ✓ items="@@Model"
            </span>
        </div>
    </div>

    <!-- Live Showcase Card -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "10. Regional Office Branch Tree (C# Model Binding)" : "10. Lokasyon / Bölge Ağacı (C# Modelinden Bağlama)")</h2>
            <p class="text-xs text-slate-500 mt-1">
                @(isEn 
                    ? "Regional offices and district branches prepared in C# code-behind and passed cleanly to the Razor view."
                    : "Bölge ve şehir şubeleri C# listesi olarak View'a iletilmiş ve DropDownTree bileşenine bağlanmıştır.")
            </p>
        </div>

        <div class="max-w-md space-y-2">
            <label class="block text-xs font-bold text-slate-700">@(isEn ? "Select Branch / Location" : "Şube / Bölge Lokasyonu Seçiniz")</label>
            <panoptes-dropdowntree id="ddt_local_demo"
                                  items="@Model"
                                  placeholder="@(isEn ? "Select region or branch..." : "Bölge veya şube seçiniz...")"
                                  value="istanbul"
                                  dropdown-width="400px">
            </panoptes-dropdowntree>
            <span class="text-[11px] text-slate-400">
                @(isEn ? "Initial selected value: Istanbul (European & Asian sides)." : "Başlangıçta seçili lokasyon: İstanbul (Avrupa & Anadolu).")
            </span>
        </div>
    </div>

    <!-- Feature Description Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Type Safety & Compile-Time Checks" : "Tip Güvenliği & Derleme Kontrolü")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Prevents runtime string typos by validating node properties (Id, Text, Children) at C# compile time."
                    : "Düğüm özellikleri derleme anında doğrulanır; yazım hataları ve çalışma zamanı çökmeleri önlenir.")
            </div>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Zero Client-Side Overhead" : "Sıfır İstemci Yükü")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "The hierarchical DOM is generated during server render, eliminating extra AJAX network trips on page load."
                    : "Hiyerarşik yapı sunucu tarafında hazırlandığından sayfa açılışında fazladan AJAX isteği yapılmaz.")
            </div>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "C# Controller & Razor View" : "C# Controller & Razor View")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>// Controller Action:
public IActionResult LocalDataBinding()
{
    var treeData = DropDownTreeDemoData.GetLocationsTree();
    return View(treeData);
}

// Razor View:
@@model List&lt;Panoptes.AspNetCore.Models.DropDownTreeItemModel&gt;

&lt;panoptes-dropdowntree id="ddt_local_demo"
                       items="@@Model"
                       placeholder="@(isEn ? "Select region or branch..." : "Bölge veya şube seçiniz...")"
                       value="istanbul"
                       dropdown-width="400px"&gt;
&lt;/panoptes-dropdowntree&gt;</code></pre>
        </div>
    </div>
</div>
