@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "DropDownTree - Remote Data Binding" : "DropDownTree - Uzak Veri Bağlama (Remote Data Binding)";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/DropDownTree" : "/DropDownTree")" class="hover:text-blue-600 transition">DropDownTree</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">@(isEn ? "Remote Data" : "Uzak Veri")</span>
    </nav>

    <!-- Top Navigation Bar between 15 examples -->
    @await Html.PartialAsync("_DropDownTreeNav")

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "Remote Data Binding (REST API)" : "Uzak Veri Bağlama (Remote Data Binding)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200">
                    Async REST API / JSON
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Tens of thousands of nodes lazy-load from REST; pages stay light."
                    : "On binlerce düğüm REST'ten tembel yüklenir; sayfa hafif açılır.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-sky-50 text-sky-700 border border-sky-200 rounded-lg text-xs font-bold shrink-0">
                ✓ url="/DropDownTree/GetCategoriesTree"
            </span>
        </div>
    </div>

    <!-- Live Showcase Card -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "11. Asynchronously Loaded Tree from Remote API" : "11. Uzak API'den Asenkron Yüklenen Ağaç")</h2>
            <p class="text-xs text-slate-500 mt-1">
                @(isEn 
                    ? "Fetches hierarchical tree JSON from `/DropDownTree/GetCategoriesTree` via client fetch, firing `on-data-bound` upon successful population."
                    : "İstemci tarafında fetch çağrısı ile veriler çekilir ve yükleme tamamlandığında ağaç otomatik oluşturulur.")
            </p>
        </div>

        <div class="max-w-md space-y-2">
            <label class="block text-xs font-bold text-slate-700">@(isEn ? "Select Remote Category" : "Uzak API'den Kategori Seçiniz")</label>
            <panoptes-dropdowntree id="ddt_remote_demo"
                                  url="/DropDownTree/GetCategoriesTree"
                                  placeholder="@(isEn ? "Loading categories from server..." : "Sunucudan kategoriler yükleniyor...")"
                                  dropdown-width="400px"
                                  on-data-bound="onRemoteTreeDataBound">
            </panoptes-dropdowntree>
            <div id="remoteStatusText" class="text-[11px] text-slate-400 font-mono">
                @(isEn ? "API Status: Initiating request..." : "API Durumu: Yükleme başlatılıyor...")
            </div>
        </div>
    </div>

    <!-- Feature Description Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Non-Blocking Async Fetch" : "Bloklamayan Asenkron İstek")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Page renders instantly while data downloads quietly in the background with a built-in loading spinner."
                    : "Sayfa anında ekrana gelir, veriler arka planda indirilirken zarif bir yükleme göstergesi görüntülenir.")
            </div>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Lifecycle Data Callback" : "Veri Yaşam Döngüsü Bildirimi")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Trigger custom logic via on-data-bound as soon as tree nodes are parsed and mounted into the DOM."
                    : "Veriler gelip ağaç çizildiği anda on-data-bound olayı tetiklenerek bağlı diğer bileşenler senkronize edilebilir.")
            </div>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "Controller API & TagHelper" : "Controller API & TagHelper")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>// Controller API Endpoint:
[HttpGet("GetCategoriesTree")]
public IActionResult GetCategoriesTree()
{
    var data = DropDownTreeDemoData.GetCategoriesTree();
    return Json(data);
}

// Razor View:
&lt;panoptes-dropdowntree id="ddt_remote_demo"
                       url="/DropDownTree/GetCategoriesTree"
                       placeholder="@(isEn ? "Loading from server..." : "Sunucudan yükleniyor...")"
                       on-data-bound="onRemoteTreeDataBound"&gt;
&lt;/panoptes-dropdowntree&gt;</code></pre>
        </div>
    </div>
</div>

<script>
    function onRemoteTreeDataBound(e) {
        const el = document.getElementById('remoteStatusText');
        if (el) {
            el.innerHTML = '<span class="text-emerald-600 font-bold">✓ @(isEn ? "API data received and tree built successfully." : "API Verileri Başarıyla Alındı ve Ağaç Oluşturuldu.")</span>';
        }
    }
</script>
