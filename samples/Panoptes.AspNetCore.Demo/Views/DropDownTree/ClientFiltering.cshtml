@model List<Panoptes.AspNetCore.Models.DropDownTreeItemModel>
@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "DropDownTree - Client Filtering & Search" : "DropDownTree - İstemci Tarafı Filtreleme (Client Filtering)";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/DropDownTree" : "/DropDownTree")" class="hover:text-blue-600 transition">DropDownTree</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">@(isEn ? "Filtering" : "Canlı Arama")</span>
    </nav>

    <!-- Top Navigation Bar between 15 examples -->
    @await Html.PartialAsync("_DropDownTreeNav")

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "Client-Side Search & Live Filtering" : "İstemci Tarafı Anlık Arama (Client Filtering)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                    Deep Hierarchical Search
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Highlights as you type, opens parents; fast keyboard lookup across thousands of nodes."
                    : "Yazdıkça vurgular, üst dalları açar; binlerce düğümde klavyeden hızlı bulma.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-blue-50 text-blue-700 border border-blue-200 rounded-lg text-xs font-bold shrink-0">
                ✓ filter="contains" & Auto-Expand
            </span>
        </div>
    </div>

    <!-- Live Showcase Card -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "9. Live Tree Filtering with Auto-Expand" : "9. Anlık Ağaç İçi Arama ve Otomatik Dal Açma")</h2>
            <p class="text-xs text-slate-500 mt-1">
                @(isEn 
                    ? "Open the dropdown and type queries like 'laptop', 'team', or 'phone'. Notice matching parent paths expand smoothly with keyword highlights."
                    : "Açılır kutuyu açtığınızda üstteki arama çubuğuna örneğin \"laptop\", \"takım\" veya \"telefon\" yazın; eşleşen dalların kendiliğinden açıldığını gözlemleyin.")
            </p>
        </div>

        <div class="max-w-md space-y-2">
            <label class="block text-xs font-bold text-slate-700">@(isEn ? "Search Product / Category" : "Ürün / Kategori Arayın")</label>
            <panoptes-dropdowntree id="ddt_filter_demo"
                                  items="@Model"
                                  filter="contains"
                                  filter-placeholder="@(isEn ? "Type category or product..." : "Kategori veya ürün adı yazın...")"
                                  placeholder="@(isEn ? "Open to search..." : "Aramak için açın...")"
                                  dropdown-width="400px">
            </panoptes-dropdowntree>
            <span class="text-[11px] text-slate-400">
                @(isEn ? "Try queries like: 'laptop', 'smart', or 'headset'." : "Deneyin: \"oyuncu\", \"laptop\" veya \"ceket\" yazın.")
            </span>
        </div>
    </div>

    <!-- Feature Description Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Automatic Ancestor Expansion" : "Otomatik Üst Dizin Açılımı")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "When a nested child matches the search string, all parents leading to that leaf expand automatically."
                    : "Derinlerdeki bir yaprak düğüm arama kriterine uyduğunda, ona giden tüm üst klasörler kullanıcı müdahalesi olmadan açılır.")
            </div>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Sub-Millisecond Speed" : "Milisaniye Altı Hız")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "In-memory client-side tree traversal handles thousands of nodes smoothly with instant keystroke feedback."
                    : "İstemci tarafı DOM taraması binlerce düğümlük ağaçlarda bile her harf vuruşunda anında filtreleme sunar.")
            </div>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-dropdowntree id="ddt_filter_demo"
                       items="@@Model"
                       filter="contains"
                       filter-placeholder="@(isEn ? "Type category or product..." : "Kategori veya ürün adı yazın...")"
                       placeholder="@(isEn ? "Open to search..." : "Aramak için açın...")"
                       dropdown-width="400px"&gt;
&lt;/panoptes-dropdowntree&gt;</code></pre>
        </div>
    </div>
</div>
