@model List<Panoptes.AspNetCore.Models.DropDownTreeItemModel>
@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "DropDownTree - Appearance & Sizes" : "DropDownTree - Görünüm ve Boyutlar (Appearance)";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/DropDownTree" : "/DropDownTree")" class="hover:text-blue-600 transition">DropDownTree</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">Appearance</span>
    </nav>

    <!-- Top Navigation Bar between 15 examples -->
    @await Html.PartialAsync("_DropDownTreeNav")

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "Styling, Sizes & Fill Modes" : "Görünüm, Boyutlar & Dolgu Modları")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                    Design Tokens & Styling
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Seamlessly align with design guidelines using Size (sm, md, lg), Rounded (none, sm, md, lg, full), and FillMode (outline, solid, flat) options."
                    : "Kurumsal tasarım sisteminde bulunan Size (sm, md, lg), Rounded ve FillMode (outline, solid, flat) ayarlarını destekler. Tasarım rehberinize anında uyum sağlar.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-amber-50 text-amber-700 border border-amber-200 rounded-lg text-xs font-bold shrink-0">
                ✓ Size + Rounded + FillMode
            </span>
        </div>
    </div>

    <!-- 1. Boyut Seçenekleri (Size) -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
        <div class="border-b border-slate-100 pb-3">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "1. Component Sizes (sm, md, lg)" : "1. Farklı Boyut Seçenekleri (Size: sm, md, lg)")</h2>
            <p class="text-xs text-slate-500 mt-0.5">@(isEn ? "Three distinct sizing tiers from dense data toolbars to hero landing inputs." : "Kompakt formlardan geniş arama alanlarına kadar 3 farklı boyut kademesi.")</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="space-y-1.5">
                <label class="block text-xs font-bold text-slate-700">@(isEn ? "Small Size (Size: sm)" : "Küçük Boyut (Size: \"sm\")")</label>
                <panoptes-dropdowntree id="ddt_size_sm"
                                      items="@Model"
                                      size="sm"
                                      placeholder="@(isEn ? "Small size (sm)..." : "Küçük boyut (sm)...")"
                                      value="backend" />
                <span class="text-[11px] text-slate-400">@(isEn ? "Dense data tables and toolbars." : "Yoğun veri tabloları ve araç çubukları için.")</span>
            </div>

            <div class="space-y-1.5">
                <label class="block text-xs font-bold text-slate-700">@(isEn ? "Default Size (Size: md)" : "Varsayılan Boyut (Size: \"md\")")</label>
                <panoptes-dropdowntree id="ddt_size_md"
                                      items="@Model"
                                      size="md"
                                      placeholder="@(isEn ? "Default size (md)..." : "Standart boyut (md)...")"
                                      value="frontend" />
                <span class="text-[11px] text-slate-400">@(isEn ? "Standard forms and admin panels." : "Standart formlar ve paneller için.")</span>
            </div>

            <div class="space-y-1.5">
                <label class="block text-xs font-bold text-slate-700">@(isEn ? "Large Size (Size: lg)" : "Büyük Boyut (Size: \"lg\")")</label>
                <panoptes-dropdowntree id="ddt_size_lg"
                                      items="@Model"
                                      size="lg"
                                      placeholder="@(isEn ? "Large size (lg)..." : "Geniş boyut (lg)...")"
                                      value="mobile" />
                <span class="text-[11px] text-slate-400">@(isEn ? "Hero search and onboarding forms." : "Giriş ve arama odaklı sayfalar için.")</span>
            </div>
        </div>
    </div>

    <!-- 2. Dolgu Modları (FillMode) -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
        <div class="border-b border-slate-100 pb-3">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "2. Fill Modes (outline, solid, flat)" : "2. Dolgu ve Kenarlık Modları (FillMode: outline, solid, flat)")</h2>
            <p class="text-xs text-slate-500 mt-0.5">@(isEn ? "Classic bordered outline, tinted solid background, or underline flat appearance." : "Klasik çerçeveli (outline), gri zeminli (solid) ve alt çizgili düz (flat) stiller.")</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="space-y-1.5">
                <label class="block text-xs font-bold text-slate-700">Outline</label>
                <panoptes-dropdowntree id="ddt_fill_outline"
                                      items="@Model"
                                      fill-mode="outline"
                                      placeholder="@(isEn ? "Outline style..." : "Outline stili...")" />
            </div>

            <div class="space-y-1.5">
                <label class="block text-xs font-bold text-slate-700">Solid</label>
                <panoptes-dropdowntree id="ddt_fill_solid"
                                      items="@Model"
                                      fill-mode="solid"
                                      placeholder="@(isEn ? "Solid style..." : "Solid stili...")" />
            </div>

            <div class="space-y-1.5">
                <label class="block text-xs font-bold text-slate-700">Flat</label>
                <panoptes-dropdowntree id="ddt_fill_flat"
                                      items="@Model"
                                      fill-mode="flat"
                                      placeholder="@(isEn ? "Flat style..." : "Flat stili...")" />
            </div>
        </div>
    </div>

    <!-- Feature Description Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Design Token Harmonization" : "Tasarım Sistemi Uyumu")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Tokens match Grid, Select, DatePicker and Button components for consistent vertical rhythm."
                    : "Grid, Select, DatePicker ve Button bileşenleriyle birebir aynı yükseklik ve font ölçeklerini paylaşır.")
            </div>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Corner Curvature (Rounded)" : "Köşe Yuvarlaklığı (Rounded)")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Supports sharp, medium, full-pill, and custom border-radius presets directly via HTML attributes."
                    : "Köşeli, hafif yuvarlak veya tam hap (pill) biçiminde kenarlık stillerini tek nitelikle yapılandırabilirsiniz.")
            </div>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;!-- Boyut Örnekleri (Size) --&gt;
&lt;panoptes-dropdowntree size="sm" items="@@Model" /&gt;
&lt;panoptes-dropdowntree size="md" items="@@Model" /&gt;
&lt;panoptes-dropdowntree size="lg" items="@@Model" /&gt;

&lt;!-- Dolgu Modları (FillMode) --&gt;
&lt;panoptes-dropdowntree fill-mode="outline" items="@@Model" /&gt;
&lt;panoptes-dropdowntree fill-mode="solid" items="@@Model" /&gt;
&lt;panoptes-dropdowntree fill-mode="flat" items="@@Model" /&gt;</code></pre>
        </div>
    </div>
</div>
