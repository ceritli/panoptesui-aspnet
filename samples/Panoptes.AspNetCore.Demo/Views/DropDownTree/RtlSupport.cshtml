@model List<Panoptes.AspNetCore.Models.DropDownTreeItemModel>
@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "DropDownTree - RTL (Right-to-Left) Support" : "DropDownTree - RTL (Sağdan Sola) Desteği - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/DropDownTree" : "/DropDownTree")" class="hover:text-blue-600 transition">DropDownTree</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">@(isEn ? "RTL Support" : "RTL Desteği")</span>
    </nav>

    <!-- Top Navigation Bar between 15 examples -->
    @await Html.PartialAsync("_DropDownTreeNav")

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "Right-to-Left (RTL) Layout Support" : "DropDownTree: RTL (Sağdan Sola) Desteği")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    Internationalization (i18n)
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Full Right-to-Left layout support for Arabic, Hebrew, Persian, and Urdu. Hierarchy indentation, chevron icons, checkboxes, and search indicators seamlessly mirror."
                    : "DropDownTree RTL (Sağdan Sola) desteği ile Arapça, İbranice veya Farsça gibi sağdan sola yazılan dillerde ağaç hiyerarşisi, ok ikonları ve seçim alanları kusursuz şekilde tersine çevrilir.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold shrink-0">
                ✓ dir="rtl" @(isEn ? "Compatible" : "Desteği")
            </span>
        </div>
    </div>

    <!-- Live Showcase Card -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "14. Right-to-Left (RTL) Showcase" : "14. Sağdan Sola Düzen (RTL) Örneği")</h2>
            <p class="text-xs text-slate-500 mt-1">
                @(isEn 
                    ? "Configured with dir=\"rtl\". Node indentations begin on the right, toggle arrows face left, and texts align naturally to the right edge."
                    : "Bileşen dir=\"rtl\" niteliği ile yapılandırılmıştır. Ağaç düğümlerinin girintileri sağdan başlar, genişletme okları sola bakar ve metinler sağa yaslı hizalanır.")
            </p>
        </div>

        <div class="max-w-md space-y-2" dir="rtl">
            <label class="block text-xs font-bold text-slate-700 text-right">الفئة / القسم (RTL Düzeninde Kategori)</label>
            <panoptes-dropdowntree id="ddt_rtl_demo"
                                  items="@Model"
                                  dir="rtl"
                                  checkboxes="true"
                                  placeholder="اختر فئة... (Kategori seçin)"
                                  value="laptop"
                                  dropdown-width="400px">
            </panoptes-dropdowntree>
            <span class="text-[11px] text-slate-400 block text-right">
                @(isEn ? "Chevron indicators and checkboxes align gracefully on the right side." : "Ok ikonları ve onay kutucukları sağ tarafta hizalanmıştır.")
            </span>
        </div>
    </div>

    <!-- Feature Description Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                <span>@(isEn ? "Native CSS Logical Properties" : "Mantıksal CSS Özellikleri")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Uses margin-inline-start and padding-inline-end so tree levels flow naturally according to the document or component direction."
                    : "margin-inline-start ve padding-inline-end gibi modern CSS mantıksal özellikleri kullanılarak hiyerarşik girintiler yöne göre otomatik adapte olur.")
            </div>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                <span>@(isEn ? "Mirrored Keyboard Navigation" : "Aynalanmış Klavye Gezintisi")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Arrow keys invert naturally: Left Arrow opens branches, while Right Arrow collapses them in RTL mode."
                    : "RTL modundayken klavye yönleri de tersine döner: Sol ok dalı açarken, Sağ ok dalı kapatır veya üst düğüme döner.")
            </div>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    Razor TagHelper
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-dropdowntree id="ddt_rtl_demo"
                       items="@@Model"
                       dir="rtl"
                       checkboxes="true"
                       placeholder="اختر فئة..."
                       value="laptop"
                       dropdown-width="400px"&gt;
&lt;/panoptes-dropdowntree&gt;</code></pre>
        </div>
    </div>
</div>
