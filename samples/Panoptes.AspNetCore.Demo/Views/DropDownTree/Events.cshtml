@model List<Panoptes.AspNetCore.Models.DropDownTreeItemModel>
@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "DropDownTree - Events & Console" : "DropDownTree - Olaylar (Events) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/DropDownTree" : "/DropDownTree")" class="hover:text-blue-600 transition">DropDownTree</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">@(isEn ? "Events" : "Olaylar")</span>
    </nav>

    <!-- Top Navigation Bar between 15 examples -->
    @await Html.PartialAsync("_DropDownTreeNav")

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "Lifecycle Events & Console" : "Olaylar & Yaşam Döngüsü (Events)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                    Interactive Event Log
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Open, select, and check events live in the console; audit logging hooks in here."
                    : "Açma, seçim ve onay olayları sağdaki konsolda canlı; denetim kaydı aynı kancalara bağlanır.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-amber-50 text-amber-700 border border-amber-200 rounded-lg text-xs font-bold shrink-0">
                ✓ @(isEn ? "Live Event Console" : "Canlı Olay Konsolu")
            </span>
        </div>
    </div>

    <!-- Live Showcase Card -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "12. Real-Time Event Interceptor Console" : "12. Canlı Olay Yakalama Konsolu")</h2>
            <p class="text-xs text-slate-500 mt-1">
                @(isEn 
                    ? "Open the tree, expand folders, select nodes, and watch all emitted events display instantly on the right console."
                    : "Açılır ağacı açın, arama yapın, düğümleri genişletin ve seçim yapın. Gerçek zamanlı tetiklenen tüm olaylar sağdaki terminalde listelenir.")
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
            <div class="space-y-4">
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">@(isEn ? "Target DropDownTree Component" : "Olay Test DropDownTree")</label>
                    <panoptes-dropdowntree id="ddt_events_demo"
                                          items="@Model"
                                          filter="contains"
                                          placeholder="@(isEn ? "Click to trigger events..." : "Olayları tetiklemek için tıklayın...")"
                                          dropdown-width="400px"
                                          on-open="onDdtOpen"
                                          on-close="onDdtClose"
                                          on-select="onDdtSelect"
                                          on-change="onDdtChange">
                    </panoptes-dropdowntree>
                </div>
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-500 space-y-1">
                    <div class="font-bold text-slate-700">@(isEn ? "Observed Events:" : "Tetiklenen Olaylar:")</div>
                    <div>• <code>on-open</code>: @(isEn ? "When popup panel expands" : "Açılır panel görünür olduğunda")</div>
                    <div>• <code>on-select</code>: @(isEn ? "When a tree node is clicked" : "Bir ağaç düğümü tıklandığında")</div>
                    <div>• <code>on-change</code>: @(isEn ? "When selected value mutates" : "Seçili değer değiştiğinde")</div>
                    <div>• <code>on-close</code>: @(isEn ? "When popup panel collapses" : "Açılır panel kapandığında")</div>
                </div>
            </div>

            <!-- Terminal / Event Log -->
            <div class="bg-slate-950 p-4 rounded-xl text-xs font-mono text-slate-300 border border-slate-800 shadow-inner">
                <div class="flex items-center justify-between border-b border-slate-800 pb-2 mb-2">
                    <span class="font-bold text-slate-400 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        @(isEn ? "Live Event Console" : "Etkileşimli Olay Konsolu")
                    </span>
                    <button type="button" onclick="document.getElementById('eventLogDdt').innerHTML=''" class="text-[11px] text-slate-400 hover:text-slate-200 transition cursor-pointer">
                        @(isEn ? "Clear" : "Temizle")
                    </button>
                </div>
                <div id="eventLogDdt" class="space-y-1 h-44 overflow-y-auto font-mono text-[11px]">
                    <div class="text-slate-500">[Ready] @(isEn ? "Listening to DropDownTree events..." : "DropDownTree dinleniyor...")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Description Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Deep Node Deserialization" : "Derin Düğüm Özellikleri")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "The event argument payload includes parent id, depth level, custom badge, and text attributes."
                    : "Olay argümanı seçilen düğümün üst kimliğini, derinlik seviyesini, rozet metnini ve metin değerini tam olarak iletir.")
            </div>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Cancelable Event Pipelines" : "İptal Edilebilir Olay Akışı")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Call e.preventDefault() inside on-select or on-open to conditionally block user interactions based on business rules."
                    : "İş kurallarına bağlı olarak on-select veya on-open içinde e.preventDefault() çağrılarak seçim iptal edilebilir.")
            </div>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "Razor TagHelper & JavaScript" : "Razor TagHelper & JavaScript")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-dropdowntree id="ddt_events_demo"
                       items="@@Model"
                       on-open="onDdtOpen"
                       on-close="onDdtClose"
                       on-select="onDdtSelect"
                       on-change="onDdtChange"&gt;
&lt;/panoptes-dropdowntree&gt;

&lt;script&gt;
function onDdtOpen(e) { console.log("Açıldı"); }
function onDdtSelect(e) { console.log("Seçildi:", e.node?.text); }
function onDdtChange(e) { console.log("Değer:", e.value); }
function onDdtClose(e) { console.log("Kapandı"); }
&lt;/script&gt;</code></pre>
        </div>
    </div>
</div>

<script>
    function logDdtEvent(msg) {
        const log = document.getElementById('eventLogDdt');
        if (!log) return;
        const time = new Date().toLocaleTimeString();
        const div = document.createElement('div');
        div.innerHTML = `<span class="text-slate-600">[${time}]</span> ${msg}`;
        log.prepend(div);
    }

    function onDdtOpen(e) {
        logDdtEvent('<strong class="text-blue-400">onOpen</strong>: Açılır ağaç listesi açıldı.');
    }

    function onDdtClose(e) {
        logDdtEvent('<strong class="text-slate-400">onClose</strong>: Açılır ağaç listesi kapandı.');
    }

    function onDdtSelect(e) {
        logDdtEvent(`<strong class="text-indigo-400">onSelect</strong>: <span class="text-cyan-400 font-bold">${e.node?.text}</span> (Değer: ${e.node?.value})`);
    }

    function onDdtChange(e) {
        logDdtEvent(`<strong class="text-emerald-400">onChange</strong>: Değer güncellendi -> <span class="text-amber-400 font-bold">${e.value || '(Boş)'}</span>`);
    }
</script>
