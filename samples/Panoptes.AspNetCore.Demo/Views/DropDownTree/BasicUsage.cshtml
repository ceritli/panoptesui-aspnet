@model List<Panoptes.AspNetCore.Models.DropDownTreeItemModel>
@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "DropDownTree - Overview & Basic Usage" : "DropDownTree - Temel Kullanım & Genel Bakış";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/DropDownTree" : "/DropDownTree")" class="hover:text-blue-600 transition">DropDownTree</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">@(isEn ? "Overview" : "Genel Bakış")</span>
    </nav>

    <!-- Top Navigation Bar between 15 examples -->
    @await Html.PartialAsync("_DropDownTreeNav")

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">DropDownTree @(isEn ? "(Hierarchical Tree Selector)" : "(Ağaç Seçim Menüsü)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-dropdowntree&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "WAI-ARIA Compliant" : "WAI-ARIA Uyumlu")
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Single-box selection for hierarchical fields like departments and categories; posts straight to model binders."
                    : "Departman ve kategori gibi hiyerarşik alanlarda tek kutuda seçim; form POST ile model binder'a düşer.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold shrink-0">
                ✓ @(isEn ? "Single Select" : "Tekil Seçim")
            </span>
        </div>
    </div>

    <!-- Live Showcase Card -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "1. Department & Team Selection (Single Select)" : "1. Departman & Ekip Seçimi (Tekil Seçim)")</h2>
            <p class="text-xs text-slate-500 mt-1">
                @(isEn 
                    ? "Click the input or dropdown arrow to expand the hierarchical tree. Expand nodes and select any team; the selection reflects immediately and the panel closes automatically."
                    : "Kullanıcı açılır oka veya girdi alanına tıkladığında hiyerarşik ağaç listelenir. Düğümler genişletilip daraltılabilir, alt ekiplerden biri tıklandığında anında kutuya yansır ve açılır panel otomatik kapanır.")
            </p>
        </div>

        <div class="max-w-md space-y-2">
            <label class="block text-xs font-bold text-slate-700">@(isEn ? "Select Department / Team" : "Departman / Ekip Seçiniz")</label>
            <panoptes-dropdowntree id="ddt_basic_demo"
                                  items="@Model"
                                  placeholder="@(isEn ? "Select a team or department..." : "Bir ekip veya departman seçiniz...")"
                                  dropdown-width="380px"
                                  value="backend">
            </panoptes-dropdowntree>
            <span class="text-[11px] text-slate-400">
                @(isEn ? "Tip: Click the arrow to open the tree, expand folders, and select any node." : "İpucu: Sağdaki oka tıklayarak ağacı açabilir, klasörleri genişletip istediğiniz ekibi seçebilirsiniz.")
            </span>
        </div>
    </div>

    <!-- Feature Description Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
            <div class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm mb-3">1</div>
            <h3 class="text-sm font-bold text-slate-800">@(isEn ? "Hierarchical Nodes" : "Hiyerarşik Düğümler")</h3>
            <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
                @(isEn 
                    ? "Each node contains Id, Text, and an optional Children list with unlimited nesting depth."
                    : "Her düğüm bir Id, Text ve çocuk düğümler listesi (Children) barındırır. İçiçe geçmiş yapılar derinlik sınırı olmaksızın otomatik seviyelendirilir.")
            </p>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
            <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm mb-3">2</div>
            <h3 class="text-sm font-bold text-slate-800">@(isEn ? "Auto Close" : "Otomatik Kapanma")</h3>
            <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
                @(isEn 
                    ? "In single select mode, selecting a leaf node instantly updates the input and dismisses the popup panel."
                    : "Tekil seçim modunda bir düğüm tıklandığında seçilen değer arka plandaki girdiye yazılır, tetikleyici güncellenir ve açılır pencere derhal kapanır.")
            </p>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
            <div class="w-8 h-8 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold text-sm mb-3">3</div>
            <h3 class="text-sm font-bold text-slate-800">@(isEn ? "Form Integration" : "Form Entegrasyonu")</h3>
            <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
                @(isEn 
                    ? "Submits the selected node key seamlessly via native HTML POST inputs and model binders."
                    : "HTML form gönderimlerinde (POST) seçilen düğümün kimlik değeri name niteliği üzerinden sunucuya otomatik olarak aktarılır.")
            </p>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-dropdowntree id="ddt_basic_demo"
                       items="@@Model"
                       placeholder="@(isEn ? "Select a team or department..." : "Bir ekip veya departman seçiniz...")"
                       dropdown-width="380px"
                       value="backend"&gt;
&lt;/panoptes-dropdowntree&gt;</code></pre>
        </div>
    </div>
</div>

