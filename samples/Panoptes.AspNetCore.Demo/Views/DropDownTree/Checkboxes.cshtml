@model List<Panoptes.AspNetCore.Models.DropDownTreeItemModel>
@using Panoptes.AspNetCore.Demo.Services
@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "DropDownTree - Checkboxes & Multi-Selection" : "DropDownTree - Checkboxes & Çoklu Seçim";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="@(isEn ? "/en" : "/")" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="@(isEn ? "/en/DropDownTree" : "/DropDownTree")" class="hover:text-blue-600 transition">DropDownTree</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">Checkboxes</span>
    </nav>

    <!-- Top Navigation Bar between 15 examples -->
    @await Html.PartialAsync("_DropDownTreeNav")

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@(isEn ? "Multi-Select & Checkboxes" : "Çoklu Seçim & Onay Kutuları (Checkboxes)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    Tri-State Checkboxes & Chips
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Parents select all children, partial shows indeterminate; bulk selection for roles and categories."
                    : "Üst düğüm tüm altları seçer, kısmi seçim belirsiz gösterilir; yetki ve kategori atamada toplu seçim.")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold shrink-0">
                ✓ @(isEn ? "CheckChildren & Tag Chips" : "CheckChildren & Çip Rozetler")
            </span>
        </div>
    </div>

    <!-- Live Showcase Card -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-base font-bold text-slate-800">@(isEn ? "3. Product Categories Selection (Multi-Select)" : "3. E-Ticaret Ürün Kategorileri (Çoklu Seçim)")</h2>
            <p class="text-xs text-slate-500 mt-1">
                @(isEn 
                    ? "Check multiple categories. Selecting a parent automatically checks all descendants; remove individual tags anytime using the (x) chip button."
                    : "Birden fazla kategori seçin. Bir üst başlığı seçtiğinizde altındakiler otomatik seçilir; kutuda çıkan etiketlerin yanındaki (x) butonuna basarak seçimi kolayca kaldırabilirsiniz.")
            </p>
        </div>

        <div class="max-w-lg space-y-2">
            <label class="block text-xs font-bold text-slate-700">@(isEn ? "Select Target Categories" : "İlgilendiğiniz Kategorileri Seçiniz")</label>
            <panoptes-dropdowntree id="ddt_checkboxes_demo"
                                  items="@Model"
                                  checkboxes="true"
                                  check-children="true"
                                  value="laptop,monitors"
                                  placeholder="@(isEn ? "Select categories..." : "Kategorileri işaretleyiniz...")"
                                  dropdown-width="420px">
            </panoptes-dropdowntree>
            <span class="text-[11px] text-slate-400">
                @(isEn ? "Select multiple nodes while the panel stays open; clear all anytime from the input button." : "Açılır liste açık kalırken birden fazla kutucuğu işaretleyebilir, altbilgiden \"Tümünü Temizle\" diyebilirsiniz.")
            </span>
        </div>
    </div>

    <!-- Feature Description Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Tri-State (Indeterminate)" : "Üç Durumlu (Tri-State)")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "If only some children are checked, the parent node reflects a minus/dash indeterminate icon."
                    : "Alt düğümlerden yalnızca bazıları seçildiğinde, üst düğüm otomatik olarak yarı-seçili (çizgi/tire) durumunu alır.")
            </div>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-xs">
            <div class="text-xs font-bold text-slate-800 flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                <span>@(isEn ? "Interactive Tag Chips" : "Etkileşimli Rozetler (Chips)")</span>
            </div>
            <div class="text-xs text-slate-500 leading-relaxed">
                @(isEn 
                    ? "Selected values render as compact chips inside the input box that can be dismissed individually."
                    : "Seçilen değerler girdi alanında zarif rozetler olarak görünür ve tek tıkla liste açılmadan kaldırılabilir.")
            </div>
        </div>
    </div>

    <!-- Razor TagHelper Code Snippet (Light Code Viewer Standard) -->
    <div class="panoptes-code-block bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">
                    @(isEn ? "Razor TagHelper (C# / .NET 8)" : "Razor TagHelper (C# / .NET 8)")
                </span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy Code" : "Kodu Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-dropdowntree id="ddt_checkboxes_demo"
                       items="@@Model"
                       checkboxes="true"
                       check-children="true"
                       value="laptop,monitors"
                       placeholder="@(isEn ? "Select categories..." : "Kategorileri işaretleyiniz...")"
                       dropdown-width="420px"&gt;
&lt;/panoptes-dropdowntree&gt;</code></pre>
        </div>
    </div>
</div>
