@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "TabStrip - Panoptes UI" : "TabStrip (Sekmeli Panel Düzeni) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="/" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="/TabStrip" class="hover:text-blue-600 transition">@(isEn ? "Navigation & Layout" : "Navigasyon & Düzen")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">TabStrip</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">TabStrip @(isEn ? "(Tabbed Panel Layout)" : "(Sekmeli Panel Düzeni)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-tabstrip&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "WAI-ARIA Compliant" : "WAI-ARIA Uyumlu")
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn ? "Organize multiple content panes into a single tabbed space with dynamic tab adding/closing, scrolling, and smooth tab transitions." : "Birden çok içerik sayfasını tek bir alanda sekmelerle organize eden, dinamik sekme ekleme/kapatma, kaydırma ve animasyonlu sekme bileşeni.")
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>@(isEn ? "Examples (Features)" : "Örnekler (Features)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">6</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>@(isEn ? "API Reference (Props & Events)" : "API Referansı (Props & Events)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">3</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>@(isEn ? "Accessibility (WAI-ARIA)" : "Erişilebilirlik (WAI-ARIA)")</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
<div class="flex items-center gap-2 shrink-0">
            <a href="/Menu" class="px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 transition flex items-center gap-1.5 shadow-2xs">
                <span>📋 Menu & ContextMenu</span>
            </a>
        </div>

    <!-- Quick Feature Highlights -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <div class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm mb-2">🧭</div>
            <div class="font-bold text-sm text-slate-800">4 Yön Konumlandırma</div>
            <div class="text-xs text-slate-500 mt-0.5">Üst (Top), Alt (Bottom), Sol ve Sağ dikey</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm mb-2">⚡</div>
            <div class="font-bold text-sm text-slate-800">AJAX Lazy Loading</div>
            <div class="text-xs text-slate-500 mt-0.5">Tıklanınca sunucudan dinamik yükleme</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-sm mb-2">✖️</div>
            <div class="font-bold text-sm text-slate-800">Kapatılabilir Sekmeler</div>
            <div class="text-xs text-slate-500 mt-0.5">Tek tıkla sekme kapatma ve otomatik geçiş</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <div class="w-8 h-8 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold text-sm mb-2">➕</div>
            <div class="font-bold text-sm text-slate-800">Çalışma Zamanı API</div>
            <div class="text-xs text-slate-500 mt-0.5">addTab, removeTab, select metotları</div>
        </div>
    </div>

    <!-- DEMO 1: Standart Yatay Sekmeler ve AJAX Lazy Load (Tek Başına Tam Genişlik) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-2xs p-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 border-b border-slate-100 pb-4">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                    <span>1. Standart Yatay Sekmeli Panel (Top Position & Lazy Load)</span>
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    İkonlar, renkli rozetler, pasif sekme ve son sekmede <strong>AJAX Lazy Loading</strong> desteği.
                </p>
            </div>
            <span class="text-xs bg-slate-100 text-slate-700 px-2.5 py-1 rounded-lg font-mono font-medium self-start sm:self-auto">
                tab-position="top"
            </span>
        </div>

        <panoptes-tabstrip id="mainTabStrip" tab-position="top" animation="fade" on-select="onTabSelect">
            <!-- Sekme 1 -->
            <panoptes-tab title="Genel Bakış" icon="home" badge="Canlı" badge-color="emerald" active="true">
                <div class="space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <h3 class="text-sm font-bold text-slate-800">Kurumsal Performans Paneli</h3>
                        <span class="text-xs text-slate-400">Son güncelleme: Az önce</span>
                    </div>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Panoptes TabStrip bileşeni, kurumsal web uygulamalarında çok sayfalı veya sekmeli veri görünümlerini organize etmek için geliştirilmiştir. Tailwind CSS ile kusursuz uyumlu, yüksek performanslı ve sıfır dış bağımlılıklıdır.
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
                        <div class="p-3 bg-blue-50/60 border border-blue-200/60 rounded-xl">
                            <div class="text-[11px] font-semibold text-blue-700">Toplam Modüller</div>
                            <div class="text-xl font-black text-blue-900 mt-0.5">24 Adet</div>
                        </div>
                        <div class="p-3 bg-emerald-50/60 border border-emerald-200/60 rounded-xl">
                            <div class="text-[11px] font-semibold text-emerald-700">Aktif İş Parçacıkları</div>
                            <div class="text-xl font-black text-emerald-900 mt-0.5">142 Worker</div>
                        </div>
                        <div class="p-3 bg-indigo-50/60 border border-indigo-200/60 rounded-xl">
                            <div class="text-[11px] font-semibold text-indigo-700">Tepki Süresi</div>
                            <div class="text-xl font-black text-indigo-900 mt-0.5">4.2 ms</div>
                        </div>
                    </div>
                </div>
            </panoptes-tab>

            <!-- Sekme 2 -->
            <panoptes-tab title="Kullanıcı Yönetimi" icon="users" badge="14 Yeni" badge-color="blue">
                <div class="space-y-3">
                    <h3 class="text-sm font-bold text-slate-800">Yetkili Kullanıcı Listesi</h3>
                    <div class="divide-y divide-slate-100 border border-slate-200 rounded-xl overflow-hidden bg-slate-50/50">
                        <div class="p-3 flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <div class="w-7 h-7 rounded-full bg-blue-600 text-white font-bold text-xs flex items-center justify-center">FC</div>
                                <div>
                                    <div class="text-xs font-bold text-slate-800">Fatih Ceritli</div>
                                    <div class="text-[11px] text-slate-400">Sistem Mimarı & Yönetici</div>
                                </div>
                            </div>
                            <span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-full">Aktif</span>
                        </div>
                        <div class="p-3 flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <div class="w-7 h-7 rounded-full bg-purple-600 text-white font-bold text-xs flex items-center justify-center">AY</div>
                                <div>
                                    <div class="text-xs font-bold text-slate-800">Ahmet Yılmaz</div>
                                    <div class="text-[11px] text-slate-400">Kıdemli Veritabanı Yöneticisi</div>
                                </div>
                            </div>
                            <span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-full">Aktif</span>
                        </div>
                    </div>
                </div>
            </panoptes-tab>

            <!-- Sekme 3 -->
            <panoptes-tab title="Güvenlik & Yetkiler" icon="shield">
                <div class="space-y-3">
                    <h3 class="text-sm font-bold text-slate-800">Güvenlik Politikaları & Sertifikasyon</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        İki faktörlü kimlik doğrulama (2FA) zorunluluğu, IP beyaz liste filtreleme ve rol bazlı erişim denetimi (RBAC) kuralları bu sekmeden yönetilir.
                    </p>
                    <div class="p-3.5 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 flex items-center gap-2 font-medium">
                        <span>⚠️</span>
                        <span>Son 24 saatte şüpheli bir giriş denemesi tespit edilmedi. SSL sertifikası geçerli.</span>
                    </div>
                </div>
            </panoptes-tab>

            <!-- Sekme 4: AJAX Lazy Loading Sekmesi -->
            <panoptes-tab title="Canlı Sunucu İstatistikleri (AJAX)" icon="chart" badge="Lazy Load" badge-color="purple" content-url="/TabStrip/LazyData">
            </panoptes-tab>

            <!-- Sekme 5: Pasif Sekme -->
            <panoptes-tab title="Arşiv Kayıtları (Kilitli)" icon="lock" disabled="true">
                <p class="text-xs text-slate-500">Bu içeriğe erişim yetkiniz kısıtlıdır.</p>
            </panoptes-tab>
        </panoptes-tabstrip>

        <!-- Collapsible Code Snippet (Standart Tıklayınca Açılan - Tüm Kod Detayları) -->
        <div class="panoptes-code-block mt-3 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-tabstrip id=&quot;mainTabStrip&quot; tab-position=&quot;top&quot; animation=&quot;fade&quot; on-select=&quot;onTabSelect&quot;&gt;
    &lt;!-- Statik Sekme: Doğrudan Razor İçeriği --&gt;
    &lt;panoptes-tab title=&quot;Genel Bakış&quot; icon=&quot;home&quot; badge=&quot;Canlı&quot; badge-color=&quot;emerald&quot; active=&quot;true&quot;&gt;
        &lt;h3&gt;Kurumsal Performans Paneli&lt;/h3&gt;
        &lt;p&gt;Sekme içeriği doğrudan Razor görünümü içinde tanımlanır.&lt;/p&gt;
    &lt;/panoptes-tab&gt;

    &lt;panoptes-tab title=&quot;Kullanıcı Yönetimi&quot; icon=&quot;users&quot; badge=&quot;14 Yeni&quot; badge-color=&quot;blue&quot;&gt;
        &lt;p&gt;Yetkili kullanıcı listesi ve roller.&lt;/p&gt;
    &lt;/panoptes-tab&gt;

    &lt;!-- AJAX Lazy Loading: Sekmeye tıklanınca sunucudan asenkron yüklenir --&gt;
    &lt;panoptes-tab title=&quot;Canlı Sunucu İstatistikleri (AJAX)&quot; icon=&quot;chart&quot; badge=&quot;Lazy Load&quot; badge-color=&quot;purple&quot; content-url=&quot;/TabStrip/LazyData&quot; /&gt;

    &lt;!-- Pasif / Kilitli Sekme --&gt;
    &lt;panoptes-tab title=&quot;Arşiv Kayıtları (Kilitli)&quot; icon=&quot;lock&quot; disabled=&quot;true&quot; /&gt;
&lt;/panoptes-tabstrip&gt;</code></pre>
        </div>
    </div>
    </div>

    <!-- DEMO 2: Kapatılabilir ve Dinamik Sekmeler (Tek Başına Tam Genişlik) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-2xs p-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 border-b border-slate-100 pb-4">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                    <span>2. Kapatılabilir & Dinamik Sekmeler (Closable & Dynamic API)</span>
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Tarayıcı sekmesi tarzında sekmeleri tek tıkla kapatma (<code class="text-blue-600 font-mono">closable="true"</code>) ve çalışma zamanında yeni sekme açma.
                </p>
            </div>
            <button type="button" onclick="addNewDynamicTab()" class="px-3.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-2xs self-start sm:self-auto">
                <span>➕</span>
                <span>Yeni Sekme Ekle</span>
            </button>
        </div>

        <panoptes-tabstrip id="closableDemo" tab-position="top" closable="true" on-select="onTabSelect" on-close="onTabClose">
            <panoptes-tab title="Sipariş #4810" icon="file" closable="true" active="true">
                <div class="space-y-2">
                    <div class="font-bold text-slate-800 text-xs">Sipariş Detayı (#4810)</div>
                    <p class="text-xs text-slate-600">Müşteri: Aslan Ticaret A.Ş. | Tutar: ₺34.500,00</p>
                    <span class="inline-block px-2 py-0.5 bg-blue-100 text-blue-800 text-[10px] font-bold rounded">Hazırlanıyor</span>
                </div>
            </panoptes-tab>
            <panoptes-tab title="Fatura #9201" icon="file" closable="true">
                <div class="space-y-2">
                    <div class="font-bold text-slate-800 text-xs">E-Arşiv Fatura Belgesi</div>
                    <p class="text-xs text-slate-600">Vergi Dairesi: Beşiktaş | KDV Dahil: ₺12.450,00</p>
                    <span class="inline-block px-2 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded">Onaylandı</span>
                </div>
            </panoptes-tab>
            <panoptes-tab title="Müşteri Raporu" icon="chart" closable="true" badge="Taslak" badge-color="amber">
                <div class="space-y-2">
                    <div class="font-bold text-slate-800 text-xs">Müşteri Sadakat & Ciro Analizi</div>
                    <p class="text-xs text-slate-600">2026 3. Çeyrek dönemsel büyüme oranı %28 olarak gerçekleşti.</p>
                </div>
            </panoptes-tab>
        </panoptes-tabstrip>

        <!-- Collapsible Code Snippet (Standart Tıklayınca Açılan) -->
        <div class="panoptes-code-block mt-3 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-tabstrip id=&quot;closableDemo&quot; tab-position=&quot;top&quot; closable=&quot;true&quot; on-select=&quot;onTabSelect&quot; on-close=&quot;onTabClose&quot;&gt;
    &lt;panoptes-tab title=&quot;Sipariş #4810&quot; icon=&quot;file&quot; closable=&quot;true&quot; active=&quot;true&quot;&gt;...&lt;/panoptes-tab&gt;
    &lt;panoptes-tab title=&quot;Fatura #9201&quot; icon=&quot;file&quot; closable=&quot;true&quot;&gt;...&lt;/panoptes-tab&gt;
    &lt;panoptes-tab title=&quot;Müşteri Raporu&quot; icon=&quot;chart&quot; closable=&quot;true&quot; badge=&quot;Taslak&quot; badge-color=&quot;amber&quot;&gt;...&lt;/panoptes-tab&gt;
&lt;/panoptes-tabstrip&gt;</code></pre>
        </div>
    </div>
    </div>

    <!-- DEMO 3: Dikey Sekmeli Panel (Tek Başına Tam Genişlik) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-2xs p-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 border-b border-slate-100 pb-4">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-indigo-600"></span>
                    <span>3. Dikey Sekmeli Panel (tab-position="left")</span>
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Sol kenar menüsü ve sağ içerik paneliyle profil, hesap ayarları veya yönetim modülleri tasarımı.
                </p>
            </div>
            <span class="text-xs bg-slate-100 text-slate-700 px-2.5 py-1 rounded-lg font-mono font-medium self-start sm:self-auto">
                tab-position="left"
            </span>
        </div>

        <panoptes-tabstrip id="verticalTabStrip" tab-position="left" animation="fade" on-select="onTabSelect">
            <panoptes-tab title="Profil Bilgileri" icon="user" active="true">
                <div class="space-y-4">
                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Kişisel Bilgiler</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="text-[11px] font-semibold text-slate-500 block mb-1">Ad Soyad</label>
                            <input type="text" value="Fatih Ceritli" readonly class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800" />
                        </div>
                        <div>
