@section Scripts {
<script>
let tabCounter = 1;

        function logTabEvent(type, title, details) {
            const consoleEl = document.getElementById('tabEventConsole');
            if (!consoleEl) return;

            const time = new Date().toLocaleTimeString('tr-TR');
            const row = document.createElement('div');
            row.className = 'flex items-start gap-2 py-0.5 border-b border-slate-900/60';
            
            const badgeColor = type === 'close' ? 'text-rose-400 bg-rose-950/60 border-rose-800' : 'text-blue-400 bg-blue-950/60 border-blue-800';
            
            row.innerHTML = `
                <span class="text-slate-500 shrink-0 font-mono text-[10px]">[${time}]</span>
                <span class="px-1.5 py-0.2 rounded border text-[10px] font-bold shrink-0 ${badgeColor}">${type === 'close' ? 'CLOSE' : 'SELECT'}</span>
                <div class="flex-1">
                    <strong class="text-slate-200">${title}</strong>
                    <div class="text-[11px] text-slate-400 mt-0.5">${details}</div>
                </div>
            `;

            consoleEl.appendChild(row);
            consoleEl.scrollTop = consoleEl.scrollHeight;
        }

        function clearEventLog() {
            const consoleEl = document.getElementById('tabEventConsole');
            if (consoleEl) {
                consoleEl.innerHTML = '<div class="text-slate-500">// Günlük temizlendi.</div>';
            }
        }

        function onTabSelect(e) {
            logTabEvent('select', `"${e.title}" Sekmesi Seçildi`, `İndeks: ${e.index} | TabStrip ID: <span class="text-amber-300">${e.sender.id}</span>`);
        }

        function onTabClose(e) {
            logTabEvent('close', `"${e.title}" Sekmesi Kapatıldı`, `Kapatılan İndeks: ${e.index} | TabStrip ID: <span class="text-rose-300">${e.sender.id}</span>`);
        }

        function addNewDynamicTab() {
            const tabStrip = window.Panoptes && window.Panoptes.TabStrip ? window.Panoptes.TabStrip.get('closableDemo') : null;
            if (!tabStrip) return;

            tabCounter++;
            const newIndex = tabStrip.addTab({
                title: `Yeni Belge #${tabCounter}`,
                icon: 'file',
                badge: 'Yeni',
                badgeColor: 'emerald',
                closable: true,
                active: true,
                content: `
                    <div class="space-y-3 animate-fadeIn">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                            <h4 class="text-xs font-bold text-slate-800">Dinamik Oluşturulan Belge #${tabCounter}</h4>
                            <span class="text-[10px] text-slate-400 font-mono">${new Date().toLocaleTimeString()}</span>
                        </div>
                        <p class="text-xs text-slate-600">
                            Bu sekme istemci tarafında <code>Panoptes.TabStrip.get('closableDemo').addTab(...)</code> fonksiyonu ile dinamik olarak oluşturuldu.
                        </p>
                        <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-xl text-xs text-emerald-900 font-medium">
                            ✓ Sekme başarıyla açıldı. Dilediğiniz zaman sağındaki çarpı (✖) butonundan kapatabilirsiniz.
                        </div>
                    </div>
                `
            });

            logTabEvent('select', `Yeni Dinamik Sekme Eklendi`, `Başlık: "Yeni Belge #${tabCounter}" | Yeni İndeks: ${newIndex}`);
        }
</script>
}
