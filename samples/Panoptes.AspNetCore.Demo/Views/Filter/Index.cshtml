@model List<Panoptes.AspNetCore.Models.FilterFieldDefinition>
@using Panoptes.AspNetCore.Demo.Services
@{
    bool isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Filter (Visual Query Builder) - Panoptes Enterprise UI" : "Filter (Görsel Sorgu & Filtre Motoru) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="/" class="hover:text-blue-600 transition">Ana Sayfa</a>
        <span>/</span>
        <a href="/Filter" class="hover:text-blue-600 transition">Veri Yönetimi & Tablolar</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">Filter</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Filter (Görsel Sorgu & Filtre Motoru)</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-filter&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    WAI-ARIA Uyumlu
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn ? "Build AND/OR report filters without code; analysts serve themselves." : "Rapor filtresini kod yazmadan VE/VEYA gruplarıyla kur; analist kendi işini görür.")
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>Örnekler (Features)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">2</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>API Referansı (Props & Events)</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">4</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>Erişilebilirlik (WAI-ARIA)</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
<!-- DEMO 1: Standart Ürün / Katalog Filtre Ağacı -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                    1. Standart Ürün & Katalog Filtre Ağacı (Varsayılan Alanlar & VE/VEYA Operatörleri)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Kullanıcılar "+ Koşul Ekle" ve "+ Alt Grup Ekle" butonlarıyla ağacı genişletebilir, mantıksal işleci (VE/VEYA) değiştirebilir ve filtreyi uygulayabilir.
                </p>
            </div>
            <span class="text-xs font-mono bg-blue-50 text-blue-700 px-2 py-1 rounded font-medium border border-blue-100">&lt;panoptes-filter /&gt;</span>
        </div>

        <div class="p-8 max-w-4xl mx-auto space-y-4">
            <panoptes-filter id="productFilterDemo" 
                             on-apply="onProductFilterApply" 
                             on-change="onProductFilterChange" />
            
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-xs">
                <div class="font-semibold text-slate-700 mb-1 flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Canlı Filtre Çıktısı (Uygulanan JSON Kriterleri):
                </div>
                <pre id="productFilterOutput" class="bg-slate-900 text-emerald-400 p-3 rounded-lg overflow-x-auto font-mono text-[11px] mt-1">// "Filtreyi Uygula" butonuna bastığınızda kriterler burada gösterilir...</pre>
            </div>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-3 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>Kopyala</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-filter id=&quot;productFilterDemo&quot; 
                 on-apply=&quot;onProductFilterApply&quot; 
                 on-change=&quot;onProductFilterChange&quot; /&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 2: Özel Model Alanlı Kurumsal Müşteri ve Finans Sorgusu -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
                    2. C# Controller Modelinden Gelen Özel Alanlar ve Programatik API
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Controller'dan gönderilen <code>List&lt;FilterFieldDefinition&gt;</code> alanları (Müşteri Adı, Şehir, Yıllık Ciro, Kredi Skoru, Üyelik Tarihi, VIP Statüsü) ile dinamik sorgu oluşturma ve programatik kontrol.
                </p>
            </div>
            <span class="text-xs font-mono bg-emerald-50 text-emerald-700 px-2 py-1 rounded font-medium border border-emerald-100">fields="@@Model"</span>
        </div>

        <div class="p-8 max-w-4xl mx-auto space-y-6">
            <panoptes-filter id="customerFilterDemo" 
                             fields="@Model" 
                             on-apply="onCustomerFilterApply" 
                             on-change="onCustomerFilterChange" />

            <!-- Programatik İşlem Butonları -->
            <div class="flex flex-wrap items-center gap-2 pt-2">
                <button type="button" onclick="setPresetFilter()" class="px-3 py-1.5 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition active:scale-95 border border-indigo-200">
                    Örnek VIP Kriterini Yükle (setExpression)
                </button>
                <button type="button" onclick="getFilterJson()" class="px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition active:scale-95 border border-slate-200">
                    Mevcut JSON'ı Oku (getExpression)
                </button>
                <button type="button" onclick="clearCustomerFilter()" class="px-3 py-1.5 text-xs font-semibold text-rose-700 bg-rose-50 hover:bg-rose-100 rounded-lg transition active:scale-95 border border-rose-200">
                    Temizle (clear)
                </button>
                <button type="button" onclick="clearFilterLog()" class="ml-auto px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-slate-800 transition">
                    Günlüğü Temizle
                </button>
            </div>

            <!-- Canlı Olay Günlüğü Terminali -->
            <div class="space-y-1">
                <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Canlı Filtre Olay Günlüğü:</div>
                <div id="filterEventLog" class="h-32 bg-slate-950 text-slate-200 p-3 rounded-xl font-mono text-[11px] overflow-y-auto space-y-1 border border-slate-800 shadow-inner">
                    <div class="text-slate-500">// Filtre değişiklikleri ve API eylemleri burada listelenecektir...</div>
                </div>
            </div>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-3 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>Kopyala</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-filter id=&quot;customerFilterDemo&quot; 
                 fields=&quot;@@Model&quot; 
                 on-apply=&quot;onCustomerFilterApply&quot; 
                 on-change=&quot;onCustomerFilterChange&quot; /&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- Parametre & Nitelik Referans Tablosu -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 bg-slate-50/50">
            <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Panoptes Filter TagHelper Nitelik & Parametre Referansı
            </h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-600">
                        <th class="py-3 px-4 font-semibold">Nitelik (Attribute)</th>
                        <th class="py-3 px-4 font-semibold">Tür (Type)</th>
                        <th class="py-3 px-4 font-semibold">Varsayılan</th>
                        <th class="py-3 px-4 font-semibold">Açıklama</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-mono text-[11px] text-slate-700">
                    <tr>
                        <td class="py-2.5 px-4 font-bold text-blue-600">id</td>
                        <td class="py-2.5 px-4 text-slate-500">string</td>
                        <td class="py-2.5 px-4 text-slate-400">Otomatik GUID</td>
                        <td class="py-2.5 px-4 font-sans text-slate-600">Filtre bileşeninin benzersiz DOM kimliği.</td>
                    </tr>
                    <tr>
                        <td class="py-2.5 px-4 font-bold text-blue-600">fields</td>
                        <td class="py-2.5 px-4 text-slate-500">List&lt;FilterFieldDefinition&gt;</td>
                        <td class="py-2.5 px-4 text-slate-400">Ürün Şablonu</td>
                        <td class="py-2.5 px-4 font-sans text-slate-600">Filtre üzerinde seçilebilecek alanların adı, başlığı ve veri tipleri (string, number, date, boolean).</td>
                    </tr>
                    <tr>
                        <td class="py-2.5 px-4 font-bold text-blue-600">on-change</td>
                        <td class="py-2.5 px-4 text-slate-500">string</td>
                        <td class="py-2.5 px-4 text-slate-400">null</td>
                        <td class="py-2.5 px-4 font-sans text-slate-600">Ağaç yapısında herhangi bir kural, işleç veya değer değiştiğinde tetiklenecek JS geri çağırma fonksiyonu.</td>
                    </tr>
                    <tr>
                        <td class="py-2.5 px-4 font-bold text-blue-600">on-apply</td>
                        <td class="py-2.5 px-4 text-slate-500">string</td>
                        <td class="py-2.5 px-4 text-slate-400">null</td>
                        <td class="py-2.5 px-4 font-sans text-slate-600">Kullanıcı "Filtreyi Uygula" butonuna bastığında çalışan JS geri çağırma fonksiyonu.</td>
                    </tr>
                    <tr>
                        <td class="py-2.5 px-4 font-bold text-blue-600">class</td>
                        <td class="py-2.5 px-4 text-slate-500">string</td>
                        <td class="py-2.5 px-4 text-slate-400">null</td>
                        <td class="py-2.5 px-4 font-sans text-slate-600">Kapsayıcı kutuya eklenecek ilave CSS sınıfları.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>


    </div>

    <!-- PANEL 2: API & ATTRIBUTES -->
    <div id="panel-api" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">TagHelper Özellikleri & Parametreleri</h3>
                    <p class="text-xs text-slate-500 mt-0.5">&lt;panoptes-filter&gt; bileşeninin desteklediği tüm C# ve HTML nitelikleri.</p>
                </div>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-blue-100 text-blue-800">PanoptesFilterTagHelper</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                            <th class="py-3 px-6">Özellik (Attribute)</th>
                            <th class="py-3 px-4">Tip (C#)</th>
                            <th class="py-3 px-4">Varsayılan</th>
                            <th class="py-3 px-6">Açıklama</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">id</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">Otomatik</td>
                            <td class="py-3 px-6 text-slate-700">Bileşen kimliği.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">fields</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">Filtrelenebilecek alanların listesi.</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">expression</td>
                            <td class="py-3 px-4 font-mono text-purple-600">string</td>
                            <td class="py-3 px-4 font-mono text-slate-400">null</td>
                            <td class="py-3 px-6 text-slate-700">Başlangıç filtre ifadesi (JSON).</td>
                        </tr>
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3 px-6 font-mono font-bold text-blue-600">allow-groups</td>
                            <td class="py-3 px-4 font-mono text-purple-600">bool</td>
                            <td class="py-3 px-4 font-mono text-slate-400">true</td>
                            <td class="py-3 px-6 text-slate-700">Alt grup ('VE' / 'VEYA') eklemeye izin verir.</td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PANEL 3: ACCESSIBILITY (WAI-ARIA & KEYBOARD) -->
    <div id="panel-a11y" class="main-doc-panel space-y-8 hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-6">
            <div>
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
                    WAI-ARIA Standartları & Klavye Erişilebilirliği
                </h2>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                    Panoptes Filter bileşeni, W3C WAI-ARIA standartlarına uygun olarak ekran okuyucular ve salt klavye navigasyonu için tasarlanmıştır.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">WAI-ARIA Nitelikleri</div>
                    <div class="text-slate-600">
                        Standart <code>role="tree / group"</code> rolünü taşır. Duruma göre <code>aria-disabled</code>, <code>aria-expanded</code>, <code>aria-selected</code> ve <code>aria-label</code> nitelikleri dinamik olarak güncellenir.
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-bold text-slate-800 font-mono">Odak Yönetimi (Focus Management)</div>
                    <div class="text-slate-600">
                        Sekme sırasını doğal akışında korur (<code>tabIndex="0"</code>). Görsel odak halkaları (focus ring) yüksek kontrastla görünür durumdadır.
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <h3 class="text-sm font-bold text-slate-900 mb-3">Klavye Kısayolları (Keyboard Shortcuts)</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 font-bold">
                                <th class="py-2.5 px-4 w-48">Tuş (Key)</th>
                                <th class="py-2.5 px-4">İşlev (Function)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700">
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Tab</kbd></td>
                                <td class="py-2.5 px-4">Filtre kuralı öğeleri arasında dolaşır.</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Enter</kbd></td>
                                <td class="py-2.5 px-4">Yeni kural veya grup ekler.</td>
                            </tr>
                            <tr>
                                <td class="py-2.5 px-4 font-mono font-bold text-slate-900"><kbd class="px-2 py-0.5 bg-slate-100 border border-slate-300 rounded text-xs shadow-2xs">Delete</kbd></td>
                                <td class="py-2.5 px-4">Odaklanmış filtre kuralını kaldırır.</td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
function logFilterEvent(msg) {
            const el = document.getElementById('filterEventLog');
            if (!el) return;
            const time = new Date().toLocaleTimeString('tr-TR');
            const row = document.createElement('div');
            row.innerHTML = `<span class="text-slate-500">[${time}]</span> <span class="text-emerald-400">${msg}</span>`;
            el.appendChild(row);
            el.scrollTop = el.scrollHeight;
        }

        function clearFilterLog() {
            const el = document.getElementById('filterEventLog');
            if (el) el.innerHTML = '<div class="text-slate-500">// Günlük temizlendi...</div>';
        }

        function onProductFilterChange(data) {
            console.log('Ürün filtresi değişti:', data);
        }

        function onProductFilterApply(data) {
            const out = document.getElementById('productFilterOutput');
            if (out) {
                out.textContent = JSON.stringify(data.filter, null, 2);
            }
        }

        function onCustomerFilterChange(data) {
            logFilterEvent('Kural veya mantık değişti.');
        }

        function onCustomerFilterApply(data) {
            logFilterEvent('Filtre uygulandı: ' + JSON.stringify(data.filter));
        }

        function setPresetFilter() {
            const inst = Panoptes.Filter.getInstance('customerFilterDemo');
            if (inst) {
                inst.setExpression({
                    logic: 'and',
                    rules: [
                        { field: 'IsVip', operator: 'eq', value: 'true' },
                        { field: 'TotalRevenue', operator: 'gte', value: '500000' }
                    ]
                });
                logFilterEvent('Örnek VIP Kriteri yüklendi: Ciro >= 500.000 TL VE VIP = Evet');
            }
        }

        function getFilterJson() {
            const inst = Panoptes.Filter.getInstance('customerFilterDemo');
            if (inst) {
                const expr = inst.getExpression();
                logFilterEvent('Mevcut Sorgu İfadesi: ' + JSON.stringify(expr));
            }
        }

        function clearCustomerFilter() {
            const inst = Panoptes.Filter.getInstance('customerFilterDemo');
            if (inst) {
                inst.clear();
                logFilterEvent('Filtre ağacı sıfırlandı.');
            }
        }
</script>
