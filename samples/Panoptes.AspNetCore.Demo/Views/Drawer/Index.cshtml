@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Drawer - Panoptes UI" : "Drawer (Kenar Çubuğu / Yan Panel) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="/" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="/Drawer" class="hover:text-blue-600 transition">@(isEn ? "Navigation & Layout" : "Navigasyon & Düzen")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">Drawer</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Drawer @(isEn ? "(Sidebar / Side Panel)" : "(Kenar Çubuğu / Yan Panel)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-drawer&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "WAI-ARIA Compliant" : "WAI-ARIA Uyumlu")
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn ? "Side drawer for mobile shells and filter panels; content slides, context stays." : "Mobil kabuk ve filtre paneli için yan çekmece; içerik kayar, bağlam korunur.")
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>@(isEn ? "Examples (Features)" : "Örnekler (Features)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">4</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>@(isEn ? "API Reference (Props & Events)" : "API Referansı (Props & Events)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">3</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>@(isEn ? "Accessibility (WAI-ARIA)" : "Erişilebilirlik (WAI-ARIA)")</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
<!-- DEMO 1: Sol Overlay Çekmece -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                    1. Sol Overlay Çekmece (Standart Navigasyon)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Sol taraftan yumuşak kayma animasyonu ile açılan, rozetler ve kategori ayırıcıları içeren kurumsal çekmece.
                </p>
            </div>
            <span class="text-xs font-mono bg-blue-50 text-blue-700 px-2 py-1 rounded font-medium border border-blue-100">position="left"</span>
        </div>

        <div class="p-6">
            <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 max-w-3xl">
                <div>
                    <h3 class="text-sm font-bold text-slate-800">Sol Çekmeceyi Açın</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Butona tıklayarak veya ESC tuşuna basarak çekmece deneyimini test edin.</p>
                </div>
                <button type="button" data-drawer-toggle="leftNavDrawer" class="inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-xs transition transform active:scale-95">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
                    <span>Sol Çekmeceyi Aç (Toggle)</span>
                </button>
            </div>

            <!-- Çekmece Tanımı -->
            <panoptes-drawer id="leftNavDrawer" position="left" title="Kurumsal Portale Giriş">
                <panoptes-drawer-item text="Ana Kontrol Paneli" icon="home" url="/" is-active="true" />
                <panoptes-drawer-item text="Gelen Kutusu & Bildirimler" icon="inbox" url="/Drawer" badge="14 Yeni" badge-color="emerald" />
                <panoptes-drawer-item text="Etkinlik Takvimi" icon="calendar" url="/Drawer" badge="3 Bugün" badge-color="blue" />
                <panoptes-drawer-item is-separator="true" />
                <panoptes-drawer-item text="Kullanıcı Yönetimi" icon="user" url="/Drawer" />
                <panoptes-drawer-item text="Sistem Ayarları" icon="settings" url="/Drawer" />
                <panoptes-drawer-item text="Finansal Raporlar (Kilitli)" icon="folder" disabled="true" badge="Erişim Yok" badge-color="red" />
            </panoptes-drawer>
        </div>

        <!-- Standart Kod Kutusu (1. Resimdeki Standart Kapalı Details) -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;button type="button" data-drawer-toggle="leftNavDrawer" class="btn-primary"&gt;
    Sol Çekmeceyi Aç
&lt;/button&gt;

&lt;panoptes-drawer id="leftNavDrawer" position="left" title="Kurumsal Portale Giriş"&gt;
    &lt;panoptes-drawer-item text="Ana Kontrol Paneli" icon="home" url="/" is-active="true" /&gt;
    &lt;panoptes-drawer-item text="Gelen Kutusu" icon="inbox" badge="14 Yeni" badge-color="emerald" /&gt;
    &lt;panoptes-drawer-item is-separator="true" /&gt;
    &lt;panoptes-drawer-item text="Sistem Ayarları" icon="settings" url="/Settings" /&gt;
&lt;/panoptes-drawer&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 2: Sağ Pozisyonlu Çekmece -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
                    2. Sağ Pozisyonlu Çekmece (Profil & Bildirim Paneli)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Sağ taraftan açılan (<code class="text-emerald-700 bg-emerald-50 px-1 py-0.5 rounded font-mono">position="right"</code>) kullanıcı paneli veya filtre çekmecesi.
                </p>
            </div>
            <span class="text-xs font-mono bg-emerald-50 text-emerald-700 px-2 py-1 rounded font-medium border border-emerald-100">position="right"</span>
        </div>

        <div class="p-6">
            <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 max-w-3xl">
                <div>
                    <h3 class="text-sm font-bold text-slate-800">Sağ Panel Çekmecesini Deneyin</h3>
                    <p class="text-xs text-slate-500 mt-0.5">Özellikle filtreleme, kullanıcı profili ve bildirimler için sağ çekmece idealdir.</p>
                </div>
                <button type="button" data-drawer-toggle="rightProfileDrawer" class="inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-xs transition transform active:scale-95">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    <span>Sağ Çekmeceyi Aç</span>
                </button>
            </div>

            <!-- Sağ Çekmece Tanımı -->
            <panoptes-drawer id="rightProfileDrawer" position="right" title="Kullanıcı Profili & Bildirimler">
                <panoptes-drawer-item text="Hesap Bilgilerim" icon="user" url="/Drawer" />
                <panoptes-drawer-item text="Güvenlik & İki Aşamalı Giriş" icon="settings" url="/Drawer" badge="Aktif" badge-color="emerald" />
                <panoptes-drawer-item text="Sipariş Geçmişi" icon="folder" url="/Drawer" badge="6 Sipariş" badge-color="blue" />
                <panoptes-drawer-item is-separator="true" />
                <panoptes-drawer-item text="Oturumu Kapat" icon="home" url="/Drawer" />
            </panoptes-drawer>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-drawer id="rightProfileDrawer" position="right" title="Kullanıcı Profili"&gt;
    &lt;panoptes-drawer-item text="Hesap Bilgilerim" icon="user" url="/Profile" /&gt;
    &lt;panoptes-drawer-item text="Güvenlik" icon="settings" badge="Aktif" badge-color="emerald" /&gt;
&lt;/panoptes-drawer&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 3: Programatik JavaScript API Kontrolü -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-purple-600 inline-block"></span>
                    3. Programatik JavaScript API ile Yönetim
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Harici JavaScript kodları ile çekmeceleri <code class="text-purple-700 bg-purple-50 px-1 py-0.5 rounded font-mono">open()</code>, <code class="text-purple-700 bg-purple-50 px-1 py-0.5 rounded font-mono">close()</code> ve <code class="text-purple-700 bg-purple-50 px-1 py-0.5 rounded font-mono">toggle()</code> metodlarıyla denetleme.
                </p>
            </div>
            <span class="text-xs font-mono bg-purple-50 text-purple-700 px-2 py-1 rounded font-medium border border-purple-100">panoptesDrawer API</span>
        </div>

        <div class="p-6">
            <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200 space-y-4 max-w-3xl">
                <p class="text-xs text-slate-600">Aşağıdaki programatik butonlar doğrudan JavaScript API'sini çağırır:</p>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" onclick="window.panoptesDrawer.open('leftNavDrawer')" class="px-3 py-2 text-xs font-semibold text-blue-700 bg-blue-100 hover:bg-blue-200 rounded-lg transition">
                        Sol Çekmeceyi Aç (.open)
                    </button>
                    <button type="button" onclick="window.panoptesDrawer.open('rightProfileDrawer')" class="px-3 py-2 text-xs font-semibold text-emerald-700 bg-emerald-100 hover:bg-emerald-200 rounded-lg transition">
                        Sağ Çekmeceyi Aç (.open)
                    </button>
                    <button type="button" onclick="window.panoptesDrawer.toggle('leftNavDrawer')" class="px-3 py-2 text-xs font-semibold text-purple-700 bg-purple-100 hover:bg-purple-200 rounded-lg transition">
                        Sol Çekmeceyi Tersine Çevir (.toggle)
                    </button>
                </div>
            </div>
        </div>

        <!-- Standart Kod Kutusu -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>// ID ile doğrudan açma/kapama
window.panoptesDrawer.open('leftNavDrawer');
window.panoptesDrawer.close('leftNavDrawer');
window.panoptesDrawer.toggle('leftNavDrawer');

// Örnek (Instance) üzerinden çağırma
const drawer = window.panoptesDrawer.getInstance('rightProfileDrawer');
if (drawer) {
    drawer.open();
}</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- API Dokümantasyonu & Nitelik Referans Tablosu -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 bg-slate-50/50">
            <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                Panoptes Drawer TagHelper Parametre & Nitelik Referansı
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">
                <code class="text-blue-600 font-mono">&lt;panoptes-drawer&gt;</code> ve <code class="text-blue-600 font-mono">&lt;panoptes-drawer-item&gt;</code> TagHelper'ları tarafından desteklenen tüm nitelikler.
            </p>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-600 border-collapse">
                <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
                    <tr>
                        <th class="py-3 px-4">TagHelper</th>
                        <th class="py-3 px-4">Nitelik (Attribute)</th>
                        <th class="py-3 px-4">Tip</th>
                        <th class="py-3 px-4">Varsayılan</th>
                        <th class="py-3 px-4">Açıklama</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <tr class="hover:bg-slate-50/50">
                        <td class="py-2.5 px-4 font-mono text-blue-600 font-semibold">&lt;panoptes-drawer&gt;</td>
                        <td class="py-2.5 px-4 font-mono font-bold text-slate-800">id</td>
                        <td class="py-2.5 px-4 font-mono text-purple-600">string</td>
                        <td class="py-2.5 px-4 font-mono text-slate-400">null</td>
                        <td class="py-2.5 px-4">Çekmecenin benzersiz HTML ID'si. Buton ve JS tetiklemelerinde kullanılır.</td>
                    </tr>
                    <tr class="hover:bg-slate-50/50">
                        <td class="py-2.5 px-4 font-mono text-blue-600 font-semibold">&lt;panoptes-drawer&gt;</td>
                        <td class="py-2.5 px-4 font-mono font-bold text-slate-800">position</td>
                        <td class="py-2.5 px-4 font-mono text-purple-600">string</td>
                        <td class="py-2.5 px-4 font-mono text-slate-400">"left"</td>
                        <td class="py-2.5 px-4">Açılma konumu: <code class="font-mono">"left"</code> (sol) veya <code class="font-mono">"right"</code> (sağ).</td>
                    </tr>
                    <tr class="hover:bg-slate-50/50">
                        <td class="py-2.5 px-4 font-mono text-blue-600 font-semibold">&lt;panoptes-drawer&gt;</td>
                        <td class="py-2.5 px-4 font-mono font-bold text-slate-800">title</td>
                        <td class="py-2.5 px-4 font-mono text-purple-600">string</td>
                        <td class="py-2.5 px-4 font-mono text-slate-400">"Menü"</td>
                        <td class="py-2.5 px-4">Çekmecenin üst başlık alanında görüntülenecek metin.</td>
                    </tr>
                    <tr class="hover:bg-slate-50/50">
                        <td class="py-2.5 px-4 font-mono text-blue-600 font-semibold">&lt;panoptes-drawer&gt;</td>
                        <td class="py-2.5 px-4 font-mono font-bold text-slate-800">close-on-backdrop</td>
                        <td class="py-2.5 px-4 font-mono text-purple-600">bool</td>
                        <td class="py-2.5 px-4 font-mono text-slate-400">true</td>
                        <td class="py-2.5 px-4">Arkaplandaki karartılmış alana tıklandığında çekmecenin otomatik kapanması.</td>
                    </tr>
                    <tr class="hover:bg-slate-50/50">
