@section Scripts {
    <script src="~/panoptes/panoptes-splitter.js"></script>
<script>
function logSplitterEvent(message) {
            const container = document.getElementById('splitterEventLogs');
            if (!container) return;
            const row = document.createElement('div');
            const time = new Date().toLocaleTimeString();
            row.innerHTML = `<span class="text-slate-500">[${time}]</span> ${message}`;
            container.appendChild(row);
            container.scrollTop = container.scrollHeight;
        }

        function handleSplitterResize(e) {
            const badge = document.getElementById('paneSizeBadge');
            if (badge && e.prevSize) {
                badge.textContent = `Sol Genişlik: ${Math.round(e.prevSize)}px`;
            }
            logSplitterEvent(`<span class="text-amber-400">onResize:</span> Sol: ${Math.round(e.prevSize)}px, Sağ: ${Math.round(e.nextSize)}px`);
        }

        function toggleLeftPane() {
            const splitter = window.panoptesSplitter.getInstance('demoSplitterApi');
            if (splitter) {
                splitter.toggle('paneApiLeft');
                logSplitterEvent(`<span class="text-blue-400">toggle:</span> Sol panel durumu değiştirildi.`);
            }
        }

        function collapseLeftPane() {
            const splitter = window.panoptesSplitter.getInstance('demoSplitterApi');
            if (splitter) {
                splitter.collapse('paneApiLeft');
                logSplitterEvent(`<span class="text-rose-400">collapse:</span> Sol panel kapatıldı.`);
            }
        }

        function expandLeftPane() {
            const splitter = window.panoptesSplitter.getInstance('demoSplitterApi');
            if (splitter) {
                splitter.expand('paneApiLeft');
                logSplitterEvent(`<span class="text-emerald-400">expand:</span> Sol panel açıldı.`);
            }
        }

        function setLeftPaneSize(size) {
            const splitter = window.panoptesSplitter.getInstance('demoSplitterApi');
            if (splitter) {
                splitter.size('paneApiLeft', size);
                const badge = document.getElementById('paneSizeBadge');
                if (badge) badge.textContent = `Sol Genişlik: ${size}`;
                logSplitterEvent(`<span class="text-purple-400">size:</span> Sol panel boyutu ${size} yapıldı.`);
            }
        }

        function clearSplitterLog() {
            const container = document.getElementById('splitterEventLogs');
            if (container) {
                container.innerHTML = '<div class="text-slate-500 italic">// Temizlendi. Yeni olaylar bekleniyor...</div>';
            }
        }
</script>
}
