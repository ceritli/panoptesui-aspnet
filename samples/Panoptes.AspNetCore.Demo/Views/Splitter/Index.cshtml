@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Splitter - Panoptes UI" : "Splitter (Panel Bölücü) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="/" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="/Splitter" class="hover:text-blue-600 transition">@(isEn ? "Navigation & Layout" : "Navigasyon & Düzen")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">Splitter</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Splitter @(isEn ? "(Resizable Splitter Panels)" : "(Panel Bölücü)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-splitter&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "WAI-ARIA Compliant" : "WAI-ARIA Uyumlu")
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn ? "Resizable side-by-side panes like mail clients; list and detail share one screen." : "E-posta istemcisi gibi yan yana paneller; liste ve detay aynı ekranı paylaşır.")
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>@(isEn ? "Examples (Features)" : "Örnekler (Features)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">5</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>@(isEn ? "API Reference (Props & Events)" : "API Referansı (Props & Events)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">3</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>@(isEn ? "Accessibility (WAI-ARIA)" : "Erişilebilirlik (WAI-ARIA)")</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
<!-- DEMO 1: Yatay İki Bölmeli Splitter (Dosya Gezgini & İçerik) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                    1. Yatay Bölmeli Splitter (Dosya Gezgini & Önizleme)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Sol panel başlangıçta 280px genişliğinde, minimum 160px ve maksimum 450px arasında sürüklenebilir.
                </p>
            </div>
            <span class="text-xs font-mono bg-blue-50 text-blue-700 px-2 py-1 rounded font-medium border border-blue-100">&lt;panoptes-splitter orientation="horizontal"&gt;</span>
        </div>

        <div class="p-6">
            <div class="h-80 w-full border border-slate-200 rounded-xl overflow-hidden bg-slate-50">
                <panoptes-splitter id="demoSplitter1" orientation="horizontal" class="h-full">
                    <panoptes-splitter-pane id="paneNav1" size="280px" min-size="160px" max-size="450px" class="bg-slate-50 p-4">
                        <div class="text-xs font-bold uppercase text-slate-400 tracking-wider mb-3">Proje Belgeleri</div>
                        <ul class="space-y-1.5 text-xs text-slate-600 font-medium">
                            <li class="p-2 rounded-lg bg-blue-50 text-blue-700 flex items-center gap-2 cursor-pointer">
                                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                <span>Mimari_Tasarim_v2.docx</span>
                            </li>
                            <li class="p-2 rounded-lg hover:bg-white flex items-center gap-2 cursor-pointer transition">
                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                <span>Veri_Modelleri_Spec.pdf</span>
                            </li>
                            <li class="p-2 rounded-lg hover:bg-white flex items-center gap-2 cursor-pointer transition">
                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                <span>API_Sozlesmesi_2026.json</span>
                            </li>
                        </ul>
                    </panoptes-splitter-pane>

                    <panoptes-splitter-pane id="paneContent1" class="bg-white p-6">
                        <div class="max-w-2xl">
                            <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
                                <h3 class="text-sm font-bold text-slate-800">Mimari Tasarım Belgesi v2.4</h3>
                                <span class="text-[11px] font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-100">Güncel Sürüm</span>
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed mb-3">
                                Panoptes mimarisinde ASP.NET Core Razor Class Library (RCL) ve Tailwind CSS altyapısı tercih edilmiştir. Tüm bileşenler hafif (lightweight), bağımsız JavaScript motorları ile desteklenmekte ve modern web standartlarına tam uyumlu çalışmaktadır.
                            </p>
                            <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 text-xs text-amber-800">
                                <strong>Bilgi:</strong> İki panel arasındaki gri ayırıcı çubuğu fare veya dokunmatik ekran ile tutup sağa-sola sürükleyerek genişliği anlık değiştirebilirsiniz.
                            </div>
                        </div>
                    </panoptes-splitter-pane>
                </panoptes-splitter>
            </div>
        </div>

        <!-- Standart Kod Kutusu (1. Resimdeki Standart Kapalı Details) -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-splitter id="demoSplitter1" orientation="horizontal" class="h-80"&gt;
    &lt;panoptes-splitter-pane id="paneNav1" size="280px" min-size="160px" max-size="450px"&gt;
        &lt;!-- Sol Liste İçeriği --&gt;
    &lt;/panoptes-splitter-pane&gt;

    &lt;panoptes-splitter-pane id="paneContent1"&gt;
        &lt;!-- Sağ Detay İçeriği --&gt;
    &lt;/panoptes-splitter-pane&gt;
&lt;/panoptes-splitter&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 2: Dikey Bölmeli Splitter (SQL Editörü & Sonuç Konsolu) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-indigo-600 inline-block"></span>
                    2. Dikey Bölmeli Splitter (SQL Editörü & Çıktı Konsolu)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    `orientation="vertical"` ile paneller alt alta konumlanır, ayırıcı çubuk yukarı ve aşağı sürüklenerek boyutlandırılır.
                </p>
            </div>
            <span class="text-xs font-mono bg-indigo-50 text-indigo-700 px-2 py-1 rounded font-medium border border-indigo-100">&lt;panoptes-splitter orientation="vertical"&gt;</span>
        </div>

        <div class="p-6">
            <div class="h-96 w-full border border-slate-200 rounded-xl overflow-hidden bg-slate-900 shadow-inner">
                <panoptes-splitter id="demoSplitterVertical" orientation="vertical" class="h-full">
                    <panoptes-splitter-pane id="paneSqlEditor" size="180px" min-size="100px" max-size="280px" class="bg-slate-950 p-4 font-mono text-xs text-slate-200">
                        <div class="flex items-center justify-between text-slate-400 pb-2 mb-2 border-b border-slate-800 font-sans text-xs">
                            <span class="font-semibold text-slate-300">Sorgu Editörü (Query.sql)</span>
                            <span class="text-[10px] bg-indigo-900/60 text-indigo-300 px-2 py-0.5 rounded border border-indigo-700">PostgreSQL</span>
                        </div>
                        <div class="text-emerald-400">SELECT</div>
                        <div class="pl-4 text-slate-300">u.id, u.username, u.email, COUNT(o.id) AS total_orders</div>
                        <div class="text-emerald-400">FROM</div>
                        <div class="pl-4 text-slate-300">users u</div>
                        <div class="text-emerald-400">LEFT JOIN</div>
                        <div class="pl-4 text-slate-300">orders o ON o.user_id = u.id</div>
                        <div class="text-emerald-400">WHERE</div>
                        <div class="pl-4 text-slate-300">u.status = 'ACTIVE'</div>
                        <div class="text-emerald-400">GROUP BY</div>
                        <div class="pl-4 text-slate-300">u.id, u.username, u.email;</div>
                    </panoptes-splitter-pane>

                    <panoptes-splitter-pane id="paneSqlResult" class="bg-slate-900 p-4 font-mono text-xs text-slate-300">
                        <div class="flex items-center justify-between text-slate-400 pb-2 mb-3 border-b border-slate-800 font-sans text-xs">
                            <span class="font-semibold text-emerald-400 flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                Sorgu Sonucu (3 Satır Döndü - 18ms)
                            </span>
                            <span class="text-[11px] text-slate-500">2026-10-10 13:40:02</span>
                        </div>
                        <table class="w-full text-left border-collapse text-[11px]">
                            <thead>
                                <tr class="text-slate-400 border-b border-slate-800 bg-slate-800/40">
                                    <th class="p-1.5">ID</th>
                                    <th class="p-1.5">Kullanıcı Adı</th>
                                    <th class="p-1.5">E-posta</th>
                                    <th class="p-1.5">Sipariş Sayısı</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800 text-slate-300">
                                <tr>
                                    <td class="p-1.5 text-slate-500">101</td>
                                    <td class="p-1.5 text-blue-400 font-semibold">fatihceritli</td>
                                    <td class="p-1.5">fatih&#64;example.com</td>
                                    <td class="p-1.5 font-bold text-amber-400">42</td>
                                </tr>
                                <tr>
                                    <td class="p-1.5 text-slate-500">102</td>
                                    <td class="p-1.5 text-blue-400 font-semibold">ahmet_yilmaz</td>
                                    <td class="p-1.5">ahmet&#64;example.com</td>
                                    <td class="p-1.5 font-bold text-amber-400">15</td>
                                </tr>
                                <tr>
                                    <td class="p-1.5 text-slate-500">103</td>
                                    <td class="p-1.5 text-blue-400 font-semibold">zeynep_kaya</td>
                                    <td class="p-1.5">zeynep&#64;example.com</td>
                                    <td class="p-1.5 font-bold text-amber-400">28</td>
                                </tr>
                            </tbody>
                        </table>
                    </panoptes-splitter-pane>
                </panoptes-splitter>
            </div>
        </div>

        <!-- Standart Kod Kutusu (1. Resimdeki Standart Kapalı Details) -->
        <div class="px-6 pb-6">
            <div class="panoptes-code-block mt-4 rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
        <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
            </div>
            <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span>@(isEn ? "Copy" : "Kopyala")</span>
            </button>
        </div>
        <div class="panoptes-code-viewer">
            <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-splitter id="demoSplitterVertical" orientation="vertical" class="h-96"&gt;
    &lt;panoptes-splitter-pane id="paneSqlEditor" size="180px" min-size="100px" max-size="280px"&gt;
        &lt;!-- Üst SQL Editör Paneli --&gt;
    &lt;/panoptes-splitter-pane&gt;

    &lt;panoptes-splitter-pane id="paneSqlResult"&gt;
        &lt;!-- Alt Çıktı ve Sonuç Paneli --&gt;
    &lt;/panoptes-splitter-pane&gt;
&lt;/panoptes-splitter&gt;</code></pre>
        </div>
    </div>
        </div>
    </div>

    <!-- DEMO 3: İç İçe Yuvalanmış Splitter (Nested Splitter - IDE Yapısı) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden w-full">
        <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
            <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
                    3. İç İçe Yuvalanmış Splitter (Nested Splitter - IDE Arayüzü)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Yatay splitter içine dikey splitter gömülerek çok boyutlu modern bir geliştirici arayüzü (Sidebar + Kod + Terminal).
                </p>
            </div>
            <span class="text-xs font-mono bg-emerald-50 text-emerald-700 px-2 py-1 rounded font-medium border border-emerald-100">İç İçe Splitter</span>
        </div>

        <div class="p-6">
            <div class="h-96 w-full border border-slate-200 rounded-xl overflow-hidden bg-slate-100">
                <panoptes-splitter id="splitterNestedOuter" orientation="horizontal" class="h-full">
                    <!-- Sol Bölme: Ağaç Görünümü / Gezgin -->
                    <panoptes-splitter-pane id="paneTree" size="220px" min-size="140px" max-size="350px" class="bg-white p-4">
                        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Çözüm Gezgini</div>
                        <div class="space-y-1 text-xs text-slate-700">
                            <div class="flex items-center gap-1.5 font-semibold text-slate-800">
                                <span>📁</span> Panoptes.Core
                            </div>
                            <div class="pl-4 space-y-1 text-slate-600">
                                <div class="flex items-center gap-1.5"><span>📄</span> Splitter.cs</div>
                                <div class="flex items-center gap-1.5"><span>📄</span> TabStrip.cs</div>
                                <div class="flex items-center gap-1.5"><span>📄</span> ListView.cs</div>
                            </div>
                            <div class="flex items-center gap-1.5 font-semibold text-slate-800 pt-2">
                                <span>📁</span> Panoptes.Demo
                            </div>
                            <div class="pl-4 space-y-1 text-slate-600">
                                <div class="flex items-center gap-1.5 text-blue-600 font-medium"><span>📄</span> Index.cshtml</div>
                            </div>
                        </div>
                    </panoptes-splitter-pane>

                    <!-- Sağ Bölme: İç Dikey Splitter (Editör + Terminal) -->
                    <panoptes-splitter-pane id="paneInnerContainer" class="p-0 overflow-hidden bg-white">
                        <panoptes-splitter id="splitterNestedInner" orientation="vertical" class="h-full border-0 rounded-none">
                            <panoptes-splitter-pane id="paneInnerCode" size="200px" min-size="120px" class="bg-white p-5 font-mono text-xs">
                                <div class="text-slate-400 mb-2 font-sans font-semibold text-[11px] flex items-center justify-between">
                                    <span>C# Kod Editörü - TabStripTagHelper.cs</span>
                                    <span class="text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded font-mono text-[10px]">Ready</span>
                                </div>
                                <p class="text-blue-600">namespace <span class="text-amber-600">Panoptes.AspNetCore.TagHelpers</span>;</p>
                                <p class="text-blue-600 mt-1">public class <span class="text-emerald-600">TabStripTagHelper</span> : TagHelper</p>
                                <p class="text-slate-700 pl-4">{</p>
                                <p class="text-slate-700 pl-8">public override async Task ProcessAsync(...)</p>
                                <p class="text-slate-700 pl-4">}</p>
                            </panoptes-splitter-pane>

                            <panoptes-splitter-pane id="paneInnerTerminal" class="bg-slate-900 p-4 font-mono text-xs text-slate-200">
                                <div class="text-[11px] text-slate-400 font-sans font-semibold pb-1 mb-2 border-b border-slate-800 flex items-center justify-between">
                                    <span>Dahili Terminal (zsh)</span>
                                    <span class="text-emerald-400">● 5085 Port Aktif</span>
                                </div>
                                <div class="text-emerald-400 font-semibold">$ dotnet run --project Panoptes.AspNetCore.Demo</div>
                                <div class="text-slate-400 text-[11px] mt-1">Building...</div>
