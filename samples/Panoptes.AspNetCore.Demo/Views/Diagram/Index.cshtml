                            <td class="py-2.5 px-4 text-slate-600">-</td>
                            <td class="py-2.5 px-4 font-sans text-slate-600">@(isEn ? "Resets canvas to initial template state provided by C# model." : "Tuvali ilk C# modelinden gelen orijinal şablon verilerine sıfırlar.")</td>
                        </tr>
                    </tbody>
