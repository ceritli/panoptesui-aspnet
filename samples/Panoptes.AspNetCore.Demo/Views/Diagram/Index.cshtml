</div>

@section Scripts {
<script>
    let stepCounter = 7;

    function logDiagEvent(msg) {
        const el = document.getElementById('diagEventLog');
        if (!el) return;
        const time = new Date().toLocaleTimeString('tr-TR');
        const row = document.createElement('div');
        row.innerHTML = `<span class="text-slate-500">[${time}]</span> <span class="text-emerald-400 font-medium">${msg}</span>`;
        el.appendChild(row);
        el.scrollTop = el.scrollHeight;
    }

    function clearDiagLog() {
        const el = document.getElementById('diagEventLog');
        if (el) el.innerHTML = '<div class="text-slate-500">// Günlük temizlendi...</div>';
    }

    function onDiagramNodeSelect(node) {
        const info = document.getElementById('selectedNodeInfo');
        if (info) {
            if (node) {
                info.innerHTML = `<strong>Seçilen Adım:</strong> <span class="text-blue-600 font-bold">[${node.Id}]</span> <span class="text-slate-800 font-semibold">${node.Title}</span> - <em>${node.Subtitle || 'Alt Başlık Yok'}</em> (Konum: X=${node.X}, Y=${node.Y})`;
                logDiagEvent(`Düğüm seçildi: "${node.Title}" [${node.Id}]`);
            } else {
                info.textContent = 'Herhangi bir adım seçilmedi. Diyagram üzerindeki bir kutuya tıklayarak seçebilirsiniz.';
            }
        }
    }

    // DEMO 1: Flowchart Yeni Adım Ekleme
    function addNewFlowStep() {
        const diag = Panoptes.Diagram.getInstance('invoiceFlowDiagram');
        if (!diag) return;

        const title = document.getElementById('flowNewTitle').value.trim() || `${stepCounter}. Yeni Adım`;
        const subtitle = document.getElementById('flowNewSubtitle').value.trim();
        const color = document.getElementById('flowNewColor').value;
        const connectFrom = document.getElementById('flowConnectFrom').value;

        const newId = 'step' + stepCounter++;
        const node = diag.addNode({
            Id: newId,
            Title: title,
            Subtitle: subtitle,
            Color: color,
            connectFrom: connectFrom || null,
            connectionLabel: 'Aktarım'
        });

        // Seçenek listesine yeni düğümü de ekle
        const selectEl = document.getElementById('flowConnectFrom');
        if (selectEl) {
            const opt = document.createElement('option');
            opt.value = newId;
            opt.textContent = `${title}`;
            selectEl.insertBefore(opt, selectEl.firstChild);
            selectEl.value = newId;
        }

        // Geri bildirim rozeti
        const fb = document.getElementById('flowActionFeedback');
        if (fb) {
            fb.textContent = `"${title}" adımı başarıyla eklendi!`;
            fb.classList.remove('hidden');
            setTimeout(() => fb.classList.add('hidden'), 3000);
        }

        logDiagEvent(`Yeni akış adımı eklendi: "${title}" [${newId}]`);
    }

    // DEMO 1: Flowchart Seçili Adımı Silme
    function deleteSelectedFlowStep() {
        const diag = Panoptes.Diagram.getInstance('invoiceFlowDiagram');
        if (!diag) return;

        if (!diag.selectedNodeId) {
            alert('Lütfen silmek istediğiniz adımı önce diyagram üzerinden tıklayarak seçin.');
            return;
        }

        const removed = diag.removeNode();
        if (removed) {
            const fb = document.getElementById('flowActionFeedback');
            if (fb) {
                fb.textContent = `"${removed.Title}" adımı ve bağlantıları silindi!`;
                fb.classList.remove('hidden');
                setTimeout(() => fb.classList.add('hidden'), 3000);
            }
            logDiagEvent(`Akış adımı silindi: "${removed.Title}" [${removed.Id}]`);
        }
    }

    // DEMO 1: Flowchart Sıfırlama
    function resetFlowDiagram() {
        const diag = Panoptes.Diagram.getInstance('invoiceFlowDiagram');
        if (diag) {
            diag.reset();
            stepCounter = 7;
            logDiagEvent('İş akış şeması orijinal varsayılan şablona sıfırlandı.');
        }
    }

    // DEMO 2: OrgChart Yeni Pozisyon Ekleme
    function addNewOrgPosition() {
        const diag = Panoptes.Diagram.getInstance('orgDiagram');
        if (!diag) return;

        const name = document.getElementById('orgNewName').value.trim() || 'Yeni Çalışan';
        const role = document.getElementById('orgNewRole').value.trim() || 'Uzman';
        const parent = document.getElementById('orgParentLeader').value;

        const newId = 'pos_' + Math.random().toString(36).substring(2, 7);
        diag.addNode({
            Id: newId,
            Title: name,
            Subtitle: role,
            Color: 'emerald',
            connectFrom: parent
        });

        logDiagEvent(`Organizasyona yeni pozisyon eklendi: "${name}" (${role}) -> Bağlı: [${parent}]`);
    }

    // DEMO 2: OrgChart Seçili Pozisyonu Silme
    function deleteSelectedOrgPosition() {
        const diag = Panoptes.Diagram.getInstance('orgDiagram');
        if (!diag) return;

        if (!diag.selectedNodeId) {
            alert('Lütfen silmek istediğiniz pozisyonu önce organizasyon ağacından tıklayarak seçin.');
            return;
        }

        const removed = diag.removeNode();
        if (removed) {
            logDiagEvent(`Pozisyon ağaçtan kaldırıldı: "${removed.Title}" [${removed.Id}]`);
        }
    }

    // DEMO 2: OrgChart Sıfırlama
    function resetOrgDiagram() {
        const diag = Panoptes.Diagram.getInstance('orgDiagram');
        if (diag) {
            diag.reset();
            logDiagEvent('Organizasyon ağacı orijinal şablona sıfırlandı.');
        }
    }

    function selectCeoNode() {
        const diag = Panoptes.Diagram.getInstance('orgDiagram');
        if (diag) {
            diag.selectNode('ceo');
            logDiagEvent('Programatik seçim: Genel Müdür (CEO) düğümü seçildi.');
        }
    }

    function selectCtoNode() {
        const diag = Panoptes.Diagram.getInstance('orgDiagram');
        if (diag) {
            diag.selectNode('cto');
            logDiagEvent('Programatik seçim: Teknoloji Direktörü (CTO) düğümü seçildi.');
        }
    }

    function fitOrgDiagram() {
        const diag = Panoptes.Diagram.getInstance('orgDiagram');
        if (diag) {
            diag.fit();
            logDiagEvent('Diyagram tuvali ekrana sığdırıldı.');
        }
    }

    function exportOrgSvg() {
        const diag = Panoptes.Diagram.getInstance('orgDiagram');
        if (diag) {
            diag.exportSvg();
            logDiagEvent('Organizasyon şeması SVG formatında indirildi.');
        }
    }
</script>
}
