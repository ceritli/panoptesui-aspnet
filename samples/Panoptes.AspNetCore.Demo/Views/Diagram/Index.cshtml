@model Panoptes.AspNetCore.Demo.Controllers.DiagramDemoViewModel

@{
    var isEn = DemoTranslations.IsEnglish(Context);
    ViewData["Title"] = isEn ? "Diagram (Org Chart & Flowchart Engine) - Panoptes Corporate UI" : "Diagram (Organizasyon Şeması & Akış Diyagramı) - Panoptes Kurumsal UI";
}

<div class="space-y-8 pb-16">
    <!-- Breadcrumb -->
    <nav class="flex text-xs font-medium text-slate-400 gap-2 items-center">
        <a href="/" class="hover:text-blue-600 transition">@(isEn ? "Home" : "Ana Sayfa")</a>
        <span>/</span>
        <a href="/Diagram" class="hover:text-blue-600 transition">@(isEn ? "Charts & Visuals" : "Grafikler & Görselleştirme")</a>
        <span>/</span>
        <span class="text-slate-700 font-semibold">Diagram</span>
    </nav>

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Diagram @(isEn ? "(Org Chart & Flowchart Engine)" : "(Organizasyon Şeması & Akış Diyagramı)")</h1>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono">
                    &lt;panoptes-diagram&gt;
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    @(isEn ? "WAI-ARIA Compliant" : "WAI-ARIA Uyumlu")
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono">
                    .NET 8 + C#
                </span>
            </div>
            <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
                @(isEn 
                    ? "Approval flows and org charts by drag-and-drop, with SVG export."
                    : "Onay akışları ve org şemaları sürükle-bırakla çizilir; SVG çıktı alınır.")
            </p>
        </div>
    </div>

    <!-- Main Navigation Tabs (Features | API | Accessibility) -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-2 -mb-px" aria-label="Tabs">
            <button type="button" 
                    id="tab-btn-features" 
                    onclick="switchMainDocTab('features')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 text-blue-600 border-blue-600 bg-blue-50/40 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>@(isEn ? "Features & Demos" : "Örnekler (Features)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-blue-100 text-blue-800">2</span>
            </button>

            <button type="button" 
                    id="tab-btn-api" 
                    onclick="switchMainDocTab('api')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span>@(isEn ? "API Reference (Props & Events)" : "API Referansı (Props & Events)")</span>
                <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-700">3</span>
            </button>

            <button type="button" 
                    id="tab-btn-a11y" 
                    onclick="switchMainDocTab('a11y')"
                    class="main-doc-tab inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-slate-600 hover:text-slate-900 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                <span>@(isEn ? "Accessibility (WAI-ARIA)" : "Erişilebilirlik (WAI-ARIA)")</span>
            </button>
        </nav>
    </div>

    <!-- PANEL 1: FEATURES & SHOWCASE -->
    <div id="panel-features" class="main-doc-panel space-y-8">
        <!-- DEMO 1: Kurumsal E-Fatura Onay ve ERP Entegrasyon İş Akışı (Flowchart) + Canlı Veri Ekleme & Çıkarma -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden w-full">
            <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-blue-600 inline-block"></span>
                        @(isEn 
                            ? "1. Enterprise E-Invoice Approval & ERP Workflow (Flowchart & Live CRUD)" 
                            : "1. Kurumsal E-Fatura Onay ve ERP Entegrasyon İş Akış Şeması (Flowchart)")
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">
                        @(isEn 
                            ? "Directed connectors between steps, action labels and status color badges. Drag nodes to reposition, or add/delete steps dynamically using the control bar below." 
                            : "Adımlar arası yönlendirilmiş oklar, işlem etiketleri, renkli durum rozetleri. Düğümleri fareyle sürükleyerek yerlerini değiştirebilir, aşağıdaki panelden yeni adım ekleyip silebilirsiniz.")
                    </p>
                </div>
                <span class="text-xs font-mono bg-blue-50 text-blue-700 px-2 py-1 rounded font-medium border border-blue-100">&lt;panoptes-diagram layout="flowchart" /&gt;</span>
            </div>

            <div class="p-8 max-w-5xl mx-auto space-y-4">
                <!-- İnteraktif Düğüm & Bağlantı Yönetim Çubuğu (Veri Ekleme / Çıkarma) -->
                <div class="bg-slate-900 text-white rounded-xl p-4 shadow-md border border-slate-800 space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                        <div class="flex items-center gap-2 text-xs font-bold text-slate-200">
                            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                            <span>@(isEn ? "Add & Manage Dynamic Flow Step (Live CRUD)" : "Dinamik Akış Adımı Ekle & Yönet (Canlı CRUD)")</span>
                        </div>
                        <span class="text-[11px] text-slate-400 font-mono">Panoptes.Diagram.addNode() / removeNode()</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-4 gap-2.5 text-xs">
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1 font-medium">@(isEn ? "Step Title" : "Adım Başlığı")</label>
                            <input id="flowNewTitle" type="text" placeholder="Örn: 7. Arşiv & Yedekleme" value="7. Arşiv & Loglama" class="w-full px-2.5 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 text-xs" />
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1 font-medium">@(isEn ? "Subtitle" : "Alt Açıklama")</label>
                            <input id="flowNewSubtitle" type="text" placeholder="Örn: Cold Storage 10 Yıl" value="Zaman Damgalı Saklama" class="w-full px-2.5 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 text-xs" />
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1 font-medium">@(isEn ? "Box Color" : "Kutu Rengi")</label>
                            <select id="flowNewColor" class="w-full px-2.5 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white focus:outline-none focus:border-blue-500 text-xs">
                                <option value="blue">@(isEn ? "Blue (Action)" : "Mavi (İşlem)")</option>
                                <option value="emerald">@(isEn ? "Emerald (Approval/Success)" : "Zümrüt Yeşili (Onay/Başarı)")</option>
                                <option value="amber">@(isEn ? "Amber (Pending)" : "Kehribar Sarısı (Beklemede)")</option>
                                <option value="purple">@(isEn ? "Purple (Validation)" : "Mor (Doğrulama)")</option>
                                <option value="rose">@(isEn ? "Rose (Critical)" : "Gül Kurusu (Kritik)")</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1 font-medium">@(isEn ? "Connect From" : "Hangi Adıma Bağlansın?")</label>
                            <select id="flowConnectFrom" class="w-full px-2.5 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white focus:outline-none focus:border-blue-500 text-xs">
                                <option value="step6">6. ERP Kaydı & Ödeme</option>
                                <option value="step5">5. GİB Entegratörü</option>
                                <option value="step4">4. Finans & Muhasebe Onayı</option>
                                <option value="step3">3. Departman Müdürü Onayı</option>
                                <option value="step2">2. Doğrulama Motoru</option>
                                <option value="step1">1. Fatura Girişi</option>
                                <option value="">@(isEn ? "None (Standalone Node)" : "Bağlantısız (Serbest Düğüm)")</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2 pt-1 border-t border-slate-800/80">
                        <button type="button" onclick="addNewFlowStep()" class="px-3.5 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-500 rounded-lg transition active:scale-95 shadow-xs flex items-center gap-1.5 cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                            @(isEn ? "Add New Step" : "Yeni Adımı Ekle")
                        </button>
                        <button type="button" onclick="deleteSelectedFlowStep()" class="px-3 py-1.5 text-xs font-bold text-red-300 bg-red-950/80 hover:bg-red-900 border border-red-800 rounded-lg transition active:scale-95 flex items-center gap-1.5 cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            @(isEn ? "Delete Selected (Delete key)" : "Seçili Adımı Sil (Delete Tuşu)")
                        </button>
                        <button type="button" onclick="resetFlowDiagram()" class="px-3 py-1.5 text-xs font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 border border-slate-600 rounded-lg transition active:scale-95 flex items-center gap-1.5 cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            @(isEn ? "Reset Default Flow" : "Varsayılan Akışa Sıfırla")
                        </button>
                        <span id="flowActionFeedback" class="ml-auto text-xs text-emerald-400 font-mono font-medium hidden">@(isEn ? "Operation successfully applied" : "İşlem başarıyla uygulandı")</span>
                    </div>
                </div>

                <!-- Diyagram Bileşeni -->
                <panoptes-diagram id="invoiceFlowDiagram" 
                                 title="E-Fatura & ERP Onay Akışı" 
                                 layout="flowchart" 
                                 nodes="@Model.FlowchartNodes" 
                                 connections="@Model.FlowchartConnections" 
                                 height="440" 
                                 on-node-select="onDiagramNodeSelect" />

                <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-xs">
                    <div class="font-semibold text-slate-700 mb-1 flex items-center justify-between">
                        <span class="flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            @(isEn ? "Active Selected Node Info (on-node-select):" : "Aktif Seçili Adım Bilgisi (on-node-select):")
                        </span>
                        <span class="text-[10px] text-slate-400 font-normal">@(isEn ? "Hint: Drag boxes on canvas to reposition." : "İpucu: Kutuları fareyle sürükleyip tuvalde istediğiniz yere taşıyabilirsiniz.")</span>
                    </div>
                    <div id="selectedNodeInfo" class="text-slate-600 font-mono text-[11px] mt-0.5">
                        @(isEn 
                            ? "Click on any node on diagram to view details here. Use 'Delete Selected' button or Delete key to remove." 
                            : "Diyagram üzerindeki herhangi bir kutuya tıkladığınızda adım detayları burada gösterilir. Kutuyu silmek için 'Seçili Adımı Sil' butonuna veya klavyeden Delete tuşuna basabilirsiniz.")
                    </div>
                </div>
            </div>

            <!-- Standart Kod Kutusu -->
            <div class="px-6 pb-6">
                <div class="panoptes-code-block rounded-xl border border-slate-200 bg-white overflow-hidden shadow-2xs">
                    <div class="flex items-center justify-between px-4 py-2 bg-slate-50/80 border-b border-slate-200/80 text-xs">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded text-[11px] font-semibold text-blue-600 bg-white border border-slate-200 shadow-2xs font-mono">Razor TagHelper</span>
                        </div>
                        <button type="button" onclick="copyPanoptesCode(this)" class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-50 text-[11px] text-slate-600 font-medium flex items-center gap-1.5 border border-slate-200 transition shadow-2xs cursor-pointer">
                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            <span>@(isEn ? "Copy" : "Kopyala")</span>
                        </button>
                    </div>
                    <div class="panoptes-code-viewer">
                        <pre class="panoptes-raw-code hidden"><code>&lt;panoptes-diagram id="invoiceFlowDiagram" 
                  title="E-Fatura Onay Akışı" 
                  layout="flowchart" 
                  nodes="@@Model.FlowchartNodes" 
                  connections="@@Model.FlowchartConnections" 
                  height="440" 
                  on-node-select="onDiagramNodeSelect" /&gt;</code></pre>
                    </div>
                </div>
            </div>
        </div>

        <!-- DEMO 2: Şirket Yönetim Organizasyon Ağacı (OrgChart) & Dinamik Pozisyon Yönetimi -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden w-full">
            <div class="border-b border-slate-100 px-6 py-4 flex items-center justify-between bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 inline-block"></span>
                        @(isEn 
                            ? "2. Enterprise Hierarchy Tree (OrgChart & Dynamic Position Management)" 
                            : "2. Şirket Yönetim Organizasyon Ağacı (OrgChart) & Dinamik Pozisyon Yönetimi")
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">
                        @(isEn 
                            ? "Hierarchical parent-child relations between CEO, Directors, and Team Leads. Add/remove positions in real time and export vector SVG diagrams." 
                            : "Genel Müdür (CEO), Direktörler ve Takım Liderleri arasındaki ast-üst hiyerarşik bağlar. Hiyerarşiye anlık yeni çalışan/pozisyon ekleyebilir, kaldırabilir ve vektörel SVG çıktısı alabilirsiniz.")
                    </p>
                </div>
                <span class="text-xs font-mono bg-emerald-50 text-emerald-700 px-2 py-1 rounded font-medium border border-emerald-100">Panoptes.Diagram API</span>
            </div>

            <div class="p-8 max-w-5xl mx-auto space-y-6">
                <!-- İnteraktif Pozisyon Ekleme & Yönetim Çubuğu -->
                <div class="bg-slate-900 text-white rounded-xl p-4 shadow-md border border-slate-800 space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                        <div class="flex items-center gap-2 text-xs font-bold text-emerald-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                            <span>@(isEn ? "Add New Position / Employee to Hierarchy" : "Organizasyon Ağacına Yeni Pozisyon / Çalışan Ekle")</span>
                        </div>
                        <span class="text-[11px] text-slate-400 font-mono">@(isEn ? "Dynamic Hierarchy Binding" : "Dinamik Hiyerarşi Bağlama")</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-2.5 text-xs">
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1 font-medium">@(isEn ? "Full Name" : "Ad Soyad")</label>
                            <input id="orgNewName" type="text" placeholder="Örn: Elif Tan" value="Elif Tan" class="w-full px-2.5 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 text-xs" />
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1 font-medium">@(isEn ? "Title / Role" : "Unvan / Rol")</label>
                            <input id="orgNewRole" type="text" placeholder="Örn: DevOps & Bulut Mimarı" value="DevOps & Bulut Mimarı" class="w-full px-2.5 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 text-xs" />
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1 font-medium">@(isEn ? "Reports To (Manager)" : "Kime Bağlı? (Yönetici)")</label>
                            <select id="orgParentLeader" class="w-full px-2.5 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-white focus:outline-none focus:border-emerald-500 text-xs">
                                <option value="cto">Zeynep Arslan (CTO)</option>
                                <option value="cfo">Ahmet Öztürk (CFO)</option>
                                <option value="cmo">Canan Demir (CMO)</option>
                                <option value="ceo">Mehmet Kaya (CEO)</option>
                                <option value="lead_be">Burak Yılmaz (Backend Lideri)</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2 pt-1 border-t border-slate-800/80">
                        <button type="button" onclick="addNewOrgPosition()" class="px-3.5 py-1.5 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 rounded-lg transition active:scale-95 shadow-xs flex items-center gap-1.5 cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                            @(isEn ? "Add Position to Tree" : "Pozisyonu Ağaca Ekle")
                        </button>
                        <button type="button" onclick="deleteSelectedOrgPosition()" class="px-3 py-1.5 text-xs font-bold text-red-300 bg-red-950/80 hover:bg-red-900 border border-red-800 rounded-lg transition active:scale-95 flex items-center gap-1.5 cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            @(isEn ? "Delete Selected" : "Seçili Pozisyonu Sil")
                        </button>
                        <button type="button" onclick="resetOrgDiagram()" class="px-3 py-1.5 text-xs font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 border border-slate-600 rounded-lg transition active:scale-95 flex items-center gap-1.5 cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            @(isEn ? "Reset Tree" : "Ağacı Sıfırla")
                        </button>
                    </div>
                </div>

                <!-- Diyagram Bileşeni -->
                <panoptes-diagram id="orgDiagram" 
                                 title="Panoptes İcra Kurulu ve Şirket Ağacı" 
                                 layout="orgchart" 
                                 nodes="@Model.OrgNodes" 
                                 connections="@Model.OrgConnections" 
                                 height="440" />

                <!-- Programatik İşlem Butonları -->
                <div class="flex flex-wrap items-center gap-2 pt-2">
                    <button type="button" onclick="selectCeoNode()" class="px-3 py-1.5 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition active:scale-95 border border-indigo-200 cursor-pointer">
                        @(isEn ? "Select CEO (selectNode('ceo'))" : "CEO'yu Seç (selectNode('ceo'))")
                    </button>
                    <button type="button" onclick="selectCtoNode()" class="px-3 py-1.5 text-xs font-semibold text-purple-700 bg-purple-50 hover:bg-purple-100 rounded-lg transition active:scale-95 border border-purple-200 cursor-pointer">
                        @(isEn ? "Select CTO (selectNode('cto'))" : "CTO'yu Seç (selectNode('cto'))")
                    </button>
                    <button type="button" onclick="fitOrgDiagram()" class="px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition active:scale-95 border border-slate-200 cursor-pointer">
                        @(isEn ? "Fit to Center" : "Merkeze Sığdır (fit)")
                    </button>
                    <button type="button" onclick="exportOrgSvg()" class="px-3 py-1.5 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-lg transition active:scale-95 border border-blue-200 flex items-center gap-1.5 cursor-pointer">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                        @(isEn ? "Download Vector SVG" : "Vektörel SVG İndir")
                    </button>
                    <button type="button" onclick="clearDiagLog()" class="ml-auto px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-slate-800 transition cursor-pointer">
                        @(isEn ? "Clear Log" : "Günlüğü Temizle")
                    </button>
                </div>

                <!-- Canlı Olay Günlüğü Terminali -->
                <div class="space-y-1">
                    <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">@(isEn ? "Live Diagram Event Log:" : "Canlı Diyagram Olay Günlüğü:")</div>
                    <div id="diagEventLog" class="h-28 bg-slate-950 text-slate-200 p-3 rounded-xl font-mono text-[11px] overflow-y-auto space-y-1 border border-slate-800 shadow-inner">
