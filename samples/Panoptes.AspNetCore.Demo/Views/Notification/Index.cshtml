@section Scripts {
    <script src="~/panoptes/panoptes-notification.js"></script>
    <script>
        const isEnNotif = @(isEn ? "true" : "false");

        function showNotif(type) {
            if (type === 'success') {
                Panoptes.notify.success(
                    isEnNotif ? 'New record has been successfully added to the system.' : 'Yeni kayıt başarıyla sisteme eklendi.', 
                    isEnNotif ? 'Operation Successful' : 'İşlem Başarılı'
                );
            } else if (type === 'error') {
                Panoptes.notify.error(
                    isEnNotif ? 'An unexpected error occurred during operation.' : 'İşlem sırasında beklenmeyen bir hata meydana geldi.', 
                    isEnNotif ? 'Server Error (500)' : 'Sunucu Hatası (500)'
                );
            } else if (type === 'warning') {
                Panoptes.notify.warning(
                    isEnNotif ? 'This action is irreversible, please proceed with caution.' : 'Bu eylem geri alınamaz, lütfen dikkat edin.', 
                    isEnNotif ? 'Critical Action Warning' : 'Kritik İşlem Uyarısı'
                );
            } else {
                Panoptes.notify.info(
                    isEnNotif ? 'System backup scheduled for 02:00 AM.' : 'Sistem yedekleme işlemi saat 02:00\'de başlatılacaktır.', 
                    isEnNotif ? 'System Information' : 'Sistem Bilgilendirmesi'
                );
            }
        }

        function showAtPos(pos) {
            Panoptes.notify.show({
                title: (isEnNotif ? 'Position: ' : 'Konum: ') + pos,
                message: isEnNotif ? `This notification appeared at '${pos}'.` : `Bu bildirim '${pos}' pozisyonunda açıldı.`,
                type: 'info',
                position: pos,
                duration: 4000
            });
        }

        function showPersistentNotif() {
            Panoptes.notify.show({
                title: isEnNotif ? 'Persistent Security Warning' : 'Kalıcı Güvenlik Uyarısı',
                message: isEnNotif ? 'Security certificate is about to expire. Please contact your admin.' : 'Güvenlik sertifikanızın süresi dolmak üzere. Güncellemek için sistem yöneticisine başvurun.',
                type: 'warning',
                position: 'top-right',
                duration: 0,
                closable: true
            });
        }

        function showFastNotif() {
            Panoptes.notify.show({
                title: isEnNotif ? 'Fast Notification' : 'Hızlı Bildirim',
                message: isEnNotif ? 'This message auto-dismisses after 2 seconds.' : 'Bu mesaj 2 saniye sonra otomatik kaybolur.',
                type: 'success',
                position: 'top-right',
                duration: 2000
            });
        }

        function triggerCustomNotification() {
            const title = document.getElementById('custTitle').value;
            const message = document.getElementById('custMessage').value;
            const type = document.getElementById('custType').value;
            const position = document.getElementById('custPos').value;
            const duration = parseInt(document.getElementById('custDuration').value, 10) || 0;

            Panoptes.notify.show({
                title: title,
                message: message,
                type: type,
                position: position,
                duration: duration,
                closable: true
            });
        }
    </script>
}
