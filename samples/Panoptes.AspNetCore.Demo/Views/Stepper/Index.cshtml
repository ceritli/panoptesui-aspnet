@section Scripts {
<script>
let stepperEventCounter = 0;

        function logStepperEvent(action, detail) {
            stepperEventCounter++;
            const counterEl = document.getElementById('stepperEventCount');
            if (counterEl) counterEl.textContent = `${stepperEventCounter} olay tetiklendi`;

            const container = document.getElementById('stepperEventLogContainer');
            if (!container) return;
            const time = new Date().toLocaleTimeString();

            const entry = document.createElement('div');
            entry.className = 'flex items-center gap-2 py-0.5 border-b border-slate-800/60';
            entry.innerHTML = `
                <span class="text-slate-500">[${time}]</span>
                <span class="font-bold text-purple-400">${action}</span>
                <span class="text-slate-300 font-medium">${detail || ''}</span>
            `;

            if (container.querySelector('.italic')) container.innerHTML = '';
            container.prepend(entry);
        }

        function handleStepperChange(e) {
            logStepperEvent('CHANGE', `Adım: ${e.index + 1}${e.isFinished ? ' (Süreç Tamamlandı)' : ''}`);
        }

        function getDemoStepper() {
            return window.panoptesStepper?.getInstance('demoStepperApi');
        }

        window.stepperGoTo = function (index) {
            const stepper = getDemoStepper();
            if (stepper) {
                stepper.goTo(index);
                logStepperEvent('API_CALL', `goTo(${index}) çağrıldı`);
            }
        };

        window.stepperNext = function () {
            const stepper = getDemoStepper();
            if (stepper) {
                stepper.next();
                logStepperEvent('API_CALL', 'next() çağrıldı');
            }
        };

        window.clearStepperLog = function () {
            stepperEventCounter = 0;
            const counterEl = document.getElementById('stepperEventCount');
            if (counterEl) counterEl.textContent = '0 olay tetiklendi';
            const container = document.getElementById('stepperEventLogContainer');
            if (container) container.innerHTML = '<div class="text-slate-500 italic">// Olay günlüğü temizlendi.</div>';
        };
</script>
}
